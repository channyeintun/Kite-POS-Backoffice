# Where the apps look for the Worker, substituted into the `api-base` meta in
# both HTML entries at build time.
#
# One codebase serves more than one shop, and the only thing that differs
# between their front ends is this line. It lives here rather than in the HTML
# so a second shop is a build variable and not an edited file somebody has to
# remember to put back — which is exactly what went wrong the first time it was
# done by hand.
#
#     VITE_API_BASE=https://khant-pos-api.chanyeintun.workers.dev/api npm run build
#
# In development Vite proxies `/api` to the Worker on 8787, so an override to
# `/api` gives a same-origin build that needs no CORS.
VITE_API_BASE=https://kite-pos-api.chanyeintun.workers.dev/api
