// ---- the back office's writes ----------------------------------------------
//
// One function per endpoint, each taking a `json.Json` the caller built from
// the form's own fields. The form system in `desk.kite` decides *what* is asked
// for; these decide only where it is sent.

pub async fn save_product(token: str, id: str, body: json.Json) -> (doc.Doc, error) {
    if id.len() > 0 {
        return await patch(token, "/catalog/products/\(id)", body)
    }
    return await post(token, "/catalog/products", body)
}

pub async fn retire_product(token: str, id: str) -> (doc.Doc, error) {
    return await remove(token, "/catalog/products/\(id)")
}

pub async fn product(token: str, id: str) -> (doc.Doc, error) {
    return await get(token, "/catalog/products/\(id)")
}

pub async fn add_barcode(token: str, product_id: str, body: json.Json) -> (doc.Doc, error) {
    return await post(token, "/catalog/products/\(product_id)/barcodes", body)
}

pub async fn drop_barcode(token: str, barcode: str) -> (doc.Doc, error) {
    return await remove(token, "/catalog/barcodes/\(window.escaped(barcode))")
}

pub async fn save_category(token: str, id: str, body: json.Json) -> (doc.Doc, error) {
    if id.len() > 0 {
        return await patch(token, "/catalog/categories/\(id)", body)
    }
    return await post(token, "/catalog/categories", body)
}

pub async fn save_supplier(token: str, id: str, body: json.Json) -> (doc.Doc, error) {
