/// The staff list, and the command table the till builds its bar from.
///
/// Two lists in one answer because they come from one request, and a tuple
/// rather than a struct for the same reason [`grid`] is one: there is no third
/// thing worth naming. The rules **decode** where the people do not — a rule is
/// four strings the Worker builds from its own table, with no column behind any
/// of them, while `users.username` and `last_seen_at` are nullable.
pub async fn staff(token: str) -> (([model.Staff], [model.CommandRule]), error) {
    let (answer, err) = await get(token, "/staff")
    check err
    var matrix: [model.CommandRule] = []
    for item in list_of(answer, "matrix") {
        let (one, derr) = model.CommandRule.decode(item)
        check errors.wrap(derr, "the command table has a row we could not read")
        matrix.push(one)
    }
    let people = map(doc.items(doc.field(answer, "staff")), model.staff_of)
    return (people, matrix), nil
}

