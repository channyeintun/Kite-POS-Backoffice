    doc.put_int(body, "counted_total", counted)
    if manager_pin.len() > 0 {
        doc.put_text(body, "manager_pin", manager_pin)
    }
    return await post(token, "/till/close-lane", body)
}

pub async fn sign_out(token: str) -> (doc.Doc, error) {
    return await post(token, "/auth/sign-out", doc.object())
}

