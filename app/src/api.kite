//! Talking to the Worker.
//!
//! Every call answers `(T, error)`, so a caller cannot use a result without
//! having said what happens when the lane was offline. What is *not* collapsed
//! into that error is a refusal the till has to act on: a 422 asking for ID or
//! for a price is a normal step in ringing a sale, not a failure, so it comes
//! back as a document with `needs` in it and the caller branches.
//!
//! There is no client object. A [`model.Session`] carries the token and is
//! passed in; a signed-out call takes nothing, because there is no session yet
//! by definition.
//!
//! ## What `T` is, and why it is usually still a document
//!
//! A handful of endpoints answer with something [`model`] has a name for, and
//! those functions return the named thing — the conversion happens once, here,
//! rather than at every call site. That is the whole list: the basket, the grid,
//! the search, the parked baskets, the customer lookup and the receipt search.
//!
//! Everything else answers `(doc.Doc, error)` and will keep doing so. The back
//! office's reports and lists are read ad hoc by the screen that asked for them,
//! and giving each one a struct would be deciding a schema this end does not
//! own.
//!
//! There is a second reason a till endpoint stays a document even when its happy
//! path is a basket: **the 422s.** `scan`, `set_qty`, `adjust_line` and the rest
//! all answer either a basket or a `needs` document, and only the caller knows
//! which question it is being asked. `basket` itself has no 422, which is why it
//! is the one of that family that could be typed.

use std/http
use std/errors
use std/window
use std/json
use doc
use model
use browser

/// Where the API lives.
///
/// Read from a `<meta name="api-base">` in the page, defaulting to a
/// same-origin `/api`. In development Vite proxies that to the Worker on 8787;
/// in production the meta names the deployed Worker, because the till is on
/// Pages and the API is not. Putting it in the HTML means the same build
/// artefacts deploy to a test shop and a real one.
pub fn base() -> str {
    let kept = browser.meta("api-base")
    if kept.len() > 0 {
        return kept
    }
    return "/api"
}

fn headers_for(token: str, body: str) -> str {
    var lines: [str] = ["accept: application/json"]
    if body.len() > 0 {
        lines.push("content-type: application/json")
    }
    if token.len() > 0 {
        lines.push("authorization: Bearer \(token)")
    }
    return join(lines, "\n")
}

/// What a status means, in words an operator can act on.
///
/// The number is not the cashier's business, and the difference between a 401
/// and a 429 is the difference between "sign in again" and "wait a moment".
fn refused(status: int, body: str) -> error {
    let parsed = parse_message(body)
    if parsed.len() > 0 {
        return errors.new(parsed)
    }
    // The server's own sentence beats every one of these, which is why the
    // `parsed` test above stays an `if`: it is a precedence rule, not a row.
    return match status {
        401 => errors.new("that session has ended — sign in again"),
        403 => errors.new("that needs a manager"),
        404 => errors.new("that is not here"),
        429 => errors.new("too many tries — wait a moment"),
        s if s >= 500 => errors.new("the shop's server is having trouble (\(status))"),
        _ => errors.new("that did not go through (\(status))"),
    }
}

/// The sentence the server put in the body, if it put one there.
fn parse_message(body: str) -> str {
    let (parsed, err) = doc.parse(body)
    if err != nil {
        return ""
    }
    return doc.text(doc.field(parsed, "error"), "message", "")
}

/// The machine-readable half of a refusal, for the cases the till branches on.
pub fn code_of(body: doc.Doc) -> str {
    return doc.text(doc.field(body, "error"), "code", "")
}

/// A body with nothing in it.
///
/// For the POSTs that are a verb and no arguments — recall, sign-out, reopen —
/// and for the document a 204 stands in for. A `{ }` literal cannot infer its
/// own type in argument position, so the empty map is named here once.
pub fn empty() -> json.Json {
    let none: { str: json.Json } = { }
    return json.Json.Object(none)
}

/// One request.
///
/// A 422 is answered as a **document rather than an error**, because the two
/// 422s this API sends — "this needs ID" and "this product has no shelf price"
/// — are steps in a sale rather than failures of one. Everything else that is
/// not a 2xx becomes an error carrying the server's own sentence.
pub async fn send(token: str, method: str, path: str, body: str) -> (doc.Doc, error) {
    let (response, err) = await http.send(method, "\(base())\(path)", body, headers_for(token, body))
    check errors.wrap(err, "the lane is offline")

    if response.status == 422 {
        let (needs, perr) = doc.parse(response.body)
        check errors.wrap(perr, "that answer was not JSON")
        return needs, nil
    }
    if !http.succeeded(response) {
        return _, refused(response.status, response.body)
    }
    // A 204 has no body and nothing to read; every other success does.
    if response.body.len() == 0 {
        // Bound rather than returned directly — see the note in `doc.parse`:
        // widening a `Json` to a `Doc` inside a fallible `return` makes the
        // wasm backend emit an invalid module.
        let none: doc.Doc = empty()
        return none, nil
    }
    let (parsed, perr) = doc.parse(response.body)
    check errors.wrap(perr, "that answer was not JSON")
    return parsed, nil
}

pub async fn get(token: str, path: str) -> (doc.Doc, error) {
    return await send(token, "GET", path, "")
}

pub async fn post(token: str, path: str, body: json.Json) -> (doc.Doc, error) {
    return await send(token, "POST", path, json.stringify(body))
}

pub async fn patch(token: str, path: str, body: json.Json) -> (doc.Doc, error) {
    return await send(token, "PATCH", path, json.stringify(body))
}

pub async fn remove(token: str, path: str) -> (doc.Doc, error) {
    return await send(token, "DELETE", path, "")
}

// ---- signing in ------------------------------------------------------------

pub async fn sign_in_with_pin(pin: str, register_id: str) -> (model.Session, error) {
    var body: { str: json.Json } = { }
    body["pin"] = json.Json.Text(pin)
    body["register_id"] = json.Json.Text(register_id)
    let (answer, err) = await post("", "/auth/pin", json.Json.Object(body))
    check err
    let token = doc.text(answer, "token", "")
    if token.len() == 0 {
        return _, errors.new("that PIN was not recognised")
    }
    return model.session_of(answer, token), nil
}

pub async fn sign_in_with_password(username: str, password: str) -> (model.Session, error) {
    var body: { str: json.Json } = { }
    body["username"] = json.Json.Text(username)
    body["password"] = json.Json.Text(password)
    let (answer, err) = await post("", "/auth/password", json.Json.Object(body))
    check err
    let token = doc.text(answer, "token", "")
    if token.len() == 0 {
        return _, errors.new("that username and password do not match")
    }
    return model.session_of(answer, token), nil
}

/// Who this token belongs to — what a reloaded page asks before drawing.
pub async fn whoami(token: str) -> (model.Session, error) {
    let (answer, err) = await get(token, "/auth/me")
    check err
    return model.session_of(answer, token), nil
}

// ---- the till --------------------------------------------------------------

/// What is on the lane right now.
///
/// The one basket-shaped endpoint with no 422 in it — there is no item being
/// added, so there is nothing to be asked for — which is why this one converts
/// and the others hand the caller a document to branch on.
pub async fn basket(token: str) -> (model.Basket, error) {
    let (answer, err) = await get(token, "/till/basket")
    check err
    return model.basket_of(answer), nil
}

pub async fn scan(token: str, code: str, product_id: str, qty: float, age_checked: bool,
    price: int, ask_price: bool) -> (doc.Doc, error) {
    var body: { str: json.Json } = { }
    if code.len() > 0 {
        body["code"] = json.Json.Text(code)
    }
    if product_id.len() > 0 {
        body["product_id"] = json.Json.Text(product_id)
    }
    if qty > 0.0 {
        body["qty"] = json.Json.Number(qty)
    }
    if age_checked {
        body["age_checked"] = json.Json.Bool(true)
    }
    if ask_price {
        body["price"] = json.Json.Number(price as float)
    }
    return await post(token, "/till/scan", json.Json.Object(body))
}

pub async fn set_qty(token: str, line_id: str, qty: float) -> (doc.Doc, error) {
    var body: { str: json.Json } = { }
    body["qty"] = json.Json.Number(qty)
    return await patch(token, "/till/line/\(line_id)", json.Json.Object(body))
}

pub async fn void_line(token: str, line_id: str) -> (doc.Doc, error) {
    return await remove(token, "/till/line/\(line_id)")
}

pub async fn adjust_line(token: str, line_id: str, kind: str, amount: int,
    manager_pin: str) -> (doc.Doc, error) {
    var body: { str: json.Json } = { }
    body["kind"] = json.Json.Text(kind)
    if kind == "discount" {
        body["amount"] = json.Json.Number(amount as float)
    }
    if kind == "override" {
        body["price"] = json.Json.Number(amount as float)
    }
    if manager_pin.len() > 0 {
        body["manager_pin"] = json.Json.Text(manager_pin)
    }
    return await post(token, "/till/line/\(line_id)/adjust", json.Json.Object(body))
}

pub async fn hold(token: str, label: str) -> (doc.Doc, error) {
    var body: { str: json.Json } = { }
    body["label"] = json.Json.Text(label)
    return await post(token, "/till/hold", json.Json.Object(body))
}

pub async fn held(token: str) -> ([model.Held], error) {
    let (answer, err) = await get(token, "/till/held")
    check err
    return map(doc.items(doc.field(answer, "held")), model.held_of), nil
}

pub async fn recall(token: str, id: str) -> (doc.Doc, error) {
    return await post(token, "/till/held/\(id)/recall", empty())
}

pub async fn void_sale(token: str, reason: str, manager_pin: str) -> (doc.Doc, error) {
    var body: { str: json.Json } = { }
    body["reason"] = json.Json.Text(reason)
    if manager_pin.len() > 0 {
        body["manager_pin"] = json.Json.Text(manager_pin)
    }
    return await post(token, "/till/void", json.Json.Object(body))
}

/// Finish the sale.
///
/// `client_id` is an idempotency key the server dedupes on, and it is generated
/// once per attempt rather than per retry — which is the whole point: a lane
/// that loses the answer and asks again lands on the same sale instead of
/// ringing a second one.
pub async fn pay(token: str, payments: [model.Payment], client_id: str) -> (doc.Doc, error) {
    var body: { str: json.Json } = { }
    body["client_id"] = json.Json.Text(client_id)
    var list: [json.Json] = []
    for p in payments {
        var entry: { str: json.Json } = { }
        entry["method"] = json.Json.Text(model.tender_code(p.tender))
        entry["amount"] = json.Json.Number(p.amount as float)
        entry["tendered"] = json.Json.Number(p.amount as float)
        if p.reference.len() > 0 {
            entry["reference"] = json.Json.Text(p.reference)
        }
        list.push(json.Json.Object(entry))
    }
    body["payments"] = json.Json.Array(list)
    return await post(token, "/till/pay", json.Json.Object(body))
}

/// Everything the till holds: the products, and the headings they file under.
///
/// Two lists in one answer because they come from one request, and a tuple
/// rather than a struct because there is no third thing worth naming — the
/// `promotions` the same response carries are applied by the server when a line
/// is priced and are never read at this end.
///
/// The categories **decode** where the products convert, which is the one place
/// in this file the difference shows: a category the server sends malformed is
/// an error here rather than a blank heading on the grid. See [`model.Category`]
/// for why that one is safe to be strict about and [`model.Product`] is not.
pub async fn grid(token: str) -> (([model.Product], [model.Category]), error) {
    let (answer, err) = await get(token, "/till/grid")
    check err
    var categories: [model.Category] = []
    for item in json.items(json.field(answer, "categories")) {
        let (one, derr) = model.Category.decode(item)
        check errors.wrap(derr, "the catalogue has a heading we could not read")
        categories.push(one)
    }
    let products = map(doc.items(doc.field(answer, "products")), model.product_of)
    return (products, categories), nil
}

pub async fn search(token: str, q: str) -> ([model.Product], error) {
    let (answer, err) = await get(token, "/till/search?q=\(window.escaped(q))")
    check err
    return map(doc.items(doc.field(answer, "products")), model.product_of), nil
}

pub async fn price_check(token: str, code: str) -> (doc.Doc, error) {
    return await get(token, "/till/price/\(window.escaped(code))")
}

// ---- the rest of the till's command bar ------------------------------------

pub async fn customers_at_till(token: str, q: str) -> ([model.Customer], error) {
    let (answer, err) = await get(token, "/till/customers?q=\(window.escaped(q))")
    check err
    var out: [model.Customer] = []
    for item in json.items(json.field(answer, "customers")) {
        let (one, derr) = model.Customer.decode(item)
        check errors.wrap(derr, "that customer list has a row we could not read")
        out.push(one)
    }
    return out, nil
}

pub async fn set_customer(token: str, customer_id: str) -> (doc.Doc, error) {
    var body: { str: json.Json } = { }
    body["customer_id"] = json.Json.Text(customer_id)
    return await post(token, "/till/customer", json.Json.Object(body))
}

pub async fn new_customer(token: str, name: str, phone: str) -> (doc.Doc, error) {
    var body: { str: json.Json } = { }
    body["name"] = json.Json.Text(name)
    body["phone"] = json.Json.Text(phone)
    return await post(token, "/till/customers", json.Json.Object(body))
}

pub async fn receipts(token: str, q: str) -> ([model.Receipt], error) {
    let (answer, err) = await get(token, "/till/receipts?q=\(window.escaped(q))")
    check err
    return map(doc.items(doc.field(answer, "receipts")), model.receipt_of), nil
}

pub async fn receipt(token: str, id: str) -> (doc.Doc, error) {
    return await get(token, "/till/receipts/\(id)")
}

pub async fn take_return(token: str, sale_id: str, lines: [model.ReturnLine],
    reason: str, manager_pin: str) -> (doc.Doc, error) {
    var body: { str: json.Json } = { }
    body["sale_id"] = json.Json.Text(sale_id)
    body["reason"] = json.Json.Text(reason)
    if manager_pin.len() > 0 {
        body["manager_pin"] = json.Json.Text(manager_pin)
    }
    var list: [json.Json] = []
    for l in lines {
        if l.taking > 0.0 {
            var entry: { str: json.Json } = { }
            entry["sale_item_id"] = json.Json.Text(l.id)
            entry["qty"] = json.Json.Number(l.taking)
            list.push(json.Json.Object(entry))
        }
    }
    body["lines"] = json.Json.Array(list)
    return await post(token, "/till/return", json.Json.Object(body))
}

pub async fn no_sale(token: str, reason: str, manager_pin: str) -> (doc.Doc, error) {
    var body: { str: json.Json } = { }
    body["reason"] = json.Json.Text(reason)
    if manager_pin.len() > 0 {
        body["manager_pin"] = json.Json.Text(manager_pin)
    }
    return await post(token, "/till/no-sale", json.Json.Object(body))
}

pub async fn close_lane(token: str, counted: int, manager_pin: str) -> (doc.Doc, error) {
    var body: { str: json.Json } = { }
    body["counted_total"] = json.Json.Number(counted as float)
    if manager_pin.len() > 0 {
        body["manager_pin"] = json.Json.Text(manager_pin)
    }
    return await post(token, "/till/close-lane", json.Json.Object(body))
}

pub async fn sign_out(token: str) -> (doc.Doc, error) {
    return await post(token, "/auth/sign-out", empty())
}

