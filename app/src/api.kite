    return await send(token, "DELETE", "/photos/\(key)", "")
}

pub async fn post_opening_balances(token: str, body: doc.Doc) -> (doc.Doc, error) {
    return await post(token, "/accounting/opening-balances", body)
}

pub async fn reverse_entry(token: str, id: str, body: doc.Doc) -> (doc.Doc, error) {
    return await post(token, "/accounting/entries/\(id)/reverse", body)
}

pub async fn reopen_period(token: str, id: str) -> (doc.Doc, error) {
    return await post(token, "/accounting/periods/\(id)/reopen", doc.object())
}

pub async fn dead_stock(token: str, days: int) -> (doc.Doc, error) {
    return await get(token, "/reports/dead-stock?days=\(days)")
}

pub async fn tax_report(token: str, from: int, to: int) -> (doc.Doc, error) {
    return await get(token, "/reports/tax?from=\(from)&to=\(to)")
}

pub async fn payables(token: str) -> (doc.Doc, error) {
    return await get(token, "/purchasing/payables")
}
