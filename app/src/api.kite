pub async fn take_return(token: str, sale_id: str, lines: [model.ReturnLine],
    reason: str, manager_pin: str) -> (doc.Doc, error) {
    let body = doc.object()
    doc.put_text(body, "sale_id", sale_id)
    doc.put_text(body, "reason", reason)
    if manager_pin.len() > 0 {
        doc.put_text(body, "manager_pin", manager_pin)
    }
    let list = doc.array()
    for l in lines {
        if l.taking > 0.0 {
            let entry = doc.object()
            doc.put_text(entry, "sale_item_id", l.id)
            doc.put_num(entry, "qty", l.taking)
            doc.push(list, entry)
        }
    }
    doc.put(body, "lines", list)
    return await post(token, "/till/return", body)
}

pub async fn no_sale(token: str, reason: str, manager_pin: str) -> (doc.Doc, error) {
    let body = doc.object()
    doc.put_text(body, "reason", reason)
    if manager_pin.len() > 0 {
        doc.put_text(body, "manager_pin", manager_pin)
    }
    return await post(token, "/till/no-sale", body)
}

pub async fn close_lane(token: str, counted: int, manager_pin: str) -> (doc.Doc, error) {
