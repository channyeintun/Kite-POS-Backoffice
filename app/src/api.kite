pub async fn save_settings(token: str, body: json.Json) -> (doc.Doc, error) {
    return await patch(token, "/settings", body)
}

pub async fn adjust_stock(token: str, body: json.Json) -> (doc.Doc, error) {
    return await post(token, "/inventory/adjust", body)
}

pub async fn movements(token: str, from: int, product_id: str) -> (doc.Doc, error) {
    return await get(token, "/inventory/movements?from=\(from)&product_id=\(window.escaped(product_id))")
}

pub async fn shift(token: str, id: str) -> (doc.Doc, error) {
    return await get(token, "/shifts/\(id)")
}

pub async fn shift_movement(token: str, id: str, body: json.Json) -> (doc.Doc, error) {
    return await post(token, "/shifts/\(id)/movement", body)
}

pub async fn close_shift(token: str, id: str, counted: int, note: str) -> (doc.Doc, error) {
    var body: { str: json.Json } = { }
    body["counted_total"] = json.Json.Number(counted as float)
    body["note"] = json.Json.Text(note)
    return await post(token, "/shifts/\(id)/close", json.Json.Object(body))
}

pub async fn sale(token: str, id: str) -> (doc.Doc, error) {
    return await get(token, "/sales/\(id)")
}

pub async fn refund_sale(token: str, id: str, body: json.Json) -> (doc.Doc, error) {
    return await post(token, "/sales/\(id)/refund", body)
}

pub async fn add_register(token: str, body: json.Json) -> (doc.Doc, error) {
    return await post(token, "/tills", body)
}

pub async fn retire_register(token: str, id: str) -> (doc.Doc, error) {
    return await remove(token, "/tills/\(id)")
}

pub async fn open_shift(token: str, register_id: str, float_amount: int) -> (doc.Doc, error) {
    var body: { str: json.Json } = { }
    body["register_id"] = json.Json.Text(register_id)
    body["opening_float"] = json.Json.Number(float_amount as float)
    return await post(token, "/shifts/open", json.Json.Object(body))
}

/// Close a lane from the back office, which needs the lane named.
pub async fn force_close_lane(token: str, register_id: str, counted: int) -> (doc.Doc, error) {
    var body: { str: json.Json } = { }
    body["counted_total"] = json.Json.Number(counted as float)
    return await post(token, "/tills/\(register_id)/close", json.Json.Object(body))
}

/// A response read as text rather than as a document.
///
/// For the exports, which answer with a CSV. Everything else in this file
/// parses JSON and would refuse a comma-separated file as malformed.
pub async fn fetch_text(token: str, path: str) -> (str, error) {
    let (response, err) = await http.send("GET", "\(base())\(path)", "", headers_for(token, ""))
    check errors.wrap(err, "the lane is offline")
    if !http.succeeded(response) {
        return _, refused(response.status, response.body)
    }
    return response.body, nil
}

