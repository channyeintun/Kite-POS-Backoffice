//! Talking to the Worker.
//!
//! Every call answers `(T, error)`, so a caller cannot use a result without
//! having said what happens when the lane was offline. What is *not* collapsed
//! into that error is a refusal the till has to act on: a 422 asking for ID or
//! for a price is a normal step in ringing a sale, not a failure, so it comes
//! back as an [`Answer`] — an enum whose variants *are* the branches, rather
//! than a document the caller has to fish a `needs` string out of.
//!
//! There is no client object. A [`model.Session`] carries the token and is
//! passed in; a signed-out call takes nothing, because there is no session yet
//! by definition.
//!
//! ## What `T` is
//!
//! Every endpoint that answers something [`model`] has a name for returns the
//! named thing. The conversion happens **once, here** — a screen is handed a
//! value with fields, not a document it has to know the key names of, and the
//! decision about which of those fields may arrive null was taken in
//! [`model`] against the schema rather than guessed at a call site.
//!
//! The till's two-answer family — `scan`, `set_qty`, `void_line`,
//! `adjust_line`, `hold`, `recall`, `void_sale` and `set_customer` — used to be
//! the largest exception: each answers *either* a basket *or* a 422 `needs`
//! document, and a struct cannot say "one of two things", so all eight handed
//! back a raw document and every call site re-derived which it had. They now
//! answer [`Answer`], and the deciding is done once, in `answer_of`. (`basket`
//! has no 422 at all, so it stays a plain [`model.Basket`].)
//!
//! Three kinds of answer still stay a document, and each for its own reason:
//!
//!   * **The transport itself.** `send`, `get`, `post`, `patch` and `remove`
//!     cannot know what shape a body is, exactly as `JSON.parse` cannot.
//!   * **`/settings`.** A key→value map of setting names, every value optional
//!     with a per-key default. A struct would encode the Worker's allow list a
//!     second time and no field of it could derive.
//!   * **Writes whose answer nobody reads**, and the two whose answer has no
//!     shape in [`model`] — a refund's `{ id, total, tax }`, and the
//!     `{ ok: true }` that every edit and every delete replies with. A `PATCH`
//!     and a `POST` to the same `save_*` do not even answer alike: the one
//!     sends `{ ok: true }` and the other `{ id }`, so a decoder strict enough
//!     to be worth having would refuse half its own call sites.

use std/http
use std/errors
use std/window
use std/json
use doc
use model
use browser

/// Where the API lives.
///
/// Read from a `<meta name="api-base">` in the page, defaulting to a
/// same-origin `/api`. In development Vite proxies that to the Worker on 8787;
/// in production the meta names the deployed Worker, because the till is on
/// Pages and the API is not. Putting it in the HTML means the same build
/// artefacts deploy to a test shop and a real one.
pub fn base() -> str {
    let kept = browser.meta("api-base")
    if kept.len() > 0 {
        return kept
    }
    return "/api"
}

fn headers_for(token: str, body: str) -> str {
    var lines: [str] = ["accept: application/json"]
    if body.len() > 0 {
        lines.push("content-type: application/json")
    }
    if token.len() > 0 {
        lines.push("authorization: Bearer \(token)")
    }
    return join(lines, "\n")
}

/// What a status means, in words an operator can act on.
///
/// The number is not the cashier's business, and the difference between a 401
/// and a 429 is the difference between "sign in again" and "wait a moment".
fn refused(status: int, body: str) -> error {
    let parsed = parse_message(body)
    if parsed.len() > 0 {
        return errors.new(parsed)
    }
    // The server's own sentence beats every one of these, which is why the
    // `parsed` test above stays an `if`: it is a precedence rule, not a row.
    return match status {
        401 => errors.new("that session has ended — sign in again"),
        403 => errors.new("that needs a manager"),
        404 => errors.new("that is not here"),
        429 => errors.new("too many tries — wait a moment"),
        s if s >= 500 => errors.new("the shop's server is having trouble (\(status))"),
        _ => errors.new("that did not go through (\(status))"),
    }
}

/// The sentence the server put in the body, if it put one there.
fn parse_message(body: str) -> str {
    let (parsed, err) = doc.parse(body)
    if err != nil {
        return ""
    }
    return doc.text(doc.field(parsed, "error"), "message", "")
}

/// The machine-readable half of a refusal, for the cases the till branches on.
pub fn code_of(body: doc.Doc) -> str {
    return doc.text(doc.field(body, "error"), "code", "")
}

/// A body with nothing in it.
///
/// For the POSTs that are a verb and no arguments — recall, sign-out, reopen —
/// and for the document a 204 stands in for. A `{ }` literal cannot infer its
/// own type in argument position, so the empty map is named here once.
pub fn empty() -> json.Json {
    let none: { str: json.Json } = { }
    return json.Json.Object(none)
}

/// A whole answer, ready for a derived decoder.
///
/// `decode` takes a `json.Json` while a response is a `doc.Doc`, which is an
/// `Option` of one. An answer that was not there at all becomes an empty object
/// rather than an error invented here: the derived decoder then names the field
/// it wanted, which is a better sentence than anything this line could write.
fn body_of(d: doc.Doc) -> json.Json {
    return or_else(d, empty())
}

/// The array under `name`, as values a derived decoder can read.
fn list_of(d: doc.Doc, name: str) -> [json.Json] {
    return json.items(json.field(d, name))
}

/// The `{ "id": … }` every create answers with.
///
/// One reader for a dozen endpoints, because they all answer alike and the
/// only thing that differs is the sentence for when they do not.
fn made_of(answer: doc.Doc, said: str) -> (model.Created, error) {
    let (made, err) = model.Created.decode(body_of(answer))
    check errors.wrap(err, said)
    return made, nil
}

/// The four figures a counted drawer answers with — the same shape from all
/// three doors that close one.
fn counted_of(answer: doc.Doc) -> (model.DrawerCount, error) {
    let (count, err) = model.DrawerCount.decode(body_of(answer))
    check errors.wrap(err, "that drawer was closed but the count would not read")
    return count, nil
}

/// One request.
///
/// A 422 is answered as an **ordinary answer rather than an error**, because
/// the two 422s this API sends — "this needs ID" and "this product has no shelf
/// price" — are steps in a sale rather than failures of one. It stays a
/// document at this level: `send` is the transport and does not know which
/// endpoint it is carrying. Naming the two is [`answer_of`]'s job, one layer
/// up. Everything else that is not a 2xx becomes an error carrying the server's
/// own sentence.
pub async fn send(token: str, method: str, path: str, body: str) -> (doc.Doc, error) {
    let (response, err) = await http.send(method, "\(base())\(path)", body, headers_for(token, body))
    check errors.wrap(err, "the lane is offline")

    if response.status == 422 {
        let (needs, perr) = doc.parse(response.body)
        check errors.wrap(perr, "that answer was not JSON")
        return needs, nil
    }
    if !http.succeeded(response) {
        return _, refused(response.status, response.body)
    }
    // A 204 has no body and nothing to read; every other success does.
    if response.body.len() == 0 {
        // Bound rather than returned directly — see the note in `doc.parse`:
        // widening a `Json` to a `Doc` inside a fallible `return` makes the
        // wasm backend emit an invalid module.
        let none: doc.Doc = empty()
        return none, nil
    }
    let (parsed, perr) = doc.parse(response.body)
    check errors.wrap(perr, "that answer was not JSON")
    return parsed, nil
}

pub async fn get(token: str, path: str) -> (doc.Doc, error) {
    return await send(token, "GET", path, "")
}

pub async fn post(token: str, path: str, body: json.Json) -> (doc.Doc, error) {
    return await send(token, "POST", path, json.stringify(body))
}

pub async fn patch(token: str, path: str, body: json.Json) -> (doc.Doc, error) {
    return await send(token, "PATCH", path, json.stringify(body))
}

pub async fn remove(token: str, path: str) -> (doc.Doc, error) {
    return await send(token, "DELETE", path, "")
}

// ---- signing in ------------------------------------------------------------

pub async fn sign_in_with_pin(pin: str, register_id: str) -> (model.Session, error) {
    var body: { str: json.Json } = { }
    body["pin"] = json.Json.Text(pin)
    body["register_id"] = json.Json.Text(register_id)
    let (answer, err) = await post("", "/auth/pin", json.Json.Object(body))
    check err
    let token = doc.text(answer, "token", "")
    if token.len() == 0 {
        return _, errors.new("that PIN was not recognised")
    }
    return model.session_of(answer, token), nil
}

pub async fn sign_in_with_password(username: str, password: str) -> (model.Session, error) {
    var body: { str: json.Json } = { }
    body["username"] = json.Json.Text(username)
    body["password"] = json.Json.Text(password)
    let (answer, err) = await post("", "/auth/password", json.Json.Object(body))
    check err
    let token = doc.text(answer, "token", "")
    if token.len() == 0 {
        return _, errors.new("that username and password do not match")
    }
    return model.session_of(answer, token), nil
}

/// Who this token belongs to — what a reloaded page asks before drawing.
pub async fn whoami(token: str) -> (model.Session, error) {
    let (answer, err) = await get(token, "/auth/me")
    check err
    return model.session_of(answer, token), nil
}

// ---- the till --------------------------------------------------------------

/// What a basket-changing call answers: the basket, or the question that has to
/// be answered before there can be one.
///
/// Eight endpoints — `scan`, `set_qty`, `void_line`, `adjust_line`, `hold`,
/// `recall`, `void_sale` and `set_customer` — reply *either* with the whole
/// basket *or*, with a 422, with a step in the sale rather than a failure of
/// one. A struct cannot say "one of two things"; an enum can. So the branch is
/// taken on a **variant** rather than on a string pulled out of a document,
/// and a caller that forgets a case is a compile error instead of a basket
/// silently read as empty.
///
/// The two questions are `POST /till/scan`'s alone today — see the two `422`
/// branches in `api/src/routes/till.ts`. The other seven are typed as answering
/// an `Answer` anyway, because which of them may ask is the Worker's to change
/// and this file should not have to be re-shaped when it does.
///
/// The two 422 variants are `NeedsAgeCheck` and `NeedsPrice` rather than the
/// `AgeCheck`/`AskPrice` the dialogs are called, and that is not a style
/// choice. [`store.Overlay`] already owns those two names, and **a Kite pattern
/// is written unqualified**: a variant name shared by two enums in one program
/// makes every existing `AgeCheck(...)` arm ambiguous. The compiler's own
/// suggestion — qualify it, `Overlay.AgeCheck(...)` — is a trap here, because a
/// qualified pattern is not a variant test at all. It is a **wildcard**: it
/// matches every value, binds nothing, satisfies exhaustiveness on its own and
/// draws no diagnostic. In `till.kite`'s `overlay_of` that would have rendered
/// the age-check dialog over the tender screen. Distinct names cost nothing.
pub enum Answer {
    /// The ordinary answer, and the only one the other seven send today.
    Basket(basket: model.Basket)

    /// `needs: "age_check"` — an age-restricted item stopped the sale.
    ///
    /// `born_before` is a Unix timestamp the **Worker** computed from the
    /// product's `min_age`, so nobody is doing date arithmetic at the counter
    /// with a queue waiting. `min_age` and `born_on_or_before` sit at the top
    /// level of that 422 while `id` and `name` are nested under `product`,
    /// which is exactly why this is worth converting once, here.
    NeedsAgeCheck(name: str, min_age: int, born_before: int, product_id: str)

    /// `needs: "price"` — the shelf price is not in the system, so the operator
    /// is asked for it.
    ///
    /// The tag on the wire is `"price"`, not `"ask_price"` — `ask_price` is the
    /// column on the product that causes it, and the two are easy to confuse.
    /// That string is now written once, in `answer_of`, instead of at every
    /// call site that had to guess which of the two the Worker meant.
    ///
    /// `unit` is on the wire (`product: { id, name, unit }`, and the column is
    /// `TEXT NOT NULL DEFAULT 'each'`, so it always arrives) and is carried
    /// here even though today's dialog does not draw it. What the Worker sends
    /// is this type's business; a field dropped at the boundary is a field no
    /// screen can later put back without another trip through this file. A
    /// price asked for "per kg" is a different question from one asked for
    /// "each", and the answer is money.
    NeedsPrice(name: str, product_id: str, unit: str)
}

/// One 422, or one basket.
///
/// **An answer with no `needs` on it is an ordinary basket** — that is the
/// common path, every reply from the other seven endpoints and every successful
/// scan. So is an answer carrying a `needs` tag this build does not recognise:
/// that is what the till did before this enum existed and it is preserved
/// deliberately rather than by omission. It is not obviously the right answer —
/// an unknown tag converts to a basket with no lines and a zero total, which on
/// a till reads as "the sale is empty" — but changing it is a behaviour change
/// on the money path and belongs in its own commit, not in a refactor.
fn answer_of(d: doc.Doc) -> Answer {
    // Both 422s nest the product; neither of the two top-level age fields is
    // under it. Bound once because only one of the arms below can be taken.
    let product = doc.field(d, "product")
    match doc.text(d, "needs", "") {
        "age_check" => {
            return Answer.NeedsAgeCheck(
                name: doc.text(product, "name", ""),
                min_age: doc.int_of(d, "min_age", 18),
                born_before: doc.int_of(d, "born_on_or_before", 0),
                product_id: doc.text(product, "id", ""))
        },
        "price" => {
            return Answer.NeedsPrice(
                name: doc.text(product, "name", ""),
                product_id: doc.text(product, "id", ""),
                unit: doc.text(product, "unit", ""))
        },
        _ => { },
    }
    return Answer.Basket(basket: model.basket_of(d))
}

/// What is on the lane right now.
///
/// The one basket-shaped endpoint with no 422 in it — there is no item being
/// added, so there is nothing to be asked for — which is why this one answers a
/// [`model.Basket`] flat rather than an [`Answer`] the caller has to match.
pub async fn basket(token: str) -> (model.Basket, error) {
    let (answer, err) = await get(token, "/till/basket")
    check err
    return model.basket_of(answer), nil
}

/// Ring an item. **The only endpoint that sends a 422 today**, and so the only
/// one whose [`Answer`] is ever `NeedsAgeCheck` or `NeedsPrice`.
pub async fn scan(token: str, code: str, product_id: str, qty: float, age_checked: bool,
    price: int, ask_price: bool) -> (Answer, error) {
    var body: { str: json.Json } = { }
    if code.len() > 0 {
        body["code"] = json.Json.Text(code)
    }
    if product_id.len() > 0 {
        body["product_id"] = json.Json.Text(product_id)
    }
    if qty > 0.0 {
        body["qty"] = json.Json.Number(qty)
    }
    if age_checked {
        body["age_checked"] = json.Json.Bool(true)
    }
    if ask_price {
        body["price"] = json.Json.Number(price as float)
    }
    let (answer, err) = await post(token, "/till/scan", json.Json.Object(body))
    check err
    return answer_of(answer), nil
}

pub async fn set_qty(token: str, line_id: str, qty: float) -> (Answer, error) {
    var body: { str: json.Json } = { }
    body["qty"] = json.Json.Number(qty)
    let (answer, err) = await patch(token, "/till/line/\(line_id)", json.Json.Object(body))
    check err
    return answer_of(answer), nil
}

pub async fn void_line(token: str, line_id: str) -> (Answer, error) {
    let (answer, err) = await remove(token, "/till/line/\(line_id)")
    check err
    return answer_of(answer), nil
}

pub async fn adjust_line(token: str, line_id: str, kind: str, amount: int,
    manager_pin: str) -> (Answer, error) {
    var body: { str: json.Json } = { }
    body["kind"] = json.Json.Text(kind)
    if kind == "discount" {
        body["amount"] = json.Json.Number(amount as float)
    }
    if kind == "override" {
        body["price"] = json.Json.Number(amount as float)
    }
    if manager_pin.len() > 0 {
        body["manager_pin"] = json.Json.Text(manager_pin)
    }
    let (answer, err) = await post(token, "/till/line/\(line_id)/adjust", json.Json.Object(body))
    check err
    return answer_of(answer), nil
}

pub async fn hold(token: str, label: str) -> (Answer, error) {
    var body: { str: json.Json } = { }
    body["label"] = json.Json.Text(label)
    let (answer, err) = await post(token, "/till/hold", json.Json.Object(body))
    check err
    return answer_of(answer), nil
}

pub async fn held(token: str) -> ([model.Held], error) {
    let (answer, err) = await get(token, "/till/held")
    check err
    return map(doc.items(doc.field(answer, "held")), model.held_of), nil
}

pub async fn recall(token: str, id: str) -> (Answer, error) {
    let (answer, err) = await post(token, "/till/held/\(id)/recall", empty())
    check err
    return answer_of(answer), nil
}

pub async fn void_sale(token: str, reason: str, manager_pin: str) -> (Answer, error) {
    var body: { str: json.Json } = { }
    body["reason"] = json.Json.Text(reason)
    if manager_pin.len() > 0 {
        body["manager_pin"] = json.Json.Text(manager_pin)
    }
    let (answer, err) = await post(token, "/till/void", json.Json.Object(body))
    check err
    return answer_of(answer), nil
}

/// Finish the sale.
///
/// `client_id` is an idempotency key the server dedupes on, and it is generated
/// once per attempt rather than per retry — which is the whole point: a lane
/// that loses the answer and asks again lands on the same sale instead of
/// ringing a second one.
pub async fn pay(token: str, payments: [model.Payment], client_id: str) -> (model.Paid, error) {
    var body: { str: json.Json } = { }
    body["client_id"] = json.Json.Text(client_id)
    var list: [json.Json] = []
    for p in payments {
        var entry: { str: json.Json } = { }
        entry["method"] = json.Json.Text(model.tender_code(p.tender))
        entry["amount"] = json.Json.Number(p.amount as float)
        entry["tendered"] = json.Json.Number(p.amount as float)
        if p.reference.len() > 0 {
            entry["reference"] = json.Json.Text(p.reference)
        }
        list.push(json.Json.Object(entry))
    }
    body["payments"] = json.Json.Array(list)
    let (answer, err) = await post(token, "/till/pay", json.Json.Object(body))
    check err
    return model.paid_of(answer), nil
}

/// Everything the till holds: the products, and the headings they file under.
///
/// Two lists in one answer because they come from one request, and a tuple
/// rather than a struct because there is no third thing worth naming — the
/// `promotions` the same response carries are applied by the server when a line
/// is priced and are never read at this end.
///
/// The categories **decode** where the products convert, which is the one place
/// in this file the difference shows: a category the server sends malformed is
/// an error here rather than a blank heading on the grid. See [`model.Category`]
/// for why that one is safe to be strict about and [`model.Product`] is not.
pub async fn grid(token: str) -> (([model.Product], [model.Category]), error) {
    let (answer, err) = await get(token, "/till/grid")
    check err
    var categories: [model.Category] = []
    for item in json.items(json.field(answer, "categories")) {
        let (one, derr) = model.Category.decode(item)
        check errors.wrap(derr, "the catalogue has a heading we could not read")
        categories.push(one)
    }
    let products = map(doc.items(doc.field(answer, "products")), model.product_of)
    return (products, categories), nil
}

pub async fn search(token: str, q: str) -> ([model.Product], error) {
    let (answer, err) = await get(token, "/till/search?q=\(window.escaped(q))")
    check err
    return map(doc.items(doc.field(answer, "products")), model.product_of), nil
}

pub async fn price_check(token: str, code: str) -> (model.PriceCheck, error) {
    let (answer, err) = await get(token, "/till/price/\(window.escaped(code))")
    check err
    return model.price_check_of(answer), nil
}

// ---- the rest of the till's command bar ------------------------------------

pub async fn customers_at_till(token: str, q: str) -> ([model.Customer], error) {
    let (answer, err) = await get(token, "/till/customers?q=\(window.escaped(q))")
    check err
    var out: [model.Customer] = []
    for item in json.items(json.field(answer, "customers")) {
        let (one, derr) = model.Customer.decode(item)
        check errors.wrap(derr, "that customer list has a row we could not read")
        out.push(one)
    }
    return out, nil
}

pub async fn set_customer(token: str, customer_id: str) -> (Answer, error) {
    var body: { str: json.Json } = { }
    body["customer_id"] = json.Json.Text(customer_id)
    let (answer, err) = await post(token, "/till/customer", json.Json.Object(body))
    check err
    return answer_of(answer), nil
}

pub async fn new_customer(token: str, name: str, phone: str) -> (model.Created, error) {
    var body: { str: json.Json } = { }
    body["name"] = json.Json.Text(name)
    body["phone"] = json.Json.Text(phone)
    let (answer, err) = await post(token, "/till/customers", json.Json.Object(body))
    check err
    return made_of(answer, "that customer was added but came back without an id")
}

pub async fn receipts(token: str, q: str) -> ([model.Receipt], error) {
    let (answer, err) = await get(token, "/till/receipts?q=\(window.escaped(q))")
    check err
    return map(doc.items(doc.field(answer, "receipts")), model.receipt_of), nil
}

pub async fn receipt(token: str, id: str) -> (model.ReceiptDetail, error) {
    let (answer, err) = await get(token, "/till/receipts/\(id)")
    check err
    return model.receipt_detail_of(answer), nil
}

pub async fn take_return(token: str, sale_id: str, lines: [model.ReturnLine],
    reason: str, manager_pin: str) -> (doc.Doc, error) {
    var body: { str: json.Json } = { }
    body["sale_id"] = json.Json.Text(sale_id)
    body["reason"] = json.Json.Text(reason)
    if manager_pin.len() > 0 {
        body["manager_pin"] = json.Json.Text(manager_pin)
    }
    var list: [json.Json] = []
    for l in lines {
        if l.taking > 0.0 {
            var entry: { str: json.Json } = { }
            entry["sale_item_id"] = json.Json.Text(l.id)
            entry["qty"] = json.Json.Number(l.taking)
            list.push(json.Json.Object(entry))
        }
    }
    body["lines"] = json.Json.Array(list)
    return await post(token, "/till/return", json.Json.Object(body))
}

pub async fn no_sale(token: str, reason: str, manager_pin: str) -> (doc.Doc, error) {
    var body: { str: json.Json } = { }
    body["reason"] = json.Json.Text(reason)
    if manager_pin.len() > 0 {
        body["manager_pin"] = json.Json.Text(manager_pin)
    }
    return await post(token, "/till/no-sale", json.Json.Object(body))
}

pub async fn close_lane(token: str, counted: int, manager_pin: str) -> (model.DrawerCount, error) {
    var body: { str: json.Json } = { }
    body["counted_total"] = json.Json.Number(counted as float)
    if manager_pin.len() > 0 {
        body["manager_pin"] = json.Json.Text(manager_pin)
    }
    let (answer, err) = await post(token, "/till/close-lane", json.Json.Object(body))
    check err
    return counted_of(answer)
}

pub async fn sign_out(token: str) -> (doc.Doc, error) {
    return await post(token, "/auth/sign-out", empty())
}

// ---- the back office -------------------------------------------------------

pub async fn overview(token: str) -> (model.Overview, error) {
    let (answer, err) = await get(token, "/reports/overview")
    check err
    return model.overview_of(answer)
}

/// Every lane, and what its drawer is doing.
///
/// The `stale_after` the same answer carries is the number of seconds after
/// which the Worker calls a lane offline. It is not returned: the `state` it
/// decides is already on every lane, and nothing at this end recomputes it.
pub async fn lanes(token: str) -> ([model.Lane], error) {
    let (answer, err) = await get(token, "/tills")
    check err
