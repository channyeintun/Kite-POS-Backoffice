/// Every offer, and the moment the server judged them at.
///
/// `now` comes back with the list because whether an offer is *running* is a
/// comparison against the clock, and the clock that matters is the one pricing
/// a line. A back office in another time zone — or on a laptop whose clock has
/// drifted — must not draw an offer as live that the till will not apply.
pub async fn promotions(token: str) -> (([model.Promotion], int), error) {
    let (answer, err) = await get(token, "/promotions")
    check err
    let offers = map(doc.items(doc.field(answer, "promotions")), model.promotion_of)
    // This lane's own clock only if the server sent none — which it always
    // does. A zero here would read as 1970 and draw every scheduled offer as
    // not yet started.
    return (offers, doc.int_of(answer, "now", browser.now())), nil
}

pub async fn promotion_performance(token: str, from: int) -> ([model.PromotionResult], error) {
    let (answer, err) = await get(token, "/promotions/performance?from=\(from)")
    check err
    var out: [model.PromotionResult] = []
    for item in list_of(answer, "performance") {
        let (one, derr) = model.PromotionResult.decode(item)
        check errors.wrap(derr, "an offer's figures would not read")
        out.push(one)
    }
    return out, nil
}

