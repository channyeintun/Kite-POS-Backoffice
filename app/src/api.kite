    return await post(token, "/catalog/suppliers", body)
}

pub async fn set_quick_keys(token: str, ids: [str]) -> (doc.Doc, error) {
    var body: { str: json.Json } = { }
    var list: [json.Json] = []
    for id in ids {
        list.push(json.Json.Text(id))
    }
    body["product_ids"] = json.Json.Array(list)
    return await post(token, "/catalog/quick-keys", json.Json.Object(body))
}

