    let (answer, err) = await get(token, "/accounting/accounts")
    check err
    var out: [model.Account] = []
    for item in list_of(answer, "accounts") {
        let (one, derr) = model.Account.decode(item)
        check errors.wrap(derr, "the chart has an account we could not read")
        out.push(one)
    }
    return out, nil
}

/// The accounts a running cost may be booked to.
///
/// Two fields, not four: this endpoint selects only the code and the name, so
/// it cannot be read as an [`model.Account`], which wants a `kind` that is not
/// on the wire here.
pub async fn expense_accounts(token: str) -> ([model.AccountOption], error) {
    let (answer, err) = await get(token, "/accounting/expense-accounts")
    check err
    var out: [model.AccountOption] = []
    for item in list_of(answer, "accounts") {
        let (one, derr) = model.AccountOption.decode(item)
        check errors.wrap(derr, "the expense accounts have a row we could not read")
        out.push(one)
    }
    return out, nil
}

