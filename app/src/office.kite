async fn load_purchasing(app: desk.App) {
    let token = desk.token_of(app)
    let (sheet, err) = await api.worksheet(token, 28)
    if err != nil {
        failed(app, err.message())
        return
    }
    var os: [model.PurchaseOrder] = []
    let (orders, oerr) = await api.purchase_orders(token)
    if oerr == nil {
        os = orders
    }
    var ps: Option<model.Payables> = nil
    let (payables, perr) = await api.payables(token)
    if perr == nil {
        ps = payables
        desk.took_invoices(app, payables.invoices)
    }
    desk.took_purchasing(app, sheet, os, ps)
    done(app, screens.purchasing(sheet, os, ps, app.goods_in, desk.goods_in_total(app),
            desk.lang_of(app), desk.currency_of(app)))
}

async fn load_order(app: desk.App, id: str) {
    let (answer, err) = await api.order(desk.token_of(app), id)
    if err != nil {
        failed(app, err.message())
        return
    }
    desk.took_order(app, answer.order, answer.lines)
    done(app, screens.order_detail(answer, desk.lang_of(app), desk.currency_of(app)))
}

async fn load_customers(app: desk.App) {
    let token = desk.token_of(app)
    let (answer, err) = await api.customers(token)
    if err != nil {
        failed(app, err.message())
        return
    }
    // Kept for the two dialogs that need a row rather than an id — the edit
    // form, and the picker that takes money off a tab.
    desk.took_customers(app, answer)

    // What is owed is fetched beside the list and is allowed to fail on its
    // own: a shopkeeper who cannot see the aging table can still edit a
    // customer, and `screens.customers` skips the table rather than drawing it
    // with zeros in it.
    var debts: Option<model.Receivables> = nil
    let (owed, oerr) = await api.receivables(token)
    if oerr == nil {
        debts = owed
    }

    // The rail carries what is late, not what is outstanding. A tab a week old
    // is the shop working normally; one over sixty days is the thing a manager
    // opened the back office to deal with.
    if debts != nil {
        // **The badge counts the people it is about.** It was the count of
        // everybody on a tab while being shown only when something was late,
        // so a shop with nine ordinary tabs and one old one put "10" on the
        // rail — a number that matched nothing on the screen it opened.
        var late = 0
        for a in debts.aging.rows {
            if a.d90 + a.d90up > 0 {
                late = late + 1
            }
        }
        if late > 0 {
            desk.badge(app, "customers", "\(late)")
        } else {
            desk.unbadge(app, "customers")
        }
    }

    done(app, screens.customers(answer, debts, desk.lang_of(app), desk.currency_of(app)))
}

async fn load_promotions(app: desk.App) {
    let token = desk.token_of(app)
    let (answer, err) = await api.promotions(token)
    if err != nil {
        failed(app, err.message())
        return
    }
    var p: [model.PromotionResult] = []
    let (perf, perr) = await api.promotion_performance(token, browser.now() - 30 * DAY)
    if perr == nil {
        p = perf
    }
    // `.0` is the offers and `.1` the moment the server judged them at — see
    // `api.promotions`, which is where the pair is named.
    done(app, screens.promotions(answer.0, answer.1, p, desk.lang_of(app),
            desk.currency_of(app)))
}

async fn load_reports(app: desk.App) {
    let token = desk.token_of(app)
    // Zero is "up to now", resolved by the Worker — the same rule
    // `desk.window_seconds` states for the books.
    let to = 0
    let from = browser.now() - 30 * DAY
    let (products, err) = await api.product_report(token, from, to)
    if err != nil {
        failed(app, err.message())
        return
    }
    var d: Option<model.SalesReport> = nil
    let (daily, derr) = await api.sales_report(token, from, to)
    if derr == nil {
        d = daily
    }
    var s: Option<model.ShrinkageReport> = nil
    let (shrink, serr) = await api.shrinkage(token, from, to)
    if serr == nil {
        s = shrink
    }
    var tax: Option<model.TaxReport> = nil
    let (rates, terr) = await api.tax_report(token, from, to)
    if terr == nil {
        tax = rates
    }
    var dead: Option<model.DeadStockReport> = nil
    let (idle, ierr) = await api.dead_stock(token, 60)
    if ierr == nil {
        dead = idle
    }
    done(app, screens.reports(products, d, s, tax, dead, desk.lang_of(app),
            desk.currency_of(app)))
}

/// Fetch only what the open sheet needs.
///
/// Eight sheets, and loading all of them on every switch would be eight round
/// trips to look at one. The summary is the exception: it is a page *about*
/// the whole of the books, so it reads several and each of those is allowed to
/// fail on its own — a health sweep that times out should not take the
/// revenue figure down with it.
async fn load_accounting(app: desk.App) {
    let token = desk.token_of(app)
    let (summary, serr) = await api.accounting_summary(token)
    if serr != nil {
        failed(app, serr.message())
        return
    }
    if !summary.enabled {
        done(app, screens.accounting_off(desk.lang_of(app)))
        return
    }

    let view = app.books_view
    let span = desk.window_seconds(app.books_window, browser.now())
    let from = span[0]
    let to = span[1]

    // A bundle the sheets each read their own corner of — see [`screens.Books`].
    // Anything that failed is left `nil`, which is what every reader below
    // treats as "not loaded"; the fields are filled through `desk`-style
    // setters because a closure may not capture a `var` and a struct literal
    // cannot be built a field at a time.
    var data = screens.books_of(summary)

    if view == "summary" || view == "pl" {
        let (pl, perr) = await api.profit_and_loss(token, from, to)
        if perr != nil {
            failed(app, perr.message())
            return
        }
        data = screens.Books{..data, pl: pl }
    }
    if view == "summary" || view == "balance" {
        let (sheet, berr) = await api.balance_sheet(token, to)
        // Reported rather than swallowed. The screen draws nothing for a sheet
        // it does not have — which is right, an invented clean bill of health
        // is worse — but on the Balance tab that left the manager looking at
        // an empty page with no way to tell a failed request from an empty
        // ledger. The other four books views already failed here; this one
        // was the odd one out.
        if berr != nil {
            failed(app, berr.message())
            return
        }
        data = screens.Books{..data, sheet: sheet }
    }
    if view == "summary" {
        let (health, herr) = await api.books_health(token)
        if herr == nil {
            data = screens.Books{..data, health: health }
        }
        let (owing, oerr) = await api.payables(token)
        if oerr == nil {
            data = screens.Books{..data, payables: owing }
        }
    }
    if view == "trial" {
        let (trial, terr) = await api.trial_balance(token, from, to)
        if terr != nil {
            failed(app, terr.message())
            return
        }
        data = screens.Books{..data, trial: trial }
    }
    if view == "journal" {
        let (journal, jerr) = await api.journal_filtered(token, from, to,
            app.journal_cause, app.journal_account, app.journal_query)
        if jerr != nil {
            failed(app, jerr.message())
            return
        }
        data = screens.Books{..data, journal: journal }
    }
    if view == "accounts" {
        let (accounts, aerr) = await api.accounts(token)
        if aerr != nil {
            failed(app, aerr.message())
            return
        }
        data = screens.Books{..data, accounts: accounts }
    }
    if view == "ledger" && app.books_account.len() > 0 {
        let (ledger, lerr) = await api.general_ledger(token, app.books_account, from, to)
        if lerr != nil {
            failed(app, lerr.message())
            return
        }
        data = screens.Books{..data, ledger: ledger }
    }

    done(app, screens.accounting(view, app.books_window, data,
            app.books_account, desk.lang_of(app), desk.currency_of(app)))
}

/// Save the open sheet as a file.
///
/// The window and the account travel with it, so the file matches what is on
/// screen rather than some default the shopkeeper did not choose. Not every
/// sheet is exportable — Periods is a list of four dates — so the ones that
/// are not fall back to the trial balance's window rather than producing an
/// empty file under a misleading name.
async fn do_export_books(app: desk.App, view: str) {
    let token = desk.token_of(app)
    let span = desk.window_seconds(app.books_window, browser.now())
    var sheet = view
    if view == "summary" || view == "periods" {
        sheet = "trial"
    }
    var query = "?view=\(sheet)&from=\(span[0])&to=\(span[1])"
    if sheet == "ledger" {
        query = "\(query)&account_code=\(app.books_account)"
    }
    let (body, err) = await api.fetch_text(token, "/accounting/export\(query)")
    if err != nil {
        failed(app, err.message())
        return
    }
    let name = "\(sheet)-\(browser.iso_day(span[0])).csv"
    browser.download(name, body, "text/csv;charset=utf-8")
    desk.say(app, words.fill(desk.lang_of(app), "toast.saved_n", name))
    repaint(app)
}

