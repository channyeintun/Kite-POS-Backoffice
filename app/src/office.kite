// ---- opening a form --------------------------------------------------------

// A row from a list, by id — what an edit form is filled from. One per list
// rather than one over documents: two types with an `id` and a `name` do not
// make one type, and `find` from the prelude already answers the question.

fn category_by(list: [model.CatalogCategory], id: str) -> Option<model.CatalogCategory> {
    return find(list, |cat: model.CatalogCategory| cat.id == id)
}

fn supplier_by(list: [model.Supplier], id: str) -> Option<model.Supplier> {
    return find(list, |s: model.Supplier| s.id == id)
}

fn customer_by(list: [model.CustomerAccount], id: str) -> Option<model.CustomerAccount> {
    return find(list, |cu: model.CustomerAccount| cu.id == id)
}

/// A product's name, for a line of a delivery held on this device.
///
/// Carried on the line rather than looked up when the table is drawn, because
/// the line outlives one screen's reference list — and a delivery whose rows
/// read as blank while the catalogue reloads is one a shopkeeper cannot check
/// against the note in their hand.
fn product_name_by(list: [model.CatalogProduct], id: str) -> str {
    let hit = find(list, |p: model.CatalogProduct| p.id == id)
    if hit == nil {
        return id
    }
    return hit.name
}

fn supplier_ids(list: [model.Supplier]) -> [str] {
    var out: [str] = []
    for s in list {
        out.push(s.id)
    }
    return out
}

fn supplier_names(list: [model.Supplier]) -> [str] {
    var out: [str] = []
    for s in list {
        out.push(s.name)
    }
    return out
}

fn register_ids(list: [model.Lane]) -> [str] {
    var out: [str] = []
    for lane in list {
        out.push(lane.id)
    }
    return out
}

fn register_names(list: [model.Lane]) -> [str] {
    var out: [str] = []
    for lane in list {
        out.push(lane.name)
    }
    return out
}

/// What the open drill-down is about, for the forms opened from it.
///
/// Each answers the empty value when there is no subject, which is what reading
/// a field off an absent document used to do.
fn subject_product_name(app: desk.App) -> str {
    let p = app.subject_product
    if p == nil {
        return ""
    }
    return p.name
}

fn subject_product_stock(app: desk.App) -> float {
    let p = app.subject_product
    if p == nil {
        return 0.0
    }
    return p.stock
}

fn subject_order_supplier(app: desk.App) -> str {
    let o = app.subject_order
    if o == nil {
        return ""
    }
    return o.supplier_id
}

fn subject_order_number(app: desk.App) -> int {
    let o = app.subject_order
    if o == nil {
        return 0
    }
    return o.number
}

fn subject_order_total(app: desk.App) -> int {
    let o = app.subject_order
    if o == nil {
        return 0
    }
    return o.total
}

fn open_form(app: desk.App, what: str, id: str) {
    let c = desk.currency_of(app)
    let l = desk.lang_of(app)

    // **Statement position, and no arm returns.** Every branch — including the
    // default — falls out to the `repaint` below, which is what actually puts
    // the dialog on screen. An arm that returned would set the form state and
    // draw nothing, and the press would look like it did nothing at all.
    match what {
        "form-product" => {
            var existing: Option<model.CatalogProduct> = nil
            if id.len() > 0 {
                existing = app.subject_product
            }
            desk.open_form(app, forms.product(existing, id, app.ref_categories,
                    app.ref_suppliers, l, c))
        },
        "form-barcode" => desk.open_form(app, forms.barcode(id, subject_product_name(app), l)),
        "form-category" => desk.open_form(app,
            forms.category(category_by(app.ref_categories, id), id, l)),
        "form-supplier" => desk.open_form(app,
            forms.supplier(supplier_by(app.ref_suppliers, id), id, l)),
        "form-promotion" => desk.open_form(app, forms.promotion(nil, id,
                app.ref_products, app.ref_categories, l, c)),
        // The row, not `nil`. Opening this blank wrote the blanks back on Save,
        // which was survivable for a name and a phone number and is not for a
        // credit limit — see `forms.customer`.
        "form-customer" => desk.open_form(app,
            forms.customer(customer_by(app.ref_customers, id), id, l, c)),
        // The key is minted here, where the dialog opens, and rides on the
        // form's subject — so Save pressed twice after a lost answer sends the
        // one the server already has. See `forms.settle_tab`.
        "form-settle-tab" => desk.open_form(app,
            forms.settle_tab(l, app.ref_customers, crypto.token(), c)),
        "form-staff" => desk.open_form(app, forms.staff(l)),
        "form-expense" => desk.open_form(app, forms.expense(app.ref_expense_accounts, l, c)),
        "form-settings" => desk.open_form(app, forms.settings(app.ref_settings, l)),
        "form-close-period" => desk.open_form(app, forms.close_period(l)),
        "form-register" => desk.open_form(app, forms.register(l)),
        "form-adjust" => desk.open_form(app, forms.adjust(id, subject_product_name(app),
                subject_product_stock(app), l)),
        "form-open-shift" => desk.open_form(app,
            forms.open_shift(register_ids(app.ref_registers),
                register_names(app.ref_registers), l, c)),
        "form-invoice" => desk.open_form(app, forms.invoice(supplier_ids(app.ref_suppliers),
                supplier_names(app.ref_suppliers), id, subject_order_supplier(app),
                subject_order_total(app), crypto.token(), l, c)),
        "form-goods-in-line" => desk.open_form(app, forms.goods_in_line(app.ref_products, l, c)),
        // The key rides on the form's subject, the way `form-settle-tab` does —
        // but it was minted when the first line was added, not here, because
        // what is being repeated is the delivery rather than the press.
        "form-goods-in-book" => desk.open_form(app,
            forms.goods_in_book(app.ref_suppliers, app.goods_in_key, app.goods_in_supplier,
                app.goods_in_settlement, desk.goods_in_total(app), l, c)),
        "form-delete-order" => desk.open_form(app,
            forms.delete_order(id, subject_order_number(app), l)),
        "form-cancel-order" => desk.open_form(app,
            forms.cancel_order(id, subject_order_number(app), l)),
        // A developer's message, not a shopkeeper's: it only appears when a
        // button names a form nobody wrote, which is a bug rather than a state.
        _ => desk.went_wrong(app, "\(what) is not wired up"),
    }
    repaint(app)
}

/// Forms that need a read before they can be filled.
async fn open_close_shift(app: desk.App, id: str) {
    let (answer, err) = await api.shift(desk.token_of(app), id)
    if err != nil {
        failed(app, err.message())
        return
    }
    desk.open_form(app, forms.close_shift(id, answer.shift.register_name,
            answer.drawer.expected, desk.lang_of(app), desk.currency_of(app)))
    repaint(app)
}

async fn open_pay_invoice(app: desk.App, id: str) {
    let (answer, err) = await api.payables(desk.token_of(app))
    if err != nil {
        failed(app, err.message())
        return
    }
    for i in answer.invoices {
        if i.id == id {
            desk.open_form(app, forms.pay_invoice(id, i.supplier_name,
                    i.outstanding, crypto.token(), desk.lang_of(app),
                    desk.currency_of(app)))
            repaint(app)
            return
        }
    }
    failed(app, words.t(desk.lang_of(app), "payables.that_invoice_is_not_open_any_more"))
}

async fn open_refund(app: desk.App, id: str) {
    let (answer, err) = await api.sale(desk.token_of(app), id)
    if err != nil {
        failed(app, err.message())
        return
    }
    desk.open_form(app, forms.refund(id, answer.sale.number, answer.lines,
            desk.lang_of(app), desk.currency_of(app)))
    repaint(app)
}

fn open_receive(app: desk.App, item_id: str) {
    for line in app.subject_order_lines {
        if line.id == item_id {
            let left = line.qty - line.qty_received
            desk.open_form(app, forms.receive(item_id, line.product_name,
                    left, line.unit_cost, desk.lang_of(app), desk.currency_of(app)))
            repaint(app)
            return
        }
    }
}

async fn open_staff_menu(app: desk.App, id: str) {
    let (answer, err) = await api.staff(desk.token_of(app))
    if err != nil {
        failed(app, err.message())
        return
    }
    // `.0` is the people and `.1` the command table — see `api.staff`.
    for u in answer.0 {
        if u.id == id {
            if u.signs_in_with == "pin" {
                desk.open_form(app, forms.staff_pin(id, u.name, desk.lang_of(app)))
            } else {
                desk.open_form(app, forms.staff_password(id, u.name, desk.lang_of(app)))
            }
            repaint(app)
            return
        }
    }
}

// ---- reading a form back ---------------------------------------------------

/// A field, by the name the form declared.
///
/// Matched on the `data-field` attribute rather than on an id, because a
/// settings key contains a dot: `#f-shop.name` parses as "the element with id
/// `f-shop` and class `name`" and matches nothing at all. Every settings field
/// read empty, so Settings could be opened, filled in and saved — and saved
/// every value as "". An attribute selector has no such syntax to trip over.
fn field_of(name: str) -> Option<dom.Element> {
    return dom.find("[data-field=\"\(name)\"]")
}

fn value_of(name: str) -> str {
    let field = field_of(name)
    if field == nil {
        return ""
    }
    return dom.value(field).trim()
}

fn checked(name: str) -> bool {
    let field = field_of(name)
    if field == nil {
        return false
    }
    return dom.checked(field)
}

/// An amount, after `first_unreadable` has already refused the form if any
/// money field could not be read. The zero here is unreachable, and is a zero
/// rather than a panic because a till has nobody to show a panic to.
fn money_of(app: desk.App, name: str) -> int {
    return or_else(money.from_text(value_of(name), desk.currency_of(app)), 0)
}

fn whole_of(name: str) -> int {
    return or_else(parse_int(value_of(name)), 0)
}

fn qty_of(name: str) -> float {
    return or_else(parse_float(value_of(name)), 0.0)
}

/// A field written only when the operator filled it in.
///
/// Returns the map rather than mutating one through a parameter: a `var`
/// parameter is a copy here — a map handed to a function and written to inside
/// it leaves the caller's map alone — so the only way to add a key from a
/// helper is to give the map back.
fn text_if(body: { str: json.Json }, key: str, value: str) -> { str: json.Json } {
    if value.len() == 0 {
        return body
    }
    var out = body
    out[key] = json.Json.Text(value)
    return out
}

// ---- what a press means ----------------------------------------------------

/// A press that writes. **It happens once, however many times it is tapped.**
///
/// Forms have had this guard since they were built — `submit` refuses while
/// `form.busy` — but a plain press had nothing at all, and the plainest press
/// in the back office is the one that writes a purchase order per supplier.
/// On a slow line nothing on screen changed, so the shopkeeper tapped again;
/// four taps across three suppliers wrote twelve draft orders, and until now
/// there was no door out of any of them.
///
/// The flag is the one the screen loads behind, so it clears itself: `desk.took`
/// and `desk.went_wrong` both put it down, and `done`/`failed` route through
/// them. Written and painted *before* the async call, because calling an
/// `async fn` in Kite only queues it — a guard inside the body has not run yet
/// when the next tap arrives.
///
/// Deliberately not applied to `pressed` as a whole: `load` raises the same
/// flag on every screen change, so a blanket test would make the rail dead
/// while a list was settling. Navigation is not a write.
/// Draw Purchasing again from what is already in hand.
///
/// Not `load`. Adding or removing a line of a delivery changes nothing on the
/// server, and re-asking for the worksheet, the orders and the payables to show
/// one more row would make the shop wait — three requests per line of a
/// delivery note, on the connection this shop actually has, which is the
/// pattern that had a shopkeeper tapping buttons twice in the first place.
/// `load_purchasing` keeps its answers on the app for exactly this.
fn redraw_purchasing(app: desk.App) {
    done(app, screens.purchasing(app.purchasing_sheet, app.purchasing_orders,
            app.purchasing_payables, app.goods_in, desk.goods_in_total(app),
            desk.lang_of(app), desk.currency_of(app)))
}

fn writing(app: desk.App) -> bool {
    if app.busy {
        return false
    }
    desk.working(app, true)
    repaint(app)
    return true
}

fn pressed(app: desk.App, what: str, id: str) {
    if what == "sign-in" {
        submit_sign_in(app)
        return
    }
    if what == "sign-out" {
        sign_off(app)
        return
    }
    if what == "lang" {
        desk.set_lang(app, i18n.of_code(id))
        browser.keep("kite-office.lang", id)
        repaint(app)
        // And ask for the screen again. A `desk.Block` carries its own words —
        // a table's headings were said in whichever language was on when the
        // screen was built — so a repaint alone changed the rail and the page
        // title and left the body in the old language. An open dialog is
        // deliberately not rebuilt: its labels go stale, but rebuilding it
        // would throw away whatever has been typed into it.
        load(app)
        return
    }
    if what == "rail" {
        desk.toggle_rail(app)
        repaint(app)
        return
    }
    if what == "go" {
        if id == "categories" {
            desk.go(app, desk.Screen.Products)
            desk.working(app, true)
            repaint(app)
            load_categories(app)
            return
        }
        browser.set_hash("#/\(id)")
        return
    }
    if what == "open-product" {
        browser.set_hash("#/products/\(id)")
        return
    }
    if what == "open-sale" {
        browser.set_hash("#/sales/\(id)")
        return
    }
    if what == "open-shift-detail" {
        browser.set_hash("#/shifts/\(id)")
        return
    }
    if what == "open-order" {
        browser.set_hash("#/purchasing/\(id)")
        return
    }
    if what == "print" {
        browser.print_page()
        return
    }
    if what == "form-cancel" {
        desk.close_form(app)
        repaint(app)
        return
    }
    if what == "form-submit" {
        submit(app)
        return
    }
    // ---- the books --------------------------------------------------------
    //
    // Switching sheet or window re-reads only what the new sheet needs, which
    // is why each of these ends in `load` rather than a repaint: the window is
    // what the request is built from, so changing it without re-asking would
    // show last window's figures under this window's label.
    if what == "books-view" {
        desk.show_books(app, id)
        load(app)
        return
    }
    if what == "books-window" {
        desk.set_books_window(app, id)
        load(app)
        return
    }
    if what == "books-account" {
        desk.open_account(app, id)
        load(app)
        return
    }
    if what == "books-export" {
        do_export_books(app, id)
        return
    }
    if what == "books-reverse" {
        desk.open_form(app, forms.reverse_entry(id, desk.lang_of(app)))
        repaint(app)
        return
    }
    if what == "form-remove-category" {
        desk.open_form(app, forms.remove_category(desk.lang_of(app), app.ref_categories))
        repaint(app)
        return
    }
    if what == "form-cancel-invoice" {
        desk.open_form(app, forms.cancel_invoice(desk.lang_of(app), app.ref_invoices,
                desk.currency_of(app)))
        repaint(app)
        return
    }
    if what == "photo-remove" {
        if writing(app) {
            do_remove_photo(app)
        }
        return
    }
    if what == "books-filter" {
        desk.open_form(app, forms.journal_filter(desk.lang_of(app), app.journal_cause,
                app.journal_account, app.journal_query, app.ref_accounts))
        repaint(app)
        return
    }
    if what == "books-opening" {
        desk.open_form(app, forms.opening_balances(desk.lang_of(app), desk.currency_of(app)))
        repaint(app)
        return
    }
    if what == "books-reopen" {
        if writing(app) {
            do_reopen_period(app, id)
        }
        return
    }
    if what == "form-close-shift" {
        open_close_shift(app, id)
        return
    }
    if what == "form-pay-invoice" {
        open_pay_invoice(app, id)
        return
    }
    if what == "form-refund" {
        open_refund(app, id)
        return
    }
    if what == "form-receive" {
        open_receive(app, id)
        return
    }
    if what == "form-movement" {
        desk.open_form(app, forms.movement(id, desk.lang_of(app), desk.currency_of(app)))
        repaint(app)
        return
    }
    if what == "staff-menu" {
        open_staff_menu(app, id)
        return
    }
    if what == "retire-product" {
        if writing(app) {
            do_retire_product(app, id)
        }
        return
    }
    if what == "drop-barcode" {
        if writing(app) {
            do_drop_barcode(app, id)
        }
        return
    }
    if what == "send-order" {
        if writing(app) {
            do_send_order(app, id)
        }
        return
    }
    if what == "receive-all" {
        if writing(app) {
            do_receive_all(app, id)
        }
        return
    }
    if what == "raise-orders" {
        if writing(app) {
            do_raise_orders(app)
        }
        return
    }
    // Taking a line back off the delivery, and abandoning the whole of it.
    // Neither writes anything, so neither needs the in-flight guard — and
    // neither may be refused while a screen is loading, because the lines are
    // held here and a shopkeeper correcting a mistyped quantity should not have
    // to wait for a worksheet.
    if what == "goods-in-drop" {
        desk.goods_in_drop(app, id)
        redraw_purchasing(app)
        return
    }
    if what == "goods-in-clear" {
        desk.goods_in_clear(app)
        redraw_purchasing(app)
        return
    }
    if what == "close-lane" {
        open_close_lane(app, id)
        return
    }
    if what == "authorise" {
        desk.went_wrong(app, words.t(desk.lang_of(app), "tills.authorise_at_the_lane_itself"))
        repaint(app)
        return
    }
    if what == "shift-detail" {
        browser.set_hash("#/shifts")
        return
    }
    if starts_with(what, "form-") {
        open_form(app, what, id)
        return
    }
}

// ---- submitting ------------------------------------------------------------

fn submit(app: desk.App) {
    let open = app.form
    if open == nil {
        return
    }
    if open.busy {
        return
    }
    let missing = first_unanswered(open)
    if missing.len() > 0 {
        desk.form_refused(app,
            words.fill(desk.lang_of(app), "error.answer_first", missing))
        repaint(app)
        return
    }
    let bad = first_unreadable(app, open)
    if bad.len() > 0 {
        desk.form_refused(app,
            words.fill(desk.lang_of(app), "error.not_a_number", bad))
        repaint(app)
        return
    }
    desk.form_working(app)
    repaint(app)
    do_submit(app, open.id, open.subject, open.key)
}

/// The label of the first amount or quantity the parser refuses, or "".
///
/// **The refusal has to stop the submission**, and it did not. `money.from_text`
/// is written to return nothing rather than guess — "anything that is not an
/// amount is refused rather than read as zero — so a slip in a form cannot
/// quietly become a free item" — and then every call site wrote
/// `or_else(…, 0)` and turned the refusal back into a zero.
///
/// What that cost: a manager retyping a shelf price as "1,200.00" out of habit
/// in a currency with no decimals sent `price: 0`, the server took it, and the
/// till gave that product away on every scan. The same keystroke on a supplier
/// invoice sent `total: 0`, which posts nothing at all — `post` drops zero
/// lines — so the payable to that supplier simply did not exist. On a drawer
/// count it sent `counted_total: 0`, booking the whole session's takings as a
/// loss and skipping the sweep, so the drawer never returned to zero.
///
/// Checked here, once, against the fields the form declared, rather than at
/// nine call sites that each have to remember.
fn first_unreadable(app: desk.App, open: desk.Form) -> str {
    let c = desk.currency_of(app)
    for f in open.fields {
        if f.kind == desk.FieldKind.Money {
            if money.from_text(value_of(f.name), c) == nil {
                return f.label
            }
        }
        if f.kind == desk.FieldKind.Quantity {
            if parse_float(value_of(f.name)) == nil {
                return f.label
            }
        }
    }
    return ""
}

/// The first required field nobody answered, or "".
///
/// **`desk.required` used to be decoration.** It put a `*` on the label and
/// validated nothing, so a form could be sent with its required fields empty
/// and the server was the only thing that noticed. For a text field that is
/// survivable — the refusal comes back and says which field. For a **picker**
/// it is not, because a picker with nothing to offer falls back to a single
/// option whose value is the empty string, and sending that builds a URL with
/// a hole in it: `/purchasing/invoices//cancel` matches no route at all, so
/// the shopkeeper is told "no such endpoint" for what is really "there are no
/// invoices to cancel".
///
/// Three pickers are built that way — cancel an invoice, remove a category,
/// take money off a tab — and each one would have needed its own guard in
/// `do_submit`. This is the guard they share, and the one every picker written
/// after this gets for free.
fn first_unanswered(open: desk.Form) -> str {
    for f in open.fields {
        if f.required && value_of(f.name).trim().len() == 0 {
            return f.label
        }
    }
    return ""
}

/// Everything that writes, in one place.
///
/// A long function on purpose: the alternative is twenty small ones that each
/// have to be found before a field can be traced from the form that asked for
/// it to the call that sends it. Every arm reads its own fields by name and
/// ends in one API call.
///
/// `body` is a plain map that each arm fills and wraps once, at the call. It
/// cannot be a document handed round and written into: `Json.Object(m)` copies
/// `m`, so a write after the wrap would not show through.
async fn do_submit(app: desk.App, id: str, subject: str, key: str) {
    let token = desk.token_of(app)
    let c = desk.currency_of(app)
    let l = desk.lang_of(app)
    var body: { str: json.Json } = { }

    // **The default is a tail, not an else.** Every arm below used to end in
    // `return`, which is the only reason the refusal underneath was reached
    // solely on a miss. As a `match` those returns are redundant — but the
    // refusal has to come *with* the default, or every successful save would
    // also refuse its own form and repaint over its own toast.
    match id {
        "product" => {
            body["sku"] = json.Json.Text(value_of("sku"))
            body["name"] = json.Json.Text(value_of("name"))
            body["name_my"] = json.Json.Text(value_of("name_my"))
            body["category_id"] = json.Json.Text(value_of("category_id"))
            body["supplier_id"] = json.Json.Text(value_of("supplier_id"))
            body["price"] = json.Json.Number(money_of(app, "price") as float)
            body["cost"] = json.Json.Number(money_of(app, "cost") as float)
            body["tax_bp"] = json.Json.Number(whole_of("tax_bp") as float)
            body["min_age"] = json.Json.Number(whole_of("min_age") as float)
            body["unit"] = json.Json.Text(value_of("unit"))
            body["ask_price"] = json.Json.Bool(checked("ask_price"))
            body["reorder_point"] = json.Json.Number(qty_of("reorder_point"))
            body["reorder_qty"] = json.Json.Number(qty_of("reorder_qty"))
            body["quick_key"] = json.Json.Number(whole_of("quick_key") as float)
            body["active"] = json.Json.Bool(checked("active"))
            let open = app.form
            if open != nil {
                body["photo_key"] = json.Json.Text(field_value_of(open, "photo_key"))
            }
            let (_, err) = await api.save_product(token, subject, json.Json.Object(body))
            settle(app, err, words.t(l, "toast.saved"))
        },
        "barcode" => {
            body["barcode"] = json.Json.Text(value_of("barcode"))
            body["pack_size"] = json.Json.Number(qty_of("pack_size"))
            body["label"] = json.Json.Text(value_of("label"))
            let (_, err) = await api.add_barcode(token, subject, json.Json.Object(body))
            settle(app, err, words.t(l, "toast.barcode_added"))
        },
        "category" => {
            body["name"] = json.Json.Text(value_of("name"))
            body["name_my"] = json.Json.Text(value_of("name_my"))
            body["sort"] = json.Json.Number(whole_of("sort") as float)
            let (_, err) = await api.save_category(token, subject, json.Json.Object(body))
            settle(app, err, words.t(l, "toast.saved"))
        },
        "supplier" => {
            body["name"] = json.Json.Text(value_of("name"))
            body["phone"] = json.Json.Text(value_of("phone"))
            body["email"] = json.Json.Text(value_of("email"))
            body["address"] = json.Json.Text(value_of("address"))
            body["lead_days"] = json.Json.Number(whole_of("lead_days") as float)
            body["active"] = json.Json.Bool(checked("active"))
            let (_, err) = await api.save_supplier(token, subject, json.Json.Object(body))
            settle(app, err, words.t(l, "toast.saved"))
        },
        "promotion" => {
            body["name"] = json.Json.Text(value_of("name"))
            body["name_my"] = json.Json.Text(value_of("name_my"))
            body["kind"] = json.Json.Text(value_of("kind"))
            body["value"] = json.Json.Number(whole_of("value") as float)
            body["n"] = json.Json.Number(whole_of("n") as float)
            body["scope"] = json.Json.Text(value_of("scope"))
            body = text_if(body, "product_id", value_of("product_id"))
            body = text_if(body, "category_id", value_of("category_id"))
            body["priority"] = json.Json.Number(whole_of("priority") as float)
            body["active"] = json.Json.Bool(checked("active"))
            let (_, err) = await api.save_promotion(token, subject, json.Json.Object(body))
            settle(app, err, words.t(l, "toast.saved"))
        },
        "customer" => {
            body["name"] = json.Json.Text(value_of("name"))
            body["phone"] = json.Json.Text(value_of("phone"))
            body["note"] = json.Json.Text(value_of("note"))
            body["credit_limit"] = json.Json.Number(money_of(app, "credit_limit") as float)
            let (_, err) = await api.save_customer(token, subject, json.Json.Object(body))
            settle(app, err, words.t(l, "toast.saved"))
        },
        "settle-tab" => {
            let who = value_of("customer_id")
            body["amount"] = json.Json.Number(money_of(app, "amount") as float)
            body["method"] = json.Json.Text(value_of("method"))
            body["note"] = json.Json.Text(value_of("note"))
            body["client_id"] = json.Json.Text(subject)
            let (_, err) = await api.settle_tab(token, who, json.Json.Object(body))
            settle(app, err, words.t(l, "receivables.payment_taken"))
        },
        "staff" => {
            body["name"] = json.Json.Text(value_of("name"))
            body["role"] = json.Json.Text(value_of("role"))
            body = text_if(body, "pin", value_of("pin"))
            body = text_if(body, "username", value_of("username"))
            body = text_if(body, "password", value_of("password"))
            let (_, err) = await api.save_staff(token, "", json.Json.Object(body))
            settle(app, err, words.t(l, "toast.added"))
        },
        "staff-pin" => {
            let (_, err) = await api.set_staff_pin(token, subject, value_of("pin"))
            settle(app, err, words.t(l, "toast.pin_set"))
        },
        "staff-password" => {
            let (_, err) = await api.set_staff_password(token, subject, value_of("password"))
            settle(app, err, words.t(l, "toast.password_set"))
        },
        "staff-edit" => {
            body["name"] = json.Json.Text(value_of("name"))
            body["active"] = json.Json.Bool(checked("active"))
            let (_, err) = await api.save_staff(token, subject, json.Json.Object(body))
            settle(app, err, words.t(l, "toast.saved"))
        },
        "adjust" => {
            body["product_id"] = json.Json.Text(subject)
            body["counted"] = json.Json.Number(qty_of("counted"))
            body["reason"] = json.Json.Text(value_of("reason"))
            body["note"] = json.Json.Text(value_of("note"))
            let (_, err) = await api.adjust_stock(token, json.Json.Object(body))
            settle(app, err, words.t(l, "toast.stock_was_adjusted"))
        },
        "receive" => {
            var lines: [json.Json] = []
            var line: { str: json.Json } = { }
            line["item_id"] = json.Json.Text(subject)
            line["qty"] = json.Json.Number(qty_of("qty"))
            line["unit_cost"] = json.Json.Number(money_of(app, "unit_cost") as float)
            lines.push(json.Json.Object(line))
            body["lines"] = json.Json.Array(lines)
            let (_, err) = await api.receive_order(token, order_id_of(app), json.Json.Object(body))
            settle(app, err, words.t(l, "common.received"))
        },
        "invoice" => {
            body["client_id"] = json.Json.Text(key)
            body["supplier_id"] = json.Json.Text(value_of("supplier_id"))
            body = text_if(body, "po_id", subject)
            body["reference"] = json.Json.Text(value_of("reference"))
            body["total"] = json.Json.Number(money_of(app, "total") as float)
            body["issued_at"] = json.Json.Number(browser.now() as float)
            body["due_at"] = json.Json.Number((browser.now() + whole_of("due_days") * DAY) as float)
            let (_, err) = await api.add_invoice(token, json.Json.Object(body))
            settle(app, err, words.t(l, "toast.invoice_recorded"))
        },
        "pay-invoice" => {
            body["client_id"] = json.Json.Text(key)
            body["amount"] = json.Json.Number(money_of(app, "amount") as float)
            body["method"] = json.Json.Text(value_of("method"))
            let (_, err) = await api.pay_invoice(token, subject, json.Json.Object(body))
            settle(app, err, words.t(l, "payables.paid"))
        },
        "expense" => {
            body["account_code"] = json.Json.Text(value_of("account_code"))
            body["category"] = json.Json.Text(value_of("category"))
            body["payee"] = json.Json.Text(value_of("payee"))
            body = text_if(body, "reference", value_of("reference"))
            body["amount"] = json.Json.Number(money_of(app, "amount") as float)
            body["tax"] = json.Json.Number(money_of(app, "tax") as float)
            body["method"] = json.Json.Text(value_of("method"))
            body["note"] = json.Json.Text(value_of("note"))
            let (_, err) = await api.add_expense(token, json.Json.Object(body))
            settle(app, err, words.t(l, "toast.recorded"))
        },
        "open-shift" => {
            let (_, err) = await api.open_shift(token, value_of("register_id"),
                money_of(app, "opening_float"))
            settle(app, err, words.t(l, "toast.drawer_open"))
        },
        "close-shift" => {
            let (_, err) = await api.close_shift(token, subject,
                money_of(app, "counted_total"), value_of("note"))
            settle(app, err, words.t(l, "toast.drawer_closed"))
        },
        "movement" => {
            body["kind"] = json.Json.Text(value_of("kind"))
            body["amount"] = json.Json.Number(money_of(app, "amount") as float)
            body["reason"] = json.Json.Text(value_of("reason"))
            let (_, err) = await api.shift_movement(token, subject, json.Json.Object(body))
            settle(app, err, words.t(l, "toast.recorded"))
        },
        "register" => {
            body["name"] = json.Json.Text(value_of("name"))
            body["kind"] = json.Json.Text(value_of("kind"))
            let (_, err) = await api.add_register(token, json.Json.Object(body))
            settle(app, err, words.t(l, "toast.lane_added"))
        },
        "remove-category" => {
            let (_, err) = await api.remove_category(token, value_of("category_id"))
            settle(app, err, words.t(l, "toast.category_removed"))
        },
        "cancel-invoice" => {
            body["reason"] = json.Json.Text(value_of("reason"))
            let (_, err) = await api.cancel_invoice(token, value_of("invoice_id"), json.Json.Object(body))
            settle(app, err, words.t(desk.lang_of(app), "payables.cancelled"))
        },
        "journal-filter" => {
            desk.filter_journal(app, value_of("ref_type"), value_of("account_code"), value_of("q"))
            desk.close_form(app)
            load(app)
        },
        "opening-balances" => {
            body["cash_in_safe"] = json.Json.Number(money_of(app, "cash_in_safe") as float)
            body["cash_in_drawer"] = json.Json.Number(money_of(app, "cash_in_drawer") as float)
            let (_, err) = await api.post_opening_balances(token, json.Json.Object(body))
            settle(app, err, words.t(desk.lang_of(app), "accounting.opening_balances"))
        },
        "reverse-entry" => {
            body["reason"] = json.Json.Text(value_of("reason"))
            let (_, err) = await api.reverse_entry(token, subject, json.Json.Object(body))
            settle(app, err, words.t(l, "toast.correction_posted"))
        },
        "refund" => {
            var lines: [json.Json] = []
            for line in app.subject_sale_lines {
                let line_id = line.id
                let wanted = qty_of("line:\(line_id)")
                if wanted > 0.0 {
                    var entry: { str: json.Json } = { }
                    entry["sale_item_id"] = json.Json.Text(line_id)
                    entry["qty"] = json.Json.Number(wanted)
                    lines.push(json.Json.Object(entry))
                }
            }
            body["lines"] = json.Json.Array(lines)
            body["reason"] = json.Json.Text(value_of("reason"))
            body["method"] = json.Json.Text(value_of("method"))
            body["restock"] = json.Json.Bool(checked("restock"))
            let (_, err) = await api.refund_sale(token, subject, json.Json.Object(body))
            settle(app, err, words.t(l, "common.refunded"))
        },
        "settings" => {
            for key in [
                "shop.name", "shop.name_my", "shop.address", "shop.phone", "shop.tax_id",
                "shop.receipt_footer", "currency.code", "currency.symbol", "currency.minor_units",
                "currency.symbol_first", "tax.inclusive", "tax.default_bp", "locale.default",
                "loyalty.points_per_unit", "accounting.enabled",
            ] {
                body[key] = json.Json.Text(value_of(key))
            }
            let (_, err) = await api.save_settings(token, json.Json.Object(body))
            settle(app, err, words.t(l, "toast.saved"))
        },
        "close-period" => {
            let month = value_of("month")
            let bounds = browser.month_bounds(month)
            if bounds.len() != 2 {
                desk.form_refused(app, words.t(l, "error.write_the_month_as"))
                repaint(app)
                return
            }
            body["starts_at"] = json.Json.Number(bounds[0] as float)
            body["ends_at"] = json.Json.Number(bounds[1] as float)
            let (_, err) = await api.close_period(token, json.Json.Object(body))
            settle(app, err, words.t(l, "toast.month_closed"))
        },
        // A line of a delivery. **This one writes nothing.**
        //
        // It puts the line on `app.goods_in` and closes the dialog, so a
        // shopkeeper can enter a delivery note line by line with the van driver
        // waiting and never touch the network until the end. Which is also why
        // a mistyped quantity costs nothing to correct: the row is taken off
        // again with one tap and no request.
        "goods-in-line" => {
            let product_id = value_of("product_id")
            if product_id.len() == 0 {
                desk.form_refused(app, words.t(l, "purchasing.which_product"))
                repaint(app)
                return
            }
            let qty = qty_of("qty")
            if qty <= 0.0 {
                desk.form_refused(app,
                    words.fill(l, "error.not_a_number", words.t(l, "purchasing.qty_arrived")))
                repaint(app)
                return
            }
            desk.goods_in_add(app, crypto.token(), desk.GoodsInLine{
                    product_id: product_id,
                    name: product_name_by(app.ref_products, product_id),
                    qty: qty,
                    unit_cost: money_of(app, "unit_cost"),
                })
            desk.close_form(app)
            redraw_purchasing(app)
        },
        // The one press that writes the delivery — stock, the bill, the payment
        // and the postings, in one request the Worker runs as one transaction.
        // `subject` is the key minted when the first line went on, so four taps
        // on a slow line book one delivery.
        "goods-in-book" => {
            if app.goods_in.len() == 0 {
                desk.form_refused(app, words.t(l, "purchasing.nothing_on_the_delivery"))
                repaint(app)
                return
            }
            let supplier_id = value_of("supplier_id")
            let settlement = value_of("settlement")
            desk.goods_in_about(app, supplier_id, settlement)
            body["client_id"] = json.Json.Text(subject)
            body["supplier_id"] = json.Json.Text(supplier_id)
            body["settlement"] = json.Json.Text(settlement)
            body["reference"] = json.Json.Text(value_of("reference"))
            body["note"] = json.Json.Text(value_of("note"))
            var lines: [json.Json] = []
            for held in app.goods_in {
                var line: { str: json.Json } = { }
                line["product_id"] = json.Json.Text(held.product_id)
                line["qty"] = json.Json.Number(held.qty)
                line["unit_cost"] = json.Json.Number(held.unit_cost as float)
                lines.push(json.Json.Object(line))
            }
            body["lines"] = json.Json.Array(lines)
            // The lines as they were when the request went out. A line added
            // while it was in flight was never sent, and clearing the whole
            // delivery afterwards would throw it away without telling anybody.
            let sent = app.goods_in
            let (replayed, err) = await api.goods_in(token, json.Json.Object(body))
            if err != nil {
                settle(app, err, "")
                return
            }
            desk.goods_in_took(app, sent)
            // **Say which of the two happened.** A press whose answer was lost
            // and is pressed again books nothing — correctly — and a shopkeeper
            // told "booked into stock" would go looking for a delivery that is
            // there once, having typed it twice.
            settle(app, nil,
                if replayed {
                    words.t(l, "purchasing.already_booked")
                } else { words.t(l, "purchasing.delivery_booked") })
        },
        "delete-order" => {
            let (_, err) = await api.delete_order(token, subject)
            if err != nil {
                desk.form_refused(app, err.message())
                repaint(app)
                return
            }
            desk.close_form(app)
            desk.say(app, words.t(l, "purchasing.draft_deleted"))
            // Back to the list: the order this page was about is gone, and
            // leaving the manager looking at a 404 is not an answer.
            desk.go(app, desk.Screen.Purchasing)
            browser.set_hash(desk.href_of(desk.Screen.Purchasing))
            load(app)
        },
        "cancel-order" => {
            let (_, err) = await api.cancel_order(token, subject, value_of("reason"))
            settle(app, err, words.t(l, "purchasing.order_cancelled"))
        },
        _ => {
            // Left in English on purpose, like "is not wired up": it can only
            // appear when a form was written and its submit arm was not, which
            // nobody outside this file can act on.
            desk.form_refused(app, "\(id) has no handler")
            repaint(app)
        },
    }
}

/// The purchase order a receive form belongs to.
fn order_id_of(app: desk.App) -> str {
    return match app.screen {
        Order(id) => id,
        Overview => "",
        Tills => "",
        Sales => "",
        Shifts => "",
        Products => "",
        Inventory => "",
        Movements => "",
        Purchasing => "",
        Suppliers => "",
        Customers => "",
        Promotions => "",
        Reports => "",
        Accounting => "",
        Expenses => "",
        Staff => "",
        Settings => "",
        Product(pid) => "",
        Sale(sid) => "",
        Shift(sid) => "",
    }
}

/// What every write does with its answer.
fn settle(app: desk.App, err: error, said: str) {
    if err != nil {
        desk.form_refused(app, err.message())
        repaint(app)
        return
    }
    desk.close_form(app)
    desk.say(app, said)
    repaint(app)
    load(app)
    load_refs(app)
}

// ---- writes with no form in front of them ----------------------------------

/// Let a closed month be posted into again.
///
/// The endpoint existed from the beginning and nothing ever called it, so a
/// month closed by mistake was a month nobody could reopen. Closing guards
/// against a backdated correction landing in a period already reported to the
/// outside world; reopening is admitting the report itself was wrong, which
/// happens often enough to need a button.
/// Take the picture off a product.
///
/// Deletes the object as well as clearing the column — the Worker does both —
/// because a key nothing points at is a file nobody will ever find and R2 bills
/// for storage.
async fn do_remove_photo(app: desk.App) {
    let open = app.form
    if open == nil {
        return
    }
    let key = field_value_of(open, "photo_key")
    if key.len() == 0 {
        return
    }
    desk.set_field(app, "photo_key", "")
    repaint(app)
    let (_, err) = await api.remove_photo(desk.token_of(app), key)
    if err != nil {
        failed(app, err.message())
        return
    }
    // **The flag has to come down on the way out as well.**
    //
    // `writing` raises `app.busy` before this is called, and the failure path
    // lowers it through `went_wrong` — the success path lowered nothing, so a
    // picture removed cleanly left every button on the page inert until the
    // manager navigated away and back. A screen that stops responding after a
    // press that worked is worse than one that stops after a press that failed.
    desk.working(app, false)
    repaint(app)
}

/// What a field currently holds, from the form rather than from the document —
/// a photo has no input to read back.
fn field_value_of(f: desk.Form, name: str) -> str {
    for field in f.fields {
        if field.name == name {
            return field.value
        }
    }
    return ""
}

