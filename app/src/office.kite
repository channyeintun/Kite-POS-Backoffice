//! The back office: the rail, the screens, and what a press means.
//!
//! The wiring. `screens.kite` says what each screen shows, `forms.kite` says
//! what each dialog asks for, `office_view.kite` draws both, and this file is
//! the three-way join: it loads, it dispatches, and it submits.
//!
//! ## One vocabulary
//!
//! A `data-action` on a button, a row or a form is a string, and the same
//! string appears in exactly three places: where the block names it, in
//! [`pressed`], and — for anything that writes — in [`submit`]. Adding a
//! feature is a form constructor, an arm in each of those two, and an API call.

use std/dom
use std/html
use api
use browser
use desk
use doc
use forms
use i18n
use money
use office_view
use screens
use words

fn repaint(app: desk.App) {
    // The stylesheet keys Burmese's taller line box off the document's own
    // `lang`, so this write is what makes မြန်မာ legible rather than cramped.
    // Written on every repaint rather than only on the switch, because a
    // reload restores the kept language and nothing else would announce it.
    browser.set_document_lang(i18n.tag_of(app.lang))
    let err = html.update(app.view, office_view.page(app))
    if err != nil {
        io.error("office: could not draw: \(err.message())")
    }
}

fn field_value(selector: str) -> str {
    let field = dom.find(selector)
    if field == nil {
        return ""
    }
    return dom.value(field).trim()
}

fn day() -> int {
    return 86400
}

// ---- signing in ------------------------------------------------------------

fn submit_sign_in(app: desk.App) {
    if app.signing_in {
        return
    }
    let username = field_value("#username")
    let password = field_value("#password")
    if username.len() == 0 || password.len() == 0 {
        return
    }
    desk.signing_in(app, true)
    repaint(app)
    do_sign_in(app, username, password)
}

async fn do_sign_in(app: desk.App, username: str, password: str) {
    let (session, err) = await api.sign_in_with_password(username, password)
    if err != nil {
        desk.signing_in(app, false)
        desk.went_wrong(app, err.message())
        repaint(app)
        return
    }
    browser.keep("kite-office.token", session.token)
    desk.signed_in(app, session)
    repaint(app)
    load(app)
    load_header(app)
    load_refs(app)
}

async fn resume(app: desk.App, token: str) {
    let (session, err) = await api.whoami(token)
    if err != nil {
        browser.drop_kept("kite-office.token")
        repaint(app)
        return
    }
    desk.signed_in(app, session)
    repaint(app)
    load(app)
    load_header(app)
    load_refs(app)
}

fn sign_off(app: desk.App) {
    let token = desk.token_of(app)
    browser.drop_kept("kite-office.token")
    desk.signed_out(app)
    repaint(app)
    do_sign_out(token)
}

async fn do_sign_out(token: str) {
    let (_, err) = await api.sign_out(token)
    if err != nil {
        io.error("office: sign-out did not reach the server")
    }
}

/// The lists every dropdown is built from.
///
/// Asked for once on arrival rather than per form, because a shop's categories
/// and suppliers change about as often as its address and a dialog that waits
/// on two requests before it opens feels broken.
async fn load_refs(app: desk.App) {
    let token = desk.token_of(app)
    // Each of these is tested in its own `if` before the answer is touched:
    // Kite will not let a `(T, error)` be read inside the same expression that
    // tests the error, and a missing list is a screen with an empty dropdown
    // rather than a failure worth stopping for.
    var categories: [doc.Doc] = []
    let (cats, cerr) = await api.categories(token)
    if cerr == nil {
        categories = doc.items(doc.field(cats, "categories"))
    }
    var suppliers: [doc.Doc] = []
    let (sups, serr) = await api.suppliers(token)
    if serr == nil {
        suppliers = doc.items(doc.field(sups, "suppliers"))
    }
    var products: [doc.Doc] = []
    let (prods, perr) = await api.products(token, "")
    if perr == nil {
        products = doc.items(doc.field(prods, "products"))
    }
    var registers: [doc.Doc] = []
    let (lanes, lerr) = await api.lanes(token)
    if lerr == nil {
        registers = doc.items(doc.field(lanes, "lanes"))
    }
    desk.took_refs(app, categories, suppliers, products, registers)

    var expense_accounts: [doc.Doc] = []
    let (chart, aerr) = await api.expense_accounts(token)
    if aerr == nil {
        expense_accounts = doc.items(doc.field(chart, "accounts"))
    }
    desk.took_expense_accounts(app, expense_accounts)

    let (settings, terr) = await api.settings(token)
    if terr == nil {
        let values = doc.field(settings, "settings")
        desk.took_settings(app, values)
        // Seed from the shop's own `locale.default` when nobody at this desk
        // has chosen yet. The setting has been on the wire since the first
        // build and nothing has ever read it.
        if browser.kept("kite-office.lang") == nil {
            let code = doc.text(values, "locale.default", "en")
            desk.set_lang(app, i18n.of_code(code))
            repaint(app)
        }
    }
}

async fn load_header(app: desk.App) {
    let (answer, err) = await api.lanes(desk.token_of(app))
    if err != nil {
        return
    }
    var open = 0
    var offline = 0
    var expected = 0
    for lane in doc.items(doc.field(answer, "lanes")) {
        let state = doc.text(lane, "state", "closed")
        if state == "open" || state == "offline" {
            open = open + 1
        }
        if state == "offline" {
            offline = offline + 1
        }
        expected = expected + doc.int_of(lane, "drawer_expected", 0)
    }
    desk.lanes_are(app, open, offline, money.show(expected, desk.currency_of(app)))
    if open > 0 {
        desk.badge(app, "tills", "\(open)")
    }
    repaint(app)
}

// ---- filling a screen ------------------------------------------------------

fn load(app: desk.App) {
    desk.working(app, true)
    repaint(app)
    match app.screen {
        Overview => load_overview(app),
        Tills => load_tills(app),
        Sales => load_sales(app),
        Shifts => load_shifts(app),
        Products => load_products(app),
        Inventory => load_inventory(app),
        Movements => load_movements(app),
        Purchasing => load_purchasing(app),
        Suppliers => load_suppliers(app),
        Customers => load_customers(app),
        Promotions => load_promotions(app),
        Reports => load_reports(app),
        Accounting => load_accounting(app),
        Expenses => load_expenses(app),
        Staff => load_staff(app),
        Settings => load_settings(app),
        Product(id) => load_product(app, id),
        Sale(id) => load_sale(app, id),
        Shift(id) => load_shift(app, id),
        Order(id) => load_order(app, id),
    }
}

fn failed(app: desk.App, why: str) {
    desk.went_wrong(app, why)
    repaint(app)
}

fn done(app: desk.App, blocks: [desk.Block]) {
    desk.took(app, blocks)
    repaint(app)
}

async fn load_overview(app: desk.App) {
    let (answer, err) = await api.overview(desk.token_of(app))
    if err != nil {
        failed(app, err.message())
        return
    }
    done(app, screens.overview(answer, desk.lang_of(app), desk.currency_of(app), desk.who_of(app)))
}

async fn load_tills(app: desk.App) {
    let token = desk.token_of(app)
    let (answer, err) = await api.lanes(token)
    if err != nil {
        failed(app, err.message())
        return
    }
    var entries = doc.nothing()
    let (audit, aerr) = await api.audit(token, browser.now() - day())
    if aerr == nil {
        entries = audit
    }
    done(app, screens.tills(answer, entries, desk.lang_of(app), desk.currency_of(app)))
}

async fn load_sales(app: desk.App) {
    let to = browser.now()
    let (answer, err) = await api.sales_history(desk.token_of(app), to - 7 * day(), to)
    if err != nil {
        failed(app, err.message())
        return
    }
    done(app, screens.sales(answer, desk.lang_of(app), desk.currency_of(app)))
}

