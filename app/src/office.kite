async fn load_reports(app: desk.App) {
    let token = desk.token_of(app)
    let to = browser.now()
    let from = to - 30 * day()
    let (products, err) = await api.product_report(token, from, to)
    if err != nil {
        failed(app, err.message())
        return
    }
    var d = doc.nothing()
    let (daily, derr) = await api.sales_report(token, from, to)
    if derr == nil {
        d = daily
    }
    var s = doc.nothing()
    let (shrink, serr) = await api.shrinkage(token, from, to)
    if serr == nil {
        s = shrink
    }
    done(app, screens.reports(products, d, s, desk.lang_of(app), desk.currency_of(app)))
}

/// Fetch only what the open sheet needs.
///
/// Eight sheets, and loading all of them on every switch would be eight round
/// trips to look at one. The summary is the exception: it is a page *about*
/// the whole of the books, so it reads several and each of those is allowed to
/// fail on its own — a health sweep that times out should not take the
/// revenue figure down with it.
async fn load_accounting(app: desk.App) {
    let token = desk.token_of(app)
    let (summary, serr) = await api.accounting_summary(token)
    if serr != nil {
        failed(app, serr.message())
        return
    }
    if !doc.bool_of(summary, "enabled", false) {
        done(app, screens.accounting_off(desk.lang_of(app)))
        return
    }

    let view = app.books_view
    let span = desk.window_seconds(app.books_window, browser.now())
    let from = span[0]
    let to = span[1]

    let data = doc.object()
    doc.put(data, "summary", summary)

    if view == "summary" || view == "pl" {
        let (pl, perr) = await api.profit_and_loss(token, from, to)
        if perr != nil {
            failed(app, perr.message())
            return
        }
        doc.put(data, "pl", pl)
    }
    if view == "summary" || view == "balance" {
        let (sheet, berr) = await api.balance_sheet(token, to)
        if berr == nil {
            doc.put(data, "sheet", sheet)
        }
    }
    if view == "summary" {
        let (health, herr) = await api.books_health(token)
        if herr == nil {
            doc.put(data, "health", health)
        }
        let (owing, oerr) = await api.payables(token)
        if oerr == nil {
            doc.put(data, "payables", owing)
        }
    }
    if view == "trial" {
        let (trial, terr) = await api.trial_balance(token, from, to)
        if terr != nil {
            failed(app, terr.message())
            return
        }
        doc.put(data, "trial", trial)
    }
    if view == "journal" {
        let (journal, jerr) = await api.journal(token, from, to)
        if jerr != nil {
            failed(app, jerr.message())
            return
        }
        doc.put(data, "journal", journal)
    }
    if view == "accounts" {
        let (accounts, aerr) = await api.accounts(token)
        if aerr != nil {
            failed(app, aerr.message())
            return
        }
        doc.put(data, "accounts", accounts)
    }
    if view == "ledger" && app.books_account.len() > 0 {
        let (ledger, lerr) = await api.general_ledger(token, app.books_account, from, to)
        if lerr != nil {
            failed(app, lerr.message())
            return
        }
        doc.put(data, "ledger", ledger)
    }

    done(app, screens.accounting(view, app.books_window, data, app.books_account,
            desk.lang_of(app), desk.currency_of(app)))
}

/// Save the open sheet as a file.
///
/// The window and the account travel with it, so the file matches what is on
/// screen rather than some default the shopkeeper did not choose. Not every
/// sheet is exportable — Periods is a list of four dates — so the ones that
/// are not fall back to the trial balance's window rather than producing an
/// empty file under a misleading name.
async fn do_export_books(app: desk.App, view: str) {
    let token = desk.token_of(app)
    let span = desk.window_seconds(app.books_window, browser.now())
    var sheet = view
    if view == "summary" || view == "periods" {
        sheet = "trial"
    }
    var query = "?view=\(sheet)&from=\(span[0])&to=\(span[1])"
    if sheet == "ledger" {
        query = "\(query)&account_code=\(app.books_account)"
    }
    let (body, err) = await api.fetch_text(token, "/accounting/export\(query)")
    if err != nil {
        failed(app, err.message())
        return
    }
    let name = "\(sheet)-\(browser.iso_day(span[0])).csv"
    browser.download(name, body, "text/csv;charset=utf-8")
    desk.say(app, words.fill(desk.lang_of(app), "toast.saved_n", name))
    repaint(app)
}

