/// Receive everything a delivery brought, in one press.
async fn do_receive_all(app: desk.App, id: str) {
    let token = desk.token_of(app)
    let (answer, err) = await api.order(token, id)
    if err != nil {
        failed(app, err.message())
        return
    }
    var body: { str: json.Json } = { }
    var lines: [json.Json] = []
    for l in answer.lines {
        let left = l.qty - l.qty_received
        if left > 0.0 {
            var entry: { str: json.Json } = { }
            entry["item_id"] = json.Json.Text(l.id)
            entry["qty"] = json.Json.Number(left)
            entry["unit_cost"] = json.Json.Number(l.unit_cost as float)
            lines.push(json.Json.Object(entry))
        }
    }
    body["lines"] = json.Json.Array(lines)
    let (_, rerr) = await api.receive_order(token, id, json.Json.Object(body))
    if rerr != nil {
        failed(app, rerr.message())
        return
    }
    desk.say(app, words.t(desk.lang_of(app), "common.received"))
    load(app)
}

/// Turn the worksheet into draft orders, one per supplier.
///
/// The worksheet already knows what to buy and from whom; this is the press
/// that writes it down. Grouped by supplier because that is how it will be
/// sent, and left as a draft because somebody should look at it first.
///
/// **The key is the supplier and the day, not the press.** This is the button
/// that wrote twelve draft orders: nothing on screen changed while it was in
/// flight, so on a slow line it was tapped again and again, and each tap wrote
/// one order per supplier with nothing anywhere to tell them apart.
/// `writing` now refuses the second tap while the first is running, and this
/// key covers the case the guard cannot — a tap after the answer was lost.
/// Today's reorder for a supplier is one order however many times it is asked
/// for, which is what the button already meant.
async fn do_raise_orders(app: desk.App) {
    let token = desk.token_of(app)
    let (lines, err) = await api.worksheet(token, 28)
    if err != nil {
        failed(app, err.message())
        return
    }
    var suppliers: [str] = []
    for l in lines {
        let supplier = l.supplier_id
        if supplier.len() > 0 && l.suggested > 0.0 && !includes(suppliers, supplier) {
            suppliers.push(supplier)
        }
    }
    if suppliers.len() == 0 {
        desk.went_wrong(app,
            words.t(desk.lang_of(app), "purchasing.nothing_to_order"))
        repaint(app)
        return
    }

    let today = browser.iso_day(browser.now())
    var raised = 0
    for supplier in suppliers {
        var body: { str: json.Json } = { }
        body["client_id"] = json.Json.Text("worksheet:\(supplier):\(today)")
        body["supplier_id"] = json.Json.Text(supplier)
        body["status"] = json.Json.Text("draft")
        var items: [json.Json] = []
        for l in lines {
            if l.supplier_id == supplier && l.suggested > 0.0 {
                var entry: { str: json.Json } = { }
                entry["product_id"] = json.Json.Text(l.id)
                entry["qty"] = json.Json.Number(l.suggested)
                entry["unit_cost"] = json.Json.Number(l.cost as float)
                items.push(json.Json.Object(entry))
            }
        }
        body["lines"] = json.Json.Array(items)
        let (replayed, oerr) = await api.raise_order(token, json.Json.Object(body))
        // Nested rather than `&&`: a value is unreadable until its error is
        // disproved, and narrowing does not cross an `&&`.
        if oerr == nil {
            if !replayed {
                raised = raised + 1
            }
        }
    }
    // Nothing new: the key above matched, which means today's orders are
    // already on the list. Said plainly rather than reported as "0 raised",
    // which reads like a failure and is not one.
    if raised == 0 {
        desk.say(app, words.t(desk.lang_of(app), "purchasing.orders_already_raised"))
        load(app)
        return
    }
    // No singular against plural: မြန်မာ does not mark it, and the reviewed
    // phrase already says "one per supplier", which is the fact worth saying.
    desk.say(app, words.fill_n(desk.lang_of(app), "toast.pos_raised", "\(raised)"))
    load(app)
}

async fn open_close_lane(app: desk.App, id: str) {
    let (answer, err) = await api.lanes(desk.token_of(app))
    if err != nil {
        failed(app, err.message())
        return
    }
    for lane in answer {
        if lane.id == id {
            let shift = lane.shift_id
            if shift.len() == 0 {
                desk.went_wrong(app,
                    words.t(desk.lang_of(app), "tills.that_lane_has_no_open_drawer"))
                repaint(app)
                return
            }
            desk.open_form(app, forms.close_shift(shift, lane.name,
                    lane.drawer_expected, desk.lang_of(app), desk.currency_of(app)))
            repaint(app)
            return
        }
    }
}

// ---- events ----------------------------------------------------------------

fn arrived(app: desk.App) {
    let wanted = desk.screen_of(window.hash())
    desk.go(app, wanted)
    if app.session == nil {
        repaint(app)
        return
    }
    load(app)
}

fn clicked(app: desk.App, e: dom.Event) {
    let hit = dom.target(e)
    if hit == nil {
        return
    }
    let acted = browser.closest(hit, "[data-action]")
    if acted == nil {
        return
    }
    let name = dom.attribute(acted, "data-action")
    if name == nil {
        return
    }
    let id = or_else(dom.attribute(acted, "data-id"), "")
    // Every other control here is a `type="button"` button, an `li` or a `tr`,
    // none of which has a default action to cancel. The photo inputs are
    // `<input type="file">`, whose default action — opening the file chooser —
    // is the entire point of pressing one, and cancelling it is why a product
    // photo could never be attached: the chooser never opened, so `change`
    // never fired and `changed` below never ran.
    if name != "photo-pick" {
        _ = dom.prevent_default(e)
    }
    pressed(app, name, id)
}

/// Something in the dialog changed. Only the photo inputs use this.
fn changed(app: desk.App, e: dom.Event) {
    let target = dom.target(e)
    if target == nil {
        return
    }
    // **The cost follows the product.**
    //
    // The Goods In line form opens with the first product's cost under the
    // chooser so the common case is one field fewer to type. That number is
    // written onto `products.cost` by the Worker, and it used to sit there
    // unchanged while the operator picked a different row — so a delivery of
    // crisps could reprice the cola, and every margin the shop reported
    // afterwards was computed against a price it never paid. There is no
    // per-field handler in the form model, so the one change listener the
    // office has is where this belongs.
    let open_form = app.form
    if open_form != nil {
        if open_form.id == "goods-in-line" {
            if or_else(dom.attribute(target, "data-field"), "") == "product_id" {
                let chosen = dom.value(target)
                for p in app.ref_products {
                    if p.id == chosen {
                        desk.set_field(app, "unit_cost",
                            money.plain(p.cost, desk.currency_of(app)))
                        repaint(app)
                    }
                }
                return
            }
        }
    }
    let acted = browser.closest(target, "[data-action]")
    if acted == nil {
        return
    }
    if or_else(dom.attribute(acted, "data-action"), "") != "photo-pick" {
        return
    }
    let open = app.form
    if open == nil {
        return
    }
    desk.form_working(app)
    repaint(app)
    // The element is read now, not inside the upload: a repaint replaces the
    // node, and the file would go with it.
    browser.upload_photo(
        "\(api.base())/photos\(if open.subject.len() > 0 { "?product_id=\(open.subject)" } else { "" })",
        desk.token_of(app),
        acted,
        |key: str| { photo_saved(app, key) },
        |why: str| { photo_failed(app, why) })
}

/// A picture landed. The key goes into the open form, so the preview redraws
/// and a Save carries it — which is what attaches it to a product that did not
/// exist yet when the picture was taken.
fn photo_saved(app: desk.App, key: str) {
    desk.set_field(app, "photo_key", key)
    desk.say(app, words.t(desk.lang_of(app), "toast.photo_saved"))
    repaint(app)
}

fn photo_failed(app: desk.App, why: str) {
    desk.form_refused(app, why)
    repaint(app)
}

fn typed(app: desk.App, e: dom.Event) {
    if dom.key(e) != "Enter" {
        return
    }
    let hit = dom.target(e)
    if hit == nil {
        return
    }
    let field = or_else(dom.attribute(hit, "id"), "")
    if field == "username" || field == "password" {
        _ = dom.prevent_default(e)
        submit_sign_in(app)
    }
}

pub fn main() {
    let root = dom.find("#app")
    if root == nil {
        io.error("office: there is no #app to mount into")
        return
    }
    let (mounted, merr) = html.mount(root, [])
    if merr != nil {
        io.error("office: could not mount: \(merr.message())")
        return
    }

    let app = desk.holding(root, mounted)
    // A kept choice wins over the shop's default: the person at this desk
    // chose it, and the shop's setting is only ever the starting point. The
    // key is the office's own — a manager reading မြန်မာ at the desk should
    // not silently switch every lane in the building.
    let kept = window.kept("kite-office.lang")
    if kept != nil {
        desk.set_lang(app, i18n.of_code(kept))
    }
    desk.go(app, desk.screen_of(window.hash()))

    // Read before the first paint — see the note in `pos.kite`. Without this
    // the desk drew its sign-in card over a session that was already good.
    let token = window.kept("kite-office.token")
    if token != nil {
        desk.restoring(app, true)
    }
    repaint(app)

    let (_, cerr) = dom.on(root, "click", |e: dom.Event| { clicked(app, e) })
    if cerr != nil {
        io.error("office: no clicks: \(cerr.message())")
    }
    // A file input announces itself with `change`, not `click`: the click opens
    // the picker and the file arrives later, on a second event.
    let (_, cherr) = dom.on(root, "change", |e: dom.Event| { changed(app, e) })
    if cherr != nil {
        io.error("office: no change events: \(cherr.message())")
    }
    let (_, kerr) = dom.on(root, "keydown", |e: dom.Event| { typed(app, e) })
    if kerr != nil {
        io.error("office: no keys: \(kerr.message())")
    }
    browser.on_window("hashchange", || { arrived(app) })

    // The lanes are the one thing on this page that is about *now*, so they are
    // re-read on a slow beat. Everything else is a window and waits to be asked.
    browser.every(30000, || { load_header(app) })

    browser.register_worker("/sw.js")

    if token != nil {
        resume(app, token)
    }
}
