// ---- opening a form --------------------------------------------------------

/// A document from a list, by id — what an edit form is filled from.
fn one_of(list: [doc.Doc], id: str) -> doc.Doc {
    for d in list {
        if doc.text(d, "id", "") == id {
            return d
        }
    }
    return doc.nothing()
}

fn names_of(list: [doc.Doc]) -> [str] {
    var out: [str] = []
    for d in list {
        out.push(doc.text(d, "name", ""))
    }
    return out
}

fn ids_of(list: [doc.Doc]) -> [str] {
    var out: [str] = []
    for d in list {
        out.push(doc.text(d, "id", ""))
    }
    return out
}

fn open_form(app: desk.App, what: str, id: str) {
    let c = desk.currency_of(app)
    let l = desk.lang_of(app)

    if what == "form-product" {
        let existing = if id.len() > 0 { app.subject } else { doc.nothing() }
        desk.open_form(app, forms.product(existing, id, app.ref_categories, app.ref_suppliers, l, c))
    } else if what == "form-barcode" {
        desk.open_form(app, forms.barcode(id, doc.text(app.subject, "name", ""), l))
    } else if what == "form-category" {
        desk.open_form(app, forms.category(one_of(app.ref_categories, id), id, l))
    } else if what == "form-supplier" {
        desk.open_form(app, forms.supplier(one_of(app.ref_suppliers, id), id, l))
    } else if what == "form-promotion" {
        desk.open_form(app, forms.promotion(doc.nothing(), id, app.ref_products,
                app.ref_categories, l, c))
    } else if what == "form-customer" {
        desk.open_form(app, forms.customer(doc.nothing(), id, l))
    } else if what == "form-staff" {
        desk.open_form(app, forms.staff(l))
    } else if what == "form-expense" {
        desk.open_form(app, forms.expense(app.ref_expense_accounts, l, c))
    } else if what == "form-settings" {
        desk.open_form(app, forms.settings(app.ref_settings, l))
    } else if what == "form-close-period" {
        desk.open_form(app, forms.close_period(l))
    } else if what == "form-register" {
        desk.open_form(app, forms.register(l))
    } else if what == "form-adjust" {
        desk.open_form(app, forms.adjust(id, doc.text(app.subject, "name", ""),
                doc.num_of(app.subject, "stock", 0.0), l))
    } else if what == "form-open-shift" {
        desk.open_form(app, forms.open_shift(ids_of(app.ref_registers),
                names_of(app.ref_registers), l, c))
    } else if what == "form-invoice" {
        desk.open_form(app, forms.invoice(ids_of(app.ref_suppliers), names_of(app.ref_suppliers),
                id, doc.text(app.subject, "supplier_id", ""),
                doc.int_of(app.subject, "total", 0), l, c))
    } else {
        // A developer's message, not a shopkeeper's: it only appears when a
        // button names a form nobody wrote, which is a bug rather than a state.
        desk.went_wrong(app, "\(what) is not wired up")
    }
    repaint(app)
}

/// Forms that need a read before they can be filled.
async fn open_close_shift(app: desk.App, id: str) {
    let (answer, err) = await api.shift(desk.token_of(app), id)
    if err != nil {
        failed(app, err.message())
        return
    }
    let shift = doc.field(answer, "shift")
    desk.open_form(app, forms.close_shift(id, doc.text(shift, "register_name", ""),
            doc.int_of(doc.field(answer, "drawer"), "expected", 0),
            desk.lang_of(app), desk.currency_of(app)))
    repaint(app)
}

async fn open_pay_invoice(app: desk.App, id: str) {
    let (answer, err) = await api.payables(desk.token_of(app))
    if err != nil {
        failed(app, err.message())
        return
    }
    for i in doc.items(doc.field(answer, "invoices")) {
        if doc.text(i, "id", "") == id {
            desk.open_form(app, forms.pay_invoice(id, doc.text(i, "supplier_name", ""),
                    doc.int_of(i, "outstanding", 0), desk.lang_of(app), desk.currency_of(app)))
            repaint(app)
            return
        }
    }
    failed(app, words.t(desk.lang_of(app), "payables.that_invoice_is_not_open_any_more"))
}

async fn open_refund(app: desk.App, id: str) {
    let (answer, err) = await api.sale(desk.token_of(app), id)
    if err != nil {
        failed(app, err.message())
        return
    }
    let sale = doc.field(answer, "sale")
    desk.open_form(app, forms.refund(id, doc.int_of(sale, "number", 0),
            doc.items(doc.field(answer, "lines")), desk.lang_of(app), desk.currency_of(app)))
    repaint(app)
}

fn open_receive(app: desk.App, item_id: str) {
    for line in app.subject_lines {
        if doc.text(line, "id", "") == item_id {
            let left = doc.num_of(line, "qty", 0.0) - doc.num_of(line, "qty_received", 0.0)
            desk.open_form(app, forms.receive(item_id, doc.text(line, "product_name", ""),
                    left, doc.int_of(line, "unit_cost", 0),
                    desk.lang_of(app), desk.currency_of(app)))
            repaint(app)
            return
        }
    }
}

async fn open_staff_menu(app: desk.App, id: str) {
    let (answer, err) = await api.staff(desk.token_of(app))
    if err != nil {
        failed(app, err.message())
        return
    }
    for u in doc.items(doc.field(answer, "staff")) {
        if doc.text(u, "id", "") == id {
            if doc.text(u, "signs_in_with", "") == "pin" {
                desk.open_form(app, forms.staff_pin(id, doc.text(u, "name", ""), desk.lang_of(app)))
            } else {
                desk.open_form(app, forms.staff_password(id, doc.text(u, "name", ""),
                        desk.lang_of(app)))
            }
            repaint(app)
            return
        }
    }
}

// ---- reading a form back ---------------------------------------------------

/// A field, by the name the form declared.
///
/// Matched on the `data-field` attribute rather than on an id, because a
/// settings key contains a dot: `#f-shop.name` parses as "the element with id
/// `f-shop` and class `name`" and matches nothing at all. Every settings field
/// read empty, so Settings could be opened, filled in and saved — and saved
/// every value as "". An attribute selector has no such syntax to trip over.
fn field_of(name: str) -> Option<dom.Element> {
    return dom.find("[data-field=\"\(name)\"]")
}

fn value_of(name: str) -> str {
    let field = field_of(name)
    if field == nil {
        return ""
    }
    return dom.value(field).trim()
}

fn checked(name: str) -> bool {
    let field = field_of(name)
    if field == nil {
        return false
    }
    return browser.is_checked(field)
}

/// An amount, after `first_unreadable` has already refused the form if any
/// money field could not be read. The zero here is unreachable, and is a zero
/// rather than a panic because a till has nobody to show a panic to.
fn money_of(app: desk.App, name: str) -> int {
    return or_else(money.from_text(value_of(name), desk.currency_of(app)), 0)
}

fn whole_of(name: str) -> int {
    return or_else(parse_int(value_of(name)), 0)
}

fn qty_of(name: str) -> float {
    return or_else(parse_float(value_of(name)), 0.0)
}

fn put_text_if(body: doc.Doc, key: str, value: str) {
    if value.len() > 0 {
        doc.put_text(body, key, value)
    }
}

// ---- what a press means ----------------------------------------------------

fn pressed(app: desk.App, what: str, id: str) {
    if what == "sign-in" {
        submit_sign_in(app)
        return
    }
    if what == "sign-out" {
        sign_off(app)
        return
    }
    if what == "lang" {
        desk.set_lang(app, i18n.of_code(id))
        browser.keep("kite-office.lang", id)
        repaint(app)
        // And ask for the screen again. A `desk.Block` carries its own words —
        // a table's headings were said in whichever language was on when the
        // screen was built — so a repaint alone changed the rail and the page
        // title and left the body in the old language. An open dialog is
        // deliberately not rebuilt: its labels go stale, but rebuilding it
        // would throw away whatever has been typed into it.
        load(app)
        return
    }
    if what == "rail" {
        desk.toggle_rail(app)
        repaint(app)
        return
    }
    if what == "go" {
        if id == "categories" {
            desk.go(app, desk.Screen.Products)
            desk.working(app, true)
            repaint(app)
            load_categories(app)
            return
        }
        browser.set_hash("#/\(id)")
        return
    }
    if what == "open-product" {
        browser.set_hash("#/products/\(id)")
        return
    }
    if what == "open-sale" {
        browser.set_hash("#/sales/\(id)")
        return
    }
    if what == "open-shift-detail" {
        browser.set_hash("#/shifts/\(id)")
        return
    }
    if what == "open-order" {
        browser.set_hash("#/purchasing/\(id)")
        return
    }
    if what == "print" {
        browser.print_page()
        return
    }
    if what == "form-cancel" {
        desk.close_form(app)
        repaint(app)
        return
    }
    if what == "form-submit" {
        submit(app)
        return
    }
    // ---- the books --------------------------------------------------------
    //
    // Switching sheet or window re-reads only what the new sheet needs, which
    // is why each of these ends in `load` rather than a repaint: the window is
    // what the request is built from, so changing it without re-asking would
    // show last window's figures under this window's label.
    if what == "books-view" {
        desk.show_books(app, id)
        load(app)
        return
    }
    if what == "books-window" {
        desk.set_books_window(app, id)
        load(app)
        return
    }
    if what == "books-account" {
        desk.open_account(app, id)
        load(app)
        return
    }
    if what == "books-export" {
        do_export_books(app, id)
        return
    }
    if what == "books-reverse" {
        desk.open_form(app, forms.reverse_entry(id, desk.lang_of(app)))
        repaint(app)
        return
    }
    if what == "books-reopen" {
        do_reopen_period(app, id)
        return
    }
    if what == "form-close-shift" {
        open_close_shift(app, id)
        return
    }
    if what == "form-pay-invoice" {
        open_pay_invoice(app, id)
        return
    }
    if what == "form-refund" {
        open_refund(app, id)
        return
    }
    if what == "form-receive" {
        open_receive(app, id)
        return
    }
    if what == "form-movement" {
        desk.open_form(app, forms.movement(id, desk.lang_of(app), desk.currency_of(app)))
        repaint(app)
        return
    }
    if what == "staff-menu" {
        open_staff_menu(app, id)
        return
    }
    if what == "retire-product" {
        do_retire_product(app, id)
        return
    }
    if what == "drop-barcode" {
        do_drop_barcode(app, id)
        return
    }
    if what == "send-order" {
        do_send_order(app, id)
        return
    }
    if what == "receive-all" {
        do_receive_all(app, id)
        return
    }
    if what == "raise-orders" {
        do_raise_orders(app)
        return
    }
    if what == "close-lane" {
        open_close_lane(app, id)
        return
    }
    if what == "authorise" {
        desk.went_wrong(app, words.t(desk.lang_of(app), "tills.authorise_at_the_lane_itself"))
        repaint(app)
        return
    }
    if what == "shift-detail" {
        browser.set_hash("#/shifts")
        return
    }
    if starts_with(what, "form-") {
        open_form(app, what, id)
        return
    }
}

// ---- submitting ------------------------------------------------------------

fn submit(app: desk.App) {
    let open = app.form
    if open == nil {
        return
    }
    if open.busy {
        return
    }
    let bad = first_unreadable(app, open)
    if bad.len() > 0 {
        desk.form_refused(app,
            words.fill(desk.lang_of(app), "error.not_a_number", bad))
        repaint(app)
        return
    }
    desk.form_working(app)
    repaint(app)
    do_submit(app, open.id, open.subject)
}

/// The label of the first amount or quantity the parser refuses, or "".
///
/// **The refusal has to stop the submission**, and it did not. `money.from_text`
/// is written to return nothing rather than guess — "anything that is not an
/// amount is refused rather than read as zero — so a slip in a form cannot
/// quietly become a free item" — and then every call site wrote
/// `or_else(…, 0)` and turned the refusal back into a zero.
///
/// What that cost: a manager retyping a shelf price as "1,200.00" out of habit
/// in a currency with no decimals sent `price: 0`, the server took it, and the
/// till gave that product away on every scan. The same keystroke on a supplier
/// invoice sent `total: 0`, which posts nothing at all — `post` drops zero
/// lines — so the payable to that supplier simply did not exist. On a drawer
/// count it sent `counted_total: 0`, booking the whole session's takings as a
/// loss and skipping the sweep, so the drawer never returned to zero.
///
/// Checked here, once, against the fields the form declared, rather than at
/// nine call sites that each have to remember.
fn first_unreadable(app: desk.App, open: desk.Form) -> str {
    let c = desk.currency_of(app)
    for f in open.fields {
        if f.kind == desk.FieldKind.Money {
            if money.from_text(value_of(f.name), c) == nil {
                return f.label
            }
        }
        if f.kind == desk.FieldKind.Quantity {
            if parse_float(value_of(f.name)) == nil {
                return f.label
            }
        }
    }
    return ""
}

/// Everything that writes, in one place.
///
/// A long function on purpose: the alternative is twenty small ones that each
/// have to be found before a field can be traced from the form that asked for
/// it to the call that sends it. Every arm reads its own fields by name and
/// ends in one API call.
async fn do_submit(app: desk.App, id: str, subject: str) {
    let token = desk.token_of(app)
    let c = desk.currency_of(app)
    let l = desk.lang_of(app)
    let body = doc.object()

    if id == "product" {
        doc.put_text(body, "sku", value_of("sku"))
        doc.put_text(body, "name", value_of("name"))
        doc.put_text(body, "name_my", value_of("name_my"))
        doc.put_text(body, "category_id", value_of("category_id"))
        doc.put_text(body, "supplier_id", value_of("supplier_id"))
        doc.put_int(body, "price", money_of(app, "price"))
        doc.put_int(body, "cost", money_of(app, "cost"))
        doc.put_int(body, "tax_bp", whole_of("tax_bp"))
        doc.put_int(body, "min_age", whole_of("min_age"))
        doc.put_text(body, "unit", value_of("unit"))
        doc.put_bool(body, "ask_price", checked("ask_price"))
        doc.put_num(body, "reorder_point", qty_of("reorder_point"))
        doc.put_num(body, "reorder_qty", qty_of("reorder_qty"))
        doc.put_int(body, "quick_key", whole_of("quick_key"))
        doc.put_bool(body, "active", checked("active"))
        let (_, err) = await api.save_product(token, subject, body)
        settle(app, err, words.t(l, "toast.saved"))
        return
    }
    if id == "barcode" {
        doc.put_text(body, "barcode", value_of("barcode"))
        doc.put_num(body, "pack_size", qty_of("pack_size"))
        doc.put_text(body, "label", value_of("label"))
        let (_, err) = await api.add_barcode(token, subject, body)
        settle(app, err, words.t(l, "toast.barcode_added"))
        return
    }
    if id == "category" {
        doc.put_text(body, "name", value_of("name"))
        doc.put_text(body, "name_my", value_of("name_my"))
        doc.put_int(body, "sort", whole_of("sort"))
        let (_, err) = await api.save_category(token, subject, body)
        settle(app, err, words.t(l, "toast.saved"))
        return
    }
    if id == "supplier" {
        doc.put_text(body, "name", value_of("name"))
        doc.put_text(body, "phone", value_of("phone"))
        doc.put_text(body, "email", value_of("email"))
        doc.put_text(body, "address", value_of("address"))
        doc.put_int(body, "lead_days", whole_of("lead_days"))
        doc.put_bool(body, "active", checked("active"))
        let (_, err) = await api.save_supplier(token, subject, body)
        settle(app, err, words.t(l, "toast.saved"))
        return
    }
    if id == "promotion" {
        doc.put_text(body, "name", value_of("name"))
        doc.put_text(body, "name_my", value_of("name_my"))
        doc.put_text(body, "kind", value_of("kind"))
        doc.put_int(body, "value", whole_of("value"))
        doc.put_int(body, "n", whole_of("n"))
        doc.put_text(body, "scope", value_of("scope"))
        put_text_if(body, "product_id", value_of("product_id"))
        put_text_if(body, "category_id", value_of("category_id"))
        doc.put_int(body, "priority", whole_of("priority"))
        doc.put_bool(body, "active", checked("active"))
        let (_, err) = await api.save_promotion(token, subject, body)
        settle(app, err, words.t(l, "toast.saved"))
        return
    }
    if id == "customer" {
        doc.put_text(body, "name", value_of("name"))
        doc.put_text(body, "phone", value_of("phone"))
        doc.put_text(body, "note", value_of("note"))
        let (_, err) = await api.save_customer(token, subject, body)
        settle(app, err, words.t(l, "toast.saved"))
        return
    }
    if id == "staff" {
        doc.put_text(body, "name", value_of("name"))
        doc.put_text(body, "role", value_of("role"))
        put_text_if(body, "pin", value_of("pin"))
        put_text_if(body, "username", value_of("username"))
        put_text_if(body, "password", value_of("password"))
        let (_, err) = await api.save_staff(token, "", body)
        settle(app, err, words.t(l, "toast.added"))
        return
    }
    if id == "staff-pin" {
        let (_, err) = await api.set_staff_pin(token, subject, value_of("pin"))
        settle(app, err, words.t(l, "toast.pin_set"))
        return
    }
    if id == "staff-password" {
        let (_, err) = await api.set_staff_password(token, subject, value_of("password"))
        settle(app, err, words.t(l, "toast.password_set"))
        return
    }
    if id == "staff-edit" {
        doc.put_text(body, "name", value_of("name"))
        doc.put_bool(body, "active", checked("active"))
        let (_, err) = await api.save_staff(token, subject, body)
        settle(app, err, words.t(l, "toast.saved"))
        return
    }
    if id == "adjust" {
        doc.put_text(body, "product_id", subject)
        doc.put_num(body, "counted", qty_of("counted"))
        doc.put_text(body, "reason", value_of("reason"))
        doc.put_text(body, "note", value_of("note"))
        let (_, err) = await api.adjust_stock(token, body)
        settle(app, err, words.t(l, "toast.stock_was_adjusted"))
        return
    }
    if id == "receive" {
        let lines = doc.array()
        let line = doc.object()
        doc.put_text(line, "item_id", subject)
        doc.put_num(line, "qty", qty_of("qty"))
        doc.put_int(line, "unit_cost", money_of(app, "unit_cost"))
        doc.push(lines, line)
        doc.put(body, "lines", lines)
        let (_, err) = await api.receive_order(token, order_id_of(app), body)
        settle(app, err, words.t(l, "common.received"))
        return
    }
    if id == "invoice" {
        doc.put_text(body, "supplier_id", value_of("supplier_id"))
        put_text_if(body, "po_id", subject)
        doc.put_text(body, "reference", value_of("reference"))
        doc.put_int(body, "total", money_of(app, "total"))
        doc.put_int(body, "issued_at", browser.now())
        doc.put_int(body, "due_at", browser.now() + whole_of("due_days") * day())
        let (_, err) = await api.add_invoice(token, body)
        settle(app, err, words.t(l, "toast.invoice_recorded"))
        return
    }
    if id == "pay-invoice" {
        doc.put_int(body, "amount", money_of(app, "amount"))
        doc.put_text(body, "method", value_of("method"))
        let (_, err) = await api.pay_invoice(token, subject, body)
        settle(app, err, words.t(l, "payables.paid"))
        return
    }
    if id == "expense" {
        doc.put_text(body, "account_code", value_of("account_code"))
        doc.put_text(body, "category", value_of("category"))
        doc.put_text(body, "payee", value_of("payee"))
        put_text_if(body, "reference", value_of("reference"))
        doc.put_int(body, "amount", money_of(app, "amount"))
        doc.put_int(body, "tax", money_of(app, "tax"))
        doc.put_text(body, "method", value_of("method"))
        doc.put_text(body, "note", value_of("note"))
        let (_, err) = await api.add_expense(token, body)
        settle(app, err, words.t(l, "toast.recorded"))
        return
    }
    if id == "open-shift" {
        let (_, err) = await api.open_shift(token, value_of("register_id"),
            money_of(app, "opening_float"))
        settle(app, err, words.t(l, "toast.drawer_open"))
        return
    }
    if id == "close-shift" {
        let (_, err) = await api.close_shift(token, subject,
            money_of(app, "counted_total"), value_of("note"))
        settle(app, err, words.t(l, "toast.drawer_closed"))
        return
    }
    if id == "movement" {
        doc.put_text(body, "kind", value_of("kind"))
        doc.put_int(body, "amount", money_of(app, "amount"))
        doc.put_text(body, "reason", value_of("reason"))
        let (_, err) = await api.shift_movement(token, subject, body)
        settle(app, err, words.t(l, "toast.recorded"))
        return
    }
    if id == "register" {
        doc.put_text(body, "name", value_of("name"))
        doc.put_text(body, "kind", value_of("kind"))
        let (_, err) = await api.add_register(token, body)
        settle(app, err, words.t(l, "toast.lane_added"))
        return
    }
    if id == "reverse-entry" {
        doc.put_text(body, "reason", value_of("reason"))
        let (_, err) = await api.reverse_entry(token, subject, body)
        settle(app, err, words.t(l, "toast.correction_posted"))
        return
    }
    if id == "refund" {
        let lines = doc.array()
        for line in app.subject_lines {
            let line_id = doc.text(line, "id", "")
            let wanted = qty_of("line:\(line_id)")
            if wanted > 0.0 {
                let entry = doc.object()
                doc.put_text(entry, "sale_item_id", line_id)
                doc.put_num(entry, "qty", wanted)
                doc.push(lines, entry)
            }
        }
        doc.put(body, "lines", lines)
        doc.put_text(body, "reason", value_of("reason"))
        doc.put_text(body, "method", value_of("method"))
        doc.put_bool(body, "restock", checked("restock"))
        let (_, err) = await api.refund_sale(token, subject, body)
        settle(app, err, words.t(l, "common.refunded"))
        return
    }
    if id == "settings" {
        for key in [
            "shop.name", "shop.name_my", "shop.address", "shop.phone", "shop.tax_id",
            "shop.receipt_footer", "currency.code", "currency.symbol", "currency.minor_units",
            "currency.symbol_first", "tax.inclusive", "tax.default_bp", "locale.default",
            "loyalty.points_per_unit", "accounting.enabled",
        ] {
            doc.put_text(body, key, value_of(key))
        }
        let (_, err) = await api.save_settings(token, body)
        settle(app, err, words.t(l, "toast.saved"))
        return
    }
    if id == "close-period" {
        let month = value_of("month")
        let bounds = browser.month_bounds(month)
        if bounds.len() != 2 {
            desk.form_refused(app, words.t(l, "error.write_the_month_as"))
            repaint(app)
            return
        }
        doc.put_int(body, "starts_at", bounds[0])
        doc.put_int(body, "ends_at", bounds[1])
        let (_, err) = await api.close_period(token, body)
        settle(app, err, words.t(l, "toast.month_closed"))
        return
    }

    // Left in English on purpose, like "is not wired up" above: it can only
    // appear when a form was written and its submit arm was not, which nobody
    // outside this file can act on.
    desk.form_refused(app, "\(id) has no handler")
    repaint(app)
}

/// The purchase order a receive form belongs to.
fn order_id_of(app: desk.App) -> str {
    return match app.screen {
        Order(id) => id,
        Overview => "",
        Tills => "",
        Sales => "",
        Shifts => "",
        Products => "",
        Inventory => "",
        Movements => "",
        Purchasing => "",
        Suppliers => "",
        Customers => "",
        Promotions => "",
        Reports => "",
        Accounting => "",
        Expenses => "",
        Staff => "",
        Settings => "",
        Product(pid) => "",
        Sale(sid) => "",
        Shift(sid) => "",
    }
}

/// What every write does with its answer.
fn settle(app: desk.App, err: error, said: str) {
    if err != nil {
        desk.form_refused(app, err.message())
        repaint(app)
        return
    }
    desk.close_form(app)
    desk.say(app, said)
    repaint(app)
    load(app)
    load_refs(app)
}

// ---- writes with no form in front of them ----------------------------------

/// Let a closed month be posted into again.
///
/// The endpoint existed from the beginning and nothing ever called it, so a
/// month closed by mistake was a month nobody could reopen. Closing guards
/// against a backdated correction landing in a period already reported to the
/// outside world; reopening is admitting the report itself was wrong, which
/// happens often enough to need a button.
async fn do_reopen_period(app: desk.App, id: str) {
    let (_, err) = await api.reopen_period(desk.token_of(app), id)
    if err != nil {
        failed(app, err.message())
        return
    }
    desk.say(app, words.t(desk.lang_of(app), "toast.that_month_is_open_again"))
    load(app)
}

async fn do_retire_product(app: desk.App, id: str) {
    let (_, err) = await api.retire_product(desk.token_of(app), id)
    if err != nil {
        failed(app, err.message())
        return
    }
    browser.set_hash("#/products")
}

async fn do_drop_barcode(app: desk.App, barcode: str) {
    let (_, err) = await api.drop_barcode(desk.token_of(app), barcode)
    if err != nil {
        failed(app, err.message())
        return
    }
    load(app)
}

async fn do_send_order(app: desk.App, id: str) {
    let (_, err) = await api.send_order(desk.token_of(app), id)
    if err != nil {
        failed(app, err.message())
        return
    }
    load(app)
}

/// Receive everything a delivery brought, in one press.
async fn do_receive_all(app: desk.App, id: str) {
    let token = desk.token_of(app)
    let (answer, err) = await api.order(token, id)
    if err != nil {
        failed(app, err.message())
        return
    }
    let body = doc.object()
    let lines = doc.array()
    for l in doc.items(doc.field(answer, "lines")) {
        let left = doc.num_of(l, "qty", 0.0) - doc.num_of(l, "qty_received", 0.0)
        if left > 0.0 {
            let entry = doc.object()
            doc.put_text(entry, "item_id", doc.text(l, "id", ""))
            doc.put_num(entry, "qty", left)
            doc.put_int(entry, "unit_cost", doc.int_of(l, "unit_cost", 0))
            doc.push(lines, entry)
        }
    }
    doc.put(body, "lines", lines)
    let (_, rerr) = await api.receive_order(token, id, body)
    if rerr != nil {
        failed(app, rerr.message())
        return
    }
    desk.say(app, words.t(desk.lang_of(app), "common.received"))
    load(app)
}

/// Turn the worksheet into draft orders, one per supplier.
///
/// The worksheet already knows what to buy and from whom; this is the press
/// that writes it down. Grouped by supplier because that is how it will be
/// sent, and left as a draft because somebody should look at it first.
async fn do_raise_orders(app: desk.App) {
    let token = desk.token_of(app)
    let (sheet, err) = await api.worksheet(token, 28)
    if err != nil {
        failed(app, err.message())
        return
    }
    let lines = doc.items(doc.field(sheet, "lines"))
    var suppliers: [str] = []
    for l in lines {
        let supplier = doc.text(l, "supplier_id", "")
        if supplier.len() > 0 && doc.num_of(l, "suggested", 0.0) > 0.0 && !includes(suppliers, supplier) {
            suppliers.push(supplier)
        }
    }
    if suppliers.len() == 0 {
        desk.went_wrong(app,
            words.t(desk.lang_of(app), "purchasing.nothing_to_order"))
        repaint(app)
        return
    }

    var raised = 0
    for supplier in suppliers {
        let body = doc.object()
        doc.put_text(body, "supplier_id", supplier)
        doc.put_text(body, "status", "draft")
        let items = doc.array()
        for l in lines {
            if doc.text(l, "supplier_id", "") == supplier && doc.num_of(l, "suggested", 0.0) > 0.0 {
                let entry = doc.object()
                doc.put_text(entry, "product_id", doc.text(l, "id", ""))
                doc.put_num(entry, "qty", doc.num_of(l, "suggested", 0.0))
                doc.put_int(entry, "unit_cost", doc.int_of(l, "cost", 0))
                doc.push(items, entry)
            }
        }
        doc.put(body, "lines", items)
        let (_, oerr) = await api.raise_order(token, body)
        if oerr == nil {
            raised = raised + 1
        }
    }
    // No singular against plural: မြန်မာ does not mark it, and the reviewed
    // phrase already says "one per supplier", which is the fact worth saying.
    desk.say(app, words.fill_n(desk.lang_of(app), "toast.pos_raised", "\(raised)"))
    load(app)
}

async fn open_close_lane(app: desk.App, id: str) {
    let (answer, err) = await api.lanes(desk.token_of(app))
    if err != nil {
        failed(app, err.message())
        return
    }
    for lane in doc.items(doc.field(answer, "lanes")) {
        if doc.text(lane, "id", "") == id {
            let shift = doc.text(lane, "shift_id", "")
            if shift.len() == 0 {
                desk.went_wrong(app,
                    words.t(desk.lang_of(app), "tills.that_lane_has_no_open_drawer"))
                repaint(app)
                return
            }
            desk.open_form(app, forms.close_shift(shift, doc.text(lane, "name", ""),
                    doc.int_of(lane, "drawer_expected", 0),
                    desk.lang_of(app), desk.currency_of(app)))
            repaint(app)
            return
        }
    }
}

// ---- events ----------------------------------------------------------------

fn arrived(app: desk.App) {
    let wanted = desk.screen_of(browser.hash())
    desk.go(app, wanted)
    if app.session == nil {
        repaint(app)
        return
    }
    load(app)
}

fn clicked(app: desk.App, e: dom.Event) {
    let hit = dom.target(e)
    if hit == nil {
        return
    }
    let acted = browser.closest(hit, "[data-action]")
    if acted == nil {
        return
    }
    let name = dom.attribute(acted, "data-action")
    if name == nil {
        return
    }
    let id = or_else(dom.attribute(acted, "data-id"), "")
    _ = dom.prevent_default(e)
    pressed(app, name, id)
}

fn typed(app: desk.App, e: dom.Event) {
    if dom.key(e) != "Enter" {
        return
    }
    let hit = dom.target(e)
    if hit == nil {
        return
    }
    let field = or_else(dom.attribute(hit, "id"), "")
    if field == "username" || field == "password" {
        _ = dom.prevent_default(e)
        submit_sign_in(app)
    }
}

pub fn main() {
    let root = dom.find("#app")
    if root == nil {
        io.error("office: there is no #app to mount into")
        return
    }
    let (mounted, merr) = html.mount(root, [])
    if merr != nil {
        io.error("office: could not mount: \(merr.message())")
        return
    }

    let app = desk.holding(root, mounted)
    // A kept choice wins over the shop's default: the person at this desk
    // chose it, and the shop's setting is only ever the starting point. The
    // key is the office's own — a manager reading မြန်မာ at the desk should
    // not silently switch every lane in the building.
    let kept = browser.kept("kite-office.lang")
    if kept != nil {
        desk.set_lang(app, i18n.of_code(kept))
    }
    desk.go(app, desk.screen_of(browser.hash()))
    repaint(app)

    let (_, cerr) = dom.on(root, "click", |e: dom.Event| { clicked(app, e) })
    if cerr != nil {
        io.error("office: no clicks: \(cerr.message())")
    }
    let (_, kerr) = dom.on(root, "keydown", |e: dom.Event| { typed(app, e) })
    if kerr != nil {
        io.error("office: no keys: \(kerr.message())")
    }
    browser.on_window("hashchange", || { arrived(app) })

    // The lanes are the one thing on this page that is about *now*, so they are
    // re-read on a slow beat. Everything else is a window and waits to be asked.
    browser.every(30000, || { load_header(app) })

    browser.register_worker("/sw.js")

    let token = browser.kept("kite-office.token")
    if token != nil {
        resume(app, token)
    }
}
