        "product_detail.only_the_main_barcode_is_mapped" => "ပင်မဘားကုဒ်သာ ချိတ်ဆက်ထားသည်။",
        "product_detail.pack_barcodes" => "အထုပ် ဘားကုဒ်များ",
        "product_detail.reorder_at" => "· ပြန်မှာရမည့်အရေအတွက်",
        // `str` is unbounded, so a `_` arm is required rather than optional.
        // It is also the missing-key path: "" tells `t` to try English, then
        // to fall back to the key itself.
        _ => "",
    }
}

