fn burmese_ago(key: str) -> str {
    return match key {
        "ago.days" => "%d ရက်က",
        "ago.hours" => "%d နာရီက",
        "ago.just_now" => "ခုလေးတင်",
        "ago.minutes" => "%d မိနစ်က",
        // `str` is unbounded, so a `_` arm is required rather than optional.
        // It is also the missing-key path: "" tells `t` to try English, then
        // to fall back to the key itself.
        _ => "",
    }
}

fn burmese_categories(key: str) -> str {
    return match key {
        "categories.nothing_empty" => "အမျိုးအစားတိုင်းတွင် ကုန်ပစ္စည်း ရှိနေသည်",
        "categories.only_empty_can_go" => "ဘာမှမရှိသော အမျိုးအစားကိုသာ ဖယ်ရှားနိုင်သည်။ ၎င်းအတွင်းရှိ ကုန်ပစ္စည်းများကို အရင်ရွှေ့ပါ — ဘောက်ချာတွင် ကုန်ပစ္စည်းကိုသာ မှတ်တမ်းတင်ပြီး အမျိုးအစားကို မမှတ်ပါ။",
        "categories.remove_a_category" => "အမျိုးအစား ဖယ်ရှားရန်",
        "categories.add_a_category" => "အမျိုးအစား ထည့်ရန်",
