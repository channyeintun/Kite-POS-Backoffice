fn burmese_products(key: str) -> str {
    if key == "products.take_photo" { return "ဓာတ်ပုံ ရိုက်ရန်" }
    if key == "products.save_first_for_a_photo" { return "ကုန်ပစ္စည်းကို သိမ်းပြီးမှ ဓာတ်ပုံ ထည့်ပါ" }
    if key == "products.adjust_the_filters_or_add_your_first" { return "စစ်ထုတ်မှုများကို ချိန်ညှိပါ သို့မဟုတ် ပထမဆုံး ကုန်ပစ္စည်းကို ထည့်ပြီး စတင်ရောင်းချပါ။" }
    if key == "products.age_restricted" { return "အသက်ကန့်သတ်ချက်ရှိ" }
    if key == "products.any_stock" { return "လက်ကျန်အားလုံး" }
    if key == "products.appears_under_favourites_at_the_till" { return "ကောင်တာတွင် အနှစ်သက်ဆုံးအောက်၌ ပေါ်မည်" }
    if key == "products.archived_products_cannot_be_sold" { return "သိမ်းဆည်းထားသော ကုန်ပစ္စည်းများကို ရောင်း၍မရပါ" }
    if key == "products.ask_for_a_price_at_the_till" { return "ကောင်တာတွင် ဈေးနှုန်း မေးမည်" }
    if key == "products.best_margin" { return "အမြတ်နှုန်း အများဆုံး" }
    if key == "products.booked_into_the_stock_ledger" { return "ကုန်လက်ကျန် စာရင်းထဲ သွင်းမည်" }
    if key == "products.change_it_from_inventory" { return "ကုန်လက်ကျန်မှ ပြောင်းပါ" }
    if key == "products.choose_photo" { return "ဓာတ်ပုံ ရွေးရန်" }
    if key == "products.cost_price" { return "အရင်းဈေး" }
    if key == "products.create_product" { return "ကုန်ပစ္စည်း ဖန်တီးရန်" }
    if key == "products.edit_product" { return "ကုန်ပစ္စည်း ပြင်ဆင်ရန်" }
    if key == "products.flagged_as_low_at_or_below_this" { return "ဤအရေအတွက် သို့မဟုတ် အောက်တွင် နည်းသည်ဟု သတ်မှတ်မည်" }
    if key == "products.for_miscellaneous_or_weighed_items" { return "အထွေထွေ သို့မဟုတ် အလေးချိန်တိုင်း ပစ္စည်းများအတွက်" }
    if key == "products.matching" { return "ကိုက်ညီမှု “" }
    if key == "products.n_in_the_catalogue" { return "စာရင်းတွင် %d မျိုး" }
    if key == "products.name_az" { return "အမည် က–အ" }
    if key == "products.name_za" { return "အမည် အ–က" }
    if key == "products.new_product" { return "ကုန်ပစ္စည်းအသစ်" }
    if key == "products.newest" { return "အသစ်ဆုံး" }
    if key == "products.no_products_match" { return "ကိုက်ညီသော ကုန်ပစ္စည်း မရှိပါ" }
    if key == "products.opening_stock" { return "အစပိုင်း လက်ကျန်" }
    if key == "products.photo" { return "ဓာတ်ပုံ" }
    if key == "products.photo_hint" { return "JPEG, PNG သို့မဟုတ် GIF။ အရွယ်အစား ချုံ့ပြီး ပြန်သိမ်းပေးမည်၊ ဖုန်းမှ ရိုက်လိုက်သည့် ဓာတ်ပုံအတိုင်း တင်နိုင်သည်။" }
    if key == "products.pin_to_the_register_grid" { return "ငွေကောင်တာ ဇယားတွင် ပင်ထိုးရန်" }
    if key == "products.price_high" { return "ဈေးများ" }
    if key == "products.price_low" { return "ဈေးနည်း" }
    if key == "products.product_name" { return "ကုန်ပစ္စည်းအမည်" }
    if key == "products.prompts_the_cashier_to_check_id" { return "ငွေကိုင်အား မှတ်ပုံတင် စစ်ရန် သတိပေးမည်" }
    if key == "products.remove_photo" { return "ဓာတ်ပုံ ဖယ်ရှားရန်" }
    if key == "products.reorder_level" { return "ပြန်မှာရမည့် အဆင့်" }
    if key == "products.reorder_quantity" { return "ပြန်မှာရမည့် အရေအတွက်" }
    if key == "products.save_changes" { return "အပြောင်းအလဲများ သိမ်းရန်" }
    if key == "products.search_name_sku_or_barcode_k" { return "အမည်၊ SKU သို့မဟုတ် ဘားကုဒ် ရှာရန်  ⌘K" }
    if key == "products.show_archived" { return "သိမ်းဆည်းထားသည်များ ပြရန်" }
    if key == "products.shown_on_the_register_grid" { return "ငွေကောင်တာ ဇယားတွင် ပြသမည်" }
    if key == "products.shown_when_there_is_no_photo" { return "ဓာတ်ပုံ မရှိလျှင် ငွေကောင်တာ ဇယားတွင် ပြသမည်" }
    if key == "products.sku" { return "SKU" }
    if key == "products.stock" { return "လက်ကျန်" }
    if key == "products.stock_low" { return "လက်ကျန်နည်း" }
    if key == "products.suggested_on_purchase_orders" { return "ဝယ်ယူမှုအမှာစာတွင် အကြံပြုမည်" }
    if key == "products.tax_rate" { return "အခွန်နှုန်း" }
    if key == "products.the_pack_the_supplier_sells_orders_round" { return "ပေးသွင်းသူ ရောင်းသည့် အထုပ်အရွယ်။ အော်ဒါများကို အထုပ်အပြည့်သို့ အလိုအလျောက် တိုးပေးသည်။" }
    if key == "products.tile_icon" { return "အမှတ်အသား" }
    if key == "products.track_stock" { return "လက်ကျန် ခြေရာခံရန်" }
    if key == "products.turn_off_for_services_and_open_keys_that" { return "ဘယ်တော့မှ မကုန်သော ဝန်ဆောင်မှုများအတွက် ပိတ်ထားပါ" }
    if key == "products.uncategorised" { return "အမျိုးအစား မခွဲရသေး" }

    // ---- the back office's own screens ----
    //
    // Written for this build rather than lifted from Corner Mart, so they
    // sit together: the reviewed set above has been through a native
    // speaker and these have not.
    if key == "products.add_a_barcode" { return "ဘားကုဒ် ထည့်ရန်" }
    if key == "products.add_a_product" { return "ကုန်ပစ္စည်း ထည့်ရန်" }
    if key == "products.age" { return "အသက်" }
    if key == "products.barcode_lede" { return "ဘားကုဒ်သည် ကုန်ပစ္စည်း မဟုတ်ပါ — ကုန်ပစ္စည်းတစ်ခုတွင် ဘားကုဒ် အများအပြား ရှိနိုင်ပြီး တစ်ခုစီက စကန်တစ်ကြိမ်လျှင် ယူနစ် မည်မျှဟု ဆိုသည်။" }
    if key == "products.barcodes" { return "ဘားကုဒ်များ" }
    if key == "products.favourites_position" { return "အနှစ်သက်ဆုံး နေရာ" }
    if key == "products.for_sale" { return "ရောင်းရန်" }
    if key == "products.for_sale_hint" { return "သိမ်းဆည်းလိုက်သော ကုန်ပစ္စည်းသည် ကောင်တာမှ ထွက်သွားပြီး မှတ်တမ်းကို ဆက်လက် ထိန်းသိမ်းထားမည်" }
    if key == "products.matching_n" { return "“%s” နှင့် ကိုက်ညီမှု" }
    if key == "products.min_age_hint" { return "ကလေး ဝယ်နိုင်သည့် ပစ္စည်းအတွက် 0 ထားပါ။ 18 သို့မဟုတ် 21 ဆိုလျှင် အရောင်းကို ရပ်ပြီး မှတ်ပုံတင် တောင်းမည်။" }
    if key == "products.minimum_age" { return "အနည်းဆုံးအသက်" }
    if key == "products.n_in_the_catalogue_touch_a_row" { return "စာရင်းတွင် %s မျိုး — စာကြောင်းတစ်ကြောင်းကို နှိပ်ပါ" }
    if key == "products.name_my" { return "အမည် (မြန်မာ)" }
    if key == "products.name_my_hint" { return "မဖြစ်မနေ မလိုပါ။ ဤနေရာ ဗလာဖြစ်လျှင် ကောင်တာက သိမ်းထားသည့် အမည်ကို ပြမည် — ကုန်ပစ္စည်းစာရင်းကို ဘာသာပြန်ခြင်း မရှိပါ။" }
    if key == "products.on_the_shelf" { return "စင်ပေါ်တွင်" }
    if key == "products.pack_size_hint" { return "ကြက်ဥ ခြောက်လုံးပါ ဗန်းတစ်ခုသည် ခြောက်လုံးတန်ဖိုးရှိသော ဘားကုဒ်တစ်ခုဖြစ်သည်။ တစ်ကြိမ် စကန်ဖတ်လျှင် ခြောက်လုံး ဝင်ပြီး တစ်ကြိမ်သာ ဈေးတွက်မည်။" }
    if key == "products.price_at_till" { return "ကောင်တာတွင် ဈေးမေးမည်" }
    if key == "products.quick_key_hint" { return "0 ဆိုလျှင် ကောင်တာ၏ အနှစ်သက်ဆုံး ဇယားတွင် မပါဝင်ပါ။" }
    if key == "products.reorder_qty" { return "ပြန်မှာရမည့် အရေအတွက်" }
    if key == "products.retire" { return "သိမ်းဆည်းရန်" }
    if key == "products.shelf_price" { return "စင်ပေါ်ဈေးနှုန်း" }
    if key == "products.sold_by" { return "ရောင်းချသည့်ပုံစံ" }
    if key == "products.tax_bp" { return "အခွန် (basis points)" }
    if key == "products.tax_bp_hint" { return "500 သည် 5% ဖြစ်သည်။ ဆက်တင်များတွင် အခြားသတ်မှတ်ထားခြင်း မရှိလျှင် ဈေးနှုန်းများတွင် အခွန် ပါဝင်ပြီးဖြစ်သည်။" }
    if key == "products.touch_one_to_remove_it" { return "ဖယ်ရှားရန် တစ်ခုကို နှိပ်ပါ" }
    if key == "products.unit_each" { return "တစ်ခုချင်း" }
    if key == "products.unit_kilo" { return "ကီလိုဖြင့်" }
    if key == "products.unit_litre" { return "လီတာဖြင့်" }
    if key == "products.unit_pack" { return "အထုပ်ဖြင့်" }
    if key == "products.units_per_scan" { return "စကန်တစ်ကြိမ်လျှင် ယူနစ်" }
    return ""
}

fn burmese_promotions(key: str) -> str {
    if key == "promotions.a_whole_category" { return "အမျိုးအစား တစ်ခုလုံး" }
    if key == "promotions.active" { return "အသုံးပြုဆဲ" }
    if key == "promotions.applied_only_while_it_is_below_the_shelf" { return "စင်ပေါ်စျေးနှုန်းအောက် နိမ့်နေမှသာ အသုံးပြုပါမည်။" }
    if key == "promotions.applies_to" { return "သက်ရောက်သည့်အရာ" }
    if key == "promotions.buy_how_many" { return "ဘယ်နှစ်ခု ဝယ်ရမည်" }
    if key == "promotions.category" { return "အမျိုးအစား" }
    if key == "promotions.choose_a_category" { return "အမျိုးအစား တစ်ခု ရွေးပါ" }
    if key == "promotions.choose_a_product" { return "ကုန်ပစ္စည်း တစ်ခု ရွေးပါ" }
    if key == "promotions.discount" { return "လျှော့စျေး" }
    if key == "promotions.edit_promotion" { return "ပရိုမိုးရှင်း ပြင်ဆင်ရန်" }
    if key == "promotions.eg_weekend_cola" { return "ဥပမာ — စနေတနင်္ဂနွေ ကိုလာ" }
    if key == "promotions.ended" { return "ပြီးဆုံးပြီ" }
    if key == "promotions.ends" { return "ပြီးဆုံးရက်" }
    if key == "promotions.for" { return "အတွက်" }
    if key == "promotions.for_how_much" { return "စျေးနှုန်း ဘယ်လောက်" }
    if key == "promotions.from" { return "စတင်ရက်" }
    if key == "promotions.leave_blank_to_run_until_you_stop_it" { return "ရပ်တန့်သည်အထိ ဆက်လက်လုပ်ဆောင်စေရန် ကွက်လပ်ထားပါ။" }
    if key == "promotions.manage" { return "စီမံရန်" }
    if key == "promotions.multibuy" { return "အစုလိုက် ဝယ်ယူမှု" }
    if key == "promotions.n_for_x" { return "%[1]s ခု %[2]s" }
    if key == "promotions.n_percent_off" { return "%s%% လျှော့" }
    if key == "promotions.n_running_now" { return "ယခု %d ခု လုပ်ဆောင်နေသည်" }
    if key == "promotions.name" { return "အမည်" }
    if key == "promotions.new_promotion" { return "ပရိုမိုးရှင်း အသစ်" }
    if key == "promotions.no_end_date" { return "ပြီးဆုံးရက် မသတ်မှတ်ထား" }
    if key == "promotions.no_promotions_yet" { return "ပရိုမိုးရှင်း မရှိသေးပါ" }
    if key == "promotions.off" { return "လျှော့" }
    if key == "promotions.offer" { return "ကမ်းလှမ်းချက်" }
    if key == "promotions.offer_type" { return "ကမ်းလှမ်းချက် အမျိုးအစား" }
    if key == "promotions.one_offer_prices_a_line_never_two" { return "စာကြောင်းတစ်ကြောင်းကို ကမ်းလှမ်းချက် တစ်ခုတည်းက စျေးသတ်မှတ်သည် — နှစ်ခု ဘယ်တော့မှ မဟုတ်ပါ။" }
    if key == "promotions.one_product" { return "ကုန်ပစ္စည်း တစ်ခု" }
    if key == "promotions.only_breaks_a_tie_between_equal_offers" { return "တန်ဖိုးတူညီသော ကမ်းလှမ်းချက်များ ကြားတွင်သာ အဆုံးအဖြတ်ပေးသည်။" }
    if key == "promotions.pause" { return "ခေတ္တရပ်ရန်" }
    if key == "promotions.pause_stops_it_without_losing_the_dates" { return "ခေတ္တရပ်ခြင်းက ရက်စွဲများ မပျောက်ဘဲ ရပ်တန့်ပေးသည်။" }
    if key == "promotions.paused" { return "ခေတ္တရပ်ထား" }
    if key == "promotions.percentage_off" { return "ရာခိုင်နှုန်း လျှော့စျေး" }
    if key == "promotions.precedence_explained" { return "ကမ်းလှမ်းချက် တစ်ခုထက်ပို၍ သက်ရောက်နိုင်ပါက ဝယ်သူသည် အသက်သာဆုံးတစ်ခုကိုသာ ရရှိသည် — တစ်ခုတည်းသာ။ တန်ဖိုးတူပါက အမျိုးအစားထက် ကုန်ပစ္စည်းကို တိုက်ရိုက်ရည်ရွယ်သည့်ကမ်းလှမ်းချက်၊ ထို့နောက် ဦးစားပေးအမြင့်၊ ထို့နောက် ပိုသစ်သောပရိုမိုးရှင်း အနိုင်ရသည်။ ငွေကောင်တာတွင် လက်ဖြင့်ရိုက်ထည့်သော စျေးနှုန်း သို့မဟုတ် လျှော့စျေးက ထိုစာကြောင်း၏ ပရိုမိုးရှင်းကို အစားထိုးသည်။" }
    if key == "promotions.priority" { return "ဦးစားပေး" }
    if key == "promotions.priority_n" { return "ဦးစားပေး %d" }
    if key == "promotions.promotion" { return "ပရိုမိုးရှင်း" }
    if key == "promotions.promotions" { return "ပရိုမိုးရှင်းများ" }
    if key == "promotions.resume" { return "ပြန်စရန်" }
    if key == "promotions.running" { return "လုပ်ဆောင်နေဆဲ" }
    if key == "promotions.runs" { return "ကာလ" }
    if key == "promotions.sale" { return "လျှော့စျေး" }
    if key == "promotions.sale_price" { return "လျှော့စျေးနှုန်း" }
    if key == "promotions.sale_price_of" { return "လျှော့စျေးနှုန်း" }
    if key == "promotions.sale_prices_percentage_discounts_and" { return "လျှော့စျေးနှုန်းများ၊ ရာခိုင်နှုန်းလျှော့စျေးများနှင့် အစုလိုက်ဝယ်ယူမှုများကို ဤနေရာမှ အချိန်ဇယားဆွဲ၊ ရပ်တန့်၊ ပြန်လည်သုံးသပ်နိုင်သည်။" }
    if key == "promotions.save_promotion" { return "ပရိုမိုးရှင်း သိမ်းရန်" }
    if key == "promotions.scheduled" { return "အချိန်ဇယားဆွဲထား" }
    if key == "promotions.set_up_a_sale_price_a_percentage_off_or_a" { return "လျှော့စျေးနှုန်း၊ ရာခိုင်နှုန်းလျှော့စျေး သို့မဟုတ် အစုလိုက်ဝယ်ယူမှု သတ်မှတ်ပါ။ ငွေကောင်တာက အလိုအလျောက် အသုံးပြုပါမည်။" }
    if key == "promotions.starts" { return "စတင်ရက်" }
    if key == "promotions.the_shelf_price_never_changes" { return "ပရိုမိုးရှင်းက စင်ပေါ်စျေးနှုန်းကို ဘယ်တော့မှ မပြောင်းလဲပါ။ ထို့ကြောင့် ပြီးဆုံးသောအခါ ပြန်ပြင်စရာ မလိုပါ။" }
    if key == "promotions.this_is_what_the_receipt_prints" { return "ဤအမည်ကို ဘောက်ချာတွင် ရိုက်နှိပ်ပါမည်။" }
    if key == "promotions.units" { return "ခု" }
    if key == "promotions.until" { return "အထိ" }
    if key == "promotions.used_this_month" { return "ဤလ အသုံးပြုမှု" }
    if key == "promotions.via_category" { return "%s အမျိုးအစားမှတစ်ဆင့်" }

    // ---- the back office's own screens ----
    //
    // Written for this build rather than lifted from Corner Mart, so they
    // sit together: the reviewed set above has been through a native
    // speaker and these have not.
    if key == "promotions.add_an_offer" { return "ကမ်းလှမ်းချက် ထည့်ရန်" }
    if key == "promotions.amount_off" { return "ပမာဏ လျှော့" }
    if key == "promotions.amount_off_each" { return "တစ်ခုလျှင် လျှော့ပမာဏ" }
    if key == "promotions.edit_offer" { return "ကမ်းလှမ်းချက် ပြင်ဆင်ရန်" }
    if key == "promotions.everything" { return "အားလုံး" }
    if key == "promotions.fixed_price" { return "သတ်မှတ် စျေးနှုန်း" }
    if key == "promotions.fixed_price_each" { return "တစ်ခုလျှင် သတ်မှတ် စျေးနှုန်း" }
    if key == "promotions.live" { return "လုပ်ဆောင်နေဆဲ" }
    if key == "promotions.live_offers" { return "လုပ်ဆောင်နေသော ကမ်းလှမ်းချက်များ" }
    if key == "promotions.n_for" { return "%s ခု" }
    if key == "promotions.n_hint" { return "အစုလိုက် ဝယ်ယူမှုအတွက်သာ — သုံးခုဝယ် နှစ်ခုဈေး ဆိုလျှင် n = 3 ဖြစ်ပြီး တန်ဖိုးမှာ သုံးခု၏ ဈေးနှုန်း ဖြစ်သည်။" }
    if key == "promotions.name_on_the_receipt" { return "ဘောက်ချာပေါ်တွင် ပေါ်မည့် အမည်" }
    if key == "promotions.offers" { return "ကမ်းလှမ်းချက်များ" }
    if key == "promotions.offers_and_discounts" { return "ကမ်းလှမ်းချက်များနှင့် လျှော့ဈေးများ" }
    if key == "promotions.offers_do_not_stack" { return "ကမ်းလှမ်းချက်များကို ထပ်၍ မသုံးပါ။ ကောင်တာက စာကြောင်းတစ်ကြောင်းအတွက် သက်ဆိုင်သမျှကို တွက်ပြီး အသက်သာဆုံးကို ကောက်ခံသည်။" }
    if key == "promotions.running_at_this_moment" { return "ယခုအချိန်တွင် လုပ်ဆောင်နေဆဲ" }
    if key == "promotions.scope" { return "သက်ရောက်မှု အတိုင်းအတာ" }
    if key == "promotions.value_hint" { return "ရာခိုင်နှုန်း - basis points ဖြင့် ရေးပါ၊ 1000 သည် 10% ဖြစ်သည်။ ကျန်အားလုံး - %s ဖြင့် ပမာဏ။" }
    if key == "promotions.what_they_cost" { return "မည်မျှ ကုန်ကျသနည်း" }
    return ""
}

fn burmese_purchase_order(key: str) -> str {
    if key == "purchase_order.cancel_order" { return "အမှာစာ ပယ်ဖျက်ရန်" }
    if key == "purchase_order.close_short" { return "လိုနေသည်များဖြင့် ပိတ်ရန်" }
    if key == "purchase_order.deliveries" { return "ပို့ဆောင်မှုများ" }
    if key == "purchase_order.expected" { return "· မျှော်မှန်း" }
    if key == "purchase_order.fully_received" { return "အပြည့်အဝ လက်ခံပြီး" }
    if key == "purchase_order.line_total" { return "စာကြောင်း စုစုပေါင်း" }
    if key == "purchase_order.n_units_still_outstanding" { return "%s ခု ကျန်ရှိနေသေးသည်" }
    if key == "purchase_order.order_lines" { return "အမှာစာ အကြောင်းအရာများ" }
    if key == "purchase_order.order_value" { return "အမှာစာ တန်ဖိုး" }
    if key == "purchase_order.part_delivered" { return "တစ်စိတ်တစ်ပိုင်း ရောက်ရှိပြီး" }
    if key == "purchase_order.per_unit" { return "· %s လျှင်" }
    if key == "purchase_order.raised_on_by" { return "· %s တွင် %s မှ ထုတ်ပြီး" }
    if key == "purchase_order.receive_delivery" { return "ပစ္စည်း လက်ခံရန်" }
    if key == "purchase_order.received_so_far" { return "ယခုအထိ လက်ခံရရှိ" }
    if key == "purchase_order.received_value" { return "လက်ခံရရှိတန်ဖိုး" }
    if key == "purchase_order.receiving_now" { return "ယခု လက်ခံမည်" }
    if key == "purchase_order.receiving_updates_stock_and_refreshes" { return "လက်ခံလိုက်လျှင် လက်ကျန်ကို ပြင်ဆင်ပြီး ကုန်ပစ္စည်းတစ်ခုစီ၏ အရင်းဈေးကိုလည်း အသစ်ပြောင်းပေးမည်။" }

    // ---- the back office's own screens ----
    //
    // Written for this build rather than lifted from Corner Mart, so they
    // sit together: the reviewed set above has been through a native
    // speaker and these have not.
    if key == "purchase_order.arrived" { return "ရောက်ရှိ" }
    if key == "purchase_order.cost_each" { return "တစ်ခုချင်း အရင်းဈေး" }
    if key == "purchase_order.order_n" { return "အမှာစာ %s" }
    if key == "purchase_order.receive" { return "လက်ခံရန်" }
    if key == "purchase_order.receive_lede" { return "အမှာစာနှင့် မတူသော အရင်းဈေးက ကုန်ပစ္စည်းကို ပြင်ဆင်ပေးသည် — ပစ္စည်းပို့လွှာပေါ်ရှိ ဈေးနှုန်းသည် အမှန်တကယ် ပေးခဲ့သည့် ဈေးနှုန်း ဖြစ်သည်။" }
    if key == "purchase_order.still_expected" { return "ကျန်ရှိ မျှော်လင့်" }
    if key == "purchase_order.touch_a_line_to_receive" { return "တစ်စိတ်တစ်ပိုင်း လက်ခံရန် စာကြောင်းတစ်ကြောင်းကို နှိပ်ပါ" }
    return ""
}

fn burmese_purchasing(key: str) -> str {
    if key == "purchasing.anything_the_supplier_should_know" { return "ပေးသွင်းသူ သိသင့်သည့် အချက်များ" }
    if key == "purchasing.at_cost" { return "ကုန်ကျစရိတ်အလိုက်" }
    if key == "purchasing.awaiting_delivery" { return "ပို့ဆောင်မှု စောင့်ဆိုင်းဆဲ" }
    if key == "purchasing.build_an_order" { return "အမှာစာ ပြုလုပ်ရန်" }
    if key == "purchasing.est_cost" { return "ခန့်မှန်း ကုန်ကျစရိတ်" }
    if key == "purchasing.everything_they_supply_is_above_its_reorder" { return "၎င်းတို့ ပေးသွင်းသမျှသည် ပြန်မှာရမည့်အဆင့်ထက် မြင့်နေသည်။ အခြားပေးသွင်းသူကို ရွေးပါ သို့မဟုတ် ခြေရာခံလိုသော ကုန်ပစ္စည်းများတွင် ပြန်မှာရမည့်အဆင့် သတ်မှတ်ပါ။" }
    if key == "purchasing.expected_delivery" { return "ပစ္စည်းရောက်ရှိမည့် ရက်" }
    if key == "purchasing.late" { return "နောက်ကျ" }
    if key == "purchasing.n_due_today" { return "ယနေ့ ရောက်ရန် %d ခု" }
    if key == "purchasing.n_lines_outstanding" { return "စာကြောင်း %d ခု ကျန်ရှိ" }
    if key == "purchasing.n_out_of_stock" { return "%d ခု ကုန်သွားပြီ" }
    if key == "purchasing.n_products_need_reordering" { return "ကုန်ပစ္စည်း %d မျိုး ပြန်မှာရန် လိုအပ်သည်" }
    if key == "purchasing.needs_reordering" { return "ပြန်မှာရန် လိုအပ်" }
    if key == "purchasing.new_purchase_order" { return "ဝယ်ယူမှုအမှာစာ အသစ်" }
    if key == "purchasing.no_purchase_orders_yet" { return "ဝယ်ယူမှုအမှာစာ မရှိသေးပါ" }
    if key == "purchasing.nothing_to_reorder_from_this_supplier" { return "ဤပေးသွင်းသူထံမှ ပြန်မှာစရာ မရှိပါ" }
    if key == "purchasing.on_order_value" { return "မှာယူထား" }
    if key == "purchasing.open_orders" { return "ဖွင့်ထားသော အော်ဒါများ" }
    if key == "purchasing.order_qty" { return "မှာယူမည့် အရေအတွက်" }
    if key == "purchasing.overdue" { return "ရက်လွန်" }
    if key == "purchasing.purchase_orders" { return "ဝယ်ယူမှု အမှာစာများ" }
    if key == "purchasing.quantities_are_pre_filled_from_your_reorder" { return "အရေအတွက်များကို သင့်ပြန်မှာရမည့်အဆင့်များမှ ကြိုတင်ဖြည့်ထားသည်" }
    if key == "purchasing.raise_one_and_receiving_the_delivery_will" { return "အမှာစာတစ်ခု ထုတ်ပြီး ပစ္စည်းလက်ခံလိုက်လျှင် လက်ကျန်နှင့် ကုန်ကျစရိတ်ကို အလိုအလျောက် ပြင်ဆင်ပေးမည်။" }
    if key == "purchasing.raise_order" { return "အမှာစာ ထုတ်ရန်" }
    if key == "purchasing.raise_orders_with_your_wholesalers_and" { return "လက်ကားဆိုင်များထံ အမှာစာထုတ်ပြီး ရောက်ရှိလာသည့် ပစ္စည်းများကို လက်ကျန်ထဲ တိုက်ရိုက် သွင်းပါ။" }
    if key == "purchasing.raised" { return "ထုတ်ပြီး" }
    if key == "purchasing.received_30_days" { return "လက်ခံရရှိ၊ ၃၀ ရက်" }
    if key == "purchasing.suggested" { return "အကြံပြုချက်" }

    // ---- the back office's own screens ----
    //
    // Written for this build rather than lifted from Corner Mart, so they
    // sit together: the reviewed set above has been through a native
    // speaker and these have not.
    if key == "purchasing.nothing_to_order" { return "မှာစရာ မရှိပါ — စာရင်း ဗလာဖြစ်နေသည် သို့မဟုတ် ထိုကုန်ပစ္စည်းများတွင် ပေးသွင်းသူ မရှိပါ။" }
    if key == "purchasing.raise_orders_from_the_worksheet" { return "ပြန်မှာရန် စာရင်းမှ အမှာစာများ ထုတ်ရန်" }
    if key == "purchasing.receive_everything_outstanding" { return "ကျန်ရှိသမျှ လက်ခံရန်" }
    if key == "purchasing.send_to_supplier" { return "ပေးသွင်းသူထံ ပို့ရန်" }
    if key == "purchasing.sent" { return "ပို့ပြီး" }
    if key == "purchasing.to_order" { return "မှာယူရန်" }
    if key == "purchasing.touch_a_row_to_receive" { return "ပစ္စည်း လက်ခံရန် စာကြောင်းတစ်ကြောင်းကို နှိပ်ပါ" }
    return ""
}

fn burmese_receipt(key: str) -> str {
    if key == "receipt.less" { return "နုတ်" }
    if key == "receipt.note" { return "မှတ်ချက် -" }
    if key == "receipt.partially_refunded" { return "တစ်စိတ်တစ်ပိုင်း ပြန်အမ်းပြီး -" }
    if key == "receipt.refunded" { return "*** ငွေပြန်အမ်းပြီး ***" }
    if key == "receipt.saved" { return "သက်သာ" }
    if key == "receipt.served_by" { return "ဝန်ဆောင်မှုပေးသူ" }
    if key == "receipt.total" { return "စုစုပေါင်း" }
    if key == "receipt.voided" { return "*** ပယ်ဖျက်ပြီး ***" }
    if key == "receipt.you_saved" { return "ယနေ့ %s သက်သာပါသည်" }

    // ---- the back office's own screens ----
    //
    // Written for this build rather than lifted from Corner Mart, so they
    // sit together: the reviewed set above has been through a native
    // speaker and these have not.
    if key == "receipt.each" { return "တစ်ခုလျှင်" }
    if key == "receipt.you_saved_label" { return "သက်သာငွေ" }
    return ""
}

fn burmese_register(key: str) -> str {
    if key == "register.add_them_from_the_customers_page_first" { return "ဖောက်သည်စာမျက်နှာမှ အရင် ထည့်ပါ။" }
    if key == "register.add_to_basket" { return "ဈေးခြင်းထဲ ထည့်ရန်" }
    if key == "register.adjust_line" { return "စာကြောင်း ချိန်ညှိရန်" }
    if key == "register.age_check_required" { return "အသက် စစ်ဆေးရန် လိုအပ်သည်" }
    if key == "register.amount_due" { return "ပေးရန်ပမာဏ" }
    if key == "register.and_over_check_photo_identification" { return "နှင့်အထက် ဖြစ်ရမည်။ ဆက်လက်မလုပ်ဆောင်မီ ဓာတ်ပုံပါ မှတ်ပုံတင် စစ်ဆေးပါ။" }
    if key == "register.applied_across_every_line" { return "စာကြောင်းတိုင်းတွင် အသုံးပြုမည်" }
    if key == "register.apply" { return "အသုံးပြုရန်" }
    if key == "register.apply_discount" { return "လျှော့ဈေး အသုံးပြုရန်" }
    if key == "register.attach_a_customer" { return "ဖောက်သည် တွဲရန်" }
    if key == "register.basket" { return "ဈေးခြင်း" }
    if key == "register.basket_discount" { return "ဈေးခြင်း လျှော့ဈေး" }
