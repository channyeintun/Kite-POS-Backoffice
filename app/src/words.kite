fn burmese_login(key: str) -> str {
    if key == "login.pin_entry" { return "ပင်နံပါတ် ရိုက်ထည့်ရန်" }
    if key == "login.pin_sign_in_for" { return "ပင်နံပါတ်ဖြင့် ဝင်ရောက်မည့်သူ -" }
    if key == "login.sign_in" { return "ဝင်ရောက်ရန် ·" }
    if key == "login.sign_in_to_open_the_register" { return "ငွေကောင်တာဖွင့်ရန် ဝင်ရောက်ပါ" }
    if key == "login.sign_in_with_a_password" { return "စကားဝှက်ဖြင့် ဝင်ရောက်ရန်" }
    if key == "login.use_a_pin_instead" { return "ပင်နံပါတ်ဖြင့် ဝင်ရောက်ရန်" }

    // ---- the back office's own screens ----
    //
    // Written for this build rather than lifted from Corner Mart, so they
    // sit together: the reviewed set above has been through a native
    // speaker and these have not.
    if key == "login.managers_and_owners_sign_in_here" { return "မန်နေဂျာနှင့် ပိုင်ရှင်များ ဤနေရာမှ ဝင်ရောက်ပါ။ အရောင်းဝန်ထမ်းများသည် ကောင်တာတွင် ပင်နံပါတ်ဖြင့် ဝင်ပါ။" }
    if key == "login.signing_in" { return "ဝင်ရောက်နေသည်…" }
    return ""
}

