    if key == "accounting.stock_adrift_from_its_movements" { return "လှုပ်ရှားမှုနှင့် လွဲနေသော လက်ကျန်" }
    if key == "accounting.the_books_are_off" { return "စာရင်းစနစ် ပိတ်ထားသည်" }
    if key == "accounting.the_books_are_off_body" { return "ဆက်တင်များတွင် စာရင်းကိုင်စနစ်ကို ဖွင့်လိုက်လျှင် ထိုအချိန်မှစ၍ အရောင်း၊ ငွေပြန်အမ်းမှု၊ အံဆွဲရေတွက်မှု၊ ပစ္စည်းလက်ခံမှုနှင့် အသုံးစရိတ်တိုင်းကို ဒွိစာရင်းစနစ်ထဲသို့ စာရင်းသွင်းမည်။ ဤနေရာတွင် လက်ကျန်ကို သိမ်းထားခြင်း မရှိပါ — ကိန်းဂဏန်းတိုင်းကို စာရင်းသွင်းချက်များမှ ပေါင်းယူထားပြီး စာရင်းသွင်းချက်များကို ပြင်၍ မရပါ။" }
    if key == "accounting.the_ledger_stock_on_hand" { return "စာရင်း (1200 လက်ကျန်ကုန်ပစ္စည်း)" }
    if key == "accounting.the_level_against_what_moved_it" { return "ကုန်ပစ္စည်းပေါ်ရှိ အရေအတွက်နှင့် ၎င်းကို လှုပ်ရှားစေသည့်အရာများ၏ ပေါင်းလဒ် နှိုင်းယှဉ်ချက်" }
    if key == "accounting.the_shelves_at_todays_cost" { return "စင်ပေါ်ရှိ ပစ္စည်းများ၊ ယနေ့အရင်းဈေးဖြင့်" }
    if key == "accounting.total_assets" { return "စုစုပေါင်း ပိုင်ဆိုင်မှု" }
    if key == "accounting.total_equity" { return "စုစုပေါင်း အရင်းအနှီး" }
    if key == "accounting.total_liabilities" { return "စုစုပေါင်း ပေးရန်တာဝန်" }
    if key == "accounting.touch_a_closed_month_to_reopen_it" { return "ပြန်ဖွင့်ရန် ပိတ်ထားသောလကို နှိပ်ပါ" }
    if key == "accounting.touch_a_row_for_its_ledger" { return "စာရင်းချုပ် ကြည့်ရန် စာကြောင်းတစ်ကြောင်းကို နှိပ်ပါ" }
    if key == "accounting.touch_an_account_for_its_ledger" { return "စာရင်းချုပ် ကြည့်ရန် အကောင့်တစ်ခုကို နှိပ်ပါ" }
    if key == "accounting.touch_an_entry_to_correct_it" { return "ပြင်ဆင်ရန် မှတ်တမ်းတစ်ခုကို နှိပ်ပါ" }
    return ""
}

fn burmese_ago(key: str) -> str {
    if key == "ago.days" { return "%d ရက်က" }
    if key == "ago.hours" { return "%d နာရီက" }
    if key == "ago.just_now" { return "ခုလေးတင်" }
    if key == "ago.minutes" { return "%d မိနစ်က" }
    return ""
}

fn burmese_categories(key: str) -> str {
    if key == "categories.add_a_category" { return "အမျိုးအစား ထည့်ရန်" }
    if key == "categories.add_category" { return "အမျိုးအစား ထည့်ရန်" }
    if key == "categories.colour" { return "အရောင်" }
    if key == "categories.eg_frozen" { return "ဥပမာ - အအေးခန်း" }
    if key == "categories.grouping_drives_the_register_tabs_and" { return "အုပ်စုခွဲခြင်းက ငွေကောင်တာ တက်ဘ်များနှင့် အရောင်းခွဲခြမ်းစိတ်ဖြာမှု အားလုံးကို ဆုံးဖြတ်သည်။" }
    if key == "categories.icon" { return "အမှတ်အသား" }
    if key == "categories.no_categories_yet" { return "အမျိုးအစား မရှိသေးပါ" }

    // ---- the back office's own screens ----
    //
    // Written for this build rather than lifted from Corner Mart, so they
    // sit together: the reviewed set above has been through a native
    // speaker and these have not.
    if key == "categories.back_to_products" { return "ကုန်ပစ္စည်းများသို့ ပြန်သွားရန်" }
    if key == "categories.edit_category" { return "အမျိုးအစား ပြင်ဆင်ရန်" }
    if key == "categories.position" { return "အစီအစဉ်" }
    return ""
}

