    if key == "movements.from" { return "မှ" }
    if key == "movements.no_movements_in_this_window" { return "ဤကာလအတွင်း လှုပ်ရှားမှု မရှိပါ" }
    if key == "movements.reset" { return "ပြန်လည်သတ်မှတ်ရန်" }
    if key == "movements.stock_movement_ledger" { return "ကုန်လက်ကျန် လှုပ်ရှားမှု စာရင်း" }
    if key == "movements.to" { return "အထိ" }
    if key == "movements.widen_the_dates_or_clear_the_type_filter" { return "ရက်စွဲအပိုင်းအခြားကို ချဲ့ပါ သို့မဟုတ် အမျိုးအစား စစ်ထုတ်မှုကို ရှင်းပါ။" }

    // ---- the back office's own screens ----
