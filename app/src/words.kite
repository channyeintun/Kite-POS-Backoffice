    if key == "shifts.open_a_drawer_before_taking_payments_and" { return "ငွေမကောက်ခံမီ အံဆွဲကို ဖွင့်ပါ၊ အဆုံးတွင် ပြန်ရေတွက်ပါ။" }
    if key == "shifts.open_a_shift" { return "အလှည့် ဖွင့်ရန်" }
    if key == "shifts.open_a_shift_with_your_starting_float_so" { return "နေ့ကုန်တွင် ငွေစာရင်း ညှိနိုင်ရန် စတင်ငွေပမာဏဖြင့် အလှည့်တစ်ခု ဖွင့်ပါ။" }
    if key == "shifts.open_shift" { return "အလှည့် ဖွင့်ရန်" }
    if key == "shifts.opening_float" { return "အစပိုင်း ငွေပမာဏ" }
    if key == "shifts.other_tenders" { return "အခြား ပေးချေမှုများ" }
    if key == "shifts.record" { return "မှတ်တမ်းတင်ရန်" }
    if key == "shifts.recorded_against_the_open_drawer" { return "ဖွင့်ထားသော အံဆွဲအတွက် မှတ်တမ်းတင်မည်" }
    if key == "shifts.refunds_cash" { return "ငွေပြန်အမ်း (ငွေသား)" }
    if key == "shifts.running" { return "လက်ရှိ လုပ်ဆောင်နေဆဲ" }
    if key == "shifts.safe_drop" { return "မီးခံသေတ္တာသို့ ထည့်ခြင်း" }
    if key == "shifts.shift_history" { return "အလှည့် မှတ်တမ်း" }
    if key == "shifts.shifts" { return "အလှည့်များ" }
    if key == "shifts.shifts_and_cash_drawer" { return "အလှည့်များ & ငွေအံဆွဲ" }
