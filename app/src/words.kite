fn english_ago(key: str) -> str {
    if key == "ago.days" { return "%dd ago" }
    if key == "ago.hours" { return "%dh ago" }
    if key == "ago.just_now" { return "just now" }
    if key == "ago.minutes" { return "%dm ago" }
    return ""
}

