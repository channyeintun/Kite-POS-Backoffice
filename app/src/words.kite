    if key == "staff.password_lede" { return "ဤအရာ ပြောင်းလိုက်လျှင် ၎င်းတို့၏ အခြားစက်များမှ ထွက်သွားမည်။ ထိုအချက်သည်ပင် ပြောင်းရခြင်း၏ ရည်ရွယ်ချက် ဖြစ်သည်။" }
    if key == "staff.pin_at_the_lane" { return "ကောင်တာတွင် ပင်နံပါတ်" }
    if key == "staff.pin_hint" { return "အရောင်းဝန်ထမ်းများအတွက်သာ။ ဂဏန်း ၄ လုံးမှ ၈ လုံး ဖြစ်ရမည်ဖြစ်ပြီး တစ်မူထူးခြားရမည် — ကောင်တာက ဂဏန်းများသာ တောင်းပြီး အခြားဘာမျှ မတောင်းပါ။" }
    if key == "staff.role_manager_option" { return "မန်နေဂျာ — စီမံခန့်ခွဲမှု စနစ်ကို ဖွင့်သည်" }
    if key == "staff.role_sale_staff_option" { return "အရောင်းဝန်ထမ်း — ကောင်တာကို ဖွင့်သည်" }
    if key == "staff.sale_staff" { return "အရောင်းဝန်ထမ်း" }
    if key == "staff.sale_staff_body" { return "ကောင်တာတွင် ဂဏန်း ၄ လုံး ပင်နံပါတ်။ မျက်နှာပြင်အပြည့် ကောင်တာ — စာရင်း၊ လုပ်ငန်းနေရာ၊ အမိန့်ဘား၊ အခြေအနေဘား။ ဘေးတန်း မရှိ၊ အစီရင်ခံစာ မရှိ၊ ဆက်တင် မရှိ၊ ထွက်ရန် နည်းလမ်းမှာ ဝင်ရောက်မှုမှ ထွက်ခြင်းသာ ဖြစ်သည်။" }
    if key == "staff.set_a_password" { return "စကားဝှက် သတ်မှတ်ရန်" }
    if key == "staff.set_a_pin" { return "ပင်နံပါတ် သတ်မှတ်ရန်" }
    if key == "staff.sign_in_method" { return "ဝင်ရောက်နည်း" }
    if key == "staff.signs_in_to" { return "ဝင်ရောက်မည့်နေရာ" }
    if key == "staff.the_till" { return "ငွေကောင်တာ" }
    if key == "staff.username_hint" { return "မန်နေဂျာနှင့် ပိုင်ရှင်များအတွက်သာ။" }
    if key == "staff.username_password" { return "အသုံးပြုသူအမည် · စကားဝှက်" }
    return ""
}

fn burmese_suppliers(key: str) -> str {
    if key == "suppliers.add_a_supplier" { return "ပေးသွင်းသူ ထည့်ရန်" }
    if key == "suppliers.add_supplier" { return "ပေးသွင်းသူ ထည့်ရန်" }
    if key == "suppliers.add_the_wholesalers_you_buy_from_to_raise" { return "ဝယ်ယူမှုအမှာစာ ထုတ်နိုင်ရန် သင်ဝယ်သည့် လက်ကားဆိုင်များကို ထည့်ပါ။" }
    if key == "suppliers.business_name" { return "လုပ်ငန်းအမည်" }
    if key == "suppliers.new_supplier" { return "ပေးသွင်းသူ အသစ်" }
    if key == "suppliers.no_suppliers_yet" { return "ပေးသွင်းသူ မရှိသေးပါ" }
    if key == "suppliers.who_you_buy_from_and_who_the_reorder" { return "မည်သူ့ထံမှ ဝယ်သည်၊ ပြန်မှာရန် အကြံပြုချက်များကို မည်သူ့အောက်တွင် စုစည်းမည်။" }

    // ---- the back office's own screens ----
    //
    // Written for this build rather than lifted from Corner Mart, so they
    // sit together: the reviewed set above has been through a native
    // speaker and these have not.
    if key == "suppliers.edit_supplier" { return "ပေးသွင်းသူ ပြင်ဆင်ရန်" }
    if key == "suppliers.lead_days_hint" { return "ပစ္စည်း ရောက်ရန် ကြာမြင့်ချိန်။ ပြန်မှာရန် စာရင်းက ထိုကာလကို လုံလောက်အောင် ဝယ်ပေးမည်။" }
    if key == "suppliers.lead_time" { return "စောင့်ဆိုင်းရက်" }
    if key == "suppliers.lead_time_days" { return "စောင့်ဆိုင်းရက် (ရက်)" }
    if key == "suppliers.still_buying_from_them" { return "ဆက်လက် ဝယ်ယူနေဆဲ" }
    return ""
}

fn burmese_tills(key: str) -> str {
    if key == "tills.a_sale_is_in_progress" { return "အရောင်းတစ်ခု လုပ်ဆောင်နေဆဲ" }
    if key == "tills.add_a_lane" { return "ငွေကောင်တာ ထည့်ရန်" }
    if key == "tills.approved_by" { return "ခွင့်ပြုသူ" }
    if key == "tills.asked_by" { return "တောင်းဆိုသူ" }
    if key == "tills.authorisations_at_the_till" { return "ကောင်တာမှ ခွင့်ပြုချက်များ" }
    if key == "tills.authorise" { return "ခွင့်ပြုရန်" }
    if key == "tills.authorise_at_the_lane_itself" { return "ကောင်တာတွင်ပင် ခွင့်ပြုပါ — မန်နေဂျာ၏ ပင်နံပါတ်ကို ကောင်တာပေါ်တွင် ရိုက်ထည့်ရမည်။ ထိုသို့ ရိုက်ထည့်မှသာ စစ်ဆေးမှတ်တမ်းထဲ ဝင်သွားမည်။" }
    if key == "tills.close_lane" { return "လိုင်းပိတ်" }
    if key == "tills.closed_n" { return "%s တွင် ပိတ်ပြီး" }
    if key == "tills.command" { return "လုပ်ဆောင်ချက်" }
    if key == "tills.confirm" { return "အတည်ပြု" }
    if key == "tills.counter_tablet" { return "ကောင်တာ တက်ဘလက်" }
    if key == "tills.drawer" { return "ငွေအံဆွဲ" }
    if key == "tills.every_lane_running_the_pos_app" { return "POS အက်ပ်ကို လည်ပတ်နေသော ကောင်တာအားလုံး။ မန်နေဂျာတစ်ဦး ကောင်တာသို့ ဤနေရာမှ ဝင်ရောက်နိုင်သည် — ငွေကောင်တာ စာမျက်နှာကိုယ်တိုင်မူ ဤလမ်းညွှန်တွင် မပါဝင်ပါ။" }
    if key == "tills.float_n" { return "အစပိုင်းငွေ %s" }
    if key == "tills.force_close" { return "အတင်း ပိတ်ရန်" }
    if key == "tills.handheld" { return "လက်ကိုင်စက်" }
    if key == "tills.held" { return "ဆိုင်းငံ့စာရင်း" }
    if key == "tills.hold" { return "ဆိုင်းငံ့" }
    if key == "tills.lane_has_not_spoken" { return "ဤကောင်တာသည် ဆိုင်၏ စနစ်နှင့် နှစ်မိနစ်ကြာ အဆက်အသွယ် ပြတ်နေသည်။" }
    if key == "tills.line_discount" { return "စာကြောင်း လျှော့ဈေး" }
    if key == "tills.manager_pin" { return "မန်နေဂျာ PIN" }
    if key == "tills.n_expected" { return "%s ရှိသင့်သည်" }
    if key == "tills.n_lanes_open" { return "ကောင်တာ %s ခု ဖွင့်ထား" }
    if key == "tills.n_offline" { return "%s ခု အော့ဖ်လိုင်း" }
    if key == "tills.no_sale" { return "အရောင်းမရှိ" }
    if key == "tills.offline" { return "အော့ဖ်လိုင်း" }
    if key == "tills.price_check" { return "စျေးနှုန်းစစ်" }
    if key == "tills.price_override" { return "စျေးနှုန်းပြင်" }
    if key == "tills.ready_for_a_float" { return "အစပိုင်းငွေ ထည့်ရန် အသင့်ဖြစ်သည်။ အရောင်းဝန်ထမ်း ပင်နံပါတ်ဖြင့် ဖွင့်နိုင်သည်။" }
    if key == "tills.retire_device" { return "စက်ကို ဖယ်ရှားရန်" }
    if key == "tills.return" { return "ပြန်အမ်း" }
    if key == "tills.shift_detail" { return "အလှည့် အသေးစိတ်" }
    if key == "tills.signed_in_and_waiting" { return "ဝင်ရောက်ပြီး နောက်ဖောက်သည်ကို စောင့်ဆိုင်းနေသည်။" }
    if key == "tills.since_n" { return "%s မှစ၍" }
    if key == "tills.that_lane_has_no_open_drawer" { return "ထိုကောင်တာတွင် ဖွင့်ထားသော အံဆွဲ မရှိပါ။" }
    if key == "tills.the_pos_command_bar_is_built_from_this" { return "POS ၏ အမိန့်ဘားကို ဤဇယားမှ တည်ဆောက်သည်" }
    if key == "tills.till_commands_by_role" { return "ရာထူးအလိုက် ကောင်တာ လုပ်ဆောင်ချက်များ" }
    if key == "tills.unattended" { return "ကိုင်တွယ်သူ မရှိ" }
    if key == "tills.void_line" { return "စာကြောင်းဖျက်" }
    if key == "tills.void_sale" { return "ပယ်ဖျက်" }
    return ""
}

fn burmese_time(key: str) -> str {
    if key == "time.am" { return "နံနက်" }
    if key == "time.pm" { return "ညနေ" }
    return ""
}

fn burmese_title(key: str) -> str {
    if key == "title.receipt" { return "ဘောက်ချာ %s" }
    if key == "title.shift" { return "အလှည့် %s" }
    return ""
}

fn burmese_toast(key: str) -> str {
    if key == "toast.photo_saved" { return "ဓာတ်ပုံ သိမ်းပြီး" }
    if key == "toast.account_deactivated" { return "အကောင့် ပိတ်လိုက်ပါပြီ" }
    if key == "toast.account_reactivated" { return "အကောင့် ပြန်ဖွင့်လိုက်ပါပြီ" }
    if key == "toast.account_removed" { return "အကောင့် ဖယ်ရှားပြီး" }
    if key == "toast.account_saved" { return "အကောင့် သိမ်းပြီး" }
    if key == "toast.barcode_added" { return "ဘားကုဒ် ထည့်ပြီး" }
    if key == "toast.barcode_removed" { return "ဘားကုဒ် ဖယ်ရှားပြီး" }
    if key == "toast.basket_cleared" { return "ဈေးခြင်း ရှင်းပြီး" }
    if key == "toast.basket_empty_first" { return "ဈေးခြင်းထဲ တစ်ခုခု အရင်ထည့်ပါ" }
    if key == "toast.cash_movement_recorded" { return "%s %s မှတ်တမ်းတင်ပြီး" }
    if key == "toast.category_deleted" { return "အမျိုးအစား ဖျက်ပြီး" }
    if key == "toast.category_saved" { return "အမျိုးအစား သိမ်းပြီး" }
    if key == "toast.count_matched" { return "%s သည် ရေတွက်ချက်နှင့် ကိုက်ညီနှင့်ပြီးဖြစ်သည်" }
    if key == "toast.customer_removed" { return "ဖောက်သည် ဖယ်ရှားပြီး" }
    if key == "toast.customer_saved" { return "%s သိမ်းပြီး" }
    if key == "toast.discount_applied" { return "လျှော့ဈေး %s အသုံးပြုပြီး" }
    if key == "toast.expense_recorded" { return "အသုံးစရိတ် မှတ်တမ်းတင်ပြီး စာရင်းသွင်းပြီး" }
    if key == "toast.held_sale_discarded" { return "ဆိုင်းငံ့ထားသော အရောင်း ဖျက်ပြီး" }
    if key == "toast.image_dimensions" { return "ထိုဓာတ်ပုံသည် လုပ်ဆောင်ရန် အလွန်ကြီးနေသည်" }
    if key == "toast.image_failed" { return "ဓာတ်ပုံ မသိမ်းနိုင်ပါ" }
    if key == "toast.image_missing" { return "ဖိုင် မရွေးရသေးပါ" }
    if key == "toast.image_removed" { return "ဓာတ်ပုံ ဖယ်ရှားပြီး" }
    if key == "toast.image_saved" { return "%s အတွက် ဓာတ်ပုံ သိမ်းပြီး" }
    if key == "toast.image_too_big" { return "ဓာတ်ပုံသည် %d MB အောက် ဖြစ်ရမည်" }
    if key == "toast.image_unsupported" { return "ထိုဖိုင်သည် JPEG, PNG သို့မဟုတ် GIF ဓာတ်ပုံ မဟုတ်ပါ" }
    if key == "toast.invoice_cancelled" { return "ငွေတောင်းခံလွှာ ပယ်ဖျက်ပြီး စာရင်းကိုလည်း ပြန်လှန်ပြီး" }
    if key == "toast.invoice_raised" { return "%s ထုတ်ပြီး" }
    if key == "toast.no_permission" { return "ထိုအရာကို လုပ်ဆောင်ရန် သင့်တွင် ခွင့်ပြုချက် မရှိပါ။" }
    if key == "toast.no_product_matches" { return "%s နှင့် ကိုက်ညီသော ကုန်ပစ္စည်း မရှိပါ" }
    if key == "toast.paid" { return "%s ပေးချေပြီး" }
    if key == "toast.payment_method_removed" { return "ပေးချေမှုနည်းလမ်း ဖယ်ရှားပြီး" }
    if key == "toast.payment_method_saved" { return "ပေးချေမှုနည်းလမ်း သိမ်းပြီး" }
    if key == "toast.period_closed" { return "%s ကို ပိတ်လိုက်ပါပြီ — ထိုလထဲသို့ ထပ်မံ စာရင်းသွင်း၍ မရတော့ပါ" }
    if key == "toast.period_reopened" { return "ကာလကို ပြန်ဖွင့်လိုက်ပါပြီ — ၎င်းကို လှုပ်ရှားမှုမှတ်တမ်းတွင် မှတ်တမ်းတင်ထားသည်" }
    if key == "toast.po_cancelled" { return "%s ပယ်ဖျက်ပြီး" }
    if key == "toast.po_closed_short" { return "%s ကို ပိတ်လိုက်ပါပြီ — ကျန်သည်များ ပို့တော့မည် မဟုတ်ပါ" }
    if key == "toast.po_raised" { return "%s ကို %s အတွက် ထုတ်ပြီး" }
    if key == "toast.pos_raised" { return "ဝယ်ယူမှုအော်ဒါ %d ခု တင်ပြီးပါပြီ၊ ပေးသွင်းသူတစ်ဦးလျှင် တစ်ခု" }
    if key == "toast.product_archived" { return "ကုန်ပစ္စည်း သိမ်းဆည်းပြီး" }
    if key == "toast.product_pinned" { return "%s ကို ငွေကောင်တာတွင် ပင်ထိုးပြီး" }
    if key == "toast.product_restored" { return "ကုန်ပစ္စည်း ပြန်လည်ရယူပြီး" }
    if key == "toast.product_saved" { return "%s %s" }
    if key == "toast.product_unpinned" { return "%s ကို ပင်ဖြုတ်ပြီး" }
    if key == "toast.promotion_paused" { return "%s ကို ခေတ္တရပ်လိုက်ပါပြီ" }
    if key == "toast.promotion_removed" { return "%s ကို ဖယ်ရှားလိုက်ပါပြီ" }
    if key == "toast.promotion_resumed" { return "%s ပြန်လည် လုပ်ဆောင်နေပါပြီ" }
    if key == "toast.promotion_saved" { return "%s ကို သိမ်းလိုက်ပါပြီ" }
    if key == "toast.refunded" { return "%s ကို %s တွင် ပြန်အမ်းပြီး" }
    if key == "toast.sale_held" { return "အရောင်း ဆိုင်းငံ့ပြီး" }
    if key == "toast.sale_resumed" { return "အရောင်း ပြန်လည်စတင်ပြီး" }
    if key == "toast.sale_voided" { return "%s ပယ်ဖျက်ပြီး ကုန်ပစ္စည်းများ ပြန်သွင်းပြီး" }
    if key == "toast.settings_saved" { return "ဆက်တင်များ သိမ်းပြီး" }
    if key == "toast.shift_closed_balanced" { return "အလှည့် ပိတ်ပြီး၊ အံဆွဲ အတိအကျ ကိုက်ညီသည်" }
    if key == "toast.shift_closed_over" { return "အလှည့် ပိတ်ပြီး — အံဆွဲတွင် %s ပိုနေသည်" }
    if key == "toast.shift_closed_short" { return "အလှည့် ပိတ်ပြီး — အံဆွဲတွင် %s လိုနေသည်" }
    if key == "toast.shift_open" { return "အလှည့် ဖွင့်ပြီး — စတင်ငွေ %s" }
    if key == "toast.something_went_wrong" { return "တစ်ခုခု မှားယွင်းသွားသည်။ ထပ်မံ ကြိုးစားပါ။" }
    if key == "toast.staff_added" { return "%s ထည့်ပြီး" }
    if key == "toast.staff_updated" { return "%s ပြင်ဆင်ပြီး" }
    if key == "toast.starter_catalogue_loaded" { return "စတင်ကုန်ပစ္စည်းစာရင်း ထည့်သွင်းပြီး" }
    if key == "toast.stock_adjusted" { return "%s - %+g %s" }
    if key == "toast.stock_counted" { return "%s ရေတွက်ပြီး - %+g %s" }
    if key == "toast.stock_part_received" { return "%s ၏ တစ်စိတ်တစ်ပိုင်း လက်ခံရရှိပါပြီ — ကျန်သည်များ ကျန်ရှိနေသေးသည်" }
    if key == "toast.stock_received" { return "%s အတွက် ကုန်ပစ္စည်း လက်ခံပြီး" }
    if key == "toast.supplier_deleted" { return "ပေးသွင်းသူ ဖျက်ပြီး" }
    if key == "toast.supplier_saved" { return "ပေးသွင်းသူ သိမ်းပြီး" }
    if key == "toast.tax_rate_removed" { return "အခွန်နှုန်း ဖယ်ရှားပြီး" }
    if key == "toast.tax_rate_saved" { return "အခွန်နှုန်း သိမ်းပြီး" }

    // ---- the back office's own screens ----
    //
    // Written for this build rather than lifted from Corner Mart, so they
    // sit together: the reviewed set above has been through a native
    // speaker and these have not.
    if key == "toast.added" { return "ထည့်ပြီး" }
    if key == "toast.correction_posted" { return "ပြင်ဆင်ချက် စာရင်းသွင်းပြီး" }
    if key == "toast.drawer_closed" { return "အံဆွဲ ပိတ်ပြီး" }
    if key == "toast.drawer_open" { return "အံဆွဲ ဖွင့်ပြီး" }
    if key == "toast.invoice_recorded" { return "ငွေတောင်းခံလွှာ မှတ်တမ်းတင်ပြီး" }
    if key == "toast.lane_added" { return "ငွေကောင်တာ ထည့်ပြီး" }
    if key == "toast.month_closed" { return "လ ပိတ်ပြီး" }
    if key == "toast.password_set" { return "စကားဝှက် သတ်မှတ်ပြီး" }
    if key == "toast.pin_set" { return "ပင်နံပါတ် သတ်မှတ်ပြီး" }
    if key == "toast.recorded" { return "မှတ်တမ်းတင်ပြီး" }
    if key == "toast.saved" { return "သိမ်းပြီး" }
    if key == "toast.saved_n" { return "%s သိမ်းပြီး" }
    if key == "toast.stock_was_adjusted" { return "လက်ကျန် ချိန်ညှိပြီး" }
    if key == "toast.that_month_is_open_again" { return "ထိုလကို ပြန်ဖွင့်လိုက်ပါပြီ" }
    return ""
}

fn burmese_ui(key: str) -> str {
    if key == "ui.draft" { return "မူကြမ်း" }
    if key == "ui.held" { return "ဆိုင်းငံ့ထား" }
    if key == "ui.low" { return "နည်း ·" }
    if key == "ui.next" { return "နောက်သို့" }
    if key == "ui.not_tracked" { return "မခြေရာခံပါ" }
    if key == "ui.page" { return "စာမျက်နှာ" }
    if key == "ui.page_x_of_y" { return "%d / %d" }
    if key == "ui.part_received" { return "တစ်စိတ်တစ်ပိုင်း လက်ခံပြီး" }
    if key == "ui.part_refund" { return "တစ်စိတ်တစ်ပိုင်း ပြန်အမ်း" }
    if key == "ui.previous" { return "ရှေ့သို့" }
    return ""
}
