    if key == "settings.how_long_a_delivery_should_last" { return "ပို့ဆောင်မှုတစ်ခု စင်ပေါ်တွင် ခံရမည့် ကြာချိန်။" }
    if key == "settings.keeps_the_cash_drawer_reconcilable" { return "ငွေအံဆွဲ စာရင်းညှိနိုင်စေရန်" }
    if key == "settings.language" { return "ဘာသာစကား" }
    if key == "settings.last_25_events" { return "နောက်ဆုံး ဖြစ်ရပ် ၂၅ ခု" }
    if key == "settings.load_a_starter_convenience_store" { return "စတင်အသုံးပြုရန် ကုန်စုံဆိုင် ကုန်ပစ္စည်းစာရင်း ထည့်သွင်းပါ — ဘားကုဒ်၊ အမျိုးအစားနှင့် ပေးသွင်းသူများပါဝင်သော ကုန်ပစ္စည်း ၇၀ ခန့်။" }
    if key == "settings.load_starter_catalogue" { return "စတင်ကုန်ပစ္စည်းစာရင်း ထည့်ရန်" }
    if key == "settings.low_stock_alerts" { return "ကုန်နည်း သတိပေးချက်" }
    if key == "settings.loyalty_points_per" { return "သစ္စာစုမှတ် နှုန်း" }
    if key == "settings.no_activity_recorded_yet" { return "လှုပ်ရှားမှု မှတ်တမ်း မရှိသေးပါ" }
    if key == "settings.payment_methods" { return "ပေးချေမှု နည်းလမ်းများ" }
    if key == "settings.prices_include_tax" { return "ဈေးနှုန်းတွင် အခွန်ပါဝင်သည်" }
    if key == "settings.printed_under_the_shop_details" { return "ဆိုင်အချက်အလက်အောက်တွင် ပရင့်ထွက်မည်" }
    if key == "settings.rate_name" { return "နှုန်း အမည်" }
    if key == "settings.receipt_footer" { return "ဘောက်ချာ အောက်ခြေစာသား" }
    if key == "settings.receipt_header" { return "ဘောက်ချာ ခေါင်းစီးစာသား" }
    if key == "settings.receipt_prefix" { return "ဘောက်ချာ နံပါတ်ရှေ့ဆက်" }
    if key == "settings.recent_activity" { return "မကြာသေးမီ လှုပ်ရှားမှုများ" }
    if key == "settings.require_an_open_shift_to_take_payments" { return "ငွေကောက်ခံရန် အလှည့်ဖွင့်ထားရမည်" }
    if key == "settings.sales_history_window" { return "ရောင်းချမှု မှတ်တမ်း ကာလ" }
    if key == "settings.save_settings" { return "ဆက်တင်များ သိမ်းရန်" }
    if key == "settings.shop_details_tax_tenders_and_the_receipt" { return "ဆိုင်အချက်အလက်၊ အခွန်၊ ပေးချေမှုနည်းလမ်းများနှင့် ဘောက်ချာ။" }
    if key == "settings.shows_the_reorder_badge_in_the_sidebar" { return "ဘေးတန်းတွင် ပြန်မှာရန် အမှတ်အသား ပြသမည်" }
    if key == "settings.store_name" { return "ဆိုင်အမည်" }
    if key == "settings.supplier_lead_time" { return "ပေးသွင်းသူ စောင့်ဆိုင်းရက်" }
    if key == "settings.tax_rates" { return "အခွန်နှုန်းများ" }
    if key == "settings.the_language_new_browsers_start_in" { return "ဤဆိုင်ကို အသစ်ဖွင့်သည့် ဘရောက်ဇာများ စတင်မည့် ဘာသာစကား။ ကောင်တာတစ်ခုစီက အပေါ်ဘားမှ ကိုယ်ပိုင် ရွေးချယ်နိုင်သည်။" }
    if key == "settings.turn_on_where_shelf_prices_are_tax" { return "စင်ပေါ်ဈေးနှုန်းများတွင် အခွန်ပါဝင်ပြီးဖြစ်ပါက ဖွင့်ပါ။ ထိုအခါ အခွန်ကို စုစုပေါင်းအပေါ် ထပ်ပေါင်းမည့်အစား စုစုပေါင်းထဲမှ နုတ်ယူမည်။" }
    if key == "settings.who" { return "မည်သူ" }
    if key == "settings.with_sample_sales_history" { return "နမူနာ အရောင်းမှတ်တမ်းနှင့်အတူ" }
    if key == "settings.your_catalogue_is_empty" { return "သင့်ကုန်ပစ္စည်းစာရင်း ဗလာဖြစ်နေသည်။" }

    // ---- the back office's own screens ----
    //
    // Written for this build rather than lifted from Corner Mart, so they
    // sit together: the reviewed set above has been through a native
    // speaker and these have not.
    if key == "settings.accounting_on" { return "စာရင်းကိုင်စနစ် ဖွင့်ထား" }
    if key == "settings.after_the_number" { return "ဂဏန်း၏ နောက်တွင်" }
    if key == "settings.before_the_number" { return "ဂဏန်း၏ ရှေ့တွင်" }
    if key == "settings.currency" { return "ငွေကြေး" }
    if key == "settings.decimal_places" { return "ဒဿမ နေရာ" }
    if key == "settings.default_tax_bp" { return "မူလ အခွန် (basis points)" }
    if key == "settings.edit_settings" { return "ဆက်တင်များ ပြင်ဆင်ရန်" }
    if key == "settings.exclude_tax" { return "အခွန် မပါဝင်" }
    if key == "settings.include_tax" { return "အခွန် ပါဝင်" }
    if key == "settings.loyalty_points_per_unit" { return "ယူနစ်တစ်ခုလျှင် သစ္စာစုမှတ်" }
    if key == "settings.minor_units_hint" { return "ကျပ်အတွက် 0၊ ဆင့်ပါသော ငွေကြေးအတွက် 2။ ဤအရာကို ပြောင်းလိုက်လျှင် သိမ်းထားပြီးသား ပမာဏတိုင်းကို အဓိပ္ပာယ် အသစ်ပြန်ဖွင့်မည် — ဆက်တင်တစ်ခု မဟုတ်ဘဲ ဒေတာပြောင်းရွှေ့ခြင်း ဖြစ်သည်။" }
    if key == "settings.off" { return "ပိတ်ထား" }
    if key == "settings.on_post_every_sale" { return "ဖွင့်ထား — အရောင်းတိုင်းကို စာရင်းထဲ သွင်းမည်" }
    if key == "settings.setting" { return "ဆက်တင်" }
    if key == "settings.settings_lede" { return "စာရင်းကိုင်စနစ်ကို ဖွင့်လိုက်လျှင် ထိုအချိန်မှစ၍ စာရင်းသွင်းမည်။ ရိုက်ပြီးသားများကို နောက်ပြန် ဖြည့်ပေးမည် မဟုတ်ပါ။" }
    if key == "settings.shelf_prices" { return "စင်ပေါ်ဈေးနှုန်းများ" }
    if key == "settings.shop_name" { return "ဆိုင်အမည်" }
    if key == "settings.shop_name_my" { return "ဆိုင်အမည် (မြန်မာ)" }
    if key == "settings.symbol" { return "သင်္ကေတ" }
    if key == "settings.symbol_first" { return "သင်္ကေတ ရှေ့တွင်" }
    if key == "settings.symbol_goes" { return "သင်္ကေတ နေရာ" }
    if key == "settings.the_shop" { return "ဆိုင်" }
    return ""
}

