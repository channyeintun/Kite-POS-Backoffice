//! The back office's vocabulary, in English and မြန်မာ.
//!
//! Separate from `i18n.kite` on purpose: both programs are built from this one
//! directory, and whatever a program's imports can reach is compiled into its
//! WebAssembly. The till has no chart of accounts and no purchase orders, so
//! it should not carry the words for them — keeping these here is the
//! difference between a 183 KB lane bundle and a 529 KB one.
//!
//! Keys are namespaced by the screen they belong to and the lookup dispatches
//! on that prefix, so a phrase costs a handful of comparisons rather than a
//! walk through nine hundred.
//!
//! The tables are `match`, not `if` chains. That was worth measuring rather
//! than assuming: on 953 arms the compiler checks a `match` in 5 ms against
//! 44 ms for the equivalent chain, builds it in 6 ms against 29 ms, and emits
//! a smaller module. Across both vocabularies here it took the back office's
//! WebAssembly down by 10 KB. A `_` arm is required rather than optional,
//! because `str` has no finite set of values to be exhaustive over — and it is
//! the missing-key path anyway.
//!
//! The Burmese is the reviewed set from the Corner Mart build rather than a
//! fresh translation — the same shop, the same tills, the same accounting
//! vocabulary a native speaker already went through. **The command words are
//! the ones to re-check before this opens**: a cashier misreading ပယ်ဖျက်
//! (void) for ပြန်အမ်း (return) is a cash-drawer problem, not a copy problem.

use i18n

/// The group a key belongs to — everything before the first dot.
fn prefix_of(key: str) -> str {
    let parts = split(key, ".")
    if parts.len() < 2 {
        return ""
    }
    return parts[0]
}

/// One string, in the current language.
///
/// Falls back to English, then to the key itself: a screen reading a phrase
/// nobody has written shows "products.shelf_price" — ugly, findable, and
/// obviously wrong, which is what you want from a gap.
pub fn t(l: i18n.Lang, key: str) -> str {
    let found = match l {
        En => english(key),
        My => burmese(key),
    }
    if found.len() > 0 {
        return found
    }
    let fallback = english(key)
    if fallback.len() > 0 {
        return fallback
    }
    return key
}

/// A phrase with one value in it, where the phrase carries a `%s`.
pub fn fill(l: i18n.Lang, key: str, value: str) -> str {
    return replace(t(l, key), "%s", value)
}

/// A phrase with two.
pub fn fill2(l: i18n.Lang, key: str, a: str, b: str) -> str {
    return replace(replace(t(l, key), "%s", a), "%s", b)
}

/// A phrase with one **number** in it.
///
/// The reviewed set spells an integer slot `%d`, because it was lifted from a
/// Go build where that is what a whole number is called, and a string slot
/// `%s`. Both are a slot here, so "မှတ်တမ်း %d ခု" does not have to be written
/// a second time with one character changed — which would be two phrases for a
/// native speaker to keep in step instead of one.
///
/// Only for phrases with a single slot. A phrase carrying both spellings would
/// get the same value in each, which is why the two-value phrases are said as
/// two one-slot fragments rather than one two-slot sentence.
pub fn fill_n(l: i18n.Lang, key: str, value: str) -> str {
    return replace(replace(t(l, key), "%d", value), "%s", value)
}

fn english(key: str) -> str {
    return match prefix_of(key) {
        "nav" => english_nav(key),
        "accounting" => english_accounting(key),
        "ago" => english_ago(key),
        "categories" => english_categories(key),
        "common" => english_common(key),
        "customers" => english_customers(key),
        "dashboard" => english_dashboard(key),
        "duration" => english_duration(key),
        "error" => english_error(key),
        "expenses" => english_expenses(key),
        "inventory" => english_inventory(key),
        "layout" => english_layout(key),
        "login" => english_login(key),
        "month" => english_month(key),
        "movements" => english_movements(key),
        "payables" => english_payables(key),
        "product_detail" => english_product_detail(key),
        "products" => english_products(key),
        "promotions" => english_promotions(key),
        "purchase_order" => english_purchase_order(key),
        "purchasing" => english_purchasing(key),
        "receipt" => english_receipt(key),
        "register" => english_register(key),
        "replenishment" => english_replenishment(key),
        "reports" => english_reports(key),
        "sales" => english_sales(key),
        "settings" => english_settings(key),
        "shift_detail" => english_shift_detail(key),
        "shifts" => english_shifts(key),
        "staff" => english_staff(key),
        "suppliers" => english_suppliers(key),
        "tills" => english_tills(key),
        "time" => english_time(key),
        "title" => english_title(key),
        "toast" => english_toast(key),
        "ui" => english_ui(key),
        _ => "",
    }
}

fn english_nav(key: str) -> str {
    return match key {
        "nav.overview" => "Overview",
        "nav.tills" => "Tills",
        "nav.staff_access" => "Staff & access",
        "nav.shift" => "Shift",
        "nav.purchase_order" => "Purchase order",
        "nav.store" => "Store",
        // `str` is unbounded, so a `_` arm is required rather than optional.
        // It is also the missing-key path: "" tells `t` to try English, then
        // to fall back to the key itself.
        _ => "",
    }
}

