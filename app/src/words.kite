        "nav.overview" => "ခြုံငုံသုံးသပ်ချက်",
        "nav.tills" => "ငွေကောင်တာများ",
        "nav.staff_access" => "ဝန်ထမ်းနှင့် ခွင့်ပြုချက်",
        "nav.shift" => "အလှည့်",
        "nav.purchase_order" => "ဝယ်ယူမှု အမှာစာ",
        "nav.store" => "ဆိုင်",
        // `str` is unbounded, so a `_` arm is required rather than optional.
        // It is also the missing-key path: "" tells `t` to try English, then
        // to fall back to the key itself.
        _ => "",
    }
}

