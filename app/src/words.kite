fn burmese_ui(key: str) -> str {
    return match key {
        "ui.draft" => "မူကြမ်း",
        "ui.held" => "ဆိုင်းငံ့ထား",
        "ui.low" => "နည်း ·",
        "ui.next" => "နောက်သို့",
        "ui.not_tracked" => "မခြေရာခံပါ",
        "ui.page" => "စာမျက်နှာ",
        "ui.page_x_of_y" => "%d / %d",
        "ui.part_received" => "တစ်စိတ်တစ်ပိုင်း လက်ခံပြီး",
        "ui.part_refund" => "တစ်စိတ်တစ်ပိုင်း ပြန်အမ်း",
        "ui.previous" => "ရှေ့သို့",
        // `str` is unbounded, so a `_` arm is required rather than optional.
        // It is also the missing-key path: "" tells `t` to try English, then
        // to fall back to the key itself.
        _ => "",
    }
}
