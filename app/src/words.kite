fn burmese_customers(key: str) -> str {
    if key == "customers.add_a_customer" { return "ဖောက်သည် ထည့်ရန်" }
    if key == "customers.add_customer" { return "ဖောက်သည် ထည့်ရန်" }
    if key == "customers.adjust_points_and_press_enter" { return "မှတ်များ ချိန်ညှိပြီး Enter နှိပ်ပါ" }
    if key == "customers.customers" { return "ဖောက်သည်များ" }
    if key == "customers.loyalty_explainer" { return "ငွေရှင်းချိန်တွင် သစ္စာစုမှတ်များကို အလိုအလျောက် ပေးအပ်သည်။ %s၁ သုံးစွဲတိုင်း %v မှတ် ရရှိမည်။ နှုန်းကို ဆက်တင်များတွင် ပြောင်းနိုင်သည်။" }
    if key == "customers.loyalty_is_optional_add_regulars_here_and" { return "သစ္စာစုမှတ်စနစ်မှာ မဖြစ်မနေ မလိုပါ — ပုံမှန်ဖောက်သည်များကို ဤနေရာတွင် ထည့်ပြီး ကောင်တာတွင် တွဲပေးပါ။" }
    if key == "customers.members" { return "အဖွဲ့ဝင်များ" }
    if key == "customers.name_or_phone" { return "အမည် သို့မဟုတ် ဖုန်း" }
    if key == "customers.no_customers_yet" { return "ဖောက်သည် မရှိသေးပါ" }
    if key == "customers.optional_loyalty_records_attach_one_at" { return "သစ္စာစုမှတ် မှတ်တမ်းများ (မဖြစ်မနေ မလို)။ မှတ်ရရှိရန် ကောင်တာတွင် တွဲပေးပါ။" }
    if key == "customers.points" { return "မှတ်များ" }
    if key == "customers.spend" { return "သုံးစွဲမှု" }
    if key == "customers.visits" { return "လာရောက်ကြိမ်" }

    // ---- the back office's own screens ----
    //
    // Written for this build rather than lifted from Corner Mart, so they
    // sit together: the reviewed set above has been through a native
    // speaker and these have not.
    if key == "customers.a_liability_not_a_takings_figure" { return "ပေးရန်တာဝန်ဖြစ်သည်၊ ရရှိငွေ မဟုတ်ပါ" }
    if key == "customers.best_customers" { return "သုံးစွဲအများဆုံး ဖောက်သည်များ" }
    if key == "customers.by_what_they_have_spent" { return "သုံးစွဲမှုအလိုက်" }
    if key == "customers.credit" { return "ခရက်ဒစ်" }
    if key == "customers.edit_customer" { return "ဖောက်သည် ပြင်ဆင်ရန်" }
    if key == "customers.last_seen" { return "နောက်ဆုံး လာရောက်ချိန်" }
    if key == "customers.on_the_loyalty_list" { return "သစ္စာစုမှတ် စာရင်းတွင်" }
    if key == "customers.spent" { return "သုံးစွဲငွေ" }
    if key == "customers.store_credit_owed" { return "ပေးရန်ရှိ ဆိုင်ခရက်ဒစ်" }
    return ""
}

