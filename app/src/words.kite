    // speaker and these have not.
    if key == "movements.cash_movement" { return "ငွေသား လှုပ်ရှားမှု" }
    if key == "movements.change" { return "ပြောင်းလဲမှု" }
    if key == "movements.every_change_to_every_level" { return "အရေအတွက်တိုင်း၏ ပြောင်းလဲမှုတိုင်းနှင့် အကြောင်းရင်း။ `products.stock` သည် ကောင်တာက တစ်ကြိမ်တည်း ဖတ်နိုင်သော ပြေးနေသည့် ကိန်းဖြစ်သည်။ ဤစာမျက်နှာက ၎င်းကို ယုံကြည်နိုင်ရသည့် အကြောင်းရင်းဖြစ်သည်။" }
    if key == "movements.every_change_to_the_level" { return "အရေအတွက် ပြောင်းလဲမှုတိုင်းနှင့် အကြောင်းရင်း" }
    if key == "movements.reason_count" { return "ကုန်ရေတွက်ခြင်း" }
    if key == "movements.reason_sale" { return "အရောင်း" }
