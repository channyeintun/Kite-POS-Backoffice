fn burmese_duration(key: str) -> str {
    if key == "duration.hours_minutes" { return "%d နာရီ %d မိနစ်" }
    if key == "duration.minutes" { return "%d မိနစ်" }
    if key == "duration.under_a_minute" { return "တစ်မိနစ်အောက်" }
    return ""
}

fn burmese_error(key: str) -> str {
    if key == "error.back_to_dashboard" { return "ဒက်ရှ်ဘုတ်သို့ ပြန်သွားရန်" }
    if key == "error.not_allowed" { return "ခွင့်မပြုပါ" }
    if key == "error.open_the_register" { return "ငွေကောင်တာ ဖွင့်ရန်" }
    if key == "error.role_cannot_open" { return "သင့်အကောင့် (%s) သည် ထိုစာမျက်နှာကို ဖွင့်၍ မရပါ။" }
    if key == "error.something_went_wrong" { return "တစ်ခုခု မှားယွင်းသွားသည်" }
    if key == "error.unknown_language" { return "ထိုဘာသာစကား မရရှိနိုင်ပါ။" }

    // ---- the back office's own screens ----
    //
    // Written for this build rather than lifted from Corner Mart, so they
    // sit together: the reviewed set above has been through a native
    // speaker and these have not.
    if key == "error.not_a_number" { return "%s သည် ဤဆိုင် လက်ခံနိုင်သော ကိန်းဂဏန်း မဟုတ်ပါ။ ဘာမျှ ပို့လိုက်ခြင်း မရှိပါ။" }
    if key == "error.write_the_month_as" { return "လကို 2026-08 ပုံစံဖြင့် ရေးပါ" }
    return ""
}

fn burmese_expenses(key: str) -> str {
    if key == "expenses.eg_july_electricity" { return "ဥပမာ - ဇူလိုင်လ မီတာခ" }
    if key == "expenses.entries" { return "ခု ·" }
    if key == "expenses.invoice_or_receipt_number" { return "ငွေတောင်းခံလွှာ သို့မဟုတ် ဘောက်ချာနံပါတ်" }
    if key == "expenses.no_expenses_in_this_window" { return "ဤကာလအတွင်း အသုံးစရိတ် မရှိပါ" }
    if key == "expenses.offsets_tax_collected_on_sales" { return "အရောင်းမှ ကောက်ခံရသည့် အခွန်နှင့် ခုနှိမ်မည်" }
    if key == "expenses.on_account" { return "အကြွေးဖြင့်" }
    if key == "expenses.recent_expenses" { return "မကြာသေးမီ အသုံးစရိတ်များ" }
    if key == "expenses.record_an_expense" { return "အသုံးစရိတ် မှတ်တမ်းတင်ရန်" }
    if key == "expenses.record_expense" { return "အသုံးစရိတ် မှတ်တမ်းတင်ရန်" }
    if key == "expenses.record_what_the_shop_spends_and_it_lands_in" { return "ဆိုင်၏ အသုံးစရိတ်ကို မှတ်တမ်းတင်လိုက်လျှင် အမြတ်အရှုံးစာရင်းထဲ ချက်ချင်း ရောက်သွားမည်။" }
    if key == "expenses.recording_an_expense_posts_it_straight_to" { return "အသုံးစရိတ်တစ်ခု မှတ်တမ်းတင်လိုက်လျှင် စာရင်းထဲသို့ တိုက်ရိုက်ရောက်သည် — ကုန်ကျစရိတ်ကို သက်ဆိုင်ရာအကောင့်သို့၊ ငွေကို ပေးချေခဲ့သည့်နေရာမှ နုတ်သည်။" }
    if key == "expenses.rent_wages_utilities_everything_the_shop" { return "အငှားခ၊ လုပ်ခ၊ မီတာခ — ကုန်ပစ္စည်းမဟုတ်သည့် ဆိုင်၏ အသုံးစရိတ်အားလုံး။" }
    if key == "expenses.spent" { return "သုံးစွဲငွေ" }
    if key == "expenses.what_was_it_for" { return "ဘာအတွက်နည်း" }

    // ---- the back office's own screens ----
    //
    // Written for this build rather than lifted from Corner Mart, so they
    // sit together: the reviewed set above has been through a native
    // speaker and these have not.
    if key == "expenses.account_hint" { return "ဤအရာသည် အမြတ်အရှုံးစာရင်းတွင် ပေါ်မည့် စာကြောင်းဖြစ်သည်။" }
    if key == "expenses.cash_from_the_safe" { return "ငွေသား — မီးခံသေတ္တာမှ" }
    if key == "expenses.expense_lede" { return "ငွေသားကို မီးခံသေတ္တာမှ ထုတ်သည်။ ကောင်တာမှ ငွေထုတ်ပေးလျှင် ထိုအလှည့်၏ ထုတ်ငွေအဖြစ် မှတ်တမ်းတင်ရမည်၊ သို့မှသာ အံဆွဲရေတွက်မှုက သိရှိမည်။ အကြွေးဖြင့် ရွေးလျှင် မည်သည့်နေရာမှမျှ မနုတ်ဘဲ ဆိုင်၏ ပေးရန်ရှိငွေထဲ ပေါင်းထည့်မည်။" }
    if key == "expenses.n_times" { return "%s ကြိမ်" }
    if key == "expenses.on_account_the_shop_owes_it" { return "အကြွေးဖြင့် — ဆိုင်က ပေးရန်ရှိသည်" }
    if key == "expenses.paid_to" { return "ပေးချေသည့်သူ" }
    if key == "expenses.tax_hint" { return "အရောင်းမှ ကောက်ခံရသည့် အခွန်နှင့် ခုနှိမ်မည်။ ငွေတောင်းခံလွှာတွင် အခွန် မပါလျှင် 0 ထားပါ။" }
    if key == "expenses.what_for" { return "ဘာအတွက်" }
    if key == "expenses.what_kind_of_cost" { return "ကုန်ကျစရိတ် အမျိုးအစား" }
    if key == "expenses.where_it_went" { return "ဘယ်နေရာတွင် ကုန်ကျသနည်း" }
    return ""
}

