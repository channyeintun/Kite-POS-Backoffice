fn burmese(key: str) -> str {
    let group = prefix_of(key)
    if group == "nav" { return burmese_nav(key) }
    if group == "accounting" { return burmese_accounting(key) }
    if group == "ago" { return burmese_ago(key) }
    if group == "categories" { return burmese_categories(key) }
    if group == "common" { return burmese_common(key) }
    if group == "customers" { return burmese_customers(key) }
    if group == "dashboard" { return burmese_dashboard(key) }
    if group == "duration" { return burmese_duration(key) }
    if group == "error" { return burmese_error(key) }
    if group == "expenses" { return burmese_expenses(key) }
    if group == "inventory" { return burmese_inventory(key) }
    if group == "layout" { return burmese_layout(key) }
    if group == "login" { return burmese_login(key) }
    if group == "month" { return burmese_month(key) }
    if group == "movements" { return burmese_movements(key) }
    if group == "payables" { return burmese_payables(key) }
    if group == "product_detail" { return burmese_product_detail(key) }
    if group == "products" { return burmese_products(key) }
    if group == "promotions" { return burmese_promotions(key) }
    if group == "purchase_order" { return burmese_purchase_order(key) }
    if group == "purchasing" { return burmese_purchasing(key) }
    if group == "receipt" { return burmese_receipt(key) }
    if group == "register" { return burmese_register(key) }
    if group == "replenishment" { return burmese_replenishment(key) }
    if group == "reports" { return burmese_reports(key) }
    if group == "sales" { return burmese_sales(key) }
    if group == "settings" { return burmese_settings(key) }
    if group == "shift_detail" { return burmese_shift_detail(key) }
    if group == "shifts" { return burmese_shifts(key) }
    if group == "staff" { return burmese_staff(key) }
    if group == "suppliers" { return burmese_suppliers(key) }
    if group == "tills" { return burmese_tills(key) }
    if group == "time" { return burmese_time(key) }
    if group == "title" { return burmese_title(key) }
    if group == "toast" { return burmese_toast(key) }
    if group == "ui" { return burmese_ui(key) }
    return ""
}

