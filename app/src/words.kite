    if key == "shift_detail.n_shown" { return "%d ခု ပြထား" }
    if key == "shift_detail.n_transactions" { return "အရောင်း %d ခု" }
    if key == "shift_detail.no_cash_movements" { return "ငွေသား လှုပ်ရှားမှု မရှိပါ" }
    if key == "shift_detail.no_sales_in_this_shift" { return "ဤအလှည့်တွင် အရောင်း မရှိပါ" }
    if key == "shift_detail.not_counted_yet" { return "မရေတွက်ရသေးပါ" }
    if key == "shift_detail.other" { return "အခြား" }
    if key == "shift_detail.pending" { return "ဆောင်ရွက်ဆဲ" }
    if key == "shift_detail.ran" { return "· ကြာချိန်" }
    if key == "shift_detail.refunds_in_cash" { return "ငွေသားဖြင့် ပြန်အမ်းငွေ" }
    if key == "shift_detail.sales_in_this_shift" { return "ဤအလှည့်အတွင်း အရောင်းများ" }
    if key == "shift_detail.shift_report" { return "အလှည့် အစီရင်ခံစာ" }
    if key == "shift_detail.tender_breakdown" { return "ပေးချေမှုနည်းလမ်း ခွဲခြမ်းချက်" }
    if key == "shift_detail.time" { return "အချိန်" }

    // ---- the back office's own screens ----
    //
    // Written for this build rather than lifted from Corner Mart, so they
    // sit together: the reviewed set above has been through a native
    // speaker and these have not.
    if key == "shift_detail.change_given" { return "ပြန်အမ်းသော အကြွေ" }
    if key == "shift_detail.derived_never_typed" { return "တွက်ချက်ယူသည်၊ ရိုက်ထည့်ခြင်း မဟုတ်" }
    if key == "shift_detail.how_the_expected_figure_is_reached" { return "ရှိသင့်သည့် ပမာဏကို မည်သို့ ရရှိသနည်း" }
    if key == "shift_detail.how_they_paid" { return "ပေးချေမှုနည်းလမ်းများ" }
    return ""
}

