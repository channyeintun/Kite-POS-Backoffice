    if key == "register.try_part_of_the_name_the_sku_or_scan_the" { return "အမည်၏ တစ်စိတ်တစ်ပိုင်း၊ SKU ဖြင့် ရှာကြည့်ပါ သို့မဟုတ် ဘားကုဒ် စကန်ဖတ်ပါ။" }
