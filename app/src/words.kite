fn burmese_product_detail(key: str) -> str {
    if key == "product_detail.a_multi_buy_pack_often_has_its_own" { return "အထုပ်လိုက်ဝယ်သည့် ပက်ကေ့တွင် သီးသန့်ဘားကုဒ် ရှိတတ်သည်။ ဤနေရာတွင် ချိတ်ဆက်ထားလျှင် တစ်ကြိမ်စကန်ဖတ်ရုံဖြင့် အရေအတွက် မှန်ကန်စွာ ဝင်လာမည်။" }
