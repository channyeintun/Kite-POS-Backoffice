fn burmese_time(key: str) -> str {
    return match key {
        "time.am" => "နံနက်",
        "time.pm" => "ညနေ",
        // `str` is unbounded, so a `_` arm is required rather than optional.
        // It is also the missing-key path: "" tells `t` to try English, then
        // to fall back to the key itself.
        _ => "",
    }
}

fn burmese_title(key: str) -> str {
    return match key {
        "title.receipt" => "ဘောက်ချာ %s",
        "title.shift" => "အလှည့် %s",
        // `str` is unbounded, so a `_` arm is required rather than optional.
        // It is also the missing-key path: "" tells `t` to try English, then
        // to fall back to the key itself.
        _ => "",
    }
}

