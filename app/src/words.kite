    if key == "register.whole_basket_discount_f6" { return "ဈေးခြင်းတစ်ခုလုံး လျှော့ဈေး (F6)" }
    return ""
}

fn burmese_replenishment(key: str) -> str {
    if key == "replenishment.adjust_these" { return "ဤတန်ဖိုးများ ပြင်ရန်" }
    if key == "replenishment.cover" { return "ခံနိုင်ရက်" }
    if key == "replenishment.every_supplier" { return "ပေးသွင်းသူ အားလုံး" }
    if key == "replenishment.every_tracked_product" { return "စာရင်းစစ်သည့် ကုန်ပစ္စည်း အားလုံး" }
    if key == "replenishment.every_tracked_product_is_above_its_reorder" { return "စာရင်းစစ်သည့် ကုန်ပစ္စည်းတိုင်း ပြန်မှာရမည့်အဆင့်ထက် မြင့်နေပြီး ရှေ့ရက်များအတွက် လုံလောက်ပါသည်။" }
    if key == "replenishment.find_a_product" { return "ကုန်ပစ္စည်း ရှာရန်" }
    if key == "replenishment.gone" { return "ကုန်ပြီ" }
    if key == "replenishment.method_explained" { return "ပြီးခဲ့သော %[1]d ရက်အတွင်း ရောင်းချမှုက တစ်နေ့ရောင်းအားကို သတ်မှတ်သည်။ ပို့ဆောင်မှုစောင့်ရက် %[2]d ရက်နှင့် စင်ပေါ်ခံနိုင်ရက် %[3]d ရက်အတွက် လုံလောက်အောင် ဝယ်ပါ။ လက်ကျန်နှင့် မှာယူပြီးသားများကို နုတ်ပြီးဖြစ်သည်။ သင်သတ်မှတ်ထားသော ပြန်မှာရမည့်အဆင့်အောက် ဘယ်တော့မှ အကြံပြုမည် မဟုတ်ပါ။" }
    if key == "replenishment.n_days" { return "%s ရက်" }
    if key == "replenishment.n_days_cover" { return "%s ရက် ကျန်" }
    if key == "replenishment.n_lines_about_x_across_y_suppliers" { return "စာကြောင်း %[1]d ခု၊ ခန့်မှန်း %[2]s၊ ပေးသွင်းသူ %[3]d ဦး" }
    if key == "replenishment.n_more_on_the_worksheet" { return "စာရင်းတွင် နောက်ထပ် %d ခု" }
    if key == "replenishment.n_on_order" { return "မှာယူထား %s" }
    if key == "replenishment.n_without_a_supplier" { return "%d ခု ပေးသွင်းသူ မရှိ" }
    if key == "replenishment.needs_reordering" { return "ပြန်မှာရန် လိုအပ်" }
    if key == "replenishment.no_sales" { return "ရောင်းအား မရှိ" }
    if key == "replenishment.no_supplier" { return "ပေးသွင်းသူ မရှိ" }
    if key == "replenishment.nothing_needs_reordering" { return "ပြန်မှာရန် မလိုအပ်ပါ" }
    if key == "replenishment.on_order" { return "မှာယူထား" }
    if key == "replenishment.open_the_worksheet" { return "စာရင်း ဖွင့်ရန်" }
    if key == "replenishment.order" { return "မှာယူရန်" }
    if key == "replenishment.order_quantity" { return "မှာယူမည့် အရေအတွက်" }
    if key == "replenishment.per_week" { return "/ပတ်" }
    if key == "replenishment.raise_orders_by_supplier" { return "ပေးသွင်းသူအလိုက် အော်ဒါတင်ရန်" }
    if key == "replenishment.reason_below_level" { return "ပြန်မှာရမည့်အဆင့် အောက်" }
    if key == "replenishment.reason_out_of_stock" { return "ကုန်သွားပြီ" }
    if key == "replenishment.reason_runs_out" { return "ပို့ဆောင်မှု မရောက်မီ ကုန်သွားမည်" }
    if key == "replenishment.reorder_at_n" { return "ပြန်မှာရန် %s" }
    if key == "replenishment.reorder_worksheet" { return "ပြန်မှာရန် စာရင်း" }
    if key == "replenishment.replenishment" { return "ကုန်ပစ္စည်း ဖြည့်တင်းမှု" }
    if key == "replenishment.select_all" { return "စာကြောင်းအားလုံး ရွေးရန်" }
    if key == "replenishment.sells" { return "ရောင်းအား" }
    if key == "replenishment.what_to_buy_worked_out_from_stock_reorder" { return "လက်ကျန်၊ သင်သတ်မှတ်ထားသော ပြန်မှာရမည့်အဆင့်နှင့် အမှန်တကယ် ရောင်းအားတို့မှ တွက်ချက်ထားသော ဝယ်ယူရန်စာရင်း။" }
    if key == "replenishment.which_products" { return "မည်သည့် ကုန်ပစ္စည်းများ" }

    // ---- the back office's own screens ----
    //
    // Written for this build rather than lifted from Corner Mart, so they
    // sit together: the reviewed set above has been through a native
    // speaker and these have not.
    if key == "replenishment.n_lines_on_the_worksheet" { return "စာရင်းတွင် စာကြောင်း %s ခု" }
    if key == "replenishment.n_per_day" { return "%s/ရက်" }
    if key == "replenishment.what_to_buy_over_28_days" { return "လွန်ခဲ့သော ၂၈ ရက်အတွင်း အမှန်တကယ် ရောင်းရသည်များမှ တွက်ချက်ထားသော ဝယ်ယူရန်စာရင်း — တစ်နေ့ရောင်းအား၊ ပေးသွင်းသူ၏ စောင့်ဆိုင်းရက်နှင့် မှာယူပြီးသားများ။" }
    return ""
}

fn burmese_reports(key: str) -> str {
    if key == "reports.tax_collected_by_rate" { return "အခွန်နှုန်းအလိုက် ကောက်ခံမှု" }
    if key == "reports.the_only_vat_output" { return "အခွန်ကြေညာလွှာ ပြုစုရန် အခြေခံ" }
    if key == "reports.rate" { return "နှုန်း %" }
    if key == "reports.net" { return "အခွန်မပါ" }
    if key == "reports.gross" { return "အခွန်အပါ" }
    if key == "reports.dead_stock" { return "မရွေ့သော ကုန်ပစ္စည်း" }
    if key == "reports.on_the_shelf_not_selling" { return "စင်ပေါ်တွင် ရှိပြီး မရောင်းရသေး" }
    if key == "reports.days_since_sold" { return "နောက်ဆုံးရောင်းပြီး ရက်" }
    if key == "reports.never_sold" { return "မရောင်းရသေး" }
    if key == "reports.by_category" { return "အမျိုးအစားအလိုက်" }
    if key == "reports.by_payment" { return "ပေးချေမှုနည်းလမ်းအလိုက်" }
    if key == "reports.cost_value" { return "အရင်း တန်ဖိုး" }
    if key == "reports.everything_is_moving" { return "အားလုံး ရောင်းအားရှိသည်" }
    if key == "reports.everything_is_stocked" { return "အားလုံး ကုန်ပြည့်စုံသည်" }
    if key == "reports.export_csv" { return "CSV ထုတ်ယူရန်" }
    if key == "reports.gross" { return "စုစုပေါင်း" }
    if key == "reports.n_rows" { return "%d ကြောင်း" }
    if key == "reports.n_sales_n_items" { return "အရောင်း %d ခု · ပစ္စည်း %s ခု" }
    if key == "reports.n_units" { return "%s ယူနစ်" }
    if key == "reports.no_data" { return "အချက်အလက် မရှိပါ။" }
    if key == "reports.no_sales_in_this_period" { return "ဤကာလအတွင်း အရောင်း မရှိပါ" }
    if key == "reports.no_shifts_recorded" { return "အလှည့် မှတ်တမ်း မရှိပါ" }
    if key == "reports.no_taxable_sales_in_this_period" { return "ဤကာလအတွင်း အခွန်ကျသည့် အရောင်း မရှိပါ" }
    if key == "reports.no_waste_recorded" { return "အလဟဿ မှတ်တမ်း မရှိပါ" }
    if key == "reports.not_sold_in_30_days" { return "၃၀ ရက်အတွင်း မရောင်းရသေး" }
    if key == "reports.nothing_to_show_for_this_period" { return "ဤကာလအတွက် ပြစရာ မရှိပါ" }
    if key == "reports.profit" { return "အမြတ်" }
    if key == "reports.refunds" { return "ငွေပြန်အမ်းမှုများ" }
    if key == "reports.revenue_over_time" { return "အချိန်အလိုက် ဝင်ငွေ" }
    if key == "reports.share" { return "အချိုး" }
    if key == "reports.shift_reconciliation" { return "အလှည့် ငွေစာရင်းညှိခြင်း" }
    if key == "reports.stock_at_retail" { return "လက်လီဈေးဖြင့် လက်ကျန်" }
    if key == "reports.tied_up_cost" { return "ရင်းနှီးထားသော အရင်း" }
    if key == "reports.top_products" { return "အရောင်းရဆုံး ကုန်ပစ္စည်းများ" }
    if key == "reports.try_a_wider_date_range" { return "ရက်စွဲအပိုင်းအခြားကို ကျယ်အောင် ချဲ့ကြည့်ပါ။" }
    if key == "reports.waste_and_write_offs" { return "အလဟဿနှင့် ဖျက်သိမ်းမှုများ" }
    if key == "reports.write_offs_booked_from_inventory_show_up" { return "ကုန်လက်ကျန်မှ ဖျက်သိမ်းမှုများကို ဤနေရာတွင် ပြသမည်။" }
    if key == "reports.x_breakdown" { return "%s ခွဲခြမ်းချက်" }

    // ---- the back office's own screens ----
    //
    // Written for this build rather than lifted from Corner Mart, so they
    // sit together: the reviewed set above has been through a native
    // speaker and these have not.
    if key == "reports.by_cashier" { return "ငွေကိုင်အလိုက်" }
    if key == "reports.ranked_by_revenue" { return "ဝင်ငွေအလိုက် အဆင့်သတ်မှတ်ထားပြီး တစ်ခုစီ အမှန်တကယ် ရရှိသည်များနှင့်အတူ" }
    if key == "reports.shrinkage" { return "အလဟဿ ဆုံးရှုံးမှု" }
    if key == "reports.the_trading_day" { return "ရောင်းချမှု တစ်နေ့တာ" }
    if key == "reports.thirty_days_by_hour" { return "၃၀ ရက်၊ နာရီအလိုက်" }
    if key == "reports.waste_counts_and_corrections" { return "အလဟဿ၊ ရေတွက်မှုနှင့် ပြင်ဆင်မှုများ" }
    if key == "reports.worst_affected" { return "အထိခိုက်ဆုံး" }
    return ""
}

fn burmese_sales(key: str) -> str {
    if key == "sales.any_cashier" { return "ငွေကိုင် အားလုံး" }
    if key == "sales.any_status" { return "အခြေအနေ အားလုံး" }
    if key == "sales.change_the_period_or_clear_the_filters" { return "ကာလကို ပြောင်းပါ သို့မဟုတ် စစ်ထုတ်မှုများကို ရှင်းပါ။" }
    if key == "sales.choose_how_many_of_each_item_is_coming" { return "ပစ္စည်းတစ်ခုစီ ဘယ်နှစ်ခု ပြန်လာသည်ကို ရွေးပါ။ ပြန်အမ်းပြီးသား အရေအတွက်များကို ချန်လှပ်ထားသည်။" }
    if key == "sales.discounts" { return "လျှော့ဈေးများ" }
    if key == "sales.eg_wrong_item_faulty_changed_mind" { return "ဥပမာ - ပစ္စည်းမှား၊ ချွတ်ယွင်း၊ စိတ်ပြောင်း" }
    if key == "sales.item" { return "ပစ္စည်း" }
    if key == "sales.last_30_days" { return "လွန်ခဲ့သော ၃၀ ရက်" }
    if key == "sales.last_7_days" { return "လွန်ခဲ့သော ၇ ရက်" }
    if key == "sales.n_refunded" { return "%s ပြန်အမ်းပြီး" }
    if key == "sales.n_sales_avg" { return "အရောင်း %d ခု · ပျမ်းမျှ %s" }
    if key == "sales.n_transactions" { return "အရောင်း %d ခု" }
    if key == "sales.no_sales_in_this_window" { return "ဤကာလအတွင်း အရောင်း မရှိပါ" }
    if key == "sales.part_refunded" { return "တစ်စိတ်တစ်ပိုင်း ပြန်အမ်းပြီး" }
    if key == "sales.process_refund" { return "ငွေပြန်အမ်းရန်" }
    if key == "sales.put_the_items_back_into_stock" { return "ပစ္စည်းများကို လက်ကျန်ထဲ ပြန်ထည့်ရန်" }
    if key == "sales.qty" { return "အရေအတွက်" }
    if key == "sales.receipt_number_product_or_customer" { return "ဘောက်ချာနံပါတ်၊ ကုန်ပစ္စည်း သို့မဟုတ် ဖောက်သည်" }
    if key == "sales.refund" { return "ငွေပြန်အမ်း" }
    if key == "sales.refund_items" { return "ပစ္စည်း ပြန်အမ်းရန်" }
    if key == "sales.refund_qty" { return "ပြန်အမ်းမည့် အရေအတွက်" }
    if key == "sales.refund_to" { return "ပြန်အမ်းမည့် နည်းလမ်း" }
    if key == "sales.refundable" { return "ပြန်အမ်းနိုင်" }
    if key == "sales.sales" { return "အရောင်း" }
    if key == "sales.sold" { return "ရောင်းပြီး" }
    if key == "sales.taken" { return "ရရှိငွေ" }
    if key == "sales.void_sale" { return "အရောင်း ပယ်ဖျက်ရန်" }
    if key == "sales.voided" { return "ပယ်ဖျက်ပြီး -" }

    // ---- the back office's own screens ----
    //
    // Written for this build rather than lifted from Corner Mart, so they
    // sit together: the reviewed set above has been through a native
    // speaker and these have not.
    if key == "sales.avg_n" { return "ပျမ်းမျှ %s" }
    if key == "sales.n_sales_in_seven_days" { return "လွန်ခဲ့သော ၇ ရက်အတွင်း အရောင်း %s ခု" }
    if key == "sales.refund_lede" { return "စာကြောင်းတစ်ကြောင်းကို စင်ပေါ်ဈေးဖြင့် မဟုတ်ဘဲ ကောက်ခံခဲ့သည့် ဈေးဖြင့် ပြန်အမ်းသည် — ထို့ကြောင့် လျှော့ဈေး သို့မဟုတ် ပရိုမိုးရှင်း ရထားသော စာကြောင်းသည် ဖောက်သည် အမှန်တကယ် ပေးခဲ့သည့် ငွေကို ပြန်အမ်းမည်။" }
    if key == "sales.restock" { return "လက်ကျန်ထဲ ပြန်ထည့်" }
    if key == "sales.returned" { return "ပြန်အမ်းပြီး" }
    if key == "sales.returned_to_customers" { return "ဖောက်သည်များထံ ပြန်အမ်းပြီး" }
    if key == "sales.seven_days_touch_a_row" { return "လွန်ခဲ့သော ၇ ရက် — ဘောက်ချာ ကြည့်ရန် စာကြောင်းတစ်ကြောင်းကို နှိပ်ပါ" }
    if key == "sales.up_to_n" { return "%s အထိ" }
    return ""
}

fn burmese_settings(key: str) -> str {
    if key == "settings.action" { return "လုပ်ဆောင်ချက်" }
    if key == "settings.cash_drawer" { return "ငွေအံဆွဲ" }
    if key == "settings.changes_apply_immediately_across_the_app" { return "အပြောင်းအလဲများသည် အက်ပ်တစ်ခုလုံးတွင် ချက်ချင်း သက်ရောက်သည်။" }
