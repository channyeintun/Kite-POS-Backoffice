    if key == "shifts.count_and_close" { return "ရေတွက်ပြီး ပိတ်ရန်" }
    if key == "shifts.counted_float" { return "ရေတွက်ရရှိသော အစပိုင်းငွေ" }
    if key == "shifts.expected_is_derived" { return "အံဆွဲထဲ ရှိသင့်သည့် ပမာဏကို တွက်ချက်ယူသည်၊ လက်ဖြင့် ရိုက်ထည့်ခြင်း မဟုတ်ပါ။ ပိတ်လိုက်လျှင် ကွာခြားချက်ကို စာရင်းထဲ သွင်းသည်။" }
    if key == "shifts.open_a_drawer" { return "အံဆွဲ ဖွင့်ရန်" }
    if key == "shifts.operator" { return "ငွေကိုင်" }
    if key == "shifts.paid_in" { return "သွင်းငွေ" }
    if key == "shifts.paid_in_option" { return "သွင်းငွေ — ဘဏ်မှ အကြွေ" }
    if key == "shifts.paid_out_and_safe_drops" { return "ထုတ်ငွေနှင့် မီးခံသေတ္တာသို့ ထည့်ငွေ" }
    if key == "shifts.paid_out_option" { return "ထုတ်ငွေ — မှန်သန့်စင်သူ" }
    if key == "shifts.safe_drop_option" { return "မီးခံသေတ္တာသို့ ထည့်ခြင်း — ငွေကို မီးခံသေတ္တာသို့ ရွှေ့သည်" }
    if key == "shifts.the_books_expect" { return "စာရင်းအရ ရှိသင့်သည်" }
    return ""
}

