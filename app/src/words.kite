    if key == "settings.days_of_cover_to_buy" { return "ဝယ်မည့် ခံနိုင်ရက်" }
    if key == "settings.days_of_sales_used_to_work_out_how_fast" { return "ရောင်းအားနှုန်း တွက်ချက်ရန် သုံးမည့် ရောင်းချမှုရက်များ။" }
    if key == "settings.default" { return "မူလ" }
    if key == "settings.default_minimum_age" { return "မူလ အသက်ကန့်သတ်ချက်" }
