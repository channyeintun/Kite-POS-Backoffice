fn burmese_replenishment(key: str) -> str {
    return match key {
        "replenishment.adjust_these" => "ဤတန်ဖိုးများ ပြင်ရန်",
        "replenishment.cover" => "ခံနိုင်ရက်",
        "replenishment.every_supplier" => "ပေးသွင်းသူ အားလုံး",
        "replenishment.every_tracked_product" => "စာရင်းစစ်သည့် ကုန်ပစ္စည်း အားလုံး",
        "replenishment.every_tracked_product_is_above_its_reorder" => "စာရင်းစစ်သည့် ကုန်ပစ္စည်းတိုင်း ပြန်မှာရမည့်အဆင့်ထက် မြင့်နေပြီး ရှေ့ရက်များအတွက် လုံလောက်ပါသည်။",
        "replenishment.find_a_product" => "ကုန်ပစ္စည်း ရှာရန်",
        "replenishment.gone" => "ကုန်ပြီ",
        "replenishment.method_explained" => "ပြီးခဲ့သော %[1]d ရက်အတွင်း ရောင်းချမှုက တစ်နေ့ရောင်းအားကို သတ်မှတ်သည်။ ပို့ဆောင်မှုစောင့်ရက် %[2]d ရက်နှင့် စင်ပေါ်ခံနိုင်ရက် %[3]d ရက်အတွက် လုံလောက်အောင် ဝယ်ပါ။ လက်ကျန်နှင့် မှာယူပြီးသားများကို နုတ်ပြီးဖြစ်သည်။ သင်သတ်မှတ်ထားသော ပြန်မှာရမည့်အဆင့်အောက် ဘယ်တော့မှ အကြံပြုမည် မဟုတ်ပါ။",
        "replenishment.n_days" => "%s ရက်",
        "replenishment.n_days_cover" => "%s ရက် ကျန်",
        "replenishment.n_lines_about_x_across_y_suppliers" => "စာကြောင်း %[1]d ခု၊ ခန့်မှန်း %[2]s၊ ပေးသွင်းသူ %[3]d ဦး",
        "replenishment.n_more_on_the_worksheet" => "စာရင်းတွင် နောက်ထပ် %d ခု",
        "replenishment.n_on_order" => "မှာယူထား %s",
        "replenishment.n_without_a_supplier" => "%d ခု ပေးသွင်းသူ မရှိ",
        "replenishment.needs_reordering" => "ပြန်မှာရန် လိုအပ်",
        "replenishment.no_sales" => "ရောင်းအား မရှိ",
        "replenishment.no_supplier" => "ပေးသွင်းသူ မရှိ",
        "replenishment.nothing_needs_reordering" => "ပြန်မှာရန် မလိုအပ်ပါ",
        "replenishment.on_order" => "မှာယူထား",
        "replenishment.open_the_worksheet" => "စာရင်း ဖွင့်ရန်",
        "replenishment.order" => "မှာယူရန်",
        "replenishment.order_quantity" => "မှာယူမည့် အရေအတွက်",
        "replenishment.per_week" => "/ပတ်",
        "replenishment.raise_orders_by_supplier" => "ပေးသွင်းသူအလိုက် အော်ဒါတင်ရန်",
        "replenishment.reason_below_level" => "ပြန်မှာရမည့်အဆင့် အောက်",
        "replenishment.reason_out_of_stock" => "ကုန်သွားပြီ",
        "replenishment.reason_runs_out" => "ပို့ဆောင်မှု မရောက်မီ ကုန်သွားမည်",
        "replenishment.reorder_at_n" => "ပြန်မှာရန် %s",
        "replenishment.reorder_worksheet" => "ပြန်မှာရန် စာရင်း",
        "replenishment.replenishment" => "ကုန်ပစ္စည်း ဖြည့်တင်းမှု",
        "replenishment.select_all" => "စာကြောင်းအားလုံး ရွေးရန်",
        "replenishment.sells" => "ရောင်းအား",
        "replenishment.what_to_buy_worked_out_from_stock_reorder" => "လက်ကျန်၊ သင်သတ်မှတ်ထားသော ပြန်မှာရမည့်အဆင့်နှင့် အမှန်တကယ် ရောင်းအားတို့မှ တွက်ချက်ထားသော ဝယ်ယူရန်စာရင်း။",
        "replenishment.which_products" => "မည်သည့် ကုန်ပစ္စည်းများ",

        // ---- the back office's own screens ----
        //
        // Written for this build rather than lifted from Corner Mart, so they
        // sit together: the reviewed set above has been through a native
        // speaker and these have not.
        "replenishment.n_lines_on_the_worksheet" => "စာရင်းတွင် စာကြောင်း %s ခု",
        "replenishment.n_per_day" => "%s/ရက်",
        "replenishment.what_to_buy_over_28_days" => "လွန်ခဲ့သော ၂၈ ရက်အတွင်း အမှန်တကယ် ရောင်းရသည်များမှ တွက်ချက်ထားသော ဝယ်ယူရန်စာရင်း — တစ်နေ့ရောင်းအား၊ ပေးသွင်းသူ၏ စောင့်ဆိုင်းရက်နှင့် မှာယူပြီးသားများ။",
        _ => "",
    }
}

