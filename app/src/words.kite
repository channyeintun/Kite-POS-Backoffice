    if key == "product_detail.n_on_order" { return "မှာယူထားသည် %s" }
    if key == "product_detail.no_movements_yet" { return "လှုပ်ရှားမှု မရှိသေးပါ" }
    if key == "product_detail.no_supplier" { return "ပေးသွင်းသူ မရှိ" }
