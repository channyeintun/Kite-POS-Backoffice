    if key == "inventory.search_products" { return "ကုန်ပစ္စည်း ရှာရန်" }
    if key == "inventory.set_to_counted" { return "ရေတွက်ရရှိသည့်အတိုင်း သတ်မှတ်ရန်" }
    if key == "inventory.show_only_these" { return "ဤအရာများသာ ပြရန်" }
    if key == "inventory.stock_value" { return "လက်ကျန် တန်ဖိုး" }
    if key == "inventory.the_difference_is_written_to_the_ledger" { return "ကွာခြားချက်ကို ကုန်ရေတွက်မှုအဖြစ် စာရင်းထဲ ရေးသွင်းမည်။" }
    if key == "inventory.try_clearing_the_filters" { return "စစ်ထုတ်မှုများကို ရှင်းကြည့်ပါ။" }
    if key == "inventory.units_across_skus" { return "SKU %d မျိုးတွင် %s ယူနစ်" }
