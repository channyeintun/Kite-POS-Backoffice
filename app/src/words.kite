    if key == "shifts.count_the_float_you_are_starting_with" { return "စတင်မည့် ငွေပမာဏကို ရေတွက်ပါ" }
    if key == "shifts.counted_cash_in_the_drawer" { return "အံဆွဲထဲ ရေတွက်ရရှိသော ငွေသား" }
    if key == "shifts.n_sales" { return "အရောင်း %d ခု" }
