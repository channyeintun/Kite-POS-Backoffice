//! Every screen, as a function from one API answer to `[desk.Block]`.
//!
//! Split out of `office.kite` because that file is the wiring — mount, listen,
//! dispatch — and this is the reading. Nothing here starts a request: each
//! function is handed the values it needs and returns what the view knows how
//! to draw.
//!
//! **Values, not documents.** Every parameter below is a [`model`] type, so a
//! cell is `p.name` rather than `doc.text(p, "name", "")` — which means a
//! misremembered key is a compile error here rather than a blank column in a
//! shop. Where the shape allows a null, [`model`] already decided what it reads
//! as, against the schema; nothing on this side guesses.
//!
//! The one exception is [`settings`], which is a key→value map of setting names
//! rather than a record — see `api.settings`.
//!
//! Sixteen screens and four drill-downs, and the whole vocabulary is five
//! shapes: stat cards, a ranked list with meters, a table, lane cards, and the
//! detail header. That is what keeps this a long file rather than a hard one.

use desk
use doc
use browser
use i18n
use model
use money
use words

// ---- small helpers ---------------------------------------------------------

/// A dash where there is nothing to show.
///
/// The nullable columns arrive here as the empty string — see [`model`] — and a
/// table cell that is simply blank reads as a column that failed to draw rather
/// than as a fact about the row.
fn or_dash(value: str) -> str {
    if value.len() == 0 {
        return "—"
    }
    return value
}

pub fn row(key: str, cells: [str], tone: str) -> desk.Row {
    return desk.Row{ key: key, cells: cells, tone: tone, action: "", id: "" }
}

pub fn touchable(key: str, cells: [str], tone: str, what: str, id: str) -> desk.Row {
    return desk.Row{ key: key, cells: cells, tone: tone, action: what, id: id }
}

pub fn table(heading: str, note: str, columns: [str], rows: [desk.Row]) -> desk.Block {
    return desk.Block.Grid(table: desk.Table{
            heading: heading, note: note, columns: columns, rows: rows })
}

/// Meter widths against the biggest in the set.
///
/// Two parallel lists rather than a list of rows and the names of two fields to
/// read off it: the four screens that draw meters draw them from four different
/// types, and a key pair was how one function pretended otherwise.
pub fn meters(names: [str], values: [int], sub: [str], c: money.Currency) -> [desk.Meter] {
    var largest = 0
    for value in values {
        largest = max(largest, value)
    }
    var out: [desk.Meter] = []
    for (i, name) in enumerate(names) {
        let value = or_else(values.get(i), 0)
        out.push(desk.Meter{
                key: "m\(i)",
                rank: "\(i + 1)",
                name: name,
                value: money.show(value, c),
                sub: or_else(sub.get(i), ""),
                width: desk.width_of(value, largest),
            })
    }
    return out
}

/// One line of a receipt's foot: a label on the left, the amount on the right.
///
/// Padded by counting characters rather than written with a run of spaces,
/// because the မြန်မာ word for a subtotal is not eight letters long and a
/// hard-coded gap put the amounts in a different place in each language.
fn foot_line(label: str, amount: str) -> str {
    return label + pad_start(amount, max(32 - label.len(), 1), " ")
}

fn when(epoch: int) -> str {
    if epoch <= 0 {
        return "—"
    }
    return "\(browser.day_of(epoch)) \(browser.clock_of(epoch))"
}

// ---- codes, said in words ---------------------------------------------------
//
// The database stores machine words — `part_received`, `safe_drop`, `n_for_x` —
// and this file used to print them with the underscores swapped for spaces. That
// reads as English to nobody and as မြန်မာ to nobody at all, so every code a
// screen shows goes through one of these. An unknown code falls back to the code
// itself for the same reason a missing key does: findable, and obviously wrong.

/// The window a books sheet is showing.
///
/// `desk.window_label` answers this in English only. The books' notes are the
/// one place a window is read as prose rather than pressed as a chip, so it is
/// said here in the reader's own language.
fn window_of(l: i18n.Lang, name: str) -> str {
    return match name {
        "today" => words.t(l, "common.today"),
        "7" => words.t(l, "common.7_days"),
        "month" => words.t(l, "common.this_month"),
        "all" => words.t(l, "common.all_time"),
        _ => words.t(l, "common.30_days"),
    }
}

/// What a movement of stock was for — `stock_movements.reason`.
fn stock_reason_of(l: i18n.Lang, code: str) -> str {
    return match code {
        "sale" => words.t(l, "movements.reason_sale"),
        "refund" => words.t(l, "sales.refund"),
        "receive" => words.t(l, "inventory.delivery_received"),
        "adjust" => words.t(l, "inventory.manual_correction"),
        "waste" => words.t(l, "movements.reason_waste"),
        "count" => words.t(l, "movements.reason_count"),
        "open" => words.t(l, "products.opening_stock"),
        _ => code,
    }
}

/// Whether a lane is being worked, shut, or has gone quiet.
fn lane_state_of(l: i18n.Lang, code: str) -> str {
    return match code {
        "open" => words.t(l, "common.open_state"),
        "closed" => words.t(l, "common.closed"),
        "offline" => words.t(l, "tills.offline"),
        _ => code,
    }
}

/// What moved the cash in a drawer — `cash_movements.kind`.
fn drawer_kind_of(l: i18n.Lang, code: str) -> str {
    return match code {
        "paid_in" => words.t(l, "shift_detail.cash_paid_in"),
        "paid_out" => words.t(l, "shift_detail.cash_paid_out"),
        "safe_drop" => words.t(l, "shifts.safe_drop"),
        _ => code,
    }
}

/// How money changed hands — a tender, a refund or an expense.
fn method_of(l: i18n.Lang, code: str) -> str {
    return match code {
        "cash" => words.t(l, "common.cash"),
        "card" => words.t(l, "common.card"),
        "wallet" => words.t(l, "common.wallet"),
        "store_credit" => words.t(l, "common.store_credit"),
        "on_account" => words.t(l, "expenses.on_account"),
        _ => code,
    }
}

/// What a person may open and how far they may reach — `users.role`.
fn role_of(l: i18n.Lang, code: str) -> str {
    return match code {
        "sale_staff" => words.t(l, "staff.sale_staff"),
        "manager" => words.t(l, "staff.manager"),
        "owner" => words.t(l, "staff.owner"),
        _ => code,
    }
}

/// Where a purchase order has got to — `purchase_orders.status`.
fn order_status_of(l: i18n.Lang, code: str) -> str {
    return match code {
        "draft" => words.t(l, "ui.draft"),
        "sent" => words.t(l, "purchasing.sent"),
        "part_received" => words.t(l, "ui.part_received"),
        "received" => words.t(l, "common.received"),
        "cancelled" => words.t(l, "common.cancelled"),
        _ => code,
    }
}

/// Where a sale has got to — `sales.status`.
fn sale_status_of(l: i18n.Lang, code: str) -> str {
    return match code {
        "held" => words.t(l, "ui.held"),
        "completed" => words.t(l, "common.completed"),
        "voided" => words.t(l, "common.voided"),
        _ => code,
    }
}

/// The shape of an offer — `promotions.kind`.
fn offer_kind_of(l: i18n.Lang, code: str) -> str {
    return match code {
        "percent_off" => words.t(l, "promotions.percentage_off"),
        "amount_off" => words.t(l, "promotions.amount_off"),
        "fixed_price" => words.t(l, "promotions.fixed_price"),
        "n_for_x" => words.t(l, "promotions.multibuy"),
        _ => code,
    }
}

/// How wide an offer casts — `promotions.scope`.
fn offer_scope_of(l: i18n.Lang, code: str) -> str {
    return match code {
        "product" => words.t(l, "common.product"),
        "category" => words.t(l, "common.category"),
        "all" => words.t(l, "common.all"),
        _ => code,
    }
}

/// Which side of the sheet an account sits on — `accounts.kind`.
fn account_kind_of(l: i18n.Lang, code: str) -> str {
    return match code {
        "asset" => words.t(l, "accounting.asset"),
        "liability" => words.t(l, "accounting.liability"),
        "equity" => words.t(l, "accounting.equity"),
        "income" => words.t(l, "accounting.income"),
        "expense" => words.t(l, "accounting.expense"),
        _ => code,
    }
}

/// Which way an account normally moves — `accounts.normal`.
fn normal_of(l: i18n.Lang, code: str) -> str {
    return match code {
        "debit" => words.t(l, "accounting.debit"),
        "credit" => words.t(l, "accounting.credit"),
        _ => code,
    }
}

/// What caused a journal entry — `journal_entries.ref_type`.
/// What caused a journal entry — `journal_entries.ref_type`. Public because
/// the journal's filter dialog offers the same list it renders.
pub fn caused_by_of(l: i18n.Lang, code: str) -> str {
    return match code {
        "sale" => words.t(l, "movements.reason_sale"),
        "refund" => words.t(l, "sales.refund"),
        "shift" => words.t(l, "nav.shift"),
        "cash_movement" => words.t(l, "movements.cash_movement"),
        "expense" => words.t(l, "accounting.expense"),
        "stock_movement" => words.t(l, "movements.stock_movement"),
        "supplier_invoice" => words.t(l, "payables.supplier_invoice"),
        "supplier_payment" => words.t(l, "payables.supplier_payment"),
        "purchase_order" => words.t(l, "nav.purchase_order"),
        "opening" => words.t(l, "accounting.opening_balance"),
        _ => code,
    }
}

/// What somebody had to be authorised for — `audit_log.action`.
fn authorised_of(l: i18n.Lang, code: str) -> str {
    return match code {
        "void_sale" => words.t(l, "tills.void_sale"),
        "no_sale" => words.t(l, "tills.no_sale"),
        "return" => words.t(l, "tills.return"),
        "refund" => words.t(l, "sales.refund"),
        "price_override" => words.t(l, "tills.price_override"),
        "line_discount" => words.t(l, "tills.line_discount"),
        "basket_discount" => words.t(l, "register.basket_discount"),
        "close_lane" => words.t(l, "tills.close_lane"),
        "expense" => words.t(l, "accounting.expense"),
        "close_period" => words.t(l, "accounting.close_the_month"),
        "reverse_entry" => words.t(l, "accounting.entry_reversed"),
        _ => code,
    }
}

/// One of the till's own command words.
///
/// The API sends the command bar's English labels rather than its ids, so this
/// maps back to the id and then into the shop's vocabulary. A label nobody
/// recognises comes through untouched, which is what a new command would do
/// until somebody adds a line here.
fn command_of(l: i18n.Lang, label: str) -> str {
    return match label {
        "Hold" => words.t(l, "tills.hold"),
        "Held" => words.t(l, "tills.held"),
        "Customer" => words.t(l, "common.customer"),
        "Price check" => words.t(l, "tills.price_check"),
        "Void line" => words.t(l, "tills.void_line"),
        "Discount" => words.t(l, "common.discount"),
        "Price override" => words.t(l, "tills.price_override"),
        "Return" => words.t(l, "tills.return"),
        "Void sale" => words.t(l, "tills.void_sale"),
        "No sale" => words.t(l, "tills.no_sale"),
        "Close lane" => words.t(l, "tills.close_lane"),
        _ => label,
    }
}

/// Whether a role may reach a command, and what it costs them.
fn allowance_of(l: i18n.Lang, code: str) -> str {
    return match code {
        "yes" => words.t(l, "accounting.yes"),
        "pin" => words.t(l, "tills.manager_pin"),
        "no" => words.t(l, "error.not_allowed"),
        _ => code,
    }
}

/// What the till asks for before it runs a command.
fn confirm_of(l: i18n.Lang, code: str) -> str {
    return match code {
        "none" => words.t(l, "common.none"),
        "explicit" => words.t(l, "tills.confirm"),
        "reason" => words.t(l, "common.reason"),
        _ => code,
    }
}

// ---- the day ---------------------------------------------------------------

pub fn overview(answer: model.Overview, l: i18n.Lang, c: money.Currency,
    who: str) -> [desk.Block] {
    let sales = answer.today.sales
    let takings = answer.today.takings
    let net = answer.margin.net
    let cost = answer.margin.cost
    let low = answer.stock.low

    let stats: [desk.Stat] = [
        desk.Stat{ label: words.t(l, "dashboard.takings_today"), value: money.show(takings, c),
            meta: "\(words.fill_n(l, "shifts.n_sales", "\(sales)")) · \(words.fill(l, "sales.avg_n", money.show(if sales > 0 { takings / sales } else { 0 }, c)))",
            tone: "ok" },
        desk.Stat{ label: words.t(l, "dashboard.margin_today"), value: money.show(net - cost, c),
            meta: words.fill(l, "dashboard.on_n_net_of_tax", money.show(net, c)), tone: "info" },
        desk.Stat{ label: words.t(l, "common.stock_at_cost"),
            value: money.show(answer.stock.at_cost, c),
            meta: "\(words.fill_n(l, "dashboard.n_skus", "\(answer.stock.skus)")) · \(words.fill_n(l, "dashboard.n_low", "\(low)"))",
            tone: if low > 0 { "warn" } else { "" } },
        desk.Stat{ label: words.t(l, "dashboard.given_away"),
            value: money.show(answer.today.given_away, c),
            meta: words.t(l, "promotions.offers_and_discounts"), tone: "" },
    ]

    var seller_names: [str] = []
    var seller_revenue: [int] = []
    var sold: [str] = []
    for s in answer.top_sellers {
        seller_names.push(s.name)
        seller_revenue.push(s.revenue)
        sold.push(words.fill(l, "dashboard.n_sold", money.quantity(s.sold)))
    }

    var lanes: [desk.Row] = []
    for lane in answer.lanes {
        let open = lane.shift_id.len() > 0
        lanes.push(row(lane.id, [
                    lane.name,
                    if open { words.t(l, "common.open_state") } else { words.t(l, "common.closed") },
                    or_dash(lane.operator),
                    "\(lane.sales)",
                    money.show(lane.takings, c),
                ], if open { "ok" } else { "" }))
    }

    var days: [desk.Row] = []
    for d in answer.fortnight {
        days.push(row(d.day, [
                    d.day,
                    "\(d.sales)",
                    money.show(d.takings, c),
                ], ""))
    }

    return [
        desk.Block.Stats(items: stats),
        desk.Block.Meters(heading: words.t(l, "dashboard.top_sellers"),
            note: words.t(l, "dashboard.last_7_days"),
            rows: meters(seller_names, seller_revenue, sold, c)),
        table(words.t(l, "dashboard.lanes_today"), "",
            [words.t(l, "common.lane"), words.t(l, "common.state"),
                words.t(l, "shifts.operator"), words.t(l, "common.sales"),
                words.t(l, "common.takings")], lanes),
        table(words.t(l, "dashboard.the_fortnight"), "",
            [words.t(l, "common.day"), words.t(l, "common.sales"),
                words.t(l, "common.takings")], days),
    ]
}

pub fn tills(lanes: [model.Lane], audit: [model.AuditEntry], l: i18n.Lang,
    c: money.Currency) -> [desk.Block] {
    var cards: [desk.LaneCard] = []
    for lane in lanes {
        let state = lane.state
        let operator = lane.operator
        let open = state != "closed"
        let items = lane.active_items
        var note = words.t(l, "tills.ready_for_a_float")
        if open && items > 0 {
            note = "\(words.t(l, "tills.a_sale_is_in_progress")) · \(words.fill(l, "register.n_items", "\(items)")) · \(money.show(lane.active_total, c))"
        } else if open {
            note = words.t(l, "tills.signed_in_and_waiting")
        }
        if state == "offline" {
            note = words.t(l, "tills.lane_has_not_spoken")
        }
        cards.push(desk.LaneCard{
                id: lane.id,
                name: lane.name,
                state: lane_state_of(l, state),
                tone: match state {
                    "open" => "ok",
                    "offline" => "warn",
                    _ => "",
                },
                initials: if operator.len() > 0 { desk.initials_of(operator) } else { "—" },
                operator: if operator.len() > 0 { operator } else { words.t(l, "tills.unattended") },
                since: if open {
                    "\(words.fill(l, "tills.since_n", browser.clock_of(lane.opened_at))) · \(words.fill(l, "tills.float_n", money.show(lane.opening_float, c)))"
                } else {
                    words.fill(l, "tills.closed_n", browser.day_of(lane.last_close))
                },
                drawer: money.show(lane.drawer_expected, c),
                sales: "\(lane.sales)",
                held: "\(lane.held)",
                note: note,
                close_label: if open {
                    words.t(l, "tills.force_close")
                } else {
                    words.t(l, "tills.retire_device")
                },
                closeable: true,
            })
    }

    var auths: [desk.Row] = []
    for a in audit {
        let what = a.action
        auths.push(row(a.id, [
                    browser.clock_of(a.at),
                    or_dash(a.register_name),
                    authorised_of(l, what),
                    or_dash(a.asked_by_name),
                    or_dash(a.approved_by_name),
                    money.show(a.amount, c),
                ], if what == "void_sale" || what == "no_sale" { "stop" } else { "" }))
    }

    return [
        desk.Block.Note(heading: words.t(l, "nav.tills"),
            body: words.t(l, "tills.every_lane_running_the_pos_app")),
        desk.Block.Buttons(items: [
                desk.action(words.t(l, "tills.add_a_lane"), "form-register", "", "soft"),
            ]),
        desk.Block.Lanes(cards: cards),
        table(words.t(l, "tills.authorisations_at_the_till"), words.t(l, "common.today"),
            [words.t(l, "shift_detail.time"), words.t(l, "common.lane"),
                words.t(l, "tills.command"), words.t(l, "tills.asked_by"),
                words.t(l, "tills.approved_by"), words.t(l, "common.amount")], auths),
    ]
}

// ---- selling ---------------------------------------------------------------

pub fn sales(answer: [model.SaleRow], l: i18n.Lang, c: money.Currency) -> [desk.Block] {
    var rows: [desk.Row] = []
    var total = 0
    var refunds = 0
    for s in answer {
        let refunded = s.refunded
        total = total + s.total
        refunds = refunds + refunded
        rows.push(touchable(s.id, [
                    "#\(s.number)",
                    when(s.completed_at),
                    s.cashier,
                    or_dash(s.customer),
                    "\(s.items)",
                    money.show(s.total, c),
                    if refunded > 0 { "−\(money.show(refunded, c))" } else { "" },
                ], if refunded > 0 { "warn" } else { "" }, "open-sale", s.id))
    }
    return [
        desk.Block.Stats(items: [
                desk.Stat{ label: words.t(l, "common.takings"), value: money.show(total, c),
                    meta: words.fill(l, "sales.n_sales_in_seven_days", "\(rows.len())"), tone: "ok" },
                desk.Stat{ label: words.t(l, "common.refunded"), value: money.show(refunds, c),
                    meta: words.t(l, "sales.returned_to_customers"),
                    tone: if refunds > 0 { "warn" } else { "" } },
            ]),
        table(words.t(l, "common.sales"), words.t(l, "sales.seven_days_touch_a_row"),
            ["#", words.t(l, "common.when"), words.t(l, "common.cashier"),
                words.t(l, "common.customer"), words.t(l, "register.items"),
                words.t(l, "common.total"), words.t(l, "common.refunded")], rows),
    ]
}

pub fn sale_detail(answer: model.SalePage, l: i18n.Lang, c: money.Currency) -> [desk.Block] {
    let sale = answer.sale
    let shop = answer.shop
    let lines = answer.lines
    let number = sale.number

    var facts: [desk.Fact] = [
        desk.Fact{ label: words.t(l, "common.total"), value: money.show(sale.total, c), tone: "" },
        desk.Fact{ label: words.t(l, "common.when"), value: when(sale.completed_at), tone: "" },
        desk.Fact{ label: words.t(l, "common.cashier"), value: sale.cashier, tone: "" },
        desk.Fact{ label: words.t(l, "common.lane"),
            value: or_dash(sale.register_name), tone: "" },
    ]
    let customer = sale.customer
    if customer.len() > 0 {
        facts.push(desk.Fact{ label: words.t(l, "common.customer"), value: customer, tone: "" })
    }

    var refunded = 0
    for r in answer.refunds {
        refunded = refunded + r.total
    }
    if refunded > 0 {
        facts.push(desk.Fact{ label: words.t(l, "common.refunded"),
                value: money.show(refunded, c), tone: "warn" })
    }

    var actions: [desk.Action] = [
        desk.action(words.t(l, "common.print"), "print", "", "soft"),
    ]
    if sale.status == "completed" {
        actions.push(desk.action(words.t(l, "sales.refund"), "form-refund", sale.id, "danger"))
    }

    // The receipt, exactly as it prints. Every line is a snapshot from the sale
    // itself — the name, the price and the offer as they were on the day — so a
    // reprint years later reads as it did at the counter.
    var head: [str] = [shop.name]
    let address = shop.address
    if address.len() > 0 {
        head.push(address)
    }
    let phone = shop.phone
    if phone.len() > 0 {
        head.push(phone)
    }
    let tax_id = shop.tax_id
    if tax_id.len() > 0 {
        head.push("\(words.t(l, "common.tax_id")) \(tax_id)")
    }
    head.push("\(words.fill(l, "title.receipt", "#\(number)")) · \(when(sale.completed_at))")
    head.push("\(words.t(l, "receipt.served_by")) \(sale.cashier)")

    var body: [str] = []
    var table_rows: [desk.Row] = []
    // `line` rather than `l`, which is the language everywhere else in this file.
    for line in lines {
        let name = line.name
        let q = line.qty
        body.push("\(money.quantity(q)) × \(name)")
        body.push("      \(money.show(line.unit_price, c)) \(words.t(l, "receipt.each"))      \(money.show(line.total, c))")
        let promo = line.promo_name
        if promo.len() > 0 {
            body.push("      \(promo) − \(money.show(line.promo_saved, c))")
        }
        let back = line.refunded_qty
        table_rows.push(row(line.id, [
                    name,
                    line.sku,
                    money.quantity(q),
                    money.show(line.unit_price, c),
                    promo,
                    money.show(line.total, c),
                    if back > 0.0 { money.quantity(back) } else { "" },
                ], if back > 0.0 { "warn" } else { "" }))
    }

    var foot: [str] = [
        foot_line(words.t(l, "common.subtotal"), money.show(sale.subtotal, c)),
    ]
    let saved = sale.promo_saved + sale.discount
    if saved > 0 {
        foot.push(foot_line(words.t(l, "receipt.you_saved_label"), money.show(saved, c)))
    }
    if sale.tax > 0 {
        foot.push(foot_line(words.t(l, "common.tax_included"), money.show(sale.tax, c)))
    }
    foot.push(foot_line(words.t(l, "receipt.total"), money.show(sale.total, c)))
    for p in answer.payments {
        foot.push(foot_line(method_of(l, p.method), money.show(p.amount, c)))
        if p.change > 0 {
            foot.push(foot_line(words.t(l, "common.change"), money.show(p.change, c)))
        }
    }
    let footer = shop.footer
    if footer.len() > 0 {
        foot.push("")
        foot.push(footer)
    }

    var refunds: [desk.Row] = []
    for r in answer.refunds {
        refunds.push(row(r.id, [
                    when(r.created_at),
                    r.by_name,
                    r.reason,
                    method_of(l, r.method),
                    money.show(r.total, c),
                ], "warn"))
    }

    var out: [desk.Block] = [
        desk.Block.Detail(title: words.fill(l, "title.receipt", "#\(number)"),
            subtitle: sale_status_of(l, sale.status),
            facts: facts, actions: actions),
        table(words.t(l, "common.lines"), "",
            [words.t(l, "common.product"), words.t(l, "products.sku"),
                words.t(l, "sales.qty"), words.t(l, "common.each"),
                words.t(l, "promotions.offer"), words.t(l, "common.total"),
                words.t(l, "sales.returned")], table_rows),
        desk.Block.Receipt(lines: body, head: head, foot: foot),
    ]
    if refunds.len() > 0 {
        out.push(table(words.t(l, "reports.refunds"), "",
                [words.t(l, "common.when"), words.t(l, "movements.by"),
                    words.t(l, "common.reason"), words.t(l, "sales.refund_to"),
                    words.t(l, "common.amount")], refunds))
    }
    return out
}

// ---- drawers ---------------------------------------------------------------

pub fn shifts(answer: [model.ShiftRow], l: i18n.Lang, c: money.Currency) -> [desk.Block] {
    var rows: [desk.Row] = []
    var variance = 0
    var open_id = ""
    for s in answer {
        let closed = s.closed_at
        let v = s.variance
        variance = variance + v
        if closed == 0 {
            open_id = s.id
        }
        rows.push(touchable(s.id, [
                    s.register_name,
                    s.user_name,
                    when(s.opened_at),
                    if closed > 0 { browser.clock_of(closed) } else { words.t(l, "common.open_state") },
                    "\(s.sales)",
                    money.show(s.takings, c),
                    if closed > 0 { money.show(v, c) } else { "" },
                ], if closed == 0 { "ok" } else if v != 0 { "warn" } else { "" },
                "open-shift-detail", s.id))
    }
    var buttons: [desk.Action] = [
        desk.action(words.t(l, "shifts.open_a_drawer"), "form-open-shift", "", "filled"),
    ]
    if open_id.len() > 0 {
        buttons.push(desk.action(words.t(l, "shifts.count_and_close"),
                "form-close-shift", open_id, "soft"))
    }
    return [
        desk.Block.Stats(items: [
                desk.Stat{ label: words.t(l, "common.over_short"), value: money.show(variance, c),
                    meta: words.t(l, "shifts.across_every_closed_drawer"),
                    tone: if variance == 0 { "ok" } else { "warn" } },
            ]),
        desk.Block.Buttons(items: buttons),
        table(words.t(l, "shifts.shifts"), words.t(l, "shifts.expected_is_derived"),
            [words.t(l, "common.lane"), words.t(l, "shifts.operator"),
                words.t(l, "common.opened"), words.t(l, "common.closed"),
                words.t(l, "common.sales"), words.t(l, "common.takings"),
                words.t(l, "common.over_short")], rows),
    ]
}

pub fn shift_detail(answer: model.ShiftPage, l: i18n.Lang, c: money.Currency) -> [desk.Block] {
    let shift = answer.shift
    let drawer = answer.drawer
    let closed = shift.closed_at
    let id = shift.id

    let facts: [desk.Fact] = [
        desk.Fact{ label: words.t(l, "common.expected_in_drawer"),
            value: money.show(drawer.expected, c), tone: "" },
        desk.Fact{ label: words.t(l, "common.counted"),
            value: if closed > 0 {
                money.show(shift.counted_total, c)
            } else {
                words.t(l, "shift_detail.not_counted_yet")
            }, tone: "" },
        desk.Fact{ label: words.t(l, "common.over_short"),
            value: if closed > 0 { money.show(shift.variance, c) } else { "—" },
            tone: if closed > 0 && shift.variance != 0 { "warn" } else { "" } },
        desk.Fact{ label: words.t(l, "common.opened"), value: when(shift.opened_at), tone: "" },
    ]
    var actions: [desk.Action] = []
    if closed == 0 {
        actions.push(desk.action(words.t(l, "shifts.cash_in_or_out"), "form-movement", id, "soft"))
        actions.push(desk.action(words.t(l, "shifts.count_and_close"),
                "form-close-shift", id, "filled"))
    }

    // The derivation, spelled out. This is the screen that answers "why does it
    // think there should be that much in the drawer", and the answer is every
    // term that went into it.
    let workings: [desk.Row] = [
        row("float", [words.t(l, "shifts.opening_float"),
                money.show(drawer.opening_float, c)], ""),
        row("taken", [words.t(l, "shifts.cash_taken"), money.show(drawer.cash_taken, c)], ""),
        row("change", [words.t(l, "shift_detail.change_given"),
                "−\(money.show(drawer.change_given, c))"], ""),
        row("in", [words.t(l, "shifts.paid_in"), money.show(drawer.cash_in, c)], ""),
        row("out", [words.t(l, "shifts.paid_out_and_safe_drops"),
                "−\(money.show(drawer.cash_out, c))"], ""),
        row("refunds", [words.t(l, "shifts.cash_refunds"),
                "−\(money.show(drawer.cash_refunds, c))"], ""),
        row("expected", [words.t(l, "common.expected"), money.show(drawer.expected, c)], "ok"),
    ]

    var movements: [desk.Row] = []
    for m in answer.movements {
        movements.push(row(m.id, [
                    browser.clock_of(m.created_at),
                    drawer_kind_of(l, m.kind),
                    m.reason,
                    m.user_name,
                    money.show(m.amount, c),
                ], ""))
    }
    var tenders: [desk.Row] = []
    for t in answer.tenders {
        tenders.push(row(t.method, [
                    method_of(l, t.method),
                    "\(t.count)",
                    money.show(t.amount, c),
                ], ""))
    }
    var sales_rows: [desk.Row] = []
    for s in answer.sales {
        sales_rows.push(touchable(s.id, [
                    "#\(s.number)",
                    browser.clock_of(s.completed_at),
                    money.show(s.total, c),
                ], "", "open-sale", s.id))
    }

    return [
        desk.Block.Detail(
            title: "\(shift.register_name) · \(shift.user_name)",
            subtitle: if closed > 0 {
                words.fill(l, "tills.closed_n", when(closed))
            } else {
                words.t(l, "common.open_state")
            },
            facts: facts, actions: actions),
        table(words.t(l, "shift_detail.how_the_expected_figure_is_reached"),
            words.t(l, "shift_detail.derived_never_typed"),
            ["", words.t(l, "common.amount")], workings),
        table(words.t(l, "shifts.cash_in_and_out"), "",
            [words.t(l, "shift_detail.time"), words.t(l, "common.kind"),
                words.t(l, "common.why"), words.t(l, "settings.who"),
                words.t(l, "common.amount")], movements),
        table(words.t(l, "shift_detail.how_they_paid"), "",
            [words.t(l, "common.tender"), words.t(l, "common.count"),
                words.t(l, "common.amount")], tenders),
        table(words.t(l, "common.sales"), "",
            ["#", words.t(l, "shift_detail.time"), words.t(l, "common.total")], sales_rows),
    ]
}

// ---- the catalogue ---------------------------------------------------------

pub fn products(answer: [model.CatalogProduct], l: i18n.Lang, c: money.Currency,
    query: str) -> [desk.Block] {
    var rows: [desk.Row] = []
    for p in answer {
        let stock = p.stock
        let reorder = p.reorder_point
        let age = p.min_age
        rows.push(touchable(p.id, [
                    p.name,
                    p.sku,
                    or_dash(p.category_name),
                    money.show(p.price, c),
                    money.show(p.cost, c),
                    money.quantity(stock),
                    if age > 0 { "\(age)+" } else { "" },
                ], if stock <= 0.0 { "stop" } else if reorder > 0.0 && stock <= reorder { "warn" } else { "" },
                "open-product", p.id))
    }
    return [
        desk.Block.Buttons(items: [
                desk.action(words.t(l, "products.add_a_product"), "form-product", "", "filled"),
                desk.action(words.t(l, "common.categories"), "go", "categories", "quiet"),
            ]),
        table(words.t(l, "common.products"),
            if query.len() > 0 {
                words.fill(l, "products.matching_n", query)
            } else {
                words.fill_n(l, "products.n_in_the_catalogue_touch_a_row", "\(rows.len())")
            },
            [words.t(l, "common.name"), words.t(l, "products.sku"),
                words.t(l, "common.category"), words.t(l, "common.price"),
                words.t(l, "common.cost"), words.t(l, "products.stock"),
                words.t(l, "products.age")], rows),
    ]
}

pub fn product_detail(answer: model.ProductPage, l: i18n.Lang,
    c: money.Currency) -> [desk.Block] {
    let p = answer.product
    let id = p.id
    let stock = p.stock
    let price = p.price
    let cost = p.cost
    let margin = price - cost

    let facts: [desk.Fact] = [
        desk.Fact{ label: words.t(l, "products.shelf_price"),
            value: money.show(price, c), tone: "" },
        desk.Fact{ label: words.t(l, "common.cost"), value: money.show(cost, c), tone: "" },
        desk.Fact{ label: words.t(l, "common.margin_2"),
            value: "\(money.show(margin, c))\(if price > 0 { " · \((margin * 100) / price)%" } else { "" })",
            tone: if margin <= 0 { "stop" } else { "" } },
        desk.Fact{ label: words.t(l, "products.on_the_shelf"), value: money.quantity(stock),
            tone: if stock <= 0.0 { "stop" } else { "" } },
        desk.Fact{ label: words.t(l, "products.reorder_level"),
            value: money.quantity(p.reorder_point), tone: "" },
        desk.Fact{ label: words.t(l, "common.supplier"),
            value: or_dash(p.supplier_name), tone: "" },
    ]
    let actions: [desk.Action] = [
        desk.action(words.t(l, "common.edit"), "form-product", id, "soft"),
        desk.action(words.t(l, "inventory.adjust_stock"), "form-adjust", id, "soft"),
        desk.action(words.t(l, "products.add_a_barcode"), "form-barcode", id, "quiet"),
        desk.action(words.t(l, "products.retire"), "retire-product", id, "danger"),
    ]

    var barcodes: [desk.Row] = []
    for b in answer.barcodes {
        barcodes.push(touchable(b.barcode, [
                    b.barcode,
                    money.quantity(b.pack_size),
                    b.label,
                ], "", "drop-barcode", b.barcode))
    }
    var movements: [desk.Row] = []
    for m in answer.movements {
        let delta = m.qty_delta
        movements.push(row(m.id, [
                    when(m.created_at),
                    stock_reason_of(l, m.reason),
                    money.quantity(delta),
                    money.show(m.unit_cost, c),
                    m.note,
                ], if delta < 0.0 { "" } else { "ok" }))
    }
    var sold: [desk.Row] = []
    for s in answer.sold {
        sold.push(row(s.day, [
                    s.day,
                    money.quantity(s.qty),
                    money.show(s.revenue, c),
                ], ""))
    }

    return [
        desk.Block.Detail(title: p.name,
            subtitle: "\(p.sku) · \(if p.category_name.len() > 0 { p.category_name } else { words.t(l, "products.uncategorised") })",
            facts: facts, actions: actions),
        table(words.t(l, "products.barcodes"), words.t(l, "products.touch_one_to_remove_it"),
            [words.t(l, "common.barcode"), words.t(l, "products.units_per_scan"),
                words.t(l, "common.label")], barcodes),
        table(words.t(l, "sales.sold"), words.t(l, "common.30_days"),
            [words.t(l, "common.day"), words.t(l, "common.quantity"),
                words.t(l, "common.revenue")], sold),
        table(words.t(l, "common.stock_movements"),
            words.t(l, "movements.every_change_to_the_level"),
            [words.t(l, "common.when"), words.t(l, "common.because"),
                words.t(l, "movements.change"), words.t(l, "purchasing.at_cost"),
                words.t(l, "common.note")], movements),
    ]
}

pub fn categories(answer: [model.CatalogCategory], l: i18n.Lang) -> [desk.Block] {
    var rows: [desk.Row] = []
    for cat in answer {
        rows.push(touchable(cat.id, [
                    cat.name,
                    cat.name_my,
                    "\(cat.products)",
                    "\(cat.sort)",
                ], "", "form-category", cat.id))
    }
    return [
        desk.Block.Buttons(items: [
                desk.action(words.t(l, "categories.add_a_category"), "form-category", "", "filled"),
                desk.action(words.t(l, "categories.remove_a_category"),
                    "form-remove-category", "", "quiet"),
                desk.action(words.t(l, "categories.back_to_products"), "go", "products", "quiet"),
            ]),
        // "မြန်မာ" names its own column in both languages, the way "English"
        // would: it is the header of the field the till reads a Burmese name from.
        table(words.t(l, "common.categories"), words.t(l, "common.touch_a_row_to_edit"),
            [words.t(l, "common.name"), "မြန်မာ", words.t(l, "common.products"),
                words.t(l, "categories.position")], rows),
    ]
}

pub fn suppliers(answer: [model.Supplier], l: i18n.Lang, c: money.Currency) -> [desk.Block] {
    var rows: [desk.Row] = []
    for s in answer {
        let owed = s.owed
        rows.push(touchable(s.id, [
                    s.name,
                    or_dash(s.phone),
                    words.fill(l, "replenishment.n_days", "\(s.lead_days)"),
                    "\(s.products)",
                    money.show(owed, c),
                ], if owed > 0 { "warn" } else { "" }, "form-supplier", s.id))
    }
    return [
        desk.Block.Buttons(items: [
                desk.action(words.t(l, "suppliers.add_a_supplier"), "form-supplier", "", "filled"),
            ]),
        table(words.t(l, "common.suppliers"), words.t(l, "common.touch_a_row_to_edit"),
            [words.t(l, "common.name"), words.t(l, "common.phone"),
                words.t(l, "suppliers.lead_time"), words.t(l, "common.products"),
                words.t(l, "payables.owed")], rows),
    ]
}

pub fn inventory(answer: model.Inventory, l: i18n.Lang, c: money.Currency) -> [desk.Block] {
    let totals = answer.totals
    let low = totals.low
    let out = totals.out

    let stats: [desk.Stat] = [
        desk.Stat{ label: words.t(l, "purchasing.at_cost"),
            value: money.show(totals.at_cost, c),
            meta: words.fill_n(l, "dashboard.n_skus", "\(totals.skus)"),
            tone: "info" },
        desk.Stat{ label: words.t(l, "inventory.at_retail"),
            value: money.show(totals.at_retail, c),
            meta: words.t(l, "inventory.if_it_all_sold_at_the_shelf_price"), tone: "" },
        desk.Stat{ label: words.t(l, "inventory.low"), value: "\(low)",
            meta: words.t(l, "inventory.at_or_below_the_reorder_point"),
            tone: if low > 0 { "warn" } else { "ok" } },
        desk.Stat{ label: words.t(l, "inventory.out"), value: "\(out)",
            meta: words.t(l, "inventory.nothing_on_the_shelf"),
            tone: if out > 0 { "stop" } else { "ok" } },
    ]

    var attention: [desk.Row] = []
    for p in answer.attention {
        let stock = p.stock
        attention.push(touchable(p.id, [
                    p.name,
                    p.sku,
                    money.quantity(stock),
                    money.quantity(p.reorder_point),
                    money.quantity(p.reorder_qty),
                    or_dash(p.supplier_name),
                ], if stock <= 0.0 { "stop" } else { "warn" }, "open-product", p.id))
    }

    var category_names: [str] = []
    var category_cost: [int] = []
    var skus: [str] = []
    for cat in answer.by_category {
        category_names.push(cat.category)
        category_cost.push(cat.at_cost)
        skus.push(words.fill_n(l, "dashboard.n_skus", "\(cat.skus)"))
    }

    return [
        desk.Block.Stats(items: stats),
        desk.Block.Buttons(items: [
                desk.action(words.t(l, "common.stock_movements"), "go", "movements", "quiet"),
            ]),
        table(words.t(l, "accounting.needs_attention"),
            words.t(l, "inventory.low_or_out_touch_a_row"),
            [words.t(l, "common.product"), words.t(l, "products.sku"),
                words.t(l, "products.stock"), words.t(l, "products.reorder_level"),
                words.t(l, "products.reorder_qty"), words.t(l, "common.supplier")], attention),
        desk.Block.Meters(heading: words.t(l, "reports.by_category"),
            note: words.t(l, "purchasing.at_cost"),
            rows: meters(category_names, category_cost, skus, c)),
    ]
}

pub fn movements(answer: [model.StockMovement], l: i18n.Lang,
    c: money.Currency) -> [desk.Block] {
    var rows: [desk.Row] = []
    for m in answer {
        let delta = m.qty_delta
        let reason = m.reason
        rows.push(touchable(m.id, [
                    when(m.created_at),
                    m.product_name,
                    m.sku,
                    stock_reason_of(l, reason),
                    money.quantity(delta),
                    money.show(m.unit_cost, c),
                    or_dash(m.user_name),
                ], if reason == "waste" { "stop" } else if delta < 0.0 { "" } else { "ok" },
                "open-product", m.product_id))
    }
    return [
        desk.Block.Note(heading: words.t(l, "common.stock_movements"),
            body: words.t(l, "movements.every_change_to_every_level")),
        table(words.t(l, "movements.the_last_seven_days"), "",
            [words.t(l, "common.when"), words.t(l, "common.product"),
                words.t(l, "products.sku"), words.t(l, "common.because"),
                words.t(l, "movements.change"), words.t(l, "purchasing.at_cost"),
                words.t(l, "settings.who")], rows),
    ]
}

// ---- buying ----------------------------------------------------------------

pub fn purchasing(sheet: [model.WorksheetLine], orders: [model.PurchaseOrder],
    payables: Option<model.Payables>, l: i18n.Lang, c: money.Currency) -> [desk.Block] {
    var lines: [desk.Row] = []
    var value = 0
    for line in sheet {
        let suggested = line.suggested
        value = value + line.value
        let left = line.days_left
        lines.push(touchable(line.id, [
                    line.name,
                    or_dash(line.supplier_name),
                    money.quantity(line.stock),
                    words.fill(l, "replenishment.n_per_day", money.quantity(line.per_day)),
                    if left >= 0.0 {
                        words.fill(l, "replenishment.n_days", money.quantity(left))
                    } else { "—" },
                    money.quantity(line.on_order),
                    money.quantity(suggested),
                    money.show(line.value, c),
                ], if suggested > 0.0 { "warn" } else { "" },
                "open-product", line.id))
    }

    var order_rows: [desk.Row] = []
    for o in orders {
        let status = o.status
        order_rows.push(touchable(o.id, [
                    "#\(o.number)",
                    o.supplier_name,
                    order_status_of(l, status),
                    "\(o.lines)",
                    money.show(o.total, c),
                    browser.day_of(o.created_at),
                ], match status {
                    "received" => "ok",
                    "draft" => "",
                    _ => "warn",
                },
                "open-order", o.id))
    }

    // Everything below the worksheet is what the shop owes, and it is allowed
    // to be absent: the payables request is made beside the worksheet's and one
    // may come back without the other. Absent means the tables are empty rather
    // than that nothing is owed, which is why the whole block is skipped rather
    // than drawn with zeros in it.
    var outstanding = 0
    var overdue = 0
    var not_due = 0
    var late_over_30 = 0
    var suppliers_owed = 0
    var owing: [desk.Row] = []
    var aged: [desk.Row] = []
    if payables != nil {
        let totals = payables.totals
        outstanding = totals.outstanding
        overdue = totals.overdue
        not_due = totals.current
        late_over_30 = totals.late_over_30
        for i in payables.invoices {
            let left = i.outstanding
            let due = i.due_at
            owing.push(touchable(i.id, [
                        i.supplier_name,
                        or_dash(i.reference),
                        browser.day_of(i.issued_at),
                        if due > 0 { browser.day_of(due) } else { "—" },
                        money.show(i.total, c),
                        money.show(left, c),
                    ], if left > 0 && due > 0 && due < browser.now() { "stop" }
                       else if left > 0 { "warn" } else { "ok" },
                    if left > 0 { "form-pay-invoice" } else { "" }, i.id))
        }

        // Aging, by supplier. Which invoice to pay first is the question this
        // screen exists to answer, and one lump sum cannot answer it. The
        // buckets are summed by the database over *every* outstanding invoice,
        // not over the page of two hundred drawn above.
        let aging = payables.aging
        suppliers_owed = aging.rows.len()
        for a in aging.rows {
            aged.push(row(a.supplier_id, [
                        a.supplier,
                        money.show(a.current, c), money.show(a.d30, c), money.show(a.d60, c),
                        money.show(a.d90, c), money.show(a.d90up, c), money.show(a.total, c),
                    ], if a.d90up > 0 { "stop" } else if a.d60 > 0 { "warn" } else { "" }))
        }
        if aged.len() > 0 {
            let sums = aging.totals
            aged.push(row("all", [
                        words.t(l, "payables.all_suppliers"),
                        money.show(sums.current, c), money.show(sums.d30, c),
                        money.show(sums.d60, c), money.show(sums.d90, c),
                        money.show(sums.d90up, c), money.show(sums.total, c),
                    ], "ok"))
        }
    }

    return [
        desk.Block.Stats(items: [
                desk.Stat{ label: words.t(l, "purchasing.to_order"), value: money.show(value, c),
                    meta: words.fill_n(l, "replenishment.n_lines_on_the_worksheet",
                        "\(lines.len())"),
                    tone: if value > 0 { "warn" } else { "ok" } },
                desk.Stat{ label: words.t(l, "accounting.owed_to_suppliers"),
                    value: money.show(outstanding, c),
                    meta: words.t(l, "payables.across_every_open_invoice"), tone: "info" },
                desk.Stat{ label: words.t(l, "purchasing.overdue"), value: money.show(overdue, c),
                    meta: words.t(l, "payables.past_the_due_date"),
                    tone: if overdue > 0 { "stop" } else { "ok" } },
                desk.Stat{ label: words.t(l, "payables.not_yet_due"),
                    value: money.show(not_due, c),
                    meta: words.fill_n(l, "payables.n_suppliers", "\(suppliers_owed)"),
                    tone: "ok" },
                desk.Stat{ label: words.t(l, "payables.over_30_days_late"),
                    value: money.show(late_over_30, c),
                    meta: words.t(l, "payables.past_the_due_date"),
                    tone: if late_over_30 > 0 { "stop" } else { "ok" } },
            ]),
        desk.Block.Buttons(items: [
                desk.action(words.t(l, "purchasing.raise_orders_from_the_worksheet"),
                    "raise-orders", "", "filled"),
                desk.action(words.t(l, "payables.record_an_invoice"), "form-invoice", "", "soft"),
                desk.action(words.t(l, "payables.cancel_invoice"), "form-cancel-invoice", "", "quiet"),
                desk.action(words.t(l, "common.suppliers"), "go", "suppliers", "quiet"),
            ]),
        table(words.t(l, "replenishment.reorder_worksheet"),
            words.t(l, "replenishment.what_to_buy_over_28_days"),
            [words.t(l, "common.product"), words.t(l, "common.supplier"),
                words.t(l, "products.stock"), words.t(l, "common.rate"),
                words.t(l, "replenishment.cover"), words.t(l, "replenishment.on_order"),
                words.t(l, "purchasing.suggested"), words.t(l, "common.value")], lines),
        table(words.t(l, "purchasing.purchase_orders"),
            words.t(l, "purchasing.touch_a_row_to_receive"),
            ["#", words.t(l, "common.supplier"), words.t(l, "common.status"),
                words.t(l, "common.lines"), words.t(l, "common.total"),
                words.t(l, "purchasing.raised")], order_rows),
        table(words.t(l, "common.payables"), words.t(l, "payables.touch_a_row_to_pay_it"),
            [words.t(l, "common.supplier"), words.t(l, "common.reference"),
                words.t(l, "payables.issued"), words.t(l, "payables.due"),
                words.t(l, "common.total"), words.t(l, "common.outstanding")], owing),
        table(words.t(l, "payables.aging_by_supplier"),
            words.t(l, "payables.past_the_due_date"),
            [words.t(l, "common.supplier"), words.t(l, "payables.not_due"),
                words.t(l, "payables.d1_30"), words.t(l, "payables.d31_60"),
                words.t(l, "payables.d61_90"), words.t(l, "payables.d90_plus"),
                words.t(l, "common.total")], aged),
    ]
}

pub fn order_detail(answer: model.OrderPage, l: i18n.Lang, c: money.Currency) -> [desk.Block] {
    let order = answer.order
    let id = order.id
    let status = order.status

    let facts: [desk.Fact] = [
        desk.Fact{ label: words.t(l, "common.supplier"), value: order.supplier_name, tone: "" },
        desk.Fact{ label: words.t(l, "common.status"), value: order_status_of(l, status),
            tone: match status {
                "received" => "ok",
                "draft" => "",
                _ => "warn",
            } },
        desk.Fact{ label: words.t(l, "common.total"), value: money.show(order.total, c), tone: "" },
        desk.Fact{ label: words.t(l, "purchasing.raised"),
            value: browser.day_of(order.created_at), tone: "" },
    ]
    var actions: [desk.Action] = []
    if status == "draft" {
        actions.push(desk.action(words.t(l, "purchasing.send_to_supplier"),
                "send-order", id, "filled"))
    }
    if status == "sent" || status == "part_received" {
        actions.push(desk.action(words.t(l, "purchasing.receive_everything_outstanding"),
                "receive-all", id, "filled"))
    }
    if status != "draft" {
        actions.push(desk.action(words.t(l, "payables.record_an_invoice"),
                "form-invoice", id, "soft"))
    }

    var lines: [desk.Row] = []
    for line in answer.lines {
        let ordered = line.qty
        let received = line.qty_received
        let left = ordered - received
        lines.push(touchable(line.id, [
                    line.product_name,
                    line.sku,
                    money.quantity(ordered),
                    money.quantity(received),
                    money.quantity(left),
                    money.show(line.unit_cost, c),
                ], if left <= 0.0 { "ok" } else { "warn" },
                if left > 0.0 { "form-receive" } else { "" }, line.id))
    }

    return [
        desk.Block.Detail(
            title: words.fill(l, "purchase_order.order_n", "#\(order.number)"),
            subtitle: order.supplier_name, facts: facts, actions: actions),
        table(words.t(l, "common.lines"), words.t(l, "purchase_order.touch_a_line_to_receive"),
            [words.t(l, "common.product"), words.t(l, "products.sku"),
                words.t(l, "common.ordered"), words.t(l, "common.received"),
                words.t(l, "common.outstanding"), words.t(l, "purchase_order.cost_each")], lines),
    ]
}

// ---- people ----------------------------------------------------------------

pub fn customers(answer: [model.CustomerAccount], l: i18n.Lang,
    c: money.Currency) -> [desk.Block] {
    let people = answer
    var rows: [desk.Row] = []
    var credit = 0
    for cu in people {
        credit = credit + cu.credit
        let seen = cu.last_seen
        rows.push(touchable(cu.id, [
                    cu.name,
                    or_dash(cu.phone),
                    "\(cu.visits)",
                    money.show(cu.spent, c),
                    "\(cu.points)",
                    money.show(cu.credit, c),
                    if seen > 0 { browser.day_of(seen) } else { words.t(l, "common.never") },
                ], "", "form-customer", cu.id))
    }
    let best = take(sorted(people, |a: model.CustomerAccount, b: model.CustomerAccount|
            a.spent > b.spent), 8)
    var best_names: [str] = []
    var best_spent: [int] = []
    var visits: [str] = []
    for cu in best {
        best_names.push(cu.name)
        best_spent.push(cu.spent)
        visits.push(words.fill_n(l, "register.n_visits", "\(cu.visits)"))
    }
    return [
        desk.Block.Stats(items: [
                desk.Stat{ label: words.t(l, "customers.customers"), value: "\(rows.len())",
                    meta: words.t(l, "customers.on_the_loyalty_list"), tone: "info" },
                desk.Stat{ label: words.t(l, "customers.store_credit_owed"),
                    value: money.show(credit, c),
                    meta: words.t(l, "customers.a_liability_not_a_takings_figure"),
                    tone: if credit > 0 { "warn" } else { "ok" } },
            ]),
        desk.Block.Buttons(items: [
                desk.action(words.t(l, "customers.add_a_customer"), "form-customer", "", "filled"),
            ]),
        desk.Block.Meters(heading: words.t(l, "customers.best_customers"),
            note: words.t(l, "customers.by_what_they_have_spent"),
            rows: meters(best_names, best_spent, visits, c)),
        table(words.t(l, "customers.customers"), words.t(l, "common.touch_a_row_to_edit"),
            [words.t(l, "common.name"), words.t(l, "common.phone"),
                words.t(l, "customers.visits"), words.t(l, "customers.spent"),
                words.t(l, "customers.points"), words.t(l, "customers.credit"),
                words.t(l, "customers.last_seen")], rows),
    ]
}

pub fn staff(answer: [model.Staff], rules: [model.CommandRule], l: i18n.Lang) -> [desk.Block] {
    var people: [desk.Row] = []
    var active = 0
    for u in answer {
        let on = u.active
        if on {
            active = active + 1
        }
        people.push(touchable(u.id, [
                    u.name,
                    role_of(l, u.role),
                    if u.app == "pos" {
                        words.t(l, "staff.the_till")
                    } else {
                        words.t(l, "layout.back_office")
                    },
                    if u.signs_in_with == "pin" {
                        words.t(l, "staff.pin_at_the_lane")
                    } else {
                        words.t(l, "staff.username_password")
                    },
                    or_dash(u.at_lane),
                ], if on { "" } else { "stop" }, "staff-menu", u.id))
    }
    var matrix: [desk.Row] = []
    for (i, m) in enumerate(rules) {
        let may = m.sale_staff
        matrix.push(row("m\(i)", [
                    command_of(l, m.command),
                    allowance_of(l, may),
                    allowance_of(l, m.manager),
                    confirm_of(l, m.confirm),
                ], match may {
                    "no" => "stop",
                    "pin" => "warn",
                    _ => "ok",
                }))
    }
    return [
        desk.Block.Note(heading: words.t(l, "nav.staff_access"),
            body: words.t(l, "staff.a_role_decides_which_app")),
        desk.Block.Buttons(items: [
                desk.action(words.t(l, "staff.add_staff"), "form-staff", "", "filled"),
            ]),
        desk.Block.Roles(cards: [
                desk.RoleCard{
                    role: words.t(l, "staff.sale_staff"),
                    opens: words.t(l, "staff.opens_the_pos_app"),
                    body: words.t(l, "staff.sale_staff_body"),
                    chips: [words.t(l, "staff.chip_sell"), words.t(l, "staff.chip_hold_and_recall"),
                        words.t(l, "tills.price_check"), words.t(l, "staff.chip_discounts_locked")],
                },
                desk.RoleCard{
                    role: words.t(l, "staff.manager_owner"),
                    opens: words.t(l, "staff.opens_the_back_office"),
                    body: words.t(l, "staff.manager_owner_body"),
                    chips: [words.t(l, "staff.chip_approve_at_any_lane"),
                        words.t(l, "staff.chip_voids_and_returns"), words.t(l, "tills.close_lane")],
                },
            ]),
        table(words.t(l, "common.staff"),
            words.fill_n(l, "staff.n_active_touch_a_row", "\(active)"),
            [words.t(l, "common.name"), words.t(l, "staff.role"),
                words.t(l, "staff.signs_in_to"), words.t(l, "staff.sign_in_method"),
                words.t(l, "customers.last_seen")], people),
        table(words.t(l, "tills.till_commands_by_role"),
            words.t(l, "tills.the_pos_command_bar_is_built_from_this"),
            [words.t(l, "tills.command"), words.t(l, "staff.sale_staff"),
                words.t(l, "staff.manager"), words.t(l, "tills.confirm")], matrix),
    ]
}

// ---- insight ---------------------------------------------------------------

/// Every offer, judged against `at` — the moment the *server* read the clock.
///
/// Not `browser.now()`. Whether an offer is running is the same comparison the
/// till makes when it prices a line, and a back office whose clock has drifted
/// must not draw an offer as live that no lane will apply.
pub fn promotions(answer: [model.Promotion], at: int, perf: [model.PromotionResult],
    l: i18n.Lang, c: money.Currency) -> [desk.Block] {
    var rows: [desk.Row] = []
    var live = 0
    for p in answer {
        let active = p.active
        let starts = p.starts_at
        let ends = p.ends_at
        let running = active && (starts == 0 || starts <= at) && (ends == 0 || ends >= at)
        if running {
            live = live + 1
        }
        let kind = p.kind
        var value = money.show(p.value, c)
        if kind == "percent_off" {
            value = "\(p.value / 100)%"
        }
        if kind == "n_for_x" {
            value = "\(words.fill(l, "promotions.n_for", "\(p.n)")) \(money.show(p.value, c))"
        }
        var applies = p.product_name
        if applies.len() == 0 {
            applies = p.category_name
        }
        rows.push(touchable(p.id, [
                    p.name,
                    offer_kind_of(l, kind),
                    value,
                    offer_scope_of(l, p.scope),
                    or_dash(applies),
                    if running {
                        words.t(l, "promotions.running")
                    } else if active {
                        words.t(l, "promotions.scheduled")
                    } else {
                        words.t(l, "promotions.ended")
                    },
                ], if running { "ok" } else if active { "warn" } else { "" },
                "form-promotion", p.id))
    }

    var performance: [desk.Row] = []
    for p in perf {
        performance.push(row(p.promo_id, [
                    p.promo_name,
                    "\(p.lines)",
                    money.quantity(p.units),
                    money.show(p.revenue, c),
                    money.show(p.saved, c),
                ], ""))
    }

    return [
        desk.Block.Stats(items: [
                desk.Stat{ label: words.t(l, "promotions.live_offers"), value: "\(live)",
                    meta: words.t(l, "promotions.running_at_this_moment"),
                    tone: if live > 0 { "ok" } else { "" } },
            ]),
        desk.Block.Buttons(items: [
                desk.action(words.t(l, "promotions.add_an_offer"),
                    "form-promotion", "", "filled"),
            ]),
        // The note is the whole sentence and nothing after it: the "touch a row"
        // hint the other tables carry is lower case, and reads as a typo when it
        // follows a full stop rather than standing on its own.
        table(words.t(l, "promotions.offers"), words.t(l, "promotions.offers_do_not_stack"),
            [words.t(l, "common.name"), words.t(l, "common.kind"), words.t(l, "common.value"),
                words.t(l, "promotions.scope"), words.t(l, "promotions.applies_to"),
                words.t(l, "common.state")], rows),
        table(words.t(l, "promotions.what_they_cost"), words.t(l, "common.30_days"),
            [words.t(l, "promotions.offer"), words.t(l, "common.lines"),
                words.t(l, "common.units"), words.t(l, "common.revenue"),
                words.t(l, "dashboard.given_away")], performance),
    ]
}

/// The reporting page — five reports, each fetched on its own.
///
/// Only the first is required. The other four are asked for beside it and any
/// of them may come back empty-handed, which is what the `Option`s say: an
/// absent report draws no rows rather than a table of noughts that reads as a
/// quiet week.
pub fn reports(products_answer: model.ProductReport, daily: Option<model.SalesReport>,
    shrink: Option<model.ShrinkageReport>, tax: Option<model.TaxReport>,
    dead: Option<model.DeadStockReport>, l: i18n.Lang, c: money.Currency) -> [desk.Block] {
    var products_rows: [desk.Row] = []
    for p in products_answer.products {
        let margin = p.margin
        products_rows.push(touchable(p.product_id, [
                    p.name,
                    p.sku,
                    money.quantity(p.sold),
                    money.show(p.revenue, c),
                    money.show(p.cost, c),
                    money.show(margin, c),
                ], if margin < 0 { "stop" } else { "" }, "open-product", p.product_id))
    }
    var categories_rows: [desk.Row] = []
    for cat in products_answer.categories {
        categories_rows.push(row(cat.category, [
                    cat.category,
                    money.quantity(cat.sold),
                    money.show(cat.revenue, c),
                    money.show(cat.margin, c),
                ], ""))
    }

    var by_hour: [model.HourlySales] = []
    var tenders: [desk.Row] = []
    var by_staff: [desk.Row] = []
    if daily != nil {
        by_hour = daily.hourly
        for t in daily.tenders {
            tenders.push(row(t.method, [
                        method_of(l, t.method),
                        "\(t.count)",
                        money.show(t.amount, c),
                    ], ""))
        }
        for s in daily.staff {
            by_staff.push(row(s.name, [
                        s.name,
                        "\(s.sales)",
                        money.show(s.takings, c),
                    ], ""))
        }
    }
    var hours: [desk.Meter] = []
    var largest = 0
    for h in by_hour {
        largest = max(largest, h.takings)
    }
    for (i, h) in enumerate(by_hour) {
        let takings = h.takings
        hours.push(desk.Meter{
                key: "h\(i)",
                rank: "\(h.hour)",
                name: "\(pad_start("\(h.hour)", 2, "0")):00",
                value: money.show(takings, c),
                sub: words.fill_n(l, "shifts.n_sales", "\(h.sales)"),
                width: desk.width_of(takings, largest),
            })
    }

    var shrinkage: [desk.Row] = []
    var worst: [desk.Row] = []
    if shrink != nil {
        for s in shrink.by_reason {
            shrinkage.push(row(s.reason, [
                        stock_reason_of(l, s.reason),
                        "\(s.movements)",
                        money.quantity(s.units),
                        money.show(s.value, c),
                    ], "warn"))
        }
        for w in shrink.worst {
            worst.push(row(w.sku, [
                        w.name,
                        w.sku,
                        money.quantity(w.units),
                        money.show(w.value, c),
                    ], "stop"))
        }
    }

    // Tax banded by the rate as it was on the line, which is what a VAT return
    // is made from. Nothing else in this system reports it.
    var tax_rows: [desk.Row] = []
    if tax != nil {
        for r in tax.rates {
            let bp = r.tax_bp
            tax_rows.push(row("r\(bp)", [
                        "\(bp / 100).\((bp % 100) / 10)\(bp % 10)",
                        money.show(r.net, c), money.show(r.tax, c), money.show(r.gross, c),
                        "\(r.sales)",
                    ], ""))
        }
        if tax_rows.len() > 0 {
            tax_rows.push(row("tax-total", [
                        words.t(l, "common.total"),
                        money.show(tax.net, c), money.show(tax.tax, c),
                        money.show(tax.gross, c), "",
                    ], "ok"))
        }
    }

    // Ranked by what it is worth, not by how long it has sat: the decision this
    // feeds is what to discount or send back, and a hundred kyat of dust is not
    // worth an afternoon.
    let now_at = browser.now()
    var dead_rows: [desk.Row] = []
    if dead != nil {
        for d in dead.products {
            let last = d.last_sold
            dead_rows.push(touchable(d.id, [
                        d.name,
                        d.sku,
                        money.quantity(d.stock),
                        if last > 0 { "\((now_at - last) / 86400)" }
                        else { words.t(l, "reports.never_sold") },
                        money.show(d.at_cost, c),
                    ], "warn", "open-product", d.id))
        }
    }

    return [
        desk.Block.Meters(heading: words.t(l, "reports.the_trading_day"),
            note: words.t(l, "reports.thirty_days_by_hour"), rows: hours),
        table(words.t(l, "common.products"), words.t(l, "reports.ranked_by_revenue"),
            [words.t(l, "common.product"), words.t(l, "products.sku"),
                words.t(l, "sales.sold"), words.t(l, "common.revenue"),
                words.t(l, "common.cost"), words.t(l, "common.margin_2")], products_rows),
        table(words.t(l, "common.categories"), "",
            [words.t(l, "common.category"), words.t(l, "sales.sold"),
                words.t(l, "common.revenue"), words.t(l, "common.margin_2")], categories_rows),
        table(words.t(l, "shift_detail.how_they_paid"), "",
            [words.t(l, "common.tender"), words.t(l, "common.count"),
                words.t(l, "common.amount")], tenders),
        table(words.t(l, "reports.by_cashier"), "",
            [words.t(l, "common.name"), words.t(l, "common.sales"),
                words.t(l, "common.takings")], by_staff),
        table(words.t(l, "reports.shrinkage"), words.t(l, "reports.waste_counts_and_corrections"),
            [words.t(l, "common.because"), words.t(l, "common.movements"),
                words.t(l, "common.units"), words.t(l, "common.value")], shrinkage),
        table(words.t(l, "reports.worst_affected"), "",
            [words.t(l, "common.product"), words.t(l, "products.sku"),
                words.t(l, "common.units"), words.t(l, "common.value")], worst),
        table(words.t(l, "reports.tax_collected_by_rate"),
            words.t(l, "reports.the_only_vat_output"),
            [words.t(l, "reports.rate"), words.t(l, "reports.net"),
                words.t(l, "common.tax"), words.t(l, "reports.gross"),
                words.t(l, "common.sales")], tax_rows),
        table(words.t(l, "reports.dead_stock"),
            words.t(l, "reports.on_the_shelf_not_selling"),
            [words.t(l, "common.product"), words.t(l, "products.sku"),
                words.t(l, "products.stock"), words.t(l, "reports.days_since_sold"),
                words.t(l, "common.value")], dead_rows),
    ]
}

pub fn expenses(answer: model.ExpenseReport, l: i18n.Lang, c: money.Currency) -> [desk.Block] {
    var rows: [desk.Row] = []
    for e in answer.expenses {
        rows.push(row(e.id, [
                    browser.day_of(e.spent_at),
                    // The account's name, or the code when the join found no
                    // account to name — which is what the old fallback meant.
                    if e.account_name.len() > 0 { e.account_name } else { e.account_code },
                    e.category,
                    or_dash(e.payee),
                    e.reference,
                    method_of(l, e.method),
                    money.show(e.tax, c),
                    money.show(e.amount, c),
                ], ""))
    }

    let totals = answer.totals
    let spent = totals.amount
    let tax = totals.tax

    // One card per account, so "what is rent costing us" is a figure on the
    // screen rather than an addition somebody does in their head.
    var cards: [desk.Stat] = [
        desk.Stat{ label: words.t(l, "expenses.spent"), value: money.show(spent, c),
            meta: "\(words.fill_n(l, "accounting.n_entries", "\(totals.count)")) · \(words.fill(l, "accounting.n_net_of_tax", money.show(spent - tax, c)))",
            tone: "warn" },
    ]
    for a in answer.by_account {
        cards.push(desk.Stat{
                label: a.account_name,
                value: money.show(a.amount, c),
                meta: words.fill_n(l, "accounting.n_entries", "\(a.count)"),
                tone: "info" })
    }

    var category_names: [str] = []
    var category_amount: [int] = []
    var counts: [str] = []
    for cat in answer.by_category {
        category_names.push(cat.category)
        category_amount.push(cat.amount)
        counts.push(words.fill_n(l, "expenses.n_times", "\(cat.count)"))
    }
    return [
        desk.Block.Stats(items: cards),
        desk.Block.Buttons(items: [
                desk.action(words.t(l, "expenses.record_an_expense"),
                    "form-expense", "", "filled"),
            ]),
        desk.Block.Meters(heading: words.t(l, "expenses.where_it_went"),
            note: words.t(l, "reports.by_category"),
            rows: meters(category_names, category_amount, counts, c)),
        table(words.t(l, "common.expenses"), words.t(l, "common.90_days"),
            [words.t(l, "common.date"), words.t(l, "common.account"),
                words.t(l, "expenses.what_for"), words.t(l, "expenses.paid_to"),
                words.t(l, "common.reference"), words.t(l, "common.how"),
                words.t(l, "common.tax"), words.t(l, "common.amount")], rows),
    ]
}

pub fn accounting_off(l: i18n.Lang) -> [desk.Block] {
    return [
        desk.Block.Note(heading: words.t(l, "accounting.the_books_are_off"),
            body: words.t(l, "accounting.the_books_are_off_body")),
        desk.Block.Buttons(items: [
                desk.action(words.t(l, "common.settings"), "go", "settings", "filled"),
            ]),
    ]
}

/// The tab strip, the window picker, and the way out to a file.
///
/// A row of chips rather than a menu, because there are eight sheets and a
/// shopkeeper moves between them constantly — and because the selected one has
/// to be visible at a glance from across a back-office desk.
fn books_chrome(view: str, win: str, l: i18n.Lang) -> [desk.Block] {
    var sheets: [desk.Action] = []
    // The second half of each pair is a phrase key rather than the phrase, so a
    // chip is named the same way the sheet under it is.
    for pair in [
        ["summary", "accounting.summary"], ["pl", "accounting.profit_and_loss"],
        ["balance", "accounting.balance_sheet"], ["trial", "accounting.trial_balance"],
        ["ledger", "accounting.general_ledger"], ["journal", "accounting.journal"],
        ["accounts", "accounting.chart_of_accounts"], ["periods", "accounting.periods"],
    ] {
        sheets.push(desk.action(words.t(l, pair[1]), "books-view", pair[0],
                if view == pair[0] { "filled" } else { "quiet" }))
    }
    var windows: [desk.Action] = []
    for pair in [
        ["today", "common.today"], ["7", "common.7_days"], ["30", "common.30_days"],
        ["month", "common.month"], ["all", "common.all_time"],
    ] {
        windows.push(desk.action(words.t(l, pair[1]), "books-window", pair[0],
                if win == pair[0] { "filled" } else { "quiet" }))
    }
    var actions: [desk.Action] = [
        desk.action(words.t(l, "expenses.record_an_expense"), "form-expense", "", "soft"),
        desk.action(words.t(l, "accounting.close_a_month"), "form-close-period", "", "soft"),
    ]
    // Two buttons that belong to one sheet each rather than to the chrome: a
    // filter with nothing to filter, and an opening balance offered from a
    // trial balance, are both noise.
    match view {
        "journal" => actions.push(desk.action(words.t(l, "accounting.filter_the_journal"),
                "books-filter", "", "soft")),
        "summary" => actions.push(desk.action(words.t(l, "accounting.opening_balances"),
                "books-opening", "", "quiet")),
        // Every other sheet gets neither, which is what the two `if`s said by
        // not having an `else`.
        _ => {},
    }
    actions.push(desk.action(words.t(l, "common.print"), "print", "", "quiet"))
    actions.push(desk.action(words.t(l, "accounting.export_this_sheet"),
            "books-export", view, "filled"))

    return [
        desk.Block.Buttons(items: sheets),
        desk.Block.Buttons(items: windows),
        desk.Block.Buttons(items: actions),
    ]
}

/// The sweep, as the shopkeeper sees it.
///
/// The last row is deliberately not a failure. The shelves are valued at what
/// each product costs **today** and account 1200 carries what that stock cost
/// **when it was bought** — a supplier raising their price revalues the shelf
/// and must not rewrite history. Shown side by side with the reason, rather
/// than raised as an alarm nobody can act on.
///
/// A sweep that did not arrive draws **nothing**. `office.load_accounting` lets
/// this one request fail on its own so that a slow sweep does not take the
/// revenue figure down with it, and every verdict on the panel is a boolean
/// that is false when it is missing — so a panel built from an absent sweep
/// reads "debits do not equal credits" and "the equation does not hold" in red,
/// about books that are very probably fine. Saying nothing is the only honest
/// answer to a question that was never answered.
fn books_health(sweep: Option<model.Health>, l: i18n.Lang, c: money.Currency) -> [desk.Block] {
    if sweep == nil {
        return []
    }
    let health = sweep
    let sides = health.sides_agree
    let unbalanced = health.unbalanced.len()
    let orphans = health.orphan_lines
    let holds = health.equation_holds
    let drift = health.stock_drift

    let checks: [desk.Row] = [
        row("debits", [words.t(l, "accounting.debits_equal_credits"),
                money.show(health.total_debit, c)],
            if sides { "ok" } else { "stop" }),
        row("entries", [words.t(l, "accounting.journal_entries"), "\(health.entries)"], ""),
        row("unbal", [words.t(l, "accounting.unbalanced_entries"), "\(unbalanced)"],
            if unbalanced == 0 { "ok" } else { "stop" }),
        row("orphans", [words.t(l, "accounting.lines_with_no_entry"), "\(orphans)"],
            if orphans == 0 { "ok" } else { "stop" }),
        row("equation", [words.t(l, "accounting.accounting_equation"),
                if holds {
                    words.t(l, "accounting.holds")
                } else {
                    words.fill(l, "accounting.out_by_n", money.show(health.out_by, c))
                }],
            if holds { "ok" } else { "stop" }),
        row("stock", [words.t(l, "accounting.stock_matches_its_movements"),
                if drift.len() == 0 {
                    words.t(l, "accounting.yes")
                } else {
                    words.fill_n(l, "accounting.n_adrift", "\(drift.len())")
                }],
            if drift.len() == 0 { "ok" } else { "stop" }),
    ]

    var blocks: [desk.Block] = [
        table(words.t(l, "accounting.ledger_health"),
            words.t(l, "accounting.rechecked_every_time_this_page_is_opened"),
            [words.t(l, "accounting.check"), words.t(l, "accounting.reading")], checks),
    ]

    if drift.len() > 0 {
        var rows: [desk.Row] = []
        for d in drift {
            let stock = d.stock
            let moved = d.moved
            rows.push(row(d.sku, [
                        d.name, d.sku,
                        money.quantity(stock), money.quantity(moved),
                        money.quantity(stock - moved),
                    ], "stop"))
        }
        blocks.push(table(words.t(l, "accounting.stock_adrift_from_its_movements"),
                words.t(l, "accounting.the_level_against_what_moved_it"),
                [words.t(l, "common.product"), words.t(l, "products.sku"),
                    words.t(l, "accounting.on_the_product"),
                    words.t(l, "accounting.in_the_movements"),
                    words.t(l, "accounting.adrift_by")], rows))
    }

    let shelf = health.stock_at_cost
    let booked = health.stock_in_ledger
    blocks.push(table(words.t(l, "accounting.stock_valuation"),
            words.t(l, "accounting.a_gap_here_is_normal"),
            ["", words.t(l, "common.amount")], [
                row("shelf", [words.t(l, "accounting.the_shelves_at_todays_cost"),
                        money.show(shelf, c)], ""),
                row("booked", [words.t(l, "accounting.the_ledger_stock_on_hand"),
                        money.show(booked, c)], ""),
                row("gap", [words.t(l, "accounting.difference"),
                        money.show(shelf - booked, c)], ""),
            ]))
    return blocks
}

fn books_summary(pl: Option<model.ProfitAndLoss>, sheet: Option<model.BalanceSheet>,
    health: Option<model.Health>, payables: Option<model.Payables>, win: str,
    l: i18n.Lang, c: money.Currency) -> [desk.Block] {
    // Each of the four is asked for separately and any of them may be missing —
    // "a health sweep that times out should not take the revenue figure down
    // with it". A missing one reads as zero here, which is what an absent key
    // read as before there were types to say so.
    var revenue = 0
    var gross = 0
    var net = 0
    var cost_of_sales = 0
    var operating = 0
    if pl != nil {
        revenue = pl.revenue
        gross = pl.gross_profit
        net = pl.net_profit
        cost_of_sales = pl.cost_of_sales
        operating = pl.operating_expenses
    }
    var out_by = 0
    var total_assets = 0
    var total_liabilities = 0
    var total_equity = 0
    var retained = 0
    if sheet != nil {
        out_by = sheet.out_by
        total_assets = sheet.total_assets
        total_liabilities = sheet.total_liabilities
        total_equity = sheet.total_equity
        retained = sheet.retained_earnings
    }
    var owed = 0
    var overdue = 0
    if payables != nil {
        owed = payables.totals.outstanding
        overdue = payables.totals.overdue
    }
    let margin = if revenue > 0 { (gross * 100) / revenue } else { 0 }

    var blocks: [desk.Block] = [
        desk.Block.Stats(items: [
                desk.Stat{ label: words.t(l, "common.revenue"), value: money.show(revenue, c),
                    meta: "\(window_of(l, win)) · \(words.t(l, "accounting.net_of_discounts_and_tax"))",
                    tone: "ok" },
                desk.Stat{ label: words.t(l, "common.gross_profit"), value: money.show(gross, c),
                    meta: words.fill(l, "common.n_margin", "\(margin)%"),
                    tone: if gross < 0 { "stop" } else { "ok" } },
                desk.Stat{ label: words.t(l, "accounting.net_profit"), value: money.show(net, c),
                    meta: words.fill(l, "accounting.after_running_costs",
                        money.show(operating, c)),
                    tone: if net < 0 { "stop" } else { "ok" } },
                desk.Stat{ label: words.t(l, "accounting.owed_to_suppliers"),
                    value: money.show(owed, c),
                    meta: words.fill(l, "accounting.n_overdue", money.show(overdue, c)),
                    tone: if overdue > 0 { "warn" } else { "info" } },
            ]),
    ]
    for b in books_health(health, l, c) {
        blocks.push(b)
    }
    blocks.push(table(words.t(l, "accounting.profit_and_loss_2"), window_of(l, win),
            ["", words.t(l, "common.amount")], [
                row("rev", [words.t(l, "common.revenue"), money.show(revenue, c)], ""),
                row("cogs", [words.t(l, "accounting.cost_of_sales"),
                        money.show(cost_of_sales, c)], ""),
                row("gross", [words.t(l, "common.gross_profit"), money.show(gross, c)], "ok"),
                row("opex", [words.t(l, "accounting.running_costs"),
                        money.show(operating, c)], ""),
                row("net", [words.t(l, "accounting.net_profit"), money.show(net, c)],
                    if net < 0 { "stop" } else { "ok" }),
            ]))
    blocks.push(table(words.t(l, "accounting.balance_sheet"),
            words.t(l, "accounting.as_at_today"), ["", words.t(l, "common.amount")], [
                row("as", [words.t(l, "accounting.assets"), money.show(total_assets, c)], ""),
                row("li", [words.t(l, "accounting.liabilities"),
                        money.show(total_liabilities, c)], ""),
                row("eq", [words.t(l, "accounting.equity"), money.show(total_equity, c)], ""),
                row("re", [words.t(l, "accounting.retained_profit"),
                        money.show(retained, c)], ""),
                row("ck", [words.t(l, "accounting.balances"),
                        if out_by == 0 {
                            words.t(l, "accounting.yes")
                        } else {
                            money.show(out_by, c)
                        }],
                    if out_by == 0 { "ok" } else { "stop" }),
            ]))
    return blocks
}

/// Profit and loss, **account by account**.
///
/// The five aggregate rows were all this ever showed, while the API had been
/// returning every account underneath them all along. Discounts are kept
/// visible rather than netted away: revenue is booked at the shelf price and
/// what was given away sits against it, so "how much did we discount this
/// month" is a number that can be read rather than reconstructed.
fn books_pl(sheet: Option<model.ProfitAndLoss>, win: str, l: i18n.Lang,
    c: money.Currency) -> [desk.Block] {
    // Unreachable on this sheet: `office` fails the whole screen when the
    // profit and loss will not load, rather than drawing the page without it.
    // The guard is here because the type admits it, not because it happens.
    if sheet == nil {
        return []
    }
    let pl = sheet
    var rows: [desk.Row] = []
    for a in pl.income {
        rows.push(touchable("i\(a.code)", [
                    words.t(l, "common.revenue"), a.code, a.name,
                    money.show(a.amount, c),
                ], "", "books-account", a.code))
    }
    rows.push(row("revenue", ["", "", words.t(l, "common.revenue"),
                money.show(pl.revenue, c)], "ok"))
    for e in pl.expenses {
        let code = e.code
        // The same split the totals use, so the sections and the footer cannot
        // disagree about which account is a cost of sale.
        let section = match code {
            "5000" | "5100" => words.t(l, "accounting.cost_of_sales"),
            _ => words.t(l, "accounting.running_costs"),
        }
        rows.push(touchable("e\(code)", [section, code, e.name,
                    money.show(e.amount, c)], "", "books-account", code))
    }
    rows.push(row("cogs", ["", "", words.t(l, "accounting.cost_of_sales"),
                money.show(pl.cost_of_sales, c)], ""))
    rows.push(row("gross", ["", "", words.t(l, "common.gross_profit"),
                money.show(pl.gross_profit, c)], "ok"))
    rows.push(row("opex", ["", "", words.t(l, "accounting.running_costs"),
                money.show(pl.operating_expenses, c)], ""))
    let net = pl.net_profit
    rows.push(row("net", ["", "", words.t(l, "accounting.net_profit"), money.show(net, c)],
            if net < 0 { "stop" } else { "ok" }))
    return [table(words.t(l, "accounting.profit_and_loss_2"),
            "\(window_of(l, win)) · \(words.t(l, "accounting.touch_an_account_for_its_ledger"))",
            [words.t(l, "accounting.section"), words.t(l, "common.code"),
                words.t(l, "common.account"), words.t(l, "common.amount")], rows)]
}

/// One section of a balance sheet, as touchable rows.
///
/// The three sections used to be a loop over pairs of strings — a field name to
/// read and a phrase key to print. The field name has no meaning now that the
/// sheet is a value, so what is left is the phrase key and the prefix a row's
/// own key is built from.
fn balance_rows(prefix: str, section: str, accounts: [model.AccountBalance],
    c: money.Currency) -> [desk.Row] {
    var out: [desk.Row] = []
    for a in accounts {
        out.push(touchable("\(prefix)\(a.code)", [section, a.code, a.name,
                    money.show(a.amount, c)], "", "books-account", a.code))
    }
    return out
}

/// The balance sheet, or nothing at all.
///
/// The sheet is the one request on this screen that `office` allows to fail
/// quietly, so absent is reachable. It draws nothing rather than a sheet of
/// zeros: the totals row asserts that assets less liabilities and equity is 0
/// and paints itself green for it, which on an answer that never came is a
/// clean bill of health invented on this side of the wire.
fn books_balance(as_at: Option<model.BalanceSheet>, l: i18n.Lang,
    c: money.Currency) -> [desk.Block] {
    if as_at == nil {
        return []
    }
    let sheet = as_at
    var rows: [desk.Row] = []
    for r in balance_rows("assets", words.t(l, "accounting.asset"), sheet.assets, c) {
        rows.push(r)
    }
    for r in balance_rows("liabilities", words.t(l, "accounting.liability"),
        sheet.liabilities, c) {
        rows.push(r)
    }
    for r in balance_rows("equity", words.t(l, "accounting.equity"), sheet.equity, c) {
        rows.push(r)
    }
    rows.push(row("re", [words.t(l, "accounting.equity"), "",
                "\(words.t(l, "accounting.retained_profit")), \(words.t(l, "accounting.not_yet_moved_to_equity"))",
                money.show(sheet.retained_earnings, c)], ""))
    let out_by = sheet.out_by
    rows.push(row("ta", ["", "", words.t(l, "accounting.total_assets"),
                money.show(sheet.total_assets, c)], ""))
    rows.push(row("tl", ["", "", words.t(l, "accounting.total_liabilities"),
                money.show(sheet.total_liabilities, c)], ""))
    rows.push(row("te", ["", "", words.t(l, "accounting.total_equity"),
                money.show(sheet.total_equity, c)], ""))
    rows.push(row("ck", ["", "", words.t(l, "accounting.assets_less_liabilities_and_equity"),
                money.show(out_by, c)],
            if out_by == 0 { "ok" } else { "stop" }))
    return [table(words.t(l, "accounting.balance_sheet"),
            "\(words.t(l, "accounting.as_at_today")) · \(words.t(l, "accounting.touch_an_account_for_its_ledger"))",
            [words.t(l, "accounting.section"), words.t(l, "common.code"),
                words.t(l, "common.account"), words.t(l, "common.amount")], rows)]
}

/// Every account with its debits, credits and balance — and a way in.
///
/// Touching a row opens that account's general ledger. Without it a trial
/// balance is a list of figures with no way to ask where any of them came
/// from, which is the one question it exists to raise.
fn books_trial(balance: Option<model.TrialBalance>, win: str, l: i18n.Lang,
    c: money.Currency) -> [desk.Block] {
    // As in `books_pl`: `office` fails the screen instead, so this cannot fire.
    if balance == nil {
        return []
    }
    let trial = balance
    var rows: [desk.Row] = []
    for line in trial.lines {
        let code = line.code
        let debit = line.debit
        let credit = line.credit
        rows.push(touchable("t\(code)", [
                    code, line.name,
                    account_kind_of(l, line.kind),
                    if debit == 0 { "" } else { money.show(debit, c) },
                    if credit == 0 { "" } else { money.show(credit, c) },
                    money.show(debit - credit, c),
                ], "", "books-account", code))
    }
    let td = trial.total_debit
    let tc = trial.total_credit
    rows.push(row("total", ["", words.t(l, "accounting.totals"), "",
                money.show(td, c), money.show(tc, c),
                if td == tc { words.t(l, "common.balanced") } else { money.show(td - tc, c) }],
            if td == tc { "ok" } else { "stop" }))
    return [table(words.t(l, "accounting.trial_balance"),
            "\(window_of(l, win)) · \(words.t(l, "accounting.touch_a_row_for_its_ledger"))",
            [words.t(l, "common.code"), words.t(l, "common.account"), words.t(l, "common.type"),
                words.t(l, "accounting.debits"), words.t(l, "accounting.credits"),
                words.t(l, "common.balance")], rows)]
}

/// One account, movement by movement, with the balance after each.
fn books_ledger(opened: Option<model.Ledger>, code: str, win: str, l: i18n.Lang,
    c: money.Currency) -> [desk.Block] {
    if code.len() == 0 {
        return [desk.Block.Note(heading: words.t(l, "accounting.pick_an_account"),
                body: words.t(l, "accounting.pick_an_account_body"))]
    }
    // An account is named and `office` fetches its ledger under exactly that
    // condition, failing the screen if it will not come. As in `books_pl`.
    if opened == nil {
        return []
    }
    let ledger = opened
    let account = ledger.account
    var rows: [desk.Row] = [
        row("opening", ["", "", words.t(l, "accounting.opening_balance"), "", "", "",
                money.show(ledger.opening, c)], ""),
    ]
    for line in ledger.lines {
        let amount = line.amount
        rows.push(row(line.entry_id + line.number, [
                    browser.day_of(line.value_at),
                    line.number,
                    if line.line_memo.len() > 0 { line.line_memo } else { line.memo },
                    caused_by_of(l, line.ref_type),
                    if amount > 0 { money.show(amount, c) } else { "" },
                    if amount < 0 { money.show(0 - amount, c) } else { "" },
                    money.show(line.balance, c),
                ], ""))
    }
    rows.push(row("closing", ["", "", words.t(l, "accounting.closing_balance"), "", "", "",
                money.show(ledger.closing, c)], "ok"))
    return [table("\(account.code) \(account.name)",
            "\(window_of(l, win)) · \(account_kind_of(l, account.kind)) · \(words.fill(l, "accounting.n_normal", normal_of(l, account.normal)))",
            [words.t(l, "common.date"), words.t(l, "accounting.entry"),
                words.t(l, "accounting.memo"), words.t(l, "accounting.caused_by"),
                words.t(l, "accounting.debit"), words.t(l, "accounting.credit"),
                words.t(l, "common.balance")], rows)]
}

/// The journal, **with the lines that make each entry up**.
///
/// The API had been returning `lines[]` all along and the screen drew only the
/// entry headers — a journal with no debits and no credits on it, which is a
/// list of events rather than a journal. Each entry is followed by its legs,
/// indented by an empty first cell.
fn books_journal(book: Option<model.Journal>, win: str, l: i18n.Lang,
    c: money.Currency) -> [desk.Block] {
    // As in `books_pl`: `office` fails the screen instead, so this cannot fire.
    if book == nil {
        return []
    }
    let journal = book
    let lines = journal.lines
    var rows: [desk.Row] = []
    for e in journal.entries {
        let id = e.id
        rows.push(touchable("e\(id)", [
                    e.number,
                    browser.day_of(e.value_at),
                    e.memo,
                    caused_by_of(l, e.ref_type),
                    or_dash(e.user_name),
                    "", "",
                ], if e.corrects_id.len() > 0 { "warn" } else { "" },
                "books-reverse", id))
        for line in lines {
            if line.entry_id == id {
                let amount = line.amount
                rows.push(row("l\(line.id)", [
                            "", "",
                            "\(line.account_code) \(line.account_name)",
                            line.memo, "",
                            if amount > 0 { money.show(amount, c) } else { "" },
                            if amount < 0 { money.show(0 - amount, c) } else { "" },
                        ], ""))
            }
        }
    }
    let shown = journal.shown
    let total = journal.total
    // "3 / 40" rather than "3 of 40": a word between two numbers has to be
    // ordered, and the slash reads the same in both languages.
    return [table(words.t(l, "accounting.journal"),
            "\(window_of(l, win)) · \(words.fill_n(l, "accounting.n_entries_newest_first", "\(shown) / \(total)")) · \(words.t(l, "accounting.touch_an_entry_to_correct_it"))",
            [words.t(l, "accounting.entry"), words.t(l, "common.date"),
                words.t(l, "common.detail"), words.t(l, "accounting.caused_by"),
                words.t(l, "settings.who"), words.t(l, "accounting.debit"),
                words.t(l, "accounting.credit")], rows)]
}

fn books_accounts(accounts: [model.Account], l: i18n.Lang, c: money.Currency) -> [desk.Block] {
    var rows: [desk.Row] = []
    for a in accounts {
        let code = a.code
        rows.push(touchable("a\(code)", [
                    code, a.name,
                    account_kind_of(l, a.kind),
                    normal_of(l, a.normal),
                ], "", "books-account", code))
    }
    return [table(words.t(l, "accounting.chart_of_accounts"),
            words.t(l, "accounting.touch_an_account_for_its_ledger"),
            [words.t(l, "common.code"), words.t(l, "common.name"), words.t(l, "common.kind"),
                words.t(l, "accounting.normal_balance")], rows)]
}

/// Months that have been closed, and the way back out of one.
///
/// Reopening is a real button rather than a support call: the endpoint existed
/// and nothing called it. Closing is the guard against a backdated correction
/// landing in a month already reported to the outside world — reopening is
/// admitting the report was wrong, which happens.
fn books_periods(summary: model.BooksSummary, l: i18n.Lang, c: money.Currency) -> [desk.Block] {
    let periods = summary.periods
    if periods.len() == 0 {
        return [
            desk.Block.Note(heading: words.t(l, "accounting.no_month_has_been_closed"),
                body: words.t(l, "accounting.closing_a_month_stops_anything")),
            desk.Block.Buttons(items: [
                    desk.action(words.t(l, "accounting.close_a_month"),
                        "form-close-period", "", "filled"),
                ]),
        ]
    }
    var rows: [desk.Row] = []
    for p in periods {
        let closed = p.closed_at
        rows.push(touchable(p.id, [
                    browser.day_of(p.starts_at),
                    browser.day_of(p.ends_at),
                    if closed > 0 {
                        browser.day_of(closed)
                    } else {
                        words.t(l, "common.open_state")
                    },
                    p.note,
                    if closed > 0 { words.t(l, "accounting.reopen") } else { "" },
                ], if closed > 0 { "ok" } else { "" },
                "books-reopen", p.id))
    }
    return [
        table(words.t(l, "accounting.fiscal_periods"),
            words.t(l, "accounting.touch_a_closed_month_to_reopen_it"),
            [words.t(l, "movements.from"), words.t(l, "movements.to"),
                words.t(l, "common.closed"), words.t(l, "common.note"), ""], rows),
    ]
}

/// What the books screen was able to fetch.
///
/// A bundle rather than nine positional parameters: the sheets do not all need
/// the same data, and threading them all through would mean every new sheet
/// changes the signature of all of them.
///
/// Every field but `summary` is an `Option`, and that is the point of the type
/// rather than an inconvenience of it. `office.load_accounting` asks only for
/// what the open sheet needs — eight requests to look at one would be eight
/// round trips — so on any given draw most of these are legitimately absent.
/// The summary is the exception: nothing is drawn at all until it has arrived,
/// because it is what says whether the books are switched on.
pub struct Books {
    pub summary: model.BooksSummary
    pub pl: Option<model.ProfitAndLoss>
    pub sheet: Option<model.BalanceSheet>
    pub health: Option<model.Health>
    pub payables: Option<model.Payables>
    pub trial: Option<model.TrialBalance>
    pub journal: Option<model.Journal>
    pub accounts: [model.Account]
    pub ledger: Option<model.Ledger>
}

/// A bundle with nothing in it but the summary.
///
/// The starting point `office` fills in, so a sheet nobody asked for is absent
/// rather than stale from the last time it was open.
pub fn books_of(summary: model.BooksSummary) -> Books {
    return Books{
        summary: summary,
        pl: nil, sheet: nil, health: nil, payables: nil,
        trial: nil, journal: nil, accounts: [], ledger: nil,
    }
}

/// The books, whichever sheet is open.
pub fn accounting(view: str, win: str, data: Books, code: str,
    l: i18n.Lang, c: money.Currency) -> [desk.Block] {
    var blocks = books_chrome(view, win, l)
    // Every arm is one call, so this is a value-position match with expression
    // arms — `body` is bound once rather than assigned in eight branches.
    let body = match view {
        "pl" => books_pl(data.pl, win, l, c),
        "balance" => books_balance(data.sheet, l, c),
        "trial" => books_trial(data.trial, win, l, c),
        "ledger" => books_ledger(data.ledger, code, win, l, c),
        "journal" => books_journal(data.journal, win, l, c),
        "accounts" => books_accounts(data.accounts, l, c),
        "periods" => books_periods(data.summary, l, c),
        // Summary is the default sheet, so it is also the sheet an unknown
        // view falls to rather than an empty page.
        _ => books_summary(data.pl, data.sheet, data.health, data.payables, win, l, c),
    }
    for b in body {
        blocks.push(b)
    }
    return blocks
}

pub fn settings(answer: doc.Doc, l: i18n.Lang) -> [desk.Block] {
    let s = doc.field(answer, "settings")
    var rows: [desk.Row] = []
    // Setting key on the left, phrase key on the right: the first is what the
    // shop stores and never translates, the second is what a reader is shown.
    for pair in [
        ["shop.name", "settings.shop_name"],
        ["shop.name_my", "settings.shop_name_my"],
        ["shop.address", "common.address"],
        ["shop.phone", "common.phone"],
        ["shop.tax_id", "common.tax_id"],
        ["shop.receipt_footer", "settings.receipt_footer"],
        ["currency.code", "settings.currency"],
        ["currency.symbol", "settings.symbol"],
        ["currency.minor_units", "settings.decimal_places"],
        ["currency.symbol_first", "settings.symbol_first"],
        ["tax.inclusive", "settings.prices_include_tax"],
        ["tax.default_bp", "settings.default_tax_bp"],
        ["locale.default", "settings.language"],
        ["loyalty.points_per_unit", "settings.loyalty_points_per_unit"],
        ["accounting.enabled", "settings.accounting_on"],
    ] {
        let key = pair[0]
        rows.push(row(key, [words.t(l, pair[1]), key, doc.text(s, key, "")], ""))
    }
    return [
        desk.Block.Buttons(items: [
                desk.action(words.t(l, "settings.edit_settings"), "form-settings", "", "filled"),
                desk.action(words.t(l, "accounting.close_a_month"),
                    "form-close-period", "", "soft"),
            ]),
        table(words.t(l, "settings.the_shop"), "",
            [words.t(l, "settings.setting"), words.t(l, "common.code"),
                words.t(l, "common.value")], rows),
    ]
}
