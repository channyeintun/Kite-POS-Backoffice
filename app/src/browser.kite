//! What the browser has that `std/window` does not.
//!
//! Storage, the address bar, timers and the wall clock come from `std/window`
//! now, and the calendar from `std/time` — every one of them used to be
//! written out in this file over `std/js`. What is left is this shop's own:
//! the parts of a page a till touches, a receipt printed by printing the page,
//! and the two transfers that carry a credential.
//!
//! The wrappers that remain over `std/window` are here for one reason each,
//! and it is always the same reason: the standard library hands an error back
//! and **this application's answer is to write it down and carry on**. A till
//! with a queue at it does not stop because a browser refused to remember
//! something. That decision belongs in one place rather than at each of the
//! twenty call sites Kite would otherwise make test it.

use std/js
use std/math
use std/dom
use std/time
use std/window

// ---- the clock ---------------------------------------------------------------
//
// **The API speaks seconds and `std/window` speaks milliseconds**, so the
// conversion lives here rather than being remembered at each call site.
//
// Every reading below is rendered in the device's own zone, which is the
// shop's. `std/time` takes that as a parameter rather than reading it, so it
// is passed in once here — and the reports now agree with the screen about
// which day it is. They did not: `iso_day` was `toISOString`, which is UTC,
// while `day_of` and `clock_of` read local fields. A sale rung up after seven
// in the evening in Yangon was shown on one day and filed under the next.

/// Minutes east of UTC, as the device believes them.
fn here() -> int {
    return window.timezone_offset()
}

/// Seconds since the epoch, which is the unit the API speaks in.
pub fn now() -> int {
    return window.epoch_ms() / 1000
}

/// `hh:mm` in the shop's own timezone.
pub fn clock_of(epoch: int) -> str {
    return time.hhmm(epoch * 1000, here())
}

/// `dd Mon`, for a status bar that has no room for a year.
///
/// The month names stay here rather than going into `std/time`, which formats
/// no month it would have to choose a language for.
pub fn day_of(epoch: int) -> str {
    let at = time.civil_of(epoch * 1000, here())
    let names = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
        "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    return "\(at.day) \(names[clamp(at.month - 1, 0, 11)])"
}

/// A date the operator has to check an ID against, spelled out.
///
/// The dialog shows the minimum age *and this*, so nobody is doing arithmetic
/// at the counter with a queue waiting.
pub fn date_of(epoch: int) -> str {
    return "\(day_of(epoch)) \(time.civil_of(epoch * 1000, here()).year)"
}

/// `YYYY-MM-DD`, which is what a filename wants.
///
/// `date_of` writes "10 Jul 2026" for a person to read; a folder of files
/// named that way sorts April before January. A saved report is filed and
/// found again months later, so its name sorts in the only order that is
/// unambiguous in every locale.
pub fn iso_day(epoch: int) -> str {
    return time.iso_day(epoch * 1000, here())
}

/// The first and last second of a month written `2026-08`.
pub fn month_bounds(month: str) -> [int] {
    let parts = split(month.trim(), "-")
    if parts.len() != 2 {
        return []
    }
    let parsed_year = parse_int(parts[0])
    let parsed_index = parse_int(parts[1])
    if parsed_year == nil {
        return []
    }
    if parsed_index == nil {
        return []
    }
    // Narrowed by the tests above; bound to plain ints so the arithmetic below
    // is ordinary arithmetic.
    let year = parsed_year
    let index = parsed_index
    if index < 1 || index > 12 {
        return []
    }
    return [
        time.month_start(year, index, here()) / 1000,
        time.month_end(year, index, here()) / 1000,
    ]
}

// ---- listeners and timers ------------------------------------------------------

/// Listen to the window, and let the page carry on if it refuses.
pub fn on_window(name: str, handler: fn()) {
    let (_, err) = window.on(name, handler)
    if err != nil {
        io.error("browser: no \(name) listener: \(err.message())")
    }
}

/// Run something on a fixed interval, for the heartbeat that keeps a lane's
/// "last seen" honest in the back office.
///
/// The timer is dropped rather than kept, because this one runs for as long as
/// the page does — there is no moment at which the back office stops wanting
/// to know which lanes are awake.
pub fn every(ms: int, handler: fn()) {
    let (_, err) = window.every(ms, handler)
    if err != nil {
        io.error("browser: could not set an interval: \(err.message())")
    }
}

// ---- remembering, and where we are ---------------------------------------------
//
// Reading needs no wrapper — `window.kept` and `window.hash` are called
// directly wherever they are wanted. Writing does, because each of these can
// fail and none of them is worth a failed sale.

pub fn keep(key: str, value: str) {
    let err = window.keep(key, value)
    if err != nil {
        io.error("browser: could not keep \(key)")
    }
}

pub fn drop_kept(key: str) {
    let err = window.drop_kept(key)
    if err != nil {
        io.error("browser: could not drop \(key)")
    }
}

pub fn set_hash(fragment: str) {
    let err = window.set_hash(fragment)
    if err != nil {
        io.error("browser: could not navigate")
    }
}

/// The browser's own print dialog.
///
/// A receipt is printed by printing the page: `@media print` in the stylesheet
/// drops the rail, the header and every card except the receipt itself, so
/// there is nothing here to build.
pub fn print_page() {
    let err = window.print_page()
    if err != nil {
        io.error("browser: could not print")
    }
}

/// Ask the browser to install the service worker.
pub fn register_worker(path: str) {
    let err = window.register_worker(path)
    if err != nil {
        io.error("browser: no service worker: \(err.message())")
    }
}

// ---- the page a till touches -----------------------------------------------------

/// The nearest ancestor matching a selector, including the element itself.
///
/// Not in `std/dom`, which has no `closest` — the one function of the twelve
/// both applications shared that still has no home in the standard library.
pub fn closest(e: dom.Element, selector: str) -> Option<dom.Element> {
    let (found, err) = js.call1(dom.raw(e), "closest", js.of_str(selector))
    if err != nil {
        return nil
    }
    if js.is_nothing(found) {
        return nil
    }
    return dom.wrap(found)
}

pub fn focus(selector: str) {
    let target = dom.find(selector)
    if target == nil {
        return
    }
    let (_, err) = js.call0(dom.raw(target), "focus")
    if err != nil {
        io.error("browser: could not focus \(selector)")
    }
}

/// Empty a field and put the caret back in it.
///
/// The scan box has to be ready for the next barcode the instant the last one
/// lands, and a scanner is a fast keyboard that types wherever the focus is.
pub fn clear_and_focus(selector: str) {
    let target = dom.find(selector)
    if target == nil {
        return
    }
    let err = dom.set_value(target, "")
    if err != nil {
        return
    }
    let (_, ferr) = js.call0(dom.raw(target), "focus")
    if ferr != nil {
        io.error("browser: could not focus \(selector)")
    }
}

/// A `<meta name="…" content="…">` from the page, or "".
///
/// How a deployment tells the program where its API is without a rebuild: the
/// same `dist/` is a test shop or a real one depending on one line of HTML.
pub fn meta(name: str) -> str {
    let tag = dom.find("meta[name=\"\(name)\"]")
    if tag == nil {
        return ""
    }
    let value = dom.attribute(tag, "content")
    if value == nil {
        return ""
    }
    return value
}

/// The document's own `lang`.
///
/// Not decoration: the stylesheet keys Burmese's taller line box off it, so
/// this is the one write that makes မြန်မာ legible rather than cramped. One
/// attribute rather than a class on every string.
pub fn set_document_lang(tag: str) {
    let (root, err) = js.get(js.global("document"), "documentElement")
    if err != nil {
        return
    }
    let serr = js.set(root, "lang", js.of_str(tag))
    if serr != nil {
        io.error("browser: could not set the document language")
    }
}

// ---- saving a file ---------------------------------------------------------

/// Hand the operator a file.
///
/// An export cannot be a plain link: the Worker wants an `Authorization`
/// header, and a link carries none — and putting the token in the query string
/// instead would write a credential into the browser's history and every log
/// between here and there. So the body is fetched with the header, turned into
/// a blob, and saved through an anchor that is created, clicked and thrown
/// away.
///
/// **The byte-order mark is added here**, and that is not belt-and-braces: the
/// Worker puts one at the front of every CSV, and the `fetch` that brought it
/// back stripped it while decoding, because that is what a UTF-8 decoder is
/// specified to do. Re-encoding without it would hand Excel on Windows a file
/// it reads in the system code page — which turns every Burmese character in
/// it into mojibake. It goes in as its own blob part, so no string in this
/// program has to carry an invisible character.
pub fn download(filename: str, body: str, mime: str) {
    let (parts, aerr) = js.new0("Array")
    if aerr != nil {
        io.error("browser: could not build the file")
        return
    }
    let bom = js.call1(js.global("String"), "fromCharCode", js.of_num(65279.0))
    let (mark, berr) = bom
    if berr == nil {
        let (_, perr) = js.call1(parts, "push", mark)
        if perr != nil {
            io.error("browser: could not mark the file")
        }
    }
    let (_, perr) = js.call1(parts, "push", js.of_str(body))
    if perr != nil {
        io.error("browser: could not fill the file")
        return
    }

    let (options, oerr) = js.new0("Object")
    if oerr != nil {
        io.error("browser: could not describe the file")
        return
    }
    let terr = js.set(options, "type", js.of_str(mime))
    if terr != nil {
        io.error("browser: could not type the file")
        return
    }

    let (blob, blerr) = js.new2("Blob", parts, options)
    if blerr != nil {
        io.error("browser: this browser cannot make a file")
        return
    }
    let (url, uerr) = js.call1(js.global("URL"), "createObjectURL", blob)
    if uerr != nil {
        io.error("browser: could not name the file")
        return
    }
    let (link, lerr) = dom.create("a")
    if lerr != nil {
        io.error("browser: could not make the link")
        return
    }
    let (href, herr) = js.as_str(url)
    if herr != nil {
        io.error("browser: could not read the file's address")
        return
    }
    let h1 = dom.set_attribute(link, "href", href)
    let h2 = dom.set_attribute(link, "download", filename)
    if h1 != nil || h2 != nil {
        io.error("browser: could not address the link")
        return
    }
    let (_, cerr) = js.call0(dom.raw(link), "click")
    if cerr != nil {
        io.error("browser: could not save the file")
    }
    // The object URL holds the whole file in memory until it is let go.
    let (_, rerr) = js.call1(js.global("URL"), "revokeObjectURL", url)
    if rerr != nil {
        io.error("browser: could not release the file")
    }
}

// ---- pictures --------------------------------------------------------------

/// Send the picture a file input is holding, and answer with its key.
///
/// **Not through `api.kite`.** `std/http` sends a `str` body, and an image is
/// bytes — re-encoding one as text to get it through a typed door would double
/// its size and corrupt it. So this is `fetch` reached through the JS bridge
/// with the `File` handed over untouched, which is also what lets the browser
/// stream it rather than holding a copy.
///
/// The content type comes off the file itself, because that is what the Worker
/// keys its allow-list on — and what R2 will serve it back as.
pub fn upload_photo(url: str, token: str, input: dom.Element,
    done: fn(str), failed: fn(str)) {
    let (files, ferr) = js.get(dom.raw(input), "files")
    if ferr != nil {
        failed("that input has no file")
        return
    }
    // Split, because Kite will not let `count` be read in the same expression
    // that tests its error — the value is only meaningful once `cerr` is nil.
    let (count, cerr) = js.length(files)
    if cerr != nil {
        failed("that input has no file")
        return
    }
    if count == 0 {
        failed("nothing was chosen")
        return
    }
    let (file, aerr) = js.at(files, 0)
    if aerr != nil {
        failed("that file could not be read")
        return
    }

    let (headers, herr) = js.new0("Object")
    if herr != nil {
        failed("could not build the request")
        return
    }
    let type_err = js.set(headers, "content-type",
        js.of_str(js.str_or(file, "type", "application/octet-stream")))
    let auth_err = js.set(headers, "authorization", js.of_str("Bearer \(token)"))
    if type_err != nil || auth_err != nil {
        failed("could not build the request")
        return
    }

    let (init, ierr) = js.new0("Object")
    if ierr != nil {
        failed("could not build the request")
        return
    }
    let m_err = js.set(init, "method", js.of_str("PUT"))
    let b_err = js.set(init, "body", file)
    let h_err = js.set(init, "headers", headers)
    if m_err != nil || b_err != nil || h_err != nil {
        failed("could not build the request")
        return
    }

    let (promise, perr) = js.call2(window.raw(), "fetch", js.of_str(url), init)
    if perr != nil {
        failed("the request did not go out")
        return
    }
    let serr = js.settle(promise,
        |response: JsValue| { photo_answered(response, done, failed) },
        |why: str| { failed(why) })
    if serr != nil {
        failed("the request was not answered")
    }
}

/// The response to an upload: refuse a non-2xx, then read the key out of the
/// body. Two settles rather than one because `json()` is itself a promise.
fn photo_answered(response: JsValue, done: fn(str), failed: fn(str)) {
    if !js.bool_or(response, "ok", false) {
        let status = math.round_to(js.num_or(response, "status", 0.0))
        if status == 413 || status == 400 {
            failed("that picture was refused — keep it under 2 MB, as a JPEG, PNG or WebP")
        } else {
            failed("that picture could not be saved (\(status))")
        }
        return
    }
    let (body, berr) = js.call0(response, "json")
    if berr != nil {
        failed("that answer could not be read")
        return
    }
    let serr = js.settle(body,
        |parsed: JsValue| { done(js.str_or(parsed, "key", "")) },
        |why: str| { failed(why) })
    if serr != nil {
        failed("that answer could not be read")
    }
}

/// Empty a file input, so choosing the *same* file twice still fires `change`.
pub fn clear_file(input: dom.Element) {
    let err = js.set(dom.raw(input), "value", js.of_str(""))
    if err != nil {
        io.error("browser: could not clear the file input")
    }
}
