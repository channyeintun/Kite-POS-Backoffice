        "age_check" => "မှတ်ပုံတင်စစ်ဆေးပါ",
        "age_min" => "အနည်းဆုံးအသက်",
        "approve" => "အတည်ပြု",
        "back_to_sale" => "ရောင်းချမှုသို့ပြန်",
