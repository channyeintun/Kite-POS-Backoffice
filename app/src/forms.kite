        desk.form("staff", words.t(l, "staff.add_staff"), words.t(l, "common.add"), [
                desk.required(text_field("name", words.t(l, "common.name"), "")),
                choice_field("role", words.t(l, "staff.role"),
                    ["sale_staff", "manager", "owner"],
                    [words.t(l, "staff.role_sale_staff_option"),
                        words.t(l, "staff.role_manager_option"), words.t(l, "staff.owner")],
                    "sale_staff"),
                desk.hinted(text_field("pin", words.t(l, "staff.pin"), ""),
                    words.t(l, "staff.pin_hint")),
                desk.hinted(text_field("username", words.t(l, "common.username"), ""),
                    words.t(l, "staff.username_hint")),
                desk.field("password", words.t(l, "common.password"), desk.FieldKind.Password, ""),
            ]),
        words.t(l, "staff.a_role_decides_which_app"))
}

