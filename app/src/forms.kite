    return desk.about(
        desk.explained(
            desk.form("staff-password", words.t(l, "staff.set_a_password"),
                words.t(l, "register.set"), [
                    readonly_field("who", words.t(l, "common.staff"), name),
                    desk.required(desk.field("password", words.t(l, "staff.new_password"),
                            desk.FieldKind.Password, "")),
                ]),
            words.t(l, "staff.password_lede")),
