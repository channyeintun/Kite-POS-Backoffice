            },
            words.t(l, "common.save"), [
                desk.required(text_field("name", words.t(l, "common.name"),
                        doc.text(existing, "name", ""))),
                text_field("phone", words.t(l, "common.phone"), doc.text(existing, "phone", "")),
                desk.field("note", words.t(l, "common.note"), desk.FieldKind.Lines,
                    doc.text(existing, "note", "")),
            ]),
