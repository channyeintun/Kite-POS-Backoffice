//! Every dialog in the back office, in one file.
//!
//! A form is a value — see `desk.Form` — so this is a list of constructors and
//! nothing else: no document, no requests, no state. `office.kite` opens one of
//! these when a button is pressed and matches on the same `id` when it is
//! submitted, so what a form *asks for* and what it *does* sit one function
//! apart and cannot drift.
//!
//! Money fields are pre-filled and read back as the shop writes amounts, which
//! for a zero-decimal currency means "18500" and for one with cents "185.00".
//! `money.from_text` is the one place that conversion happens.
//!
//! Every constructor takes the language first among the things it is told,
//! because a label, a hint and a dropdown's options are all chrome. What a
//! field is *called* switches; what it holds — a supplier's name, an account
//! code, a barcode — does not.

use desk
use doc
use i18n
use money
use screens
use words

fn text_field(name: str, label: str, value: str) -> desk.Field {
    return desk.field(name, label, desk.FieldKind.Text, value)
}

fn money_field(name: str, label: str, value: int, c: money.Currency) -> desk.Field {
    return desk.field(name, label, desk.FieldKind.Money, money.plain(value, c))
}

fn whole_field(name: str, label: str, value: int) -> desk.Field {
    return desk.field(name, label, desk.FieldKind.Whole, "\(value)")
}

fn qty_field(name: str, label: str, value: float) -> desk.Field {
    return desk.field(name, label, desk.FieldKind.Quantity, money.quantity(value))
}

fn toggle_field(name: str, label: str, on: bool, hint: str) -> desk.Field {
    return desk.hinted(desk.field(name, label, desk.FieldKind.Toggle, if on { "1" } else { "0" }), hint)
}

fn choice_field(name: str, label: str, options: [str], labels: [str], value: str) -> desk.Field {
    return desk.field(name, label, desk.FieldKind.Choice(options: options, labels: labels), value)
}

fn readonly_field(name: str, label: str, value: str) -> desk.Field {
    return desk.field(name, label, desk.FieldKind.Readonly, value)
}

/// The empty option at the top of a dropdown that may be left unanswered.
///
/// A phrase rather than a blank line, because a select whose first option is
/// empty looks broken rather than optional.
fn none_option(l: i18n.Lang) -> str {
    return words.t(l, "common.none_dash")
}

// ---- the catalogue ---------------------------------------------------------

/// Add or edit a product.
///
/// The same form both ways: an empty `id` means a new one, and the values are
/// whatever the product already had. Two forms would drift the day a column is
/// added, which is the sort of drift a shop notices as "the edit screen has
/// forgotten about age restrictions".
pub fn product(existing: doc.Doc, id: str, categories: [doc.Doc], suppliers: [doc.Doc],
    l: i18n.Lang, c: money.Currency) -> desk.Form {
    var category_ids: [str] = [""]
    var category_names: [str] = [none_option(l)]
    for cat in categories {
        category_ids.push(doc.text(cat, "id", ""))
        category_names.push(doc.text(cat, "name", ""))
    }
    var supplier_ids: [str] = [""]
    var supplier_names: [str] = [none_option(l)]
    for s in suppliers {
        supplier_ids.push(doc.text(s, "id", ""))
        supplier_names.push(doc.text(s, "name", ""))
    }

    let fields: [desk.Field] = [
        desk.required(text_field("sku", words.t(l, "products.sku"),
                doc.text(existing, "sku", ""))),
        desk.required(text_field("name", words.t(l, "common.name"),
                doc.text(existing, "name", ""))),
        desk.hinted(text_field("name_my", words.t(l, "products.name_my"),
                doc.text(existing, "name_my", "")),
            words.t(l, "products.name_my_hint")),
        choice_field("category_id", words.t(l, "common.category"), category_ids, category_names,
            doc.text(existing, "category_id", "")),
        choice_field("supplier_id", words.t(l, "common.supplier"), supplier_ids, supplier_names,
            doc.text(existing, "supplier_id", "")),
        money_field("price", words.t(l, "products.shelf_price"),
            doc.int_of(existing, "price", 0), c),
        money_field("cost", words.t(l, "common.cost"), doc.int_of(existing, "cost", 0), c),
        desk.hinted(whole_field("tax_bp", words.t(l, "products.tax_bp"),
                doc.int_of(existing, "tax_bp", 0)),
            words.t(l, "products.tax_bp_hint")),
        desk.hinted(whole_field("min_age", words.t(l, "products.minimum_age"),
                doc.int_of(existing, "min_age", 0)),
            words.t(l, "products.min_age_hint")),
        choice_field("unit", words.t(l, "products.sold_by"), ["each", "kg", "litre", "pack"],
            [words.t(l, "products.unit_each"), words.t(l, "products.unit_kilo"),
                words.t(l, "products.unit_litre"), words.t(l, "products.unit_pack")],
            doc.text(existing, "unit", "each")),
        toggle_field("ask_price", words.t(l, "products.price_at_till"),
            doc.int_of(existing, "ask_price", 0) == 1,
            words.t(l, "products.ask_for_a_price_at_the_till")),
        qty_field("reorder_point", words.t(l, "common.reorder_at"),
            doc.num_of(existing, "reorder_point", 0.0)),
        qty_field("reorder_qty", words.t(l, "products.reorder_quantity"),
            doc.num_of(existing, "reorder_qty", 0.0)),
        desk.hinted(whole_field("quick_key", words.t(l, "products.favourites_position"),
                doc.int_of(existing, "quick_key", 0)),
            words.t(l, "products.quick_key_hint")),
        toggle_field("active", words.t(l, "products.for_sale"),
            doc.int_of(existing, "active", 1) == 1,
            words.t(l, "products.for_sale_hint")),
    ]
    return desk.about(
        desk.form("product",
            if id.len() > 0 {
                words.t(l, "products.edit_product")
            } else {
                words.t(l, "products.add_a_product")
            },
            words.t(l, "common.save"), fields),
        id)
}

pub fn barcode(product_id: str, product_name: str, l: i18n.Lang) -> desk.Form {
    return desk.about(
        desk.explained(
            desk.form("barcode", words.t(l, "products.add_a_barcode"), words.t(l, "common.add"), [
                    readonly_field("product", words.t(l, "common.product"), product_name),
                    desk.required(text_field("barcode", words.t(l, "common.barcode"), "")),
                    desk.hinted(qty_field("pack_size", words.t(l, "products.units_per_scan"), 1.0),
                        words.t(l, "products.pack_size_hint")),
                    text_field("label", words.t(l, "common.label"), ""),
                ]),
            words.t(l, "products.barcode_lede")),
        product_id)
}

pub fn category(existing: doc.Doc, id: str, l: i18n.Lang) -> desk.Form {
    return desk.about(
        desk.form("category",
            if id.len() > 0 {
                words.t(l, "categories.edit_category")
            } else {
                words.t(l, "categories.add_a_category")
            },
            words.t(l, "common.save"), [
                desk.required(text_field("name", words.t(l, "common.name"),
                        doc.text(existing, "name", ""))),
                text_field("name_my", words.t(l, "products.name_my"),
                    doc.text(existing, "name_my", "")),
                whole_field("sort", words.t(l, "categories.position"),
                    doc.int_of(existing, "sort", 0)),
            ]),
        id)
}

pub fn supplier(existing: doc.Doc, id: str, l: i18n.Lang) -> desk.Form {
    return desk.about(
        desk.form("supplier",
            if id.len() > 0 {
                words.t(l, "suppliers.edit_supplier")
            } else {
                words.t(l, "suppliers.add_a_supplier")
            },
            words.t(l, "common.save"), [
                desk.required(text_field("name", words.t(l, "common.name"),
                        doc.text(existing, "name", ""))),
                text_field("phone", words.t(l, "common.phone"), doc.text(existing, "phone", "")),
                text_field("email", words.t(l, "common.email"), doc.text(existing, "email", "")),
                desk.field("address", words.t(l, "common.address"), desk.FieldKind.Lines,
                    doc.text(existing, "address", "")),
                desk.hinted(whole_field("lead_days", words.t(l, "suppliers.lead_time_days"),
                        doc.int_of(existing, "lead_days", 3)),
                    words.t(l, "suppliers.lead_days_hint")),
                toggle_field("active", words.t(l, "suppliers.still_buying_from_them"),
                    doc.int_of(existing, "active", 1) == 1, words.t(l, "common.active")),
            ]),
        id)
}

// ---- offers ----------------------------------------------------------------

pub fn promotion(existing: doc.Doc, id: str, products: [doc.Doc], categories: [doc.Doc],
    l: i18n.Lang, c: money.Currency) -> desk.Form {
    var product_ids: [str] = [""]
    var product_names: [str] = [none_option(l)]
    for p in products {
        product_ids.push(doc.text(p, "id", ""))
        product_names.push(doc.text(p, "name", ""))
    }
    var category_ids: [str] = [""]
    var category_names: [str] = [none_option(l)]
    for cat in categories {
        category_ids.push(doc.text(cat, "id", ""))
        category_names.push(doc.text(cat, "name", ""))
    }

    return desk.about(
        desk.explained(
            desk.form("promotion",
                if id.len() > 0 {
                    words.t(l, "promotions.edit_offer")
                } else {
                    words.t(l, "promotions.add_an_offer")
                },
                words.t(l, "common.save"), [
                    desk.required(text_field("name", words.t(l, "promotions.name_on_the_receipt"),
                            doc.text(existing, "name", ""))),
                    text_field("name_my", words.t(l, "products.name_my"),
                        doc.text(existing, "name_my", "")),
                    choice_field("kind", words.t(l, "common.kind"),
                        ["percent_off", "amount_off", "fixed_price", "n_for_x"],
                        [words.t(l, "promotions.percentage_off"),
                            words.t(l, "promotions.amount_off_each"),
                            words.t(l, "promotions.fixed_price_each"),
                            words.t(l, "promotions.multibuy")],
                        doc.text(existing, "kind", "percent_off")),
                    desk.hinted(whole_field("value", words.t(l, "common.value"),
                            doc.int_of(existing, "value", 0)),
                        words.fill(l, "promotions.value_hint", c.code)),
                    desk.hinted(whole_field("n", words.t(l, "promotions.buy_how_many"),
                            doc.int_of(existing, "n", 0)),
                        words.t(l, "promotions.n_hint")),
                    choice_field("scope", words.t(l, "promotions.applies_to"),
                        ["product", "category", "all"],
                        [words.t(l, "promotions.one_product"),
                            words.t(l, "promotions.a_whole_category"),
                            words.t(l, "promotions.everything")],
                        doc.text(existing, "scope", "product")),
                    choice_field("product_id", words.t(l, "common.product"),
                        product_ids, product_names,
                        doc.text(existing, "product_id", "")),
                    choice_field("category_id", words.t(l, "common.category"),
                        category_ids, category_names,
                        doc.text(existing, "category_id", "")),
                    desk.hinted(whole_field("priority", words.t(l, "promotions.priority"),
                            doc.int_of(existing, "priority", 0)),
                        words.t(l, "promotions.only_breaks_a_tie_between_equal_offers")),
                    toggle_field("active", words.t(l, "promotions.live"),
                        doc.int_of(existing, "active", 1) == 1,
                        words.t(l, "promotions.running")),
                ]),
            words.t(l, "promotions.offers_do_not_stack")),
        id)
}

