//! The till: what to mount, what to listen to, and what a touch means.
//!
//! This is the wiring. It mounts a description, attaches three listeners, and
//! turns each event into a call on somebody else — `till.kite` says what the
//! screen looks like, `api.kite` talks to the Worker, and `store.kite` holds
//! the value both of them are about.
//!
//! **Every closure in this program is created here**, and that is a language
//! rule showing through rather than a filing decision: a closure may not
//! capture a `var`, so the handlers are made where `app` is a `let` and each
//! calls an ordinary function that takes it as `var`.
//!
//! ## Work is marked as started on the line that starts it
//!
//! Calling an `async fn` in Kite does not run its body — it queues a state
//! machine the scheduler polls on a later turn. So a guard written at the top
//! of an async body has not run yet when the next event arrives, and a cashier
//! double-tapping Pay would get two of everything. Every handler below is an
//! ordinary function that writes the guard and repaints *before* the `async`
//! one behind it is called.

use std/crypto
use std/dom
use std/html
use std/window
use api
use browser
use doc
use i18n
use model
use money
use store
use till

// ---- drawing ---------------------------------------------------------------

fn repaint(app: store.App) {
    // The stylesheet keys Burmese's taller line box off the document's `lang`,
    // so this has to be written before the description that depends on it.
    browser.set_document_lang(i18n.tag_of(app.lang))
    let err = html.update(app.view, till.page(app))
    if err != nil {
        io.error("till: could not draw: \(err.message())")
        return
    }
    // **Nothing is focused from here.**
    //
    // This used to end with `browser.focus("#scan")`, unconditionally, on every
    // repaint — and every tap repaints. The promise it was keeping is real: a
    // barcode scanner is a fast keyboard and whatever it types has to land in
    // the box. The way it kept it was not. Tapping a tile, a tab, a basket line
    // or the language chip pulled the caret out of wherever the operator had
    // just put it, and on a tablet it did so inside the tap's own gesture — so
    // the on-screen keyboard came back up and the layout jumped, on every
    // single touch.
    //
    // The promise is kept at the other end now: `typed` listens on the document
    // rather than on this tree, so a scanner's burst reaches the till with
    // nothing focused at all, and is written into the box a character at a
    // time. The focus is left where the operator put it.
}

fn field_value(selector: str) -> str {
    let field = dom.find(selector)
    if field == nil {
        return ""
    }
    return dom.value(field).trim()
}

// ---- signing in ------------------------------------------------------------

/// A digit on the pad. **The pad never submits by itself.**
///
/// It used to, on the fourth digit — "four digits is the common case, and
/// submitting on the fourth saves a tap at the busiest moment of the day. A
/// longer PIN uses the → key." The → key was unreachable: the auto-submit fired
/// before a fifth digit could be pressed. So every PIN of five to eight digits
/// — which the back office invites, in so many words, on the form that sets one
/// — was sent to the Worker as its first four characters, refused, and the pad
/// cleared itself before the cashier could finish. A shop could add staff all
/// day and none of them could sign in, while the one person whose PIN happened
/// to be exactly four digits worked perfectly.
///
/// One tap was worth having. It was not worth a member of staff who cannot
/// open a lane, so the → key is the only way in now and it means what it says.
fn press_pin(app: store.App, key: str) {
    store.press_pin(app, key)
    repaint(app)
}

fn submit_pin(app: store.App) {
    if app.signing_in {
        return
    }
    // Said rather than ignored. → is the only way in now, so a press that does
    // nothing at all reads as a broken pad — which is the complaint this whole
    // screen is being changed to answer.
    if app.pin.len() < 4 {
        store.went_wrong(app, i18n.t(app.lang, "pin_too_short"))
        repaint(app)
        return
    }
    store.signing_in(app, true)
    repaint(app)
    do_sign_in(app, app.pin)
}

async fn do_sign_in(app: store.App, pin: str) {
    let lane = or_else(window.kept("kite-pos.register"), "reg_1")
    let (session, err) = await api.sign_in_with_pin(pin, lane)
    if err != nil {
        store.signing_in(app, false)
        store.went_wrong(app, err.message())
        store.press_pin(app, "clear")
        repaint(app)
        return
    }
    browser.keep("kite-pos.token", session.token)
    store.signed_in(app, session)
    repaint(app)
    load_everything(app)
}

async fn resume(app: store.App, token: str) {
    let (session, err) = await api.whoami(token)
    if err != nil {
        // An expired or unknown token is not an error the cashier can act on;
        // it is simply the sign-in screen.
        browser.drop_kept("kite-pos.token")
        store.signing_in(app, false)
        store.restoring(app, false)
        repaint(app)
        return
    }
    store.signed_in(app, session)
    repaint(app)
    load_everything(app)
}

/// Signing off, and the one thing that stops it.
///
/// **A basket with lines on it is refused.** The status bar is a row of small
/// targets beside the scan field, and a mis-tap that signed the cashier out
/// mid-transaction would leave the customer's shopping stranded on a lane
/// nobody is on. Hold parks it in one press and Void clears it; either makes
/// this legal. That is also why there is no "are you sure" here — the refusal
/// is more useful than a dialog, because it names what to do instead.
fn sign_off(app: store.App) {
    if app.basket.lines.len() > 0 {
        store.went_wrong(app, i18n.t(app.lang, "sign_out_busy"))
        repaint(app)
        return
    }
    let token = store.token_of(app)
    browser.drop_kept("kite-pos.token")
    store.signed_out(app)
    repaint(app)
    do_sign_out(token)
}

async fn do_sign_out(token: str) {
    let (_, err) = await api.sign_out(token)
    if err != nil {
        io.error("till: sign-out did not reach the server")
    }
}

// ---- loading ---------------------------------------------------------------

fn load_everything(app: store.App) {
    load_catalogue(app)
    refresh(app)
}

async fn load_catalogue(app: store.App) {
    // `.0` is the products and `.1` the categories — see `api.grid`, which is
    // where the two lists are named and where a heading that will not decode
    // becomes this `err`.
    let (catalogue, err) = await api.grid(store.token_of(app))
    if err != nil {
        store.reachable(app, false)
        repaint(app)
        return
    }
    store.took_catalogue(app, catalogue.0, catalogue.1)
    store.reachable(app, true)
    repaint(app)
}

async fn refresh(app: store.App) {
    let (basket, err) = await api.basket(store.token_of(app))
    if err != nil {
        store.reachable(app, false)
        store.went_wrong(app, err.message())
        repaint(app)
        return
    }
    store.took_basket(app, basket)
    repaint(app)
}

/// A call that did not get through.
///
/// The connection dot is set from this rather than from `navigator.onLine`,
/// which says true for a device attached to a router with no internet behind
/// it. Whether the last request actually worked is the only thing this end can
/// honestly know.
fn failed(app: store.App, why: str) {
    store.reachable(app, false)
    store.went_wrong(app, why)
    repaint(app)
}

/// What every basket-changing call does with its answer.
///
/// One shape for all of them: a scan, a quantity change and a discount all come
/// back as the whole basket, so the lines, the totals and the badges cannot
/// show different numbers to each other.
///
/// Kite will not let an error be handed to another function to look at — it has
/// to be tested in the scope it arrived in — so every caller checks its own
/// failure and only a success reaches here. That is a better shape anyway: this
/// function is about baskets, not about the network.
///
/// The branch is on an [`api.Answer`] variant, not on a `needs` string read out
/// of a document. The three arms are the three answers, the compiler counts
/// them, and no key name or tag spelling appears in this file — those live in
/// `api.answer_of`, next to the endpoints that produce them.
fn settle(app: store.App, answer: api.Answer) {
    store.reachable(app, true)

    match answer {
        // A 422 is a step in the sale rather than a failure of one: the till is
        // being told it needs ID, or a price, before this item can go on. Both
        // arms leave the basket exactly as it was — the item did not go on —
        // and neither dismisses, because each is *opening* a dialog.
        NeedsAgeCheck(name, min_age, born_before, product_id) => {
            // `code` is empty because the server's age_check 422 does not send
            // one: it identifies the product by id, and the re-scan on approval
            // goes back out by `product_id`. Unchanged from before the enum.
            store.show(app, store.Overlay.AgeCheck(
                    name: name,
                    min_age: min_age,
                    born_before: born_before,
                    code: "",
                    product_id: product_id))
            repaint(app)
            return
        },
        // `unit` is carried on the answer and the price dialog has nowhere to
        // put it yet, so it is discarded here rather than at the boundary —
        // where it would be lost to every future reader of that dialog too.
        NeedsPrice(name, product_id, _) => {
            store.show(app, store.Overlay.AskPrice(name: name, product_id: product_id))
            repaint(app)
            return
        },
        // The ordinary path, and the one an untagged answer takes.
        Basket(basket) => {
            store.took_basket(app, basket)
            store.dismiss(app)
            repaint(app)
            return
        },
    }
}

// ---- ringing ---------------------------------------------------------------

fn scan_typed(app: store.App) {
    let code = field_value("#scan")
    if code.len() == 0 {
        return
    }
    browser.clear_field("#scan")
    store.working(app, true)
    do_scan(app, code, "", 0.0, false, 0, false)
}

fn tap_tile(app: store.App, product_id: str) {
    let product = store.product_of(app, product_id)
    if product == nil {
        return
    }
    store.working(app, true)
    repaint(app)
    do_scan(app, "", product_id, 1.0, false, 0, false)
}

async fn do_scan(app: store.App, code: str, product_id: str, qty: float,
    age_checked: bool, price: int, ask_price: bool) {
    let (answer, err) = await api.scan(store.token_of(app), code, product_id, qty,
        age_checked, price, ask_price)
    if err != nil {
        failed(app, err.message())
        return
    }
    settle(app, answer)
}

async fn do_qty(app: store.App, line_id: str, qty: float) {
    let (answer, err) = await api.set_qty(store.token_of(app), line_id, qty)
    if err != nil {
        failed(app, err.message())
        return
    }
    settle(app, answer)
}

async fn do_void_line(app: store.App, line_id: str) {
    let (answer, err) = await api.void_line(store.token_of(app), line_id)
    if err != nil {
        failed(app, err.message())
        return
    }
    settle(app, answer)
}

async fn do_adjust(app: store.App, line_id: str, kind: str, value: int, manager_pin: str) {
    let (answer, err) = await api.adjust_line(store.token_of(app), line_id, kind, value, manager_pin)
    if err != nil {
        failed(app, err.message())
        return
    }
    settle(app, answer)
}

async fn do_hold(app: store.App, label: str) {
    let (answer, err) = await api.hold(store.token_of(app), label)
    if err != nil {
        failed(app, err.message())
        return
    }
    settle(app, answer)
}

async fn do_recall(app: store.App, id: str) {
    let (answer, err) = await api.recall(store.token_of(app), id)
    if err != nil {
        failed(app, err.message())
        return
    }
    settle(app, answer)
}

async fn do_void_sale(app: store.App, reason: str, manager_pin: str) {
    let (answer, err) = await api.void_sale(store.token_of(app), reason, manager_pin)
    if err != nil {
        failed(app, err.message())
        return
    }
    settle(app, answer)
}

async fn load_held(app: store.App) {
    let (parked, err) = await api.held(store.token_of(app))
    if err != nil {
        store.went_wrong(app, err.message())
        repaint(app)
        return
    }
    store.took_held(app, parked)
    store.show(app, store.Overlay.Held)
    repaint(app)
}

async fn do_search(app: store.App, q: str) {
    let (found, err) = await api.search(store.token_of(app), q)
    if err != nil {
        return
    }
    store.found_products(app, found)
    repaint(app)
}

async fn do_price_check(app: store.App, code: str) {
    let (answer, err) = await api.price_check(store.token_of(app), code)
    if err != nil {
        store.went_wrong(app, err.message())
        repaint(app)
        return
    }
    let saved = answer.promo_saved
    var detail = answer.sku
    if saved > 0 {
        detail = "\(detail) · \(answer.promo_name) · \(i18n.t(app.lang, "saved")) \(money.show(saved, store.currency_of(app)))"
    }
    store.show(app, store.Overlay.PriceCheck(
            name: answer.name,
            detail: detail,
            price: money.show(answer.total, store.currency_of(app))))
    repaint(app)
}

// ---- taking payment --------------------------------------------------------

fn add_tender(app: store.App) {
    let typed = money.from_keys(app.entry, store.currency_of(app))
    if typed == nil {
        return
    }
    if typed <= 0 {
        return
    }
    let due = store.balance_due(app)
    // Only cash returns change, so a card or a wallet may not be charged more
    // than the balance. The till refuses it here rather than letting the server
    // do it, because the cashier is standing in front of the customer.
    if !model.returns_change(app.tender) && typed > due {
        store.went_wrong(app, i18n.t(app.lang, "only_cash_change"))
        repaint(app)
        return
    }
    // A tab belongs to somebody, and only up to what they are trusted with.
    //
    // Both of these are refused by the server too — they have to be, because a
    // limit enforced only at a lane is not a limit. Saying so here is about
    // *when* the cashier finds out: while the customer is still choosing how
    // to pay, rather than after pressing Pay on a basket that has to be taken
    // apart again.
    if model.needs_customer(app.tender) && app.basket.customer_name.len() == 0 {
        // Two tenders need somebody and they need them for opposite reasons, so
        // they say so differently: store credit is a balance the shop owes and
        // has none to spend without a holder; a tab is a balance the shop is
        // owed and has nobody to chase.
        store.went_wrong(app, if app.tender == model.Tender.OnAccount {
                i18n.t(app.lang, "tab_needs_customer")
            } else {
                i18n.t(app.lang, "credit_needs_customer")
            })
        repaint(app)
        return
    }
    if app.tender == model.Tender.OnAccount && typed > store.tab_room(app) {
        store.went_wrong(app, i18n.t(app.lang, "tab_no_room"))
        repaint(app)
        return
    }
    store.add_payment(app, model.Payment{ tender: app.tender, amount: typed, reference: "" })
    repaint(app)
}

fn finish(app: store.App) {
    if app.busy {
        return
    }
    if store.balance_due(app) > 0 {
        return
    }
    if app.taken.len() == 0 {
        return
    }
    store.working(app, true)
    repaint(app)
    do_pay(app)
}

async fn do_pay(app: store.App) {
    // The idempotency key is made once **per basket**, not once per attempt —
    // see `store.pay_key_of`. A lane that loses the answer and presses Pay
    // again sends the same key and lands on the same sale, which is the whole
    // reason the server takes one. Minting it here, which is what this did,
    // gave every retry a key the server had never seen.
    let (answer, err) = await api.pay(store.token_of(app), app.taken,
        store.pay_key_of(app, crypto.token()))
    if err != nil {
        store.went_wrong(app, err.message())
        repaint(app)
        return
    }
    let change = answer.change
    let number = answer.number
    let owing = answer.on_account
    store.clear_payments(app)
    store.go_to_mode(app, store.Mode.Sale)
    // The one line the cashier reads back to the customer: change first,
    // because there is money in their hand waiting for it, then what went on
    // the tab. **Both, not one or the other** — a customer who says "put 500 on
    // my tab" and hands over the only note they have gets change *and* a debt,
    // and an else-if told them about the change only. The tab figure comes back
    // off the rows, so a replay says the same thing.
    var said = "#\(number)"
    if change > 0 {
        said = "\(said) · \(i18n.t(app.lang, "change_due")) \(money.show(change, store.currency_of(app)))"
    }
    if owing > 0 {
        said = "\(said) · \(i18n.t(app.lang, "on_account")) \(money.show(owing, store.currency_of(app)))"
    }
    store.say(app, said)
    repaint(app)
    refresh(app)
}

// ---- what a touch means ----------------------------------------------------

fn command(app: store.App, id: str) {
    // **Every arm returns.** Not decoration: an arm whose last expression is a
    // call to an `async fn` yields that call's `Task<()>`, and a `match` needs
    // one type across its arms — so `load_held(app)` alone made this arm a
    // `Task<()>` against the others' `()`. A returning arm diverges instead,
    // which unifies with anything and is the shape the spec's own `fn area`
    // example uses. The nested guards inside `price_check` and `discount` are
    // their own — they belong to those arms, not to the table.
    match id {
        "hold" => {
            store.show(app, store.Overlay.Confirm(purpose: "hold",
                    message: i18n.t(app.lang, "label")))
            repaint(app)
            return
        },
        "held" => {
            load_held(app)
            return
        },
        "price_check" => {
            let code = field_value("#scan")
            if code.len() == 0 {
                store.went_wrong(app, i18n.t(app.lang, "scan_hint"))
                repaint(app)
                return
            }
            browser.clear_field("#scan")
            do_price_check(app, code)
            return
        },
        "void_sale" => {
            store.show(app, store.Overlay.Confirm(purpose: "void_sale",
                    message: i18n.t(app.lang, "reason")))
            repaint(app)
            return
        },
        "discount" => {
            let line = last(app.basket.lines)
            if line == nil {
                return
            }
            store.show(app, store.Overlay.Keypad(purpose: "discount", line_id: line.id,
                    title: "\(i18n.t(app.lang, "discount")) · \(line.name)"))
            repaint(app)
            return
        },
        "customer" => {
            store.show(app, store.Overlay.Customers)
            repaint(app)
            browser.focus("#who")
            load_customers(app, "")
            return
        },
        "return" => {
            store.show(app, store.Overlay.Receipts(purpose: "return"))
            repaint(app)
            browser.focus("#receipt")
            load_receipts(app, "")
            return
        },
        "receipt" => {
            store.show(app, store.Overlay.Receipts(purpose: "print"))
            repaint(app)
            browser.focus("#receipt")
            load_receipts(app, "")
            return
        },
        "no_sale" => {
            // Manager-only and logged to the shift: the drawer coming open outside
            // a transaction is the single most useful line in an audit trail.
            store.show(app, store.Overlay.Confirm(purpose: "no_sale",
                    message: i18n.t(app.lang, "why")))
            repaint(app)
            return
        },
        "close_lane" => {
            store.show(app, store.Overlay.Keypad(purpose: "close_lane", line_id: "",
                    title: i18n.t(app.lang, "counted")))
            repaint(app)
            return
        },
        // A command the matrix names but this build does not handle yet does
        // nothing, which is what falling off the end of the chain did.
        _ => { },
    }
}

// ---- customers, returns, the drawer ----------------------------------------

async fn load_customers(app: store.App, q: str) {
    let (who, err) = await api.customers_at_till(store.token_of(app), q)
    if err != nil {
        failed(app, err.message())
        return
    }
    store.took_customers(app, who)
    repaint(app)
}

async fn do_attach_customer(app: store.App, id: str) {
    let (answer, err) = await api.set_customer(store.token_of(app), id)
    if err != nil {
        failed(app, err.message())
        return
    }
    settle(app, answer)
}

/// Money off a tab, taken at the counter.
///
/// A plain `fn` in front of the async one, like `finish`: an `async fn` body
/// does not run when it is called, it queues — so a guard written at the top of
/// one has not run when the next tap arrives. The busy flag has to be set here,
/// before anything is awaited, or a double tap sends two settlements.
fn settle_tab(app: store.App, customer_id: str) {
    if app.busy {
        return
    }
    let typed = money.from_keys(app.entry, store.currency_of(app))
    if typed == nil {
        return
    }
    if typed <= 0 {
        return
    }
    store.working(app, true)
    repaint(app)
    do_settle_tab(app, customer_id, typed)
}

async fn do_settle_tab(app: store.App, customer_id: str, amount: int) {
    // The key is kept on `App` against this customer, not made here and not
    // held in the dialog — see `store.settle_key_of`. A key of its own, too,
    // not the basket's: `pay_key` belongs to a sale and is reset when the
    // basket changes, and borrowing it would let a retried settlement be
    // answered with a sale.
    let (answer, err) = await api.pay_tab(store.token_of(app), customer_id, amount,
        model.Tender.Cash, store.settle_key_of(app, customer_id, crypto.token()))
    if err != nil {
        failed(app, err.message())
        return
    }
    store.reachable(app, true)
    store.settled_tab(app)
    store.dismiss(app)
    // What was taken, and what is left — the two things the cashier reads back
    // over the counter.
    store.say(app, "\(i18n.t(app.lang, "tab_paid")) \(money.show(answer.total, store.currency_of(app))) · \(i18n.t(app.lang, "owes")) \(money.show(answer.owed, store.currency_of(app)))")
    store.working(app, false)
    // **Drawn here, before the refresh.** `refresh` is an `async fn`, so calling
    // it only queues — nothing reaches the screen on this turn. Without this the
    // dialog sat there for a whole round trip after the money had been taken,
    // and if that basket read then failed on the same bad link, the first paint
    // after a *successful* settlement was the red offline bar with the
    // confirmation never shown at all.
    repaint(app)
    // The basket is refreshed because the customer on it may be the one who
    // just settled, and the tender screen reads their remaining room off it.
    refresh(app)
}

async fn do_new_customer(app: store.App, name: str, phone: str) {
    let (answer, err) = await api.new_customer(store.token_of(app), name, phone)
    if err != nil {
        failed(app, err.message())
        return
    }
    do_attach_customer(app, answer.id)
}

async fn load_slip(app: store.App, id: str) {
    let (slip, err) = await api.slip(store.token_of(app), id)
    if err != nil {
        failed(app, err.message())
        return
    }
    store.took_slip(app, slip)
    repaint(app)
}

async fn load_receipts(app: store.App, q: str) {
    let (found, err) = await api.receipts(store.token_of(app), q)
    if err != nil {
        failed(app, err.message())
        return
    }
    store.took_receipts(app, found)
    repaint(app)
}

async fn load_receipt(app: store.App, id: str) {
    let (answer, err) = await api.receipt(store.token_of(app), id)
    if err != nil {
        failed(app, err.message())
        return
    }
    store.took_return_lines(app, answer.lines)
    store.show(app, store.Overlay.Returning(sale_id: id, number: answer.number))
    repaint(app)
}

fn step_return(app: store.App, id: str, by: float) {
    let line = find(app.returning, |l: model.ReturnLine| l.id == id)
    if line == nil {
        return
    }
    store.set_return_qty(app, id, line.taking + by)
    repaint(app)
}

async fn do_return(app: store.App, sale_id: str, reason: str, manager_pin: str) {
    let (answer, err) = await api.take_return(store.token_of(app), sale_id,
        app.returning, reason, manager_pin)
    if err != nil {
        store.went_wrong(app, err.message())
        repaint(app)
        return
    }
    store.dismiss(app)
    // **What leaves the drawer, not what the goods were worth.**
    //
    // A refund has two legs: anything the customer still owes on the sale comes
    // off their tab first, and only the remainder is counted out of the till.
    // Saying the total here told the cashier to hand over money the shop was
    // never going to book — a K900 line on a basket half paid on account reads
    // "Return K900" while the drawer only expects K400 to leave, so the lane
    // closes short by the difference and the customer is up by it. Both figures
    // are on the answer; both are said.
    let back = doc.int_of(answer, "total", 0)
    let tab = doc.int_of(answer, "on_account", 0)
    let money_back = back - tab
    var said = "\(i18n.t(app.lang, "return")) \(money.show(money_back, store.currency_of(app)))"
    if tab > 0 {
        said = "\(said) · \(i18n.t(app.lang, "on_account")) \(money.show(tab, store.currency_of(app)))"
    }
    store.say(app, said)
    repaint(app)
    refresh(app)
}

async fn do_no_sale(app: store.App, reason: str, manager_pin: str) {
    let (_, err) = await api.no_sale(store.token_of(app), reason, manager_pin)
    if err != nil {
        store.went_wrong(app, err.message())
        repaint(app)
        return
    }
    store.dismiss(app)
    store.say(app, i18n.t(app.lang, "no_sale"))
    repaint(app)
}

async fn do_close_lane(app: store.App, counted: int, manager_pin: str) {
    let (answer, err) = await api.close_lane(store.token_of(app), counted, manager_pin)
    if err != nil {
        store.went_wrong(app, err.message())
        repaint(app)
        return
    }
    // The lane's sessions are gone, so this device is signed out — which is
    // what closing a drawer means.
    let variance = answer.variance
    browser.drop_kept("kite-pos.token")
    store.signed_out(app)
    store.say(app, "\(i18n.t(app.lang, "close_lane")) · \(money.show(variance, store.currency_of(app)))")
    repaint(app)
}

fn clicked(app: store.App, e: dom.Event) {
    let hit = dom.target(e)
    if hit == nil {
        return
    }
    let acted = browser.closest(hit, "[data-action]")
    if acted == nil {
        return
    }
    let name = dom.attribute(acted, "data-action")
    if name == nil {
        return
    }
    let id = or_else(dom.attribute(acted, "data-id"), "")
    let purpose = or_else(dom.attribute(acted, "data-purpose"), "")
    _ = dom.prevent_default(e)

    if name == "pin-key" {
        press_pin(app, id)
        return
    }
    if name == "pin-go" {
        submit_pin(app)
        return
    }
    if name == "lang-en" {
        store.set_lang(app, i18n.Lang.En)
        browser.keep("kite-pos.lang", "en")
        repaint(app)
        return
    }
    if name == "lang-my" {
        store.set_lang(app, i18n.Lang.My)
        browser.keep("kite-pos.lang", "my")
        repaint(app)
        return
    }
    if name == "tab" {
        store.set_tab(app, id)
        repaint(app)
        return
    }
    if name == "tile" {
        tap_tile(app, id)
        return
    }
    if name == "line" {
        let line = store.line_of(app, id)
        if line == nil {
            return
        }
        store.show(app, store.Overlay.Keypad(purpose: "qty", line_id: id,
                title: "\(i18n.t(app.lang, "quantity")) · \(line.name)"))
        repaint(app)
        return
    }
    if name == "command" {
        command(app, id)
        return
    }
    if name == "dismiss" {
        // Not while something is in flight. Closing a dialog whose request has
        // not answered yet is how a cashier ends up sending the same money
        // twice — they are shown "the lane is offline", close the dialog
        // *because* of it, and open a fresh one. The key on `App` makes the
        // retry safe either way; this makes the dialog stop lying about being
        // idle.
        if app.busy {
            return
        }
        store.dismiss(app)
        repaint(app)
        return
    }
    if name == "pay" {
        if app.basket.lines.len() == 0 {
            return
        }
        store.go_to_mode(app, store.Mode.Tender)
        repaint(app)
        return
    }
    if name == "back-to-sale" {
        store.clear_payments(app)
        store.go_to_mode(app, store.Mode.Sale)
        repaint(app)
        return
    }
    if name == "tender" {
        // **The repaint stays outside.** These five arms do not return — the
        // tail below runs whichever fires, and for an id none of them names it
        // runs alone. Moving the repaint into the arms would stop an
        // unrecognised tender redrawing at all, which is a real change.
        match id {
            "cash" => store.choose_tender(app, model.Tender.Cash),
            "card" => store.choose_tender(app, model.Tender.Card),
            "wallet" => store.choose_tender(app, model.Tender.Wallet),
            "store_credit" => store.choose_tender(app, model.Tender.StoreCredit),
            "on_account" => store.choose_tender(app, model.Tender.OnAccount),
            _ => { },
        }
        repaint(app)
        return
    }
    if name == "key" {
        store.press_key(app, id)
        repaint(app)
        return
    }
    if name == "quick" {
        store.set_entry(app, id)
        repaint(app)
        return
    }
    if name == "add-tender" {
        add_tender(app)
        return
    }
    if name == "finish" {
        finish(app)
        return
    }
    if name == "age-ok" {
        let product_id = or_else(dom.attribute(acted, "data-pid"), "")
        store.dismiss(app)
        repaint(app)
        do_scan(app, id, product_id, 0.0, true, 0, false)
        return
    }
    if name == "price-ok" {
        let typed = money.from_keys(app.entry, store.currency_of(app))
        if typed == nil {
            return
        }
        store.dismiss(app)
        repaint(app)
        do_scan(app, "", id, 1.0, false, typed, true)
        return
    }
    if name == "keypad-ok" {
        let typed = money.from_keys(app.entry, store.currency_of(app))
        if typed == nil {
            return
        }
        // `typed` is narrowed by the guard above and every arm uses it, so it
        // stays there. Note `close_lane` passes no line id — it is a drawer
        // count, not a line amount.
        match purpose {
            "qty" => {
                store.dismiss(app)
                repaint(app)
                do_qty(app, id, typed as float)
                return
            },
            "discount" => {
                // A discount is the "PIN" row of the command matrix: a cashier
                // may take one with a manager's PIN entered at the lane, and a
                // manager needs nobody. The till asks either way and the server
                // decides.
                store.show(app, store.Overlay.ManagerPin(purpose: "discount", line_id: id,
                        amount: typed))
                repaint(app)
                return
            },
            "override" => {
                store.show(app, store.Overlay.ManagerPin(purpose: "override", line_id: id,
                        amount: typed))
                repaint(app)
                return
            },
            "close_lane" => {
                store.show(app, store.Overlay.ManagerPin(purpose: "close_lane", line_id: "",
                        amount: typed))
                repaint(app)
                return
            },
            _ => { },
        }
        return
    }
    if name == "manager-ok" {
        let pin = app.entry
        let value = or_else(parse_int(or_else(dom.attribute(acted, "data-amount"), "0")), 0)
        store.dismiss(app)
        repaint(app)
        // **The default is not a no-op.** Everything this does not name — today
        // "discount" and "override" — goes to `do_adjust` with `purpose` as the
        // kind, so the wildcard has to forward the scrutinee rather than fall
        // silent. Spelling those two out instead would drop any adjust kind the
        // server grows later.
        match purpose {
            "void_sale" => {
                do_void_sale(app, "voided at the lane", pin)
                return
            },
            "return" => {
                // The reason was parked in `notice` when the operator confirmed
                // the lines; it is the only thing that has to survive the PIN
                // dialog.
                do_return(app, id, app.notice, pin)
                return
            },
            "no_sale" => {
                do_no_sale(app, app.notice, pin)
                return
            },
            "close_lane" => {
                do_close_lane(app, value, pin)
                return
            },
            _ => {
                do_adjust(app, id, purpose, value, pin)
                return
            },
        }
    }
    if name == "confirm-ok" {
        let typed = field_value("#reason")
        if typed.len() == 0 {
            return
        }
        store.dismiss(app)
        repaint(app)
        if purpose == "hold" {
            do_hold(app, typed)
            return
        }
        if purpose == "void_sale" {
            do_void_sale(app, typed, "")
            return
        }
        if purpose == "no_sale" {
            store.say(app, typed)
            store.show(app, store.Overlay.ManagerPin(purpose: "no_sale", line_id: "", amount: 0))
            repaint(app)
            return
        }
        return
    }
    if name == "customer-pick" {
        store.dismiss(app)
        repaint(app)
        do_attach_customer(app, id)
        return
    }
    if name == "pay-tab" {
        let who = find(app.customers, |cu: model.Customer| cu.id == id)
        if who == nil {
            return
        }
        store.show(app, store.Overlay.PayTab(customer_id: id, name: who.name,
                owed: who.owed))
        repaint(app)
        return
    }
    if name == "tab-ok" {
        settle_tab(app, id)
        return
    }
    if name == "customer-new" {
        let typed_name = field_value("#who")
        if typed_name.len() == 0 {
            return
        }
        store.dismiss(app)
        repaint(app)
        do_new_customer(app, typed_name, "")
        return
    }
    if name == "receipt-pick" {
        // The same list serves two commands, so the tap follows the reason it
        // was opened rather than assuming a return.
        match app.overlay {
            Receipts(purpose) => {
                if purpose == "print" {
                    load_slip(app, id)
                } else {
                    load_receipt(app, id)
                }
            },
            _ => { },
        }
        return
    }
    if name == "slip-print" {
        browser.print_page()
        return
    }
    if name == "return-less" {
        step_return(app, id, -1.0)
        return
    }
    if name == "return-more" {
        step_return(app, id, 1.0)
        return
    }
    if name == "return-go" {
        let why = field_value("#reason")
        if why.len() == 0 {
            store.went_wrong(app, i18n.t(app.lang, "reason"))
            repaint(app)
            return
        }
        // A return is the "PIN" row of the command matrix, so a manager proves
        // it at the lane before anything is paid out.
        store.show(app, store.Overlay.ManagerPin(purpose: "return", line_id: id, amount: 0))
        store.say(app, why)
        repaint(app)
        return
    }
    if name == "recall" {
        store.dismiss(app)
        repaint(app)
        do_recall(app, id)
        return
    }
    if name == "search" {
        store.show(app, store.Overlay.Search)
        repaint(app)
        browser.focus("#find")
        return
    }
    if name == "keypad" {
        let line = last(app.basket.lines)
        if line == nil {
            return
        }
        store.show(app, store.Overlay.Keypad(purpose: "qty", line_id: line.id,
                title: "\(i18n.t(app.lang, "quantity")) · \(line.name)"))
        repaint(app)
        return
    }
    if name == "sign-out" {
        sign_off(app)
        return
    }
}

/// Whether a bare keystroke belongs in the scan box.
///
/// Only on the sale screen, only with no dialog in front of it, only when
/// somebody is signed in — and never when the caret is already in the box,
/// where the browser is doing the typing itself and a second copy of every
/// character would land.
fn routable(app: store.App, field: str) -> bool {
    if app.session == nil {
        return false
    }
    if app.mode != store.Mode.Sale {
        return false
    }
    if app.overlay != store.Overlay.None {
        return false
    }
    return field != "scan"
}

/// Whether a keyboard shortcut may stand in for a press of the command bar.
///
/// The bar is only drawn when somebody is signed in, on the sale screen, with
/// no dialog over it — and a press is refused while a request is in flight.
/// A function key answers to all four.
fn commandable(app: store.App) -> bool {
    if app.session == nil {
        return false
    }
    if app.busy {
        return false
    }
    if app.overlay != store.Overlay.None {
        return false
    }
    return app.mode == store.Mode.Sale
}

/// Every key the page sees, wherever the focus happens to be.
///
/// This listener is on the **document**, which is what the comment beside it
/// always claimed and what the code did not do: it was attached to `#app`, a
/// descendant of `<body>`, so a keystroke with nothing focused — the ordinary
/// state of the screen after a tap — travelled body → html → document and never
/// passed it. The till got away with that only because every repaint dragged
/// the focus back into the scan box, which is the behaviour being removed.
fn typed(app: store.App, e: dom.Event) {
    let key = dom.key(e)
    let hit = dom.target(e)
    // A target that is not an element is the document or `<body>` — which is
    // exactly the case this listener was moved here to catch, so it is a blank
    // field rather than a reason to return.
    var field = ""
    if hit != nil {
        field = or_else(dom.attribute(hit, "id"), "")
    }

    // `prevent_default` is called per arm and deliberately not everywhere:
    // Escape and every unnamed key are left to the browser, and so is Enter
    // inside the reason box — which is why "reason" is its own empty arm rather
    // than folded into the default.
    match key {
        "Enter" => {
            match field {
                "scan" => {
                    _ = dom.prevent_default(e)
                    scan_typed(app)
                    return
                },
                "find" => {
                    _ = dom.prevent_default(e)
                    do_search(app, field_value("#find"))
                    return
                },
                "reason" => { return },
                // Enter with the focus anywhere else — or nowhere at all.
                //
                // A scanner ends its burst with one, and by then its characters
                // are already in the box because the arm at the bottom of this
                // match put them there. So a box with something in it is what
                // says "that was a scanner"; an empty one leaves Enter to the
                // button under the operator's finger, where it belongs.
                _ => {
                    if !routable(app, field) {
                        return
                    }
                    if field_value("#scan").len() == 0 {
                        return
                    }
                    _ = dom.prevent_default(e)
                    scan_typed(app)
                    return
                },
            }
        },
        "Escape" => {
            if app.busy {
                return
            }
            store.dismiss(app)
            repaint(app)
            return
        },
        // Xstore maps every menu button to a function key, and a counter with a
        // keyboard is faster for it. F2 is the commit, which is the one worth
        // having under a finger.
        //
        // **Each one is gated exactly as the button beside it is.** They were
        // not, and the listener moving to the document made that reachable: a
        // modal focuses no input, so a stray F3 while a manager was typing
        // their PIN replaced the authorisation dialog with the held list and
        // took the reason it was carrying with it. A key must not reach a
        // command a finger could not.
        "F2" => {
            _ = dom.prevent_default(e)
            if !commandable(app) {
                return
            }
            if app.basket.lines.len() > 0 && app.mode == store.Mode.Sale {
                store.go_to_mode(app, store.Mode.Tender)
                repaint(app)
            }
            return
        },
        "F3" => {
            _ = dom.prevent_default(e)
            if !commandable(app) {
                return
            }
            command(app, "hold")
            return
        },
        "F4" => {
            _ = dom.prevent_default(e)
            if !commandable(app) {
                return
            }
            command(app, "held")
            return
        },
        // **The scanner, typing into a box it has not got the caret in.**
        //
        // One bare character. The operator has tapped a tile, so the focus is
        // on a button; the scanner fires anyway, because it is a keyboard and
        // it does not know that. Each character is written into the scan box
        // instead of going wherever the focus is, and the Enter that ends the
        // burst rings it up. The till reads exactly as it did when it held the
        // focus hostage, and the operator's own taps now keep theirs.
        //
        // Space is excluded: a space on a focused button is that button being
        // pressed, and no barcode this shop scans contains one.
        _ => {
            if key.len() != 1 || key == " " {
                return
            }
            if !browser.plain_key(e) {
                return
            }
            if routable(app, field) {
                _ = dom.prevent_default(e)
                browser.append_value("#scan", key)
                return
            }
            // **A scan that cannot be rung is said out loud.**
            //
            // The dialogs a scan itself raises — an age check, a price to ask
            // for — carry no input of their own, so nothing has the focus while
            // one is up. A cashier looking at a customer's ID scans the next
            // two items out of habit, the characters reach a till that is not
            // in a state to ring them, and without this they go nowhere at all:
            // no red band, no line on the basket, and the scanner beeped both
            // times. Those items leave the shop unpaid.
            //
            // Only when nothing is focused. A character typed into a dialog's
            // own box — a manager's PIN, a reason — is the operator answering
            // the dialog, and belongs to it.
            if field.len() == 0 && app.session != nil && app.overlay != store.Overlay.None {
                store.went_wrong(app, i18n.t(app.lang, "finish_this_first"))
                repaint(app)
            }
            return
        },
    }
}

// ---- starting up -----------------------------------------------------------

pub fn main() {
    let root = dom.find("#app")
    if root == nil {
        io.error("till: there is no #app to mount into")
        return
    }
    let (mounted, merr) = html.mount(root, [])
    if merr != nil {
        io.error("till: could not mount: \(merr.message())")
        return
    }

    let lang = i18n.of_code(or_else(window.kept("kite-pos.lang"), "en"))
    let app = store.holding(root, mounted, lang)

    // Read before the first paint rather than after it, which is the whole of
    // the fix: a kept token means somebody is signed in until the Worker says
    // otherwise, and the paint below is the one that used to put a PIN pad in
    // front of a cashier who already was. The ask itself still happens last,
    // once the listeners are on.
    let token = window.kept("kite-pos.token")
    if token != nil {
        store.restoring(app, true)
    }
    repaint(app)

    // One listener for every touch in the application. A repainted description
    // has nothing to reattach, because nothing was ever attached to a described
    // element in the first place.
    let (_, cerr) = dom.on(root, "click", |e: dom.Event| { clicked(app, e) })
    if cerr != nil {
        io.error("till: no clicks: \(cerr.message())")
    }
    // On the document rather than the root: a scanner types wherever the focus
    // happens to be, and a keystroke that lands outside the mounted tree still
    // has to reach the scan box. `#app` is *inside* `<body>`, so a keydown with
    // nothing focused never passed it — which is why this now says `document`
    // instead of `root`, and why `typed` can stop assuming the focus is already
    // where it wants it.
    let (_, kerr) = dom.on(browser.document_element(), "keydown",
        |e: dom.Event| { typed(app, e) })
    if kerr != nil {
        io.error("till: no keys: \(kerr.message())")
    }

    browser.register_worker("/sw.js")

    if token != nil {
        resume(app, token)
    }
}
