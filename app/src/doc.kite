//! JSON, read with `std/json`.
//!
//! This file used to hold a whole JSON facade over the host's `JSON.parse`,
//! because `std/json` was O(n²) here: a `str` was an index into a table the
//! glue held, every string primitive rebuilt the whole string to answer a
//! question about one character, and a parser walking a document one character
//! at a time paid for the entire document at every step. **That stopped being
//! true when a `str` became a WasmGC array.** `std/json` is now linear and
//! within about 1.8x of the host parser — 1 ms for a 24 KB payload, 5.7 ms for
//! 122 KB — which is nowhere near what a queue at the counter can notice.
//!
//! So the parsing came home, and what is left here is a *naming* layer, not an
//! implementation. `Doc` is `Option<json.Json>` with no wrapper around it, and
//! every function below is one line over `std/json`. Two things earn the layer
//! its keep:
//!
//!   * The accessors take a fallback and return a plain value, which is the
//!     shape a screen wants: the API is ours, its shape is a contract, and a
//!     missing field is its empty value rather than an `Option` that a thousand
//!     call sites have to unwrap.
//!   * `int_of` rounds where `json.int_or` truncates. Every amount of money in
//!     this application crossed the wire as a JSON number.
//!
//! There is no writing side any more. A `Json.Object(m)` copies `m`, so a
//! builder that hands out a document and then mutates it cannot work; a request
//! body is built as a local `{ str: json.Json }` and wrapped once at the end.
//!
//! ## The one thing the host did that this does not
//!
//! `std/json` **does not decode `\uXXXX`**: it drops the backslash and leaves
//! the four digits as text, because building a character from a code point is
//! an operation `str` does not have yet. `JSON.parse` decoded them. Nothing
//! breaks today — the Worker serialises with `JSON.stringify`, which emits
//! non-ASCII as itself — but if anything upstream ever starts escaping, a
//! Burmese product name arrives as `u1006` rather than as ဆ. That is a
//! `std/json` gap to close, not something this file can work around.

use std/json
use std/math
use std/errors

/// A JSON value, or nothing.
///
/// An alias rather than a struct: `std/json`'s accessors already take and
/// return `Option<Json>`, so wrapping it would only mean unwrapping it again on
/// every line below.
pub type Doc = Option<json.Json>

/// A value that is not there.
///
/// Every accessor answers with this rather than failing, which is what makes
/// them chain: `doc.field(doc.field(d, "sale"), "total")` reads left to right
/// and is absent the moment anything on the path is.
pub fn nothing() -> Doc {
    return nil
}

/// Whether a value is absent — **or explicitly `null`**, which is the same
/// question a caller is asking.
///
/// `d == nil` answers only the first. The host-backed predecessor of this file
/// used `js.is_nothing`, which was true for both, and kite-feeds depends on
/// that difference: Mastodon sends `"reblog": null` on every post that is not
/// a boost, and reading that as *present* makes every ordinary post look like
/// a boost of nothing.
pub fn missing(d: Doc) -> bool {
    return json.is_null(d)
}

// ---- reading ---------------------------------------------------------------

pub fn parse(body: str) -> (Doc, error) {
    let (value, err) = json.parse(body)
    check errors.wrap(err, "that is not JSON")
    return value, nil
}

pub fn field(d: Doc, name: str) -> Doc {
    return json.field(d, name)
}

/// The elements of an array, or nothing at all.
///
/// A slice rather than a branch, because a caller iterating them wants a loop
/// and not an `if` around one. `json.items` yields `[Json]`; these are `[Doc]`
/// so that a converter written against `Doc` can still be handed to `map`.
pub fn items(d: Doc) -> [Doc] {
    var out: [Doc] = []
    for item in json.items(d) {
        // Widened through a binding rather than in the `push` — see `parse`.
        let one: Doc = item
        out.push(one)
    }
    return out
}

/// This value as text, or "" when it is not text.
pub fn text_of(d: Doc) -> str {
    return or_else(json.text(d), "")
}

pub fn text(d: Doc, name: str, fallback: str) -> str {
    return json.text_or(d, name, fallback)
}

/// A whole-number field, rounded rather than cast.
///
/// JSON has one numeric type and a count crosses as a double; truncating
/// towards zero is the wrong answer for anything that was a whole number before
/// it crossed — and every amount of money in this application is one. This is
/// not `json.int_or`, which is `n as int` and therefore truncates.
pub fn int_of(d: Doc, name: str, fallback: int) -> int {
    return math.round_to(or_else(json.number_of(json.field(d, name)), fallback as float))
}

/// A quantity, which is the one field that is legitimately fractional.
pub fn num_of(d: Doc, name: str, fallback: float) -> float {
    return or_else(json.number_of(json.field(d, name)), fallback)
}

pub fn bool_of(d: Doc, name: str, fallback: bool) -> bool {
    return json.bool_or(d, name, fallback)
}

/// An int held directly rather than under a name, for an array of numbers.
pub fn as_int(d: Doc) -> int {
    return math.round_to(or_else(json.number_of(d), 0.0))
}
